                                    <div class="h-48"><canvas id="riskTrendChart"></canvas></div>
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-white p-5 lg:col-span-4 dark:border-slate-700 dark:bg-slate-800/90">
