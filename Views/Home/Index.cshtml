                                </div>
                                <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-4 dark:border-slate-700 dark:bg-slate-800/90">
                                    <p class="font-black tracking-[0.2em] text-[9px] text-slate-400 uppercase">Approvals</p>
                                    <h3 class="mt-2 text-2xl font-black text-slate-900 dark:text-white">08</h3>
                                    <p class="mt-2 font-black text-[8px] text-emerald-500 uppercase italic">+6 New</p>
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-4 dark:border-slate-700 dark:bg-slate-800/90">
                                    <p class="font-black tracking-[0.2em] text-[9px] text-slate-400 uppercase">Health Index</p>
                                    <h3 class="mt-2 text-2xl font-black text-emerald-500">98.2%</h3>
                                    <div class="mt-3 h-1 w-full rounded-full bg-slate-100 dark:bg-slate-700"><div class="h-full bg-emerald-500" style="width: 98%"></div></div>
                                </div>
                                <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-4 dark:border-slate-700 dark:bg-slate-800/90">
                                    <p class="font-black tracking-[0.2em] text-[9px] text-slate-400 uppercase">System State</p>
                                    <h3 class="mt-2 text-lg font-black tracking-tighter text-slate-900 uppercase dark:text-white">Operational</h3>
                                    <p class="mt-2 font-bold text-[9px] text-emerald-500 uppercase">✔ Optimal</p>
                                </div>
                            </div>

                            <div class="grid gap-4 lg:grid-cols-12">
