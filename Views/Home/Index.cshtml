                    </p>
                </div>
                <div class="w-full md:w-1/2">
                    <div class="glass-card rounded-3xl border border-slate-200 p-4 shadow-sm dark:border-slate-800">
                        <img src="~/images/feature-work-management.png" alt="Risk and work management dashboard"
                             class="w-full rounded-2xl object-cover" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

