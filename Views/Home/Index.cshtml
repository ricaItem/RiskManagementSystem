                                        Export
                                    </button>
                                </div>
                            </div>

                            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                                <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-4 dark:border-slate-700 dark:bg-slate-800/90">
                                    <p class="font-black tracking-[0.2em] text-[9px] text-slate-400 uppercase">Overdue Items</p>
                                    <h3 class="mt-2 text-2xl font-black text-slate-900 dark:text-white">12</h3>
