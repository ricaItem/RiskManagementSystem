@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}
<style>
    #forgot-submit-btn { background-color: #0B1F33 !important; color: #fff !important; }
    .dark #forgot-submit-btn { background-color: #fff !important; color: #0f172a !important; }
    @@keyframes auth-spin { to { transform: rotate(360deg); } }
    .auth-btn-spinner { display: inline-block; border: 2px solid currentColor; border-top-color: transparent; border-radius: 9999px; animation: auth-spin .8s linear infinite; }
    .auth-btn-spinner.hidden { display: none; }
    button.processing .btn-text { visibility: hidden; }
    button.processing .auth-btn-spinner { display: inline-block !important; }
</style>

<section class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
        <div class="mx-auto w-full max-w-md">
            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png" alt="Sentro" class="h-10 w-auto object-contain" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                </a>
            </div>

            <h1 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">Forgot your password?</h1>
            <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">Enter your email and we'll send you a link to reset it.</p>

            <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                <form id="forgotForm" method="post" class="space-y-5">
                    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/40 dark:bg-rose-900/20 dark:text-rose-200" role="alert"></div>

                    <div>
                        <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Email</label>
                        <input asp-for="Input.Email" type="email" autocomplete="username"
                               class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <button type="submit" id="forgot-submit-btn"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-70 dark:focus:ring-offset-slate-900">
                        <span id="forgot-spinner" class="auth-btn-spinner hidden h-4 w-4" aria-hidden="true"></span>
                        <span id="forgot-btn-text" class="btn-text">Send reset link</span>
                    </button>

                    <p class="text-center text-sm text-slate-600 dark:text-slate-300">
                        <a asp-page="./Login" class="font-medium text-[#059669] hover:underline dark:text-emerald-400">Back to sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('forgotForm');
            var btn = document.getElementById('forgot-submit-btn');
            var spinner = document.getElementById('forgot-spinner');
            var text = document.getElementById('forgot-btn-text');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    if (btn.classList.contains('processing')) return;
                    btn.classList.add('processing');
                    btn.disabled = true;
                    if (spinner) spinner.classList.remove('hidden');
                    if (text) text.textContent = 'Sending...';
                });
            }
        })();
    </script>
}
