@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}

<section class="relative min-h-screen overflow-hidden bg-gradient-to-b from-[#F4F7F9] to-[#EBF0F5] dark:from-slate-950 dark:to-slate-900">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
        <div class="mx-auto w-full max-w-md">
            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png" alt="Sentro" class="h-10 w-auto object-contain" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                </a>
            </div>

            <div class="mt-10 rounded-2xl border border-[#D7E0EA] bg-white p-8 text-center shadow-[0_16px_40px_rgba(15,34,53,0.12)] dark:border-slate-800 dark:bg-slate-900">
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white">@ViewData["Title"]</h1>
                <div class="mt-4 text-sm [&>div]:rounded-xl [&>div]:border [&>div]:px-4 [&>div]:py-3"> 
                    <partial name="_StatusMessage" model="Model.StatusMessage" />
                </div>
                <a asp-page="./Login" class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-[#0E3A5D] py-3.5 text-sm font-semibold text-white transition hover:bg-[#114B77]">Continue to sign in</a>
            </div>
        </div>
    </div>
</section>
