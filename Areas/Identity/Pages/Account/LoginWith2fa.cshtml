@page
@model WEB_Sentro.Areas.Identity.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}

<section class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
        <div class="mx-auto w-full max-w-md">
            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png" alt="Sentro Logo" class="h-10 w-auto object-contain transition-all duration-300" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                </a>
            </div>

            <h1 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                Enter your verification code
            </h1>
            <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                Open Google Authenticator and enter the 6-digit code to continue.
            </p>

            <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                <form method="post" class="space-y-5">
                    @if (ViewData.ModelState[""]?.Errors?.Count > 0)
                    {
                        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/40 dark:bg-rose-900/20 dark:text-rose-200" role="alert">
                            <div asp-validation-summary="ModelOnly" class="[&>ul]:list-none [&>ul]:m-0 [&>ul]:p-0"></div>
                        </div>
                    }

                    <div>
                        <label asp-for="Input.TwoFactorCode" class="block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
                        <input asp-for="Input.TwoFactorCode" autocomplete="one-time-code" inputmode="numeric"
                               class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm tracking-[0.25em] text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        <span asp-validation-for="Input.TwoFactorCode" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <button type="submit"
                            class="inline-flex w-full items-center justify-center rounded-xl bg-[#0B1F33] py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-[#0B1F33]/40 dark:bg-white dark:text-slate-900">
                        Verify and continue
                    </button>

                    <input type="hidden" name="rememberMe" value="@Model.RememberMe.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
