@page
@model RegisterSuccessModel
@{
    ViewData["Title"] = "Registration complete";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}

<section class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
        <div class="mx-auto w-full max-w-md">

            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png" alt="Sentro" class="h-10 w-auto object-contain" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                </a>
            </div>

            <div class="mt-10 rounded-2xl border border-[#E5E7EB] bg-white p-8 shadow-lg dark:border-slate-800 dark:bg-slate-900 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h1 class="mt-6 text-2xl font-bold text-slate-900 dark:text-white">Payment successful</h1>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Your account has been created and your subscription is active.</p>

                <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50/50 p-5 dark:border-slate-700 dark:bg-slate-800/30 text-left">
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">Receipt sent to your email</p>
                    <p class="mt-1 text-sm font-medium text-slate-700 dark:text-slate-200">We've sent a confirmation and receipt to <strong>@(Model.Email ?? "your email")</strong>. Check your inbox (and spam folder).</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Plan) || !string.IsNullOrEmpty(Model.Amount))
                {
                    <div class="mt-6 flex justify-center gap-6 text-sm">
                        @if (!string.IsNullOrEmpty(Model.Plan))
                        {
                            <span class="rounded-lg bg-slate-100 px-3 py-1.5 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Plan: @Model.Plan</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Amount) && Model.Amount != "—")
                        {
                            <span class="rounded-lg bg-slate-100 px-3 py-1.5 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Amount: @Model.Amount</span>
                        }
                    </div>
                }

                <div class="mt-8 space-y-3">
                    <a asp-page="./Login" asp-route-returnUrl="/Client/Dashboard" class="inline-flex w-full items-center justify-center rounded-xl bg-[#0B1F33] py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90 dark:bg-white dark:text-slate-900">
                        Continue to dashboard
                    </a>
                    <a asp-page="./Login" class="inline-flex w-full items-center justify-center rounded-xl border border-slate-300 bg-white py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                        Log in to your account
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
