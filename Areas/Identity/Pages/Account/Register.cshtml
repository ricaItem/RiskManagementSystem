                                            <label class="block text-sm font-semibold text-slate-800">Country</label>
                                            <input type="text" placeholder="Country"
                                                   class="mt-2 w-full rounded-xl border-2 border-slate-500 bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-500 focus:border-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-700/20 transition" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Terms -->
                            <label class="flex cursor-pointer items-start gap-3 pt-2">
                                <input type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 rounded border-2 border-slate-500 bg-white accent-slate-700" />
                                <span class="text-sm text-slate-700 leading-relaxed">
                                    I agree to Sentro's <span class="font-semibold text-slate-900 underline underline-offset-2 cursor-pointer">terms of service</span>, <span class="font-semibold text-slate-900 underline underline-offset-2 cursor-pointer">privacy policy</span>, and <span class="font-semibold text-slate-900 underline underline-offset-2 cursor-pointer">billing terms</span>.
                                </span>
                            </label>

                            <!-- Pay button (right panel, below terms) -->
                            <div class="pt-6">
                                <button type="button" id="completeSetup"
                                        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#0B1F33] py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90">
                                    <span class="btn-spinner"></span>
                                    <span class="btn-text">Pay now</span>
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    // ── Plan card selector (global so onclick attrs can reach it) ──
    function selectPlan(plan) {
        const hidden = document.getElementById('selectedPlan');
        if (hidden) hidden.value = plan;
        document.querySelectorAll('#planCardGroup .plan-card').forEach(function (card) {
            card.classList.toggle('selected', card.getAttribute('data-plan') === plan);
        });
        // keep billing summary in sync if already rendered
        if (typeof syncPlanSummary === 'function') syncPlanSummary();
    }

    (function () {
        let currentStep = 1;
        let orgCodeManuallyEdited = false;

        const stepCount = 6;
        const planMeta = {
            Basic:        { price: '₱49 / month',  total: '₱49',  seats: 'Up to 10' },
            Professional: { price: '₱149 / month', total: '₱149', seats: 'Up to 50' },
            Enterprise:   { price: '₱399 / month', total: '₱399', seats: 'Up to 200' }
        };

        function showStep(step) {
            currentStep = step;
            const step1Wrapper = document.getElementById('step-1-wrapper');
            const multiStepWrapper = document.getElementById('multi-step-wrapper');
            const section = document.getElementById('registerSection');

            // Toggle between step-1 full-screen layout and multi-step layout
            const isStep1 = step === 1;
            if (step1Wrapper) step1Wrapper.classList.toggle('hidden', !isStep1);
            if (multiStepWrapper) multiStepWrapper.classList.toggle('hidden', isStep1);

            // Show/hide individual step panels (steps 2–6 inside multi-step-wrapper)
            for (let i = 2; i <= stepCount; i++) {
                const panel = document.getElementById(`step-${i}`);
                if (!panel) continue;
                panel.classList.toggle('hidden', i !== step);

                const dot = document.querySelector(`[data-step-dot="${i}"]`);
                const label = document.querySelector(`[data-step-label="${i}"]`);
                if (dot) dot.classList.toggle('active', i <= step);
                if (label) label.classList.toggle('active', i <= step);
            }

            const isBilling = step === 6;
            if (section) {
                section.style.background = isBilling ? 'transparent' : '';
            }
        }

        function syncEmails() {
            const email = document.getElementById('flowEmail')?.value?.trim() || '';
            const verifyLabel = document.getElementById('verifyEmailLabel');
            const loginEmail = document.getElementById('loginEmail');
            const paymentEmail = document.getElementById('paymentEmail');
            if (verifyLabel) verifyLabel.textContent = email || 'your email';
            if (loginEmail) loginEmail.value = email;
            if (paymentEmail) paymentEmail.value = email;
        }

        function generateOrgCode(name) {
            const cleaned = (name || '')
                .toUpperCase()
                .replace(/[^A-Z0-9\s]/g, '')
                .trim()
                .split(/\s+/)
                .slice(0, 3)
                .map(x => x.substring(0, 3))
                .join('');
            const suffix = String(Math.floor(Math.random() * 900) + 100);
            return (cleaned || 'ORG') + '-' + suffix;
        }

        function syncPlanSummary() {
            const plan = document.getElementById('selectedPlan')?.value || 'Basic';
            const paymentPlan = document.getElementById('paymentPlan');
            const planName = document.getElementById('summaryPlanName');
            const planPrice = document.getElementById('summaryPlanPrice');
            const planAmount = document.getElementById('summaryPlanAmount');
            const subtotal = document.getElementById('summarySubtotal');
            const total = document.getElementById('summaryTotal');
            const meta = planMeta[plan] || planMeta.Basic;

            if (paymentPlan && paymentPlan.value !== plan) paymentPlan.value = plan;
            if (planName) planName.textContent = plan;
            if (planPrice) planPrice.textContent = meta.price;
            // Bill breakdown: plan amount and subtotal match total (tax at checkout)
            const amount = meta.total;
            if (planAmount) planAmount.textContent = amount.includes('.') ? amount : amount + '.00';
            if (subtotal) subtotal.textContent = amount.includes('.') ? amount : amount + '.00';
            if (total) total.textContent = meta.total;
        }
        // expose for selectPlan global
        window.syncPlanSummary = syncPlanSummary;

        function updatePasswordChecklist() {
            const value = document.getElementById('adminPassword')?.value || '';
            const checks = {
                'chk-len': value.length >= 12,
                'chk-upper': /[A-Z]/.test(value),
                'chk-lower': /[a-z]/.test(value),
                'chk-number': /\d/.test(value),
                'chk-symbol': /[^A-Za-z0-9]/.test(value)
            };
            Object.keys(checks).forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.classList.toggle('ok', checks[id]);
            });
        }

        function setupVerifyInputs() {
            const inputs = Array.from(document.querySelectorAll('.verify-digit'));
            inputs.forEach((input, idx) => {
                input.addEventListener('input', function () {
                    input.value = input.value.replace(/\D/g, '').slice(0, 1);
                    if (input.value && idx < inputs.length - 1) inputs[idx + 1].focus();
                });
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Backspace' && !input.value && idx > 0) {
                        inputs[idx - 1].focus();
                    }
                });
            });
        }

        function setupPaymentMethods() {
            const cards = Array.from(document.querySelectorAll('.payment-method'));
            const cardFields = document.getElementById('cardFields');
            const walletFields = document.getElementById('walletFields');
            const walletTitle = document.getElementById('walletTitle');

            function setMethod(method) {
                cards.forEach(c => c.classList.toggle('active', c.getAttribute('data-method') === method));
                const useCard = method === 'card';
                if (cardFields) cardFields.classList.toggle('hidden', !useCard);
                if (walletFields) walletFields.classList.toggle('hidden', useCard);
                if (walletTitle) walletTitle.textContent = method === 'maya' ? 'Maya Account Information' : 'GCash Account Information';
            }

            cards.forEach(c => c.addEventListener('click', () => setMethod(c.getAttribute('data-method') || 'card')));
            setMethod('card');
        }

        function setupCardExpiryFormatter() {
            const expiry = document.getElementById('cardExpiry');
            if (!expiry) return;
            expiry.addEventListener('input', function () {
                const digits = expiry.value.replace(/\D/g, '').slice(0, 4);
                if (digits.length >= 3) {
                    expiry.value = digits.slice(0, 2) + '/' + digits.slice(2);
                } else {
                    expiry.value = digits;
                }
            });
        }

        function setupPhoneFormat() {
            document.querySelectorAll('input[data-phone-format]').forEach(function (input) {
                input.addEventListener('input', function () {
                    const digits = this.value.replace(/\D/g, '').slice(0, 10);
                    if (digits.length <= 3) {
                        this.value = digits;
                    } else if (digits.length <= 6) {
                        this.value = digits.slice(0, 3) + ' ' + digits.slice(3);
                    } else {
                        this.value = digits.slice(0, 3) + ' ' + digits.slice(3, 6) + ' ' + digits.slice(6);
                    }
                });
            });
        }

        async function sendVerificationCode() {
            const email = (document.getElementById('flowEmail')?.value || '').trim();
            if (!email) { alert('Please enter your email.'); return false; }
            try {
                const r = await fetch('/api/registration/send-verification-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                const data = await r.json().catch(() => ({}));
                if (!r.ok) { alert(data.error || 'Failed to send code.'); return false; }
                return true;
            } catch (e) { alert('Network error. Please try again.'); return false; }
        }

        async function verifyCodeAndContinue() {
            const email = (document.getElementById('flowEmail')?.value || '').trim();
            const digits = Array.from(document.querySelectorAll('.verify-digit')).map(i => i.value).join('');
            if (digits.length !== 6) { alert('Please enter the 6-digit code.'); return false; }
            try {
                const r = await fetch('/api/registration/verify-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, code: digits })
                });
                const data = await r.json().catch(() => ({}));
                if (!r.ok) { alert(data.error || 'Invalid or expired code.'); return false; }
                return true;
            } catch (e) { alert('Network error. Please try again.'); return false; }
        }

        document.querySelectorAll('[data-next]').forEach(btn => {
            btn.addEventListener('click', async function () {
                const next = parseInt(btn.getAttribute('data-next') || '1', 10);

                if (currentStep === 1) {
                    syncEmails();
                    if (btn.id === 'get-started-btn') {
                        btn.classList.add('processing');
                        const ok = await sendVerificationCode();
                        btn.classList.remove('processing');
                        if (!ok) return;
                        const label = document.getElementById('verifyEmailLabel');
                        if (label) label.textContent = document.getElementById('flowEmail')?.value || '';
                    }
                }

                if (currentStep === 2 && next === 3 && btn.id === 'verify-continue-btn') {
                    btn.classList.add('processing');
                    const ok = await verifyCodeAndContinue();
                    btn.classList.remove('processing');
                    if (!ok) return;
                }

                if (currentStep === 1 || currentStep === 2) syncEmails();
                if (currentStep === 3) syncPlanSummary();

                showStep(next);
            });
        });

        document.querySelectorAll('[data-back]').forEach(btn => {
            btn.addEventListener('click', function () {
                const back = parseInt(btn.getAttribute('data-back') || '1', 10);
                showStep(back);
            });
        });

        const flowEmail = document.getElementById('flowEmail');
        if (flowEmail) flowEmail.addEventListener('input', syncEmails);

        const orgName = document.getElementById('orgName');
        const orgCode = document.getElementById('orgCode');
        if (orgCode) {
            orgCode.addEventListener('input', function () {
                orgCodeManuallyEdited = true;
            });
        }
        if (orgName) {
            orgName.addEventListener('input', function () {
                if (!orgCode || orgCodeManuallyEdited) return;
                orgCode.value = generateOrgCode(orgName.value);
            });
            orgName.addEventListener('blur', function () {
                if (!orgCode || orgCodeManuallyEdited || orgCode.value.trim()) return;
                orgCode.value = generateOrgCode(orgName.value);
            });
        }

        const adminPassword = document.getElementById('adminPassword');
        if (adminPassword) adminPassword.addEventListener('input', updatePasswordChecklist);

        const resendCodeBtn = document.getElementById('resend-code-btn');
        if (resendCodeBtn) {
            resendCodeBtn.addEventListener('click', async function () {
                const email = (document.getElementById('flowEmail')?.value || '').trim();
                if (!email) { alert('Email is required.'); return; }
                resendCodeBtn.classList.add('processing');
                const ok = await sendVerificationCode();
                resendCodeBtn.classList.remove('processing');
                if (ok) alert('A new code has been sent to your email.');
            });
        }

        const completeSetup = document.getElementById('completeSetup');
        if (completeSetup) {
            completeSetup.addEventListener('click', async function () {
                const email = (document.getElementById('flowEmail')?.value || '').trim();
                const plan = document.getElementById('selectedPlan')?.value || 'Basic';
                const orgName = document.getElementById('orgName')?.value?.trim();
                const orgCode = document.getElementById('orgCode')?.value?.trim();
                const adminFirstName = document.getElementById('adminFirstName')?.value?.trim();
                const adminMiddleName = document.getElementById('adminMiddleName')?.value?.trim();
                const adminLastName = document.getElementById('adminLastName')?.value?.trim();
                const loginEmail = document.getElementById('loginEmail')?.value?.trim();
                const adminPassword = document.getElementById('adminPassword')?.value;
                const paymentEmail = document.getElementById('paymentEmail')?.value?.trim();
                if (!email || !orgName || !orgCode || !adminFirstName || !adminLastName || !adminPassword) {
                    alert('Please fill in all required fields.');
                    return;
                }
                const amountCentavos = plan === 'Professional' ? 14900 : plan === 'Enterprise' ? 39900 : 10000;
                completeSetup.classList.add('processing');
                try {
                    const intentRes = await fetch('/api/paymongo/payment-intents', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ amountCentavos: amountCentavos, paymentMethodAllowed: ['card', 'paymaya', 'gcash'] })
                    });
                    const intentData = await intentRes.json().catch(() => ({}));
                    const paymentIntentId = intentRes.ok ? intentData.id : null;

                    const completePayload = {
                        email: email,
                        plan: plan,
                        organizationName: orgName,
                        organizationCode: orgCode,
                        adminFirstName: adminFirstName,
                        adminMiddleName: adminMiddleName || '',
                        adminLastName: adminLastName,
                        password: adminPassword,
                        paymentIntentId: paymentIntentId,
                        useTestPayment: true
                    };
                    const completeRes = await fetch('/api/registration/complete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(completePayload)
                    });
                    const completeData = await completeRes.json().catch(() => ({}));
                    if (!completeRes.ok) {
                        alert(completeData.error || 'Registration failed.');
                        completeSetup.classList.remove('processing');
                        return;
                    }
                    if (completeData.redirectUrl) {
                        window.location.href = completeData.redirectUrl;
                        return;
                    }
                    window.location.href = '/Identity/Account/RegisterSuccess?email=' + encodeURIComponent(email) + '&plan=' + encodeURIComponent(plan) + '&amount=' + encodeURIComponent(plan === 'Professional' ? '₱149' : plan === 'Enterprise' ? '₱399' : '₱49');
                } catch (e) {
                    alert('Something went wrong. Please try again.');
                    completeSetup.classList.remove('processing');
                }
            });
        }

        document.querySelectorAll('.password-toggle').forEach(function (btn) {
            var targetId = btn.getAttribute('data-target');
            if (!targetId) return;
            var input = document.getElementById(targetId);
            var eyeOpen = btn.querySelector('.eye-open');
            var eyeClosed = btn.querySelector('.eye-closed');
            if (!input || !eyeOpen || !eyeClosed) return;
            btn.addEventListener('click', function () {
                if (input.type === 'password') {
                    input.type = 'text';
                    eyeOpen.classList.add('hidden');
                    eyeClosed.classList.remove('hidden');
                    btn.setAttribute('aria-label', 'Hide password');
                } else {
                    input.type = 'password';
                    eyeOpen.classList.remove('hidden');
                    eyeClosed.classList.add('hidden');
                    btn.setAttribute('aria-label', 'Show password');
                }
            });
        });

        setupVerifyInputs();
        setupPaymentMethods();
        setupCardExpiryFormatter();
        setupPhoneFormat();
        syncEmails();
        syncPlanSummary();
        updatePasswordChecklist();
        showStep(1);
    })();
</script>
