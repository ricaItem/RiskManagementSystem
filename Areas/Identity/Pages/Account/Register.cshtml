@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}

<style>
    #get-started-btn { background-color: #0B1F33 !important; color: #fff !important; }
    .dark #get-started-btn { background-color: #fff !important; color: #0f172a !important; }
    #verify-continue-btn { background-color: #0B1F33 !important; color: #fff !important; }
    .dark #verify-continue-btn { background-color: #fff !important; color: #0f172a !important; }

    .payment-method.active {
        border-color: #0b1f33;
        background: #eff6ff;
    }

    .dark .payment-method.active {
        border-color: #34d399;
        background: rgba(16, 185, 129, 0.1);
    }
    .pwd-check.ok { color: #059669; }

    /* ── Onboarding progress bar ── */
    .ob-progress-track {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .ob-progress-track::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 4px;
        background: #e2e8f0;
        transform: translateY(-50%);
        border-radius: 9999px;
        z-index: 0;
    }
    .ob-progress-fill {
        position: absolute;
        top: 50%;
        left: 0;
        height: 4px;
        background: linear-gradient(to right, #F0395A, #F5C518, #5BC8F5, #1BAF82);
        transform: translateY(-50%);
        border-radius: 9999px;
        z-index: 1;
        transition: width 0.4s ease;
    }
    .dark .ob-progress-track::before { background: #334155; }
    .dark .ob-progress-fill {
        background: linear-gradient(to right, #F0395A, #F5C518, #5BC8F5, #1BAF82);
    }

    .ob-step-node {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: #e2e8f0;
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 700;
        transition: background 0.3s, color 0.3s, box-shadow 0.3s;
        border: 3px solid #f9fafb;
    }
    .dark .ob-step-node {
        background: #334155;
        color: #64748b;
        border-color: #0f172a;
    }
    /* node 1 = pink, node 2 = yellow, node 3 = teal */
    .ob-step-node.done:nth-child(2),
    .ob-step-node.active:nth-child(2) {
        background: #F0395A;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(240,57,90,0.2);
    }
    .ob-step-node.done:nth-child(3),
    .ob-step-node.active:nth-child(3) {
        background: #F5C518;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(245,197,24,0.2);
    }
    .ob-step-node.done:nth-child(4),
    .ob-step-node.active:nth-child(4) {
        background: #1BAF82;
        color: #fff;
        box-shadow: 0 0 0 4px rgba(27,175,130,0.2);
    }

    /* ── Plan card selector ── */
    .plan-card {
        cursor: pointer;
        border: 2px solid #E5E7EB;
        border-radius: 0.75rem;
        padding: 0.875rem 1rem;
        transition: border-color 0.2s, background 0.2s;
        background: #fff;
    }
    .dark .plan-card {
        border-color: #334155;
        background: transparent;
    }
    .plan-card.selected {
        border-color: #0B1F33;
        background: #f8fafc;
    }
    .dark .plan-card.selected {
        border-color: #fff;
        background: rgba(255,255,255,0.05);
    }

    /* ── Button processing spinner ── */
    .btn-spinner {
        display: none;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid currentColor;
        border-top-color: transparent;
        border-radius: 9999px;
        animation: btn-spin 0.7s linear infinite;
        vertical-align: middle;
    }
    button.processing .btn-spinner { display: inline-block; }
    button.processing .btn-text { display: none; }
    button.processing { cursor: wait; pointer-events: none; }
    @@keyframes btn-spin { to { transform: rotate(360deg); } }
</style>

<section id="registerSection" class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div id="step-1-wrapper" class="relative flex min-h-screen items-center justify-center px-4 py-12">
        <div class="mx-auto w-full max-w-md">

            <div id="registerTopBrand" class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png" alt="Sentro Logo" class="h-10 w-auto object-contain" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                </a>
            </div>

            <div id="step-1" class="flow-step">
                <h1 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                    Create your workspace
                </h1>
                <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                    Enter your email to begin account setup.
                </p>

                <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                    <div class="space-y-5">
                        <div>
                            <label for="flowEmail" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Email address:</label>
                            <input id="flowEmail" type="email" placeholder="name@example.com"
                                   class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        </div>

                        <button type="button" id="get-started-btn" data-next="2"
                                style="background-color: #0B1F33; color: #fff;"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
                            <span class="btn-spinner"></span>
                            <span class="btn-text">Get Started</span>
                        </button>

                        <p class="text-center text-sm text-slate-600 dark:text-slate-300">
                            Already have an account?
                            <a asp-page="./Login" style="color: #059669;" class="font-medium hover:underline hover:opacity-90 dark:text-emerald-400">Log in</a>
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div id="multi-step-wrapper" class="hidden min-h-screen">

        <div id="step-2" class="flow-step hidden relative flex min-h-screen items-center justify-center px-4 py-12">
            <div class="mx-auto w-full max-w-md">

                <!-- Logo -->
                <div class="flex justify-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                        <div class="flex items-center gap-3">
                            <img src="~/images/logo1.png" alt="Sentro Logo" class="h-10 w-auto object-contain" />
                            <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                        </div>
                        <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                    </a>
                </div>

                <!-- Header & subheader outside card -->
                <h2 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                    Check your email
                </h2>
                <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                    A verification code has been sent to your inbox.
                </p>

                <!-- Card -->
                <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                    <div class="space-y-5">

                        <!-- Email icon -->
                        <div class="flex justify-center">
                            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#E6F4EA] dark:bg-emerald-900/30">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#059669] dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                        </div>

                        <!-- Description text -->
                        <div class="text-center">
                            <p class="text-sm text-slate-600 dark:text-slate-300">We sent a 6-digit code to</p>
                            <p class="mt-0.5 text-sm font-semibold text-slate-900 dark:text-white" id="verifyEmailLabel">jr@gmail.com</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Enter the code below. It expires in <span class="font-semibold text-slate-800 dark:text-slate-200">15 minutes</span>.</p>
                        </div>

                        <!-- Verification code input -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">Verification code</label>
                            <div class="mt-3 flex justify-center gap-3">
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                                <input class="verify-digit h-14 w-12 rounded-xl border border-[#E5E7EB] bg-white text-center text-2xl font-bold tracking-widest text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" maxlength="1" inputmode="numeric" />
                            </div>
                        </div>

                        <!-- Primary: Verify and Continue -->
                        <button type="button" id="verify-continue-btn" data-next="3"
                                style="background-color: #0B1F33; color: #fff;"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
                            <span class="btn-spinner"></span>
                            <span class="btn-text">Verify and Continue</span>
                        </button>

                        <!-- Secondary: Resend code -->
                        <button type="button" id="resend-code-btn"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                            <span class="btn-spinner"></span>
                            <span class="btn-text">Resend code</span>
                        </button>

                        <!-- Text link: Change email -->
                        <p class="text-center text-sm text-slate-600 dark:text-slate-300">
                            Wrong address?
                            <button type="button" data-back="1" style="color: #059669;" class="font-medium hover:underline hover:opacity-90 dark:text-emerald-400 bg-transparent border-0 p-0 cursor-pointer">Change email</button>
                        </p>

                    </div>
                </div>

            </div>
        </div>

        <div id="step-3" class="flow-step hidden relative flex min-h-screen items-center justify-center px-4 py-12">
            <div class="mx-auto w-full max-w-lg">

                <!-- Logo -->
                <div class="flex justify-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                        <div class="flex items-center gap-3">
                            <img src="~/images/logo1.png" alt="Sentro Logo" class="h-10 w-auto object-contain" />
                            <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                        </div>
                        <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                    </a>
                </div>

                <!-- Header & subheader -->
                <h2 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                    Plan & Organization
                </h2>
                <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                    Choose your plan and set up your organization profile.
                </p>

                <!-- Progress bar: step 1 of 3 -->
                <div class="mt-6">
                    <div class="ob-progress-track mx-auto max-w-xs">
                        <div class="ob-progress-fill" style="width: 0%;" id="ob-fill-3"></div>
                        <div class="ob-step-node active" id="ob-node-3-1">1</div>
                        <div class="ob-step-node" id="ob-node-3-2">2</div>
                        <div class="ob-step-node" id="ob-node-3-3">3</div>
                    </div>
                    <div class="mt-2 flex justify-between text-xs font-medium text-slate-400 dark:text-slate-500 mx-auto max-w-xs">
                        <span class="text-slate-700 dark:text-slate-200">Plan</span>
                        <span>Profile</span>
                        <span>Credentials</span>
                    </div>
                </div>

                <!-- Card -->
                <div class="mt-6 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                    <div class="space-y-5">

                        <!-- Plan selector (card-style) -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-3">Available Plans</label>
                            <input type="hidden" id="selectedPlan" value="Basic" />
                            <div class="space-y-3" id="planCardGroup">

                                <div class="plan-card selected" data-plan="Basic" onclick="selectPlan('Basic')">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">Basic</span>
                                            <span class="text-sm font-semibold text-slate-900 dark:text-white">Starter plan</span>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-base font-bold text-slate-900 dark:text-white">₱49</span>
                                            <span class="text-xs text-slate-500 dark:text-slate-400"> / mo</span>
                                        </div>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Up to 10 admin seats · Core risk modules</p>
                                </div>

                                <div class="plan-card" data-plan="Professional" onclick="selectPlan('Professional')">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">Professional</span>
                                            <span class="text-sm font-semibold text-slate-900 dark:text-white">Growing teams</span>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-base font-bold text-slate-900 dark:text-white">₱149</span>
                                            <span class="text-xs text-slate-500 dark:text-slate-400"> / mo</span>
                                        </div>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Up to 50 admin seats · Advanced analytics</p>
                                </div>

                                <div class="plan-card" data-plan="Enterprise" onclick="selectPlan('Enterprise')">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-semibold text-violet-800 dark:bg-violet-900/40 dark:text-violet-300">Enterprise</span>
                                            <span class="text-sm font-semibold text-slate-900 dark:text-white">Large organizations</span>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-base font-bold text-slate-900 dark:text-white">₱399</span>
                                            <span class="text-xs text-slate-500 dark:text-slate-400"> / mo</span>
                                        </div>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Up to 200 admin seats · Full suite + priority support</p>
                                </div>

                            </div>
                        </div>

                        <!-- Organization Name -->
                        <div>
                            <label for="orgName" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Organization Name</label>
                            <input id="orgName" type="text" placeholder="Example: BuildCraft Solutions"
                                   class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        </div>

                        <!-- Organization Code -->
                        <div>
                            <label for="orgCode" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Organization Code <span class="text-xs font-normal text-slate-400">(auto-generated)</span></label>
                            <input id="orgCode" type="text"
                                   class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm font-semibold tracking-wide text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        </div>

                        <!-- Actions -->
                        <div class="flex gap-3 pt-1">
                            <button type="button" data-back="2" class="w-full rounded-xl border border-slate-200 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Back</button>
                            <button type="button" data-next="4"
                                    style="background-color: #0B1F33; color: #fff;"
                                    class="inline-flex w-full items-center justify-center rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 dark:focus:ring-offset-slate-900">
                                Next
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <div id="step-4" class="flow-step hidden relative flex min-h-screen items-center justify-center px-4 py-12">
            <div class="mx-auto w-full max-w-lg">

                <!-- Logo -->
                <div class="flex justify-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                        <div class="flex items-center gap-3">
                            <img src="~/images/logo1.png" alt="Sentro Logo" class="h-10 w-auto object-contain" />
                            <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                        </div>
                        <div class="mt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">ERP Risk Management</div>
                    </a>
                </div>

                <!-- Header & subheader -->
                <h2 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                    Admin Profile
                </h2>
                <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                    Enter the profile details for the organization administrator.
                </p>

                <!-- Progress bar: step 2 of 3 -->
                <div class="mt-6">
                    <div class="ob-progress-track mx-auto max-w-xs">
                        <div class="ob-progress-fill" style="width: 50%;" id="ob-fill-4"></div>
                        <div class="ob-step-node done" id="ob-node-4-1">1</div>
                        <div class="ob-step-node active" id="ob-node-4-2">2</div>
                        <div class="ob-step-node" id="ob-node-4-3">3</div>
                    </div>
                    <div class="mt-2 flex justify-between text-xs font-medium text-slate-400 dark:text-slate-500 mx-auto max-w-xs">
                        <span class="text-slate-500 dark:text-slate-400">Plan</span>
                        <span class="text-slate-700 dark:text-slate-200">Profile</span>
                        <span>Credentials</span>
                    </div>
                </div>

                <!-- Card -->
                <div class="mt-6 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg dark:border-slate-800 dark:bg-slate-900">
                    <div class="space-y-5">

                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                            <div>
                                <label for="adminFirstName" class="block text-sm font-medium text-slate-700 dark:text-slate-200">First Name</label>
                                <input id="adminFirstName" type="text" class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                            </div>
                            <div>
                                <label for="adminMiddleName" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Middle Name <span class="text-xs font-normal text-slate-400">(Optional)</span></label>
                                <input id="adminMiddleName" type="text" class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                            </div>
                            <div>
                                <label for="adminLastName" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Last Name</label>
                                <input id="adminLastName" type="text" class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900 focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20 dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                            </div>
                        </div>

