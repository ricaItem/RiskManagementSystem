@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}
<style>
    #login-submit-btn { background-color: #0B1F33 !important; color: #fff !important; }
    .dark #login-submit-btn { background-color: #fff !important; color: #0f172a !important; }
</style>
<section class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">

        <div class="mx-auto w-full max-w-md">
            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png"
                             alt="Sentro Logo"
                             class="h-10 w-auto object-contain transition-all duration-300 dark:brightness-0 dark:invert" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-2">ERP Risk Management</div>
                </a>
            </div>

            <h1 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                Sign in to your account
            </h1>
            <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                Welcome back. Please enter your details.
            </p>

            <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.04)]
                        dark:border-slate-800 dark:bg-slate-900">
                <form method="post" class="space-y-5">
                    @if (ViewData.ModelState[""]?.Errors?.Count > 0)
                    {
                        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700
                                    dark:border-rose-900/40 dark:bg-rose-900/20 dark:text-rose-200" role="alert">
                            <div asp-validation-summary="ModelOnly" class="[&>ul]:list-none [&>ul]:m-0 [&>ul]:p-0"></div>
                        </div>
                    }

                    <div>
                        <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
                        <input asp-for="Input.Email" autocomplete="username"
                               class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900
                                      focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20
                                      dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
                        <input asp-for="Input.Password" type="password" autocomplete="current-password"
                               class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900
                                      focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20
                                      dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
                            <input asp-for="Input.RememberMe"
                                   class="h-4 w-4 rounded border-[#E5E7EB] text-[#0B1F33] focus:ring-[#0B1F33] dark:border-slate-600" />
                            Remember me
                        </label>

                        <a asp-page="./ForgotPassword"
                           class="text-sm font-medium text-[#059669] hover:text-[#047857] dark:text-emerald-400 dark:hover:text-emerald-300">
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" id="login-submit-btn"
                            style="background-color: #0B1F33; color: #fff;"
                            class="w-full rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
                        Log In
                    </button>

                    <p class="text-center text-sm text-slate-600 dark:text-slate-300">
                        Don’t have an account?
                        <a asp-page="./Register" style="color: #059669;" class="font-medium hover:underline hover:opacity-90 dark:text-emerald-400">Register</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>