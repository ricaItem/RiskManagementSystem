@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_LayoutLanding.cshtml";
}
<style>
    #login-submit-btn { background-color: #0B1F33 !important; color: #fff !important; }
    .dark #login-submit-btn { background-color: #fff !important; color: #0f172a !important; }
    @@keyframes auth-spin {
        to { transform: rotate(360deg); }
    }
    .auth-btn-spinner {
        display: inline-block;
        border: 2px solid currentColor;
        border-top-color: transparent;
        border-radius: 9999px;
        animation: auth-spin .8s linear infinite;
    }
    .auth-btn-spinner.hidden {
        display: none;
    }
</style>
<section class="relative min-h-screen overflow-hidden bg-[#F9FAFB] dark:bg-slate-950">
    <div class="relative flex min-h-screen items-center justify-center px-4 py-12">

        <div class="mx-auto w-full max-w-md">
            <div class="flex justify-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex flex-col items-center">
                    <div class="flex items-center gap-3">
                        <img src="~/images/logo1.png"
                             alt="Sentro Logo"
                             class="h-10 w-auto object-contain transition-all duration-300" />
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Sentro</span>
                    </div>
                    <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-2">ERP Risk Management</div>
                </a>
            </div>

            <h1 class="mt-8 text-center text-2xl font-semibold text-slate-900 dark:text-white">
                Sign in to your account
            </h1>
            <p class="mt-2 text-center text-sm text-slate-600 dark:text-slate-300">
                Welcome back. Please enter your details.
            </p>

            <div class="mt-8 rounded-2xl border border-[#E5E7EB] bg-white p-7 shadow-lg
                        dark:border-slate-800 dark:bg-slate-900">
                <form id="loginForm" method="post" class="space-y-5">
                    @if (ViewData.ModelState[""]?.Errors?.Count > 0)
                    {
                        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700
                                    dark:border-rose-900/40 dark:bg-rose-900/20 dark:text-rose-200" role="alert">
                            <div asp-validation-summary="ModelOnly" class="[&>ul]:list-none [&>ul]:m-0 [&>ul]:p-0"></div>
                        </div>
                    }

                    <div>
                        <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
                        <input asp-for="Input.Email" autocomplete="username"
                               class="mt-1 w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 text-sm text-slate-900
                                      focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20
                                      dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                        <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
                        <div class="relative mt-1">
                            <input asp-for="Input.Password" id="loginPassword" type="password" autocomplete="current-password"
                                   class="w-full rounded-xl border border-[#E5E7EB] bg-white px-4 py-3 pr-11 text-sm text-slate-900
                                          focus:border-[#0B1F33] focus:ring-2 focus:ring-[#0B1F33]/20
                                          dark:border-slate-700 dark:bg-slate-950/40 dark:text-white" />
                            <button type="button"
                                    class="absolute inset-y-0 right-0 flex items-center justify-center px-3 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
                                    data-toggle-password
                                    data-target="loginPassword"
                                    aria-label="Show password">
                                <svg data-eye-open xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.6 10.6a2 2 0 102.8 2.8" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.9 4.8A10.6 10.6 0 0112 4.5c6 0 9.75 7.5 9.75 7.5a18.9 18.9 0 01-4.1 5.1" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.2 6.2A18.9 18.9 0 002.25 12s3.75 7.5 9.75 7.5c1.8 0 3.4-.5 4.8-1.3" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
                            <input asp-for="Input.RememberMe"
                                   class="h-4 w-4 rounded border-[#E5E7EB] text-[#0B1F33] focus:ring-[#0B1F33] dark:border-slate-600" />
                            Remember me
                        </label>

                        <a asp-page="./ForgotPassword"
                           class="text-sm font-medium text-[#059669] hover:text-[#047857] dark:text-emerald-400 dark:hover:text-emerald-300">
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" id="login-submit-btn"
                            style="background-color: #0B1F33; color: #fff;"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl py-3 text-sm font-semibold shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70 dark:focus:ring-offset-slate-900">
                        <span id="login-submit-spinner" class="auth-btn-spinner hidden h-4 w-4" aria-hidden="true"></span>
                        <span id="login-submit-text">Log In</span>
                    </button>

                    <p class="text-center text-sm text-slate-600 dark:text-slate-300">
                        Don’t have an account?
                        <a asp-page="./Register" style="color: #059669;" class="font-medium hover:underline hover:opacity-90 dark:text-emerald-400">Register</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function togglePassword(button) {
                const targetId = button.getAttribute('data-target');
                const input = document.getElementById(targetId);
                if (!input) return;

                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';

                const openIcon = button.querySelector('[data-eye-open]');
                const closedIcon = button.querySelector('[data-eye-closed]');
                if (openIcon && closedIcon) {
                    openIcon.classList.toggle('hidden', show);
                    closedIcon.classList.toggle('hidden', !show);
                }

                button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-toggle-password]');
                if (!btn) return;
                togglePassword(btn);
            });

            const loginForm = document.getElementById('loginForm');
            const loginButton = document.getElementById('login-submit-btn');
            const loginSpinner = document.getElementById('login-submit-spinner');
            const loginText = document.getElementById('login-submit-text');

            if (loginForm && loginButton) {
                loginForm.addEventListener('submit', function (e) {
                    if (loginForm.dataset.submitting === '1') {
                        e.preventDefault();
                        return;
                    }

                    loginForm.dataset.submitting = '1';
                    loginButton.disabled = true;
                    if (loginSpinner) loginSpinner.classList.remove('hidden');
                    if (loginText) loginText.textContent = 'Logging in...';
                });
            }
        })();
    </script>
}
