@model IReadOnlyList<WEB_Sentro.Services.ControlDto>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Control Library";
}
<div class="animate-in fade-in mx-auto max-w-5xl space-y-8 duration-500">
    <div class="flex items-center justify-between">
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Control <span class="italic text-emerald-500">Library</span></h1>
        <button type="button" onclick="document.getElementById('newControlModal').classList.remove('hidden')" class="btn-primary rounded-xl px-6 py-3">+ Add control</button>
    </div>
    @if (TempData["ControlMessage"] != null) { <div class="rounded-xl bg-emerald-100 px-4 py-3 text-sm text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">@TempData["ControlMessage"]</div> }
    @if (TempData["ControlError"] != null) { <div class="rounded-xl bg-rose-100 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">@TempData["ControlError"]</div> }
    <form method="get" action="@Url.Action("Index","Controls", new { area = "Client" })" class="flex gap-2">
        <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search controls..." class="flex-1 rounded-2xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        <button type="submit" class="btn-accent rounded-2xl px-6 py-3">Search</button>
    </form>
    <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-100 dark:bg-slate-800"><tr><th class="p-3">Name</th><th class="p-3">Description</th><th class="p-3">Type</th><th class="p-3">Frequency</th><th class="p-3">Status</th><th class="w-24 p-3"></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="border-t border-slate-100 dark:border-slate-800"><td class="p-3 font-bold">@c.Name</td><td class="p-3 max-w-xs truncate">@(c.Description ?? "—")</td><td class="p-3">@(c.Type ?? "—")</td><td class="p-3">@(c.Frequency ?? "—")</td><td class="p-3">@c.Status</td><td class="p-3">
                        <form method="post" action="@Url.Action("Delete","Controls", new { area = "Client", id = c.ControlId })" onsubmit="return confirm('Remove this control?');">@Html.AntiForgeryToken()<button type="submit" class="text-rose-500 hover:underline text-xs">Remove</button></form>
                    </td></tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0) { <p class="p-6 text-slate-500">No controls. Add one to get started.</p> }
    </div>
</div>
<div id="newControlModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-slate-900/60" onclick="this.parentElement.classList.add('hidden')"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="mb-4 text-lg font-black dark:text-white">New control</h3>
            <form method="post" action="@Url.Action("Create","Controls", new { area = "Client" })">
                @Html.AntiForgeryToken()
                <div class="space-y-3">
                    <input type="text" name="Name" required placeholder="Name" class="w-full rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    <textarea name="Description" rows="2" placeholder="Description" class="w-full rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-700 dark:bg-slate-800 dark:text-white"></textarea>
                    <input type="text" name="Type" placeholder="Type" class="w-full rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    <input type="text" name="Frequency" placeholder="Frequency" class="w-full rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div class="mt-4 flex gap-2">
                    <button type="button" onclick="document.getElementById('newControlModal').classList.add('hidden')" class="flex-1 rounded-xl bg-slate-200 py-2.5 dark:bg-slate-700">Cancel</button>
                    <button type="submit" class="flex-1 rounded-xl bg-emerald-600 py-2.5 text-white">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
