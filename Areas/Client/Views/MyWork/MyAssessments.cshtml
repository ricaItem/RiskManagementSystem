@model IEnumerable<WEB_Sentro.Areas.Client.Controllers.RiskAssessmentItemViewModel>
@{
    ViewData["Title"] = "My Assessments";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}
<div class="space-y-6 animate-in fade-in duration-500">
    <div class="flex items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">My <span class="text-emerald-600">Assessments</span></h1>
            <p class="text-slate-500 dark:text-slate-400">Risks where you are owner or accountable reviewer.</p>
        </div>
        <a href="/Client/MyWork" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Back to dashboard</a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/70 text-[10px] font-black uppercase tracking-widest text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3">Risk</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Due</th>
                        <th class="px-6 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var dueText = item.DueDate?.ToString("MMM dd, yyyy") ?? "Not scheduled";
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="px-6 py-4 text-sm font-semibold text-slate-900 dark:text-white">@item.RiskTitle</td>
                                <td class="px-6 py-4 text-xs text-slate-600 dark:text-slate-300">@item.Status</td>
                                <td class="px-6 py-4 text-xs text-slate-500 dark:text-slate-400">@dueText</td>
                                <td class="px-6 py-4 text-right">
                                    <a href="@Url.Action("Assess", "Risks", new { area = "Client", id = item.RiskId })" class="rounded-lg bg-slate-900 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900">Assess</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-sm text-slate-500 dark:text-slate-400">No assessments assigned to you right now.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
