@model WEB_Sentro.Areas.Client.Controllers.MyWorkDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<div class="space-y-6 animate-in fade-in duration-500 pb-12">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <h1 class="text-2xl font-black text-slate-900 dark:text-white">Employee <span class="text-emerald-600">Dashboard</span></h1>
        <div class="flex items-center gap-2">
            <a href="/Client/MyWork/MyTasks" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-wider text-slate-700 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Open My Tasks</a>
            <a href="/Client/Risks/Identification" class="rounded-lg bg-emerald-600 px-4 py-2 text-[10px] font-black text-white hover:bg-emerald-700 transition shadow-lg shadow-emerald-500/20 inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Report a risk
            </a>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Assigned Tasks</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@Model.MyAssignedTasksCount</h3>
            <a href="/Client/MyWork/MyTasks" class="mt-2 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 hover:underline">View all tasks</a>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Overdue Tasks</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@Model.MyOverdueTasksCount</h3>
            <p class="mt-2 text-[10px] font-bold text-slate-500 dark:text-slate-400">Tasks past due date</p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Risks I Reported</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@Model.MyOpenRisksCount</h3>
            <p class="mt-2 text-[10px] font-bold text-slate-500 dark:text-slate-400">Still open in risk register</p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Private Notes</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@Model.Notes.Count</h3>
            <p class="mt-2 text-[10px] font-bold text-slate-500 dark:text-slate-400">Only visible to you</p>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-1 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white mb-4">My Task Queue</h3>
            @if (Model.MyTasks.Any())
            {
                <ul class="space-y-2">
                    @foreach (var t in Model.MyTasks)
                    {
                        var isLate = t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.UtcNow.Date && t.Status != "Done";
                        <li class="flex items-center justify-between gap-2 py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                            <span class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate">@t.Title</span>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-black @(isLate ? "bg-rose-100 text-rose-600 dark:bg-rose-500/20" : "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300")">@t.Status</span>
                        </li>
                    }
                </ul>
                <a href="/Client/MyWork/MyTasks" class="mt-3 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 hover:underline block">View all tasks</a>
            }
            else
            {
                <p class="text-sm text-slate-500 dark:text-slate-400">No tasks assigned.</p>
            }
        </div>

        <div class="lg:col-span-1 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white mb-4">Recent Risk Updates</h3>
            @if (Model.RecentAssessedRisks.Any())
            {
                <ul class="space-y-2">
                    @foreach (var a in Model.RecentAssessedRisks)
                    {
                        <li class="py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                            <a href="/Client/Risks/Assess/@a.RiskId" class="text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 truncate block">@a.RiskTitle</a>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400">@a.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-slate-500 dark:text-slate-400">No new assessment updates yet.</p>
            }
        </div>

        <div class="lg:col-span-1 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white mb-4">My Recent Risks</h3>
            @if (Model.MyRecentRisks.Any())
            {
                <ul class="space-y-2">
                    @foreach (var r in Model.MyRecentRisks)
                    {
                        <li class="py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                            <span class="text-xs font-medium text-slate-700 dark:text-slate-300 block">@r.Title</span>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400">@r.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-slate-500 dark:text-slate-400">No risks reported yet.</p>
            }
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/50 space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white">Private Notes</h3>
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">Only visible to you</span>
        </div>

        <form method="post" asp-action="AddNote" class="grid gap-3 md:grid-cols-4">
            @Html.AntiForgeryToken()
            <input name="title" maxlength="120" placeholder="Note title" class="md:col-span-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 outline-none ring-0 focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" />
            <input name="body" maxlength="1200" required placeholder="Write a quick note for your workday" class="md:col-span-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 outline-none ring-0 focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" />
            <button type="submit" class="md:col-span-1 rounded-xl bg-emerald-600 px-4 py-2 text-[11px] font-black uppercase tracking-wider text-white hover:bg-emerald-700">Save Note</button>
        </form>

        @if (Model.Notes.Any())
        {
            <ul class="space-y-2">
                @foreach (var note in Model.Notes)
                {
                    <li class="rounded-2xl border border-slate-200 p-3 dark:border-slate-700 @(note.Pinned ? "bg-amber-50/60 dark:bg-amber-950/20" : "bg-slate-50 dark:bg-slate-900")">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-slate-800 dark:text-slate-100">@note.Title</p>
                                <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 break-words">@note.Body</p>
                                <p class="text-[10px] text-slate-400 mt-1">Updated @note.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</p>
                            </div>
                            <div class="flex items-center gap-1 shrink-0">
                                <form method="post" asp-action="ToggleNotePin">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="noteId" value="@note.NoteId" />
                                    <button type="submit" class="rounded-lg border border-slate-200 px-2 py-1 text-[10px] font-bold text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">@(note.Pinned ? "Unpin" : "Pin")</button>
                                </form>
                                <form method="post" asp-action="DeleteNote">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="noteId" value="@note.NoteId" />
                                    <button type="submit" class="rounded-lg border border-rose-200 px-2 py-1 text-[10px] font-bold text-rose-600 hover:bg-rose-50 dark:border-rose-800/40 dark:text-rose-400 dark:hover:bg-rose-900/20">Delete</button>
                                </form>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-sm text-slate-500 dark:text-slate-400">No notes yet. Add one to track follow-ups and reminders.</p>
        }
    </div>
</div>
