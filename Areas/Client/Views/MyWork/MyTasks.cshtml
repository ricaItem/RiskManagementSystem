@model IEnumerable<Web_Sentro.Areas.Client.Models.MitigationTaskViewModel>
@{
    ViewData["Title"] = "My Tasks";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}
<div class="space-y-6 animate-in fade-in duration-500">
    <div class="flex items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">My <span class="text-emerald-600">Tasks</span></h1>
            <p class="text-slate-500 dark:text-slate-400">Mitigation tasks assigned to you.</p>
        </div>
        <a href="/Client/MyWork" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-[10px] font-black uppercase tracking-wider text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Back to dashboard</a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/70 text-[10px] font-black uppercase tracking-widest text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3">Task</th>
                        <th class="px-6 py-3">Risk</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Due</th>
                        <th class="px-6 py-3 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var task in Model)
                        {
                            var isOverdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.UtcNow.Date && task.Status != "Done";
                            var statusClass = task.Status == "Done"
                                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400"
                                : task.Status == "InProgress"
                                ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400"
                                : "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300";

                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="text-sm font-bold text-slate-900 dark:text-white">@task.Title</p>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Priority: @task.Priority</p>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-600 dark:text-slate-300">@(string.IsNullOrWhiteSpace(task.RiskTitle) ? $"Risk #{task.RiskId}" : task.RiskTitle)</td>
                                <td class="px-6 py-4"><span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider @statusClass">@task.Status</span></td>
                                <td class="px-6 py-4 text-xs @(isOverdue ? "text-rose-600 dark:text-rose-400" : "text-slate-500 dark:text-slate-400")">@(task.DueDate?.ToString("MMM dd, yyyy") ?? "No due date")</td>
                                <td class="px-6 py-4 text-right">
                                    <a href="@Url.Action("Board", "Mitigation", new { area = "Client", riskId = task.RiskId })" class="rounded-lg bg-slate-900 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900">Open</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-sm text-slate-500 dark:text-slate-400">No mitigation tasks assigned to you yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
