@using Web_Sentro.Areas.Client.Controllers
@model IEnumerable<EmployeeRowVm>

@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Workforce Directory";

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

@if (TempData["Alert"] != null)
{
    var isSuccess = string.Equals(TempData["AlertType"]?.ToString(), "success", StringComparison.OrdinalIgnoreCase);
    var toastBg = isSuccess ? "bg-emerald-500" : "bg-rose-500";
    var toastIcon = isSuccess
        ? "<path d=\"M5 13l4 4L19 7\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />"
        : "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />";
    <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
        <div class="@toastBg text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">@Html.Raw(toastIcon)</svg>
            <span class="text-sm font-medium">@TempData["Alert"]</span>
        </div>
    </div>
}

<!-- Loading Skeleton -->
<div id="employee-skeleton" class="animate-pulse min-h-screen space-y-6 p-6">
    <!-- Header Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <div class="h-8 w-48 bg-slate-200 rounded-md dark:bg-slate-700"></div>
            <div class="h-4 w-64 bg-slate-100 rounded-md mt-2 dark:bg-slate-800"></div>
        </div>
        <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
    </div>

    <!-- Filter Bar Skeleton -->
    <div class="flex flex-wrap items-center gap-3">
        <div class="h-10 w-64 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
        <div class="h-10 w-32 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
        <div class="h-10 w-32 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
        <div class="h-10 w-10 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
    </div>

    <!-- Table Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50">
            <div class="h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>
        <div class="p-4 space-y-4">
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3 w-1/4">
                        <div class="h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                        <div class="h-3 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                    </div>
                    <div class="h-3 w-32 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-3 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-6 w-16 rounded-md bg-slate-100 dark:bg-slate-800"></div>
                </div>
                @if (i < 4)
                {
                    <div class="border-b border-slate-50 dark:border-slate-800"></div>
                }
            }
        </div>
    </div>
</div>

<!-- Main Content -->
<div id="employee-content" class="hidden animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-6 duration-700">
    
    <!-- Header -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Workforce Management
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage employee directory, roles, and access</p>
        </div>
        <div>
            <button onclick="openDeployModal()" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Add Employee
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-3">
        <!-- Search -->
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800 flex-1 lg:flex-none lg:w-80">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" /></svg>
            <input type="text" id="empSearch" placeholder="Search employees..."
                   class="w-full border-0 bg-transparent p-0 text-xs font-semibold text-slate-700 placeholder-slate-400 focus:ring-0 dark:text-slate-300">
        </div>

        <!-- Role Filter -->
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <span class="text-xs font-medium text-slate-500">Role</span>
            <select id="roleFilter" class="border-0 bg-transparent p-0 text-xs font-semibold text-slate-700 focus:ring-0 dark:text-slate-300 cursor-pointer">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="RiskManager">Risk Manager</option>
                <option value="Manager">Manager</option>
                <option value="Employee">Employee</option>
                <option value="ProcurementOfficer">Procurement</option>
            </select>
        </div>

        <!-- Date Filter -->
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <span class="text-xs font-medium text-slate-500">Joined</span>
            <select id="dateFilter" class="border-0 bg-transparent p-0 text-xs font-semibold text-slate-700 focus:ring-0 dark:text-slate-300 cursor-pointer">
                <option value="">All time</option>
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>

        <!-- Reset Button -->
        <button onclick="resetFilters()" class="rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-500" title="Reset Filters">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
    </div>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/20">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Directory List</h3>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                @((Model != null) ? Model.Count() : 0) Members
            </span>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="empTable">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 text-xs font-medium text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3 font-medium">Employee</th>
                        <th class="px-6 py-3 font-medium">Email</th>
                        <th class="px-6 py-3 font-medium">Role</th>
                        <th class="px-6 py-3 font-medium">Joined Date</th>
                        <th class="px-6 py-3 font-medium text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var emp in Model)
                        {
                            var empJson = System.Text.Json.JsonSerializer.Serialize(emp, jsonOptions);
                            var initials = (emp.Name ?? "??");
                            initials = initials.Length >= 2 ? initials.Substring(0, 2) : initials;
                            var statusLower = (emp.Status ?? "").ToLower();
                            var isActive = statusLower == "active";

                            <tr onclick='openProfile(@Html.Raw(empJson))' class="group emp-row cursor-pointer hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors" data-added="@emp.CreatedAt.ToString("O")">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-8 w-8 rounded-full bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase shrink-0">
                                            @initials
                                        </div>
                                        <div class="text-sm font-medium text-slate-900 dark:text-slate-200 emp-name">@emp.Name</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-xs text-slate-500 dark:text-slate-400 emp-email">@emp.Email</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-700 emp-role">
                                        @emp.Role
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500 dark:text-slate-400">
                                    @emp.CreatedAt.ToString("MMM d, yyyy")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button type="button" onclick="event.stopPropagation(); toggleStatus('@emp.UserId', '@emp.Status')" class="group relative focus:outline-none">
                                        @if (isActive)
                                        {
                                            <span class="emp-status inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-600 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-900/20 dark:text-emerald-400 dark:ring-emerald-500/20 hover:bg-emerald-100 transition-colors">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="emp-status inline-flex items-center rounded-md bg-rose-50 px-2 py-1 text-xs font-medium text-rose-600 ring-1 ring-inset ring-rose-600/10 dark:bg-rose-900/20 dark:text-rose-400 dark:ring-rose-500/20 hover:bg-rose-100 transition-colors">
                                                Inactive
                                            </span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="h-12 w-12 rounded-full bg-slate-50 flex items-center justify-center mb-3 dark:bg-slate-800">
                                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    </div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">No employees found</p>
                                    <p class="text-xs text-slate-500 mt-1 dark:text-slate-400">Get started by adding a new team member.</p>
                                    <button type="button" onclick="openDeployModal()" class="mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-700">Add Employee &rarr;</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Deploy Modal -->
<div id="deployModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-300" id="deployModal">
        <form action="@Url.Action("Deploy", "Employees", new { area = "Client" })" method="post" class="p-8" onsubmit="var b=document.getElementById('addEmpSubmitBtn');b.disabled=true;b.innerHTML='<span class=\'save-btn-spinner\'></span> Saving...';">
            @Html.AntiForgeryToken()
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Add New Employee</h2>
                    <p class="text-xs text-slate-500 mt-1">Onboard a new member to your organization</p>
                </div>
                <button type="button" onclick="closeDeployModal()" class="text-slate-400 hover:text-slate-500 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">First name</label>
                        <input type="text" name="firstName" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" placeholder="e.g. Juan">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Last name</label>
                        <input type="text" name="lastName" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" placeholder="e.g. Dela Cruz">
                    </div>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Email Address</label>
                    <input type="email" name="email" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" placeholder="juan@sentro.com">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Role</label>
                        <select name="role" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Employee">Employee</option>
                            <option value="Manager">Manager</option>
                            <option value="RiskManager">Risk Manager</option>
                            <option value="Admin">Admin</option>
                            <option value="ProcurementOfficer">Procurement Officer</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Department</label>
                        <select name="department" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option>Operations</option>
                            <option>Design</option>
                            <option>HSE</option>
                            <option>Construction</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-8">
                <button type="submit" id="addEmpSubmitBtn" class="w-full bg-slate-900 text-white py-2.5 rounded-lg text-sm font-semibold shadow hover:bg-slate-800 transition-colors disabled:opacity-70 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">
                    Save Employee
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Status Modal (Archive / Deactivation protocol) -->
<div id="statusModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[70] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-xl shadow-xl p-8 border border-slate-200 dark:border-slate-700">
        <form action="@Url.Action("UpdateStatus", "Employees", new { area = "Client" })" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="statusEmpId" />
            <input type="hidden" name="newStatus" value="Inactive" />

            <div class="mb-6">
                <div class="h-10 w-10 rounded-full bg-rose-50 flex items-center justify-center mb-3 dark:bg-rose-900/20">
                    <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white">Deactivate Account</h2>
                <p class="text-sm text-slate-500 mt-1">Please provide a reason for deactivating this employee record.</p>
            </div>

            <textarea name="reason" required rows="3" placeholder="Reason (e.g., Resignation, Termination)..." class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg p-3 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none mb-6 resize-none"></textarea>

            <div class="flex gap-3 justify-end">
                <button type="button" onclick="closeStatusModal()" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600 dark:hover:bg-slate-700">Cancel</button>
                <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-rose-600 border border-transparent rounded-lg shadow-sm hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500">Deactivate</button>
            </div>
        </form>
    </div>
</div>

<!-- Reactivate hidden form (POST + antiforgery) -->
<form id="reactivateForm" action="@Url.Action("UpdateStatus", "Employees", new { area = "Client" })" method="post" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="reactivateId" />
    <input type="hidden" name="newStatus" value="Active" />
    <input type="hidden" name="reason" value="Reactivation" />
</form>

<!-- Side panel overlay -->
<div id="sidePanelOverlay" onclick="closeProfile()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Side panel -->
<div id="sidePanel" class="fixed inset-y-0 right-0 w-full max-w-md bg-white dark:bg-slate-900 shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 dark:border-slate-800">
    <div class="h-full flex flex-col p-6">

        <div class="flex justify-between items-start mb-8">
            <div id="panelHeader" class="flex items-center gap-4">
                <div class="h-16 w-16 rounded-full bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-xl font-bold text-indigo-600 dark:text-indigo-400 uppercase" id="panelInitial"></div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white" id="panelName"></h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400 font-medium" id="panelRole"></p>
                </div>
            </div>

            <div class="flex gap-1">
                <button onclick="toggleEditMode()" id="editBtn" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors dark:hover:bg-indigo-900/20" title="Edit Profile">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
                <button onclick="closeProfile()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors dark:hover:bg-slate-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">

            <div id="viewMode" class="space-y-6">
                <section>
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Professional Bio</h3>
                    <p id="panelBio" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed"></p>
                </section>
                <section>
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Skills & Expertise</h3>
                    <div id="panelSkills" class="flex flex-wrap gap-2"></div>
                </section>

                <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 dark:bg-slate-800/50 dark:border-slate-700/50">
                            <p class="text-xs font-medium text-slate-500 uppercase">Utilization</p>
                            <p id="panelUtil" class="text-xl font-bold text-slate-900 dark:text-white mt-1"></p>
                        </div>
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 dark:bg-slate-800/50 dark:border-slate-700/50">
                            <p class="text-xs font-medium text-slate-500 uppercase">Performance</p>
                            <p id="panelPerf" class="text-xl font-bold text-slate-900 dark:text-white mt-1"></p>
                        </div>
                    </div>
                </div>
            </div>

            <form id="editMode" action="@Url.Action("UpdateEmployee", "Employees", new { area = "Client" })" method="post" class="hidden space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Full Name</label>
                    <input type="text" name="name" id="editName" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Work Email</label>
                    <input type="email" name="email" id="editEmail" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Role</label>
                    <select name="role" id="editRole" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                        <option value="Admin">Admin</option>
                        <option value="RiskManager">Risk Manager</option>
                        <option value="Manager">Manager</option>
                        <option value="Employee">Employee</option>
                        <option value="ProcurementOfficer">Procurement Officer</option>
                    </select>
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800 mt-6">
                    <button type="button" onclick="toggleEditMode()" class="flex-1 px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
                    <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 shadow-sm transition-colors">Save Changes</button>
                </div>
            </form>
        </div>

        <div id="panelFooter" class="mt-auto pt-6 border-t border-slate-100 dark:border-slate-800">
            <button type="button" class="w-full bg-slate-900 dark:bg-white dark:text-slate-900 text-white py-3 rounded-lg text-sm font-semibold hover:bg-slate-800 transition-colors flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Generate Performance Report
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        setTimeout(function() {
            const skeleton = document.getElementById('employee-skeleton');
            const content = document.getElementById('employee-content');
            
            if(skeleton && content) {
                skeleton.classList.add('hidden');
                content.classList.remove('hidden');
            }
        }, 600);
    });

    let isEditMode = false;
    const searchInput = document.getElementById('empSearch');
    const roleFilter = document.getElementById('roleFilter');
    const dateFilter = document.getElementById('dateFilter');

    (function () {
        const toast = document.getElementById('toastAlert');
        if (toast) {
            toast.style.transition = 'opacity 0.4s ease';
            setTimeout(function () {
                toast.style.opacity = '0';
                setTimeout(function () { toast.style.display = 'none'; }, 400);
            }, 4000);
        }
    })();

    function filterEmployees() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const roleTerm = (roleFilter.value || "").toLowerCase();
        const dateDays = dateFilter.value ? parseInt(dateFilter.value, 10) : 0;
        const cutoff = dateDays > 0 ? new Date(Date.now() - dateDays * 24 * 60 * 60 * 1000) : null;

        document.querySelectorAll('.emp-row').forEach(row => {
            const name = (row.querySelector('.emp-name')?.innerText || "").toLowerCase();
            const email = (row.querySelector('.emp-email')?.innerText || "").toLowerCase();
            const role = (row.querySelector('.emp-role')?.innerText || "").toLowerCase();
            const addedStr = row.getAttribute('data-added');
            const addedDate = addedStr ? new Date(addedStr) : null;

            const matchesSearch = !searchTerm || name.includes(searchTerm) || email.includes(searchTerm) || role.includes(searchTerm);
            const matchesRole = !roleTerm || role === roleTerm || role.replace(/\s/g, '').toLowerCase() === roleTerm.replace(/\s/g, '').toLowerCase();
            const matchesDate = !cutoff || (addedDate && addedDate >= cutoff);

            row.style.display = (matchesSearch && matchesRole && matchesDate) ? "" : "none";
        });
    }

    searchInput.addEventListener('input', filterEmployees);
    roleFilter.addEventListener('change', filterEmployees);
    dateFilter.addEventListener('change', filterEmployees);

    function resetFilters() {
        searchInput.value = "";
        roleFilter.value = "";
        dateFilter.value = "";
        filterEmployees();
    }

    function openProfile(emp) {
        isEditMode = false;
        document.getElementById('viewMode').classList.remove('hidden');
        document.getElementById('editMode').classList.add('hidden');
        document.getElementById('panelFooter').classList.remove('hidden');
        
        // Reset Edit Button State
        const editBtn = document.getElementById('editBtn');
        editBtn.classList.remove('bg-indigo-50', 'text-indigo-600');
        editBtn.classList.add('text-slate-400');

        document.getElementById('panelName').innerText = emp.name ?? "";
        document.getElementById('panelRole').innerText = (emp.role ?? "Employee") + " • " + (emp.department ?? "N/A");
        document.getElementById('panelInitial').innerText = (emp.name ?? "??").substring(0, 2);
        document.getElementById('panelBio').innerText = emp.bio ?? "No biography available.";
        document.getElementById('panelUtil').innerText = emp.utilization ?? "0%";
        document.getElementById('panelPerf').innerText = (emp.performance ?? 0) + "%";

        document.getElementById('editId').value = emp.userId ?? emp.id ?? "";
        document.getElementById('editName').value = emp.name ?? "";
        document.getElementById('editEmail').value = emp.email ?? "";
        var roleSelect = document.getElementById('editRole');
        var roleVal = (emp.role || "Employee").trim();
        if (roleSelect.querySelector('option[value="' + roleVal + '"]')) {
            roleSelect.value = roleVal;
        } else {
            roleSelect.value = "Employee";
        }

        const skillsContainer = document.getElementById('panelSkills');
        skillsContainer.innerHTML = '';
        if (emp.skills && emp.skills.length) {
            emp.skills.forEach(skill => {
                skillsContainer.innerHTML += `<span class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700">${skill}</span>`;
            });
        } else {
            skillsContainer.innerHTML = `<span class="text-sm text-slate-400 italic">No skills listed</span>`;
        }

        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.replace('opacity-0', 'opacity-100'), 10);
        panel.classList.remove('translate-x-full');
    }

    function closeProfile() {
        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        panel.classList.add('translate-x-full');
        overlay.classList.replace('opacity-100', 'opacity-0');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function openDeployModal() {
        const overlay = document.getElementById('deployModalOverlay');
        const modal = document.getElementById('deployModal');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.replace('opacity-0', 'opacity-100');
            modal.classList.replace('scale-95', 'scale-100');
        }, 10);
    }

    function closeDeployModal() {
        const overlay = document.getElementById('deployModalOverlay');
        const modal = document.getElementById('deployModal');
        overlay.classList.replace('opacity-100', 'opacity-0');
        modal.classList.replace('scale-100', 'scale-95');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function toggleStatus(id, currentStatus) {
        if (currentStatus === "Active") {
            document.getElementById('statusEmpId').value = id;
            const overlay = document.getElementById('statusModalOverlay');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.add('opacity-100'), 10);
        } else {
            if (confirm("Reactivate this employee?")) {
                document.getElementById('reactivateId').value = id;
                document.getElementById('reactivateForm').submit();
            }
        }
    }

    function closeStatusModal() {
        const overlay = document.getElementById('statusModalOverlay');
        overlay.classList.remove('opacity-100');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function toggleEditMode() {
        isEditMode = !isEditMode;
        const viewDiv = document.getElementById('viewMode');
        const editForm = document.getElementById('editMode');
        const footer = document.getElementById('panelFooter');
        const editBtn = document.getElementById('editBtn');

        if (isEditMode) {
            viewDiv.classList.add('hidden');
            footer.classList.add('hidden');
            editForm.classList.remove('hidden');
            editBtn.classList.add('bg-indigo-50', 'text-indigo-600');
            editBtn.classList.remove('text-slate-400');
        } else {
            viewDiv.classList.remove('hidden');
            footer.classList.remove('hidden');
            editForm.classList.add('hidden');
            editBtn.classList.remove('bg-indigo-50', 'text-indigo-600');
            editBtn.classList.add('text-slate-400');
        }
    }
</script>