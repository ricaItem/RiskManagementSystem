@using Web_Sentro.Areas.Client.Controllers
@model IEnumerable<EmployeeRowVm>

@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Workforce Directory";

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

@if (TempData["Alert"] != null)
{
    <div class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500">
        <div class="bg-emerald-500 text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="text-xs font-black uppercase tracking-widest">@TempData["Alert"]</span>
        </div>
    </div>
}

<div class="max-w-full mx-auto space-y-6 animate-in fade-in duration-700">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight">Workforce <span class="text-blue-600">Management</span></h1>
        </div>
        <div class="flex gap-3">
            <button onclick="openDeployModal()" class="bg-blue-600 text-white px-4 py-2 rounded-xl text-[10px] font-black uppercase shadow-lg shadow-blue-500/20 hover:bg-blue-700 transition-all flex items-center gap-2">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Deploy Staff
            </button>
        </div>
    </div>

    <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 backdrop-blur-md mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-6 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2.5" stroke-linecap="round" /></svg>
                </span>
                <input type="text" id="empSearch" placeholder="Search by Name or Role..."
                       class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500 transition-all">
            </div>

            <div class="md:col-span-5">
                <select id="statusFilter" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="md:col-span-1">
                <button onclick="resetFilters()" class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-xl hover:bg-slate-200 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <table class="w-full text-left" id="empTable">
            <thead>
                <tr class="text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30">
                    <th class="px-6 py-4">Employee</th>
                    <th class="px-6 py-4">Role</th>
                    <th class="px-6 py-4 text-right">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                @foreach (var emp in Model)
                {
                    var empJson = System.Text.Json.JsonSerializer.Serialize(emp, jsonOptions);
                    var initials = (emp.Name ?? "??");
                    initials = initials.Length >= 2 ? initials.Substring(0, 2) : initials;

                    <tr onclick='openProfile(@Html.Raw(empJson))' class="hover:bg-slate-50/50 dark:hover:bg-blue-500/5 transition-all group emp-row cursor-pointer">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-[11px] font-black text-blue-600 uppercase">
                                    @initials
                                </div>
                                <div>
                                    <div class="text-xs font-black text-slate-900 dark:text-white emp-name">@emp.Name</div>
                                    <div class="text-[10px] font-medium text-slate-400">@emp.Email</div>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-5">
                            <div class="text-[10px] font-black uppercase text-slate-700 dark:text-slate-300 emp-role">@emp.Role</div>
                            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 emp-dept">N/A</span>
                        </td>

                        <td class="px-6 py-5 text-right">
                            @{
                                var statusLower = (emp.Status ?? "").ToLower();
                                var sc = statusLower == "active" ? "emerald" : "rose";
                                var icon = statusLower == "active" ? "✓" : "✕";
                            }

                            <button type="button" onclick="event.stopPropagation(); toggleStatus('@emp.UserId', '@emp.Status')" class="group relative focus:outline-none">
                                <span class="emp-status inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-@sc-500/10 text-@sc-600 text-[9px] font-black uppercase tracking-tighter border border-@sc-500/20 hover:bg-@sc-500 hover:text-white transition-all">
                                    <span class="text-[10px]">@icon</span> @emp.Status
                                </span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Deploy Modal -->
<div id="deployModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-[2.5rem] shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-300" id="deployModal">
        <form action="@Url.Action("Deploy", "Employees", new { area = "Client" })" method="post" class="p-10">
            @Html.AntiForgeryToken()
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter">New <span class="text-blue-600">Deployment</span></h2>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Onboard a new organization member</p>
                </div>
                <button type="button" onclick="closeDeployModal()" class="text-slate-400 hover:text-rose-500 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" /></svg>
                </button>
            </div>

            <div class="space-y-5">
                <div>
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1 mb-2 block">Full Name</label>
                    <input type="text" name="name" required class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-4 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all" placeholder="e.g. Juan Dela Cruz">
                </div>
                <div>
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1 mb-2 block">Email Address</label>
                    <input type="email" name="email" required class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-4 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all" placeholder="juan@sentro.com">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 mb-2 block">Role</label>
                        <select name="role" required class="w-full ...">
                            <option value="Employee">Employee</option>
                            <option value="Manager">Manager</option>
                            <option value="ProcurementOfficer">ProcurementOfficer</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 mb-2 block">Department</label>
                        <select name="department" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-4 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                            <option>Operations</option>
                            <option>Design</option>
                            <option>HSE</option>
                            <option>Construction</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-10">
                <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-2xl font-black uppercase text-xs tracking-[0.2em] shadow-xl shadow-blue-500/20 hover:bg-blue-700 hover:scale-[1.01] active:scale-[0.98] transition-all">
                    Confirm Deployment
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Status Modal (Archive) -->
<div id="statusModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[70] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-[2.5rem] shadow-2xl p-10 border border-slate-200">
        <form action="@Url.Action("UpdateStatus", "Employees", new { area = "Client" })" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="statusEmpId" />
            <input type="hidden" name="newStatus" value="Inactive" />

            <h2 class="text-xl font-black text-slate-900 mb-2 uppercase italic">Deactivation <span class="text-rose-600">Protocol</span></h2>
            <p class="text-xs text-slate-500 mb-6 font-bold uppercase tracking-tight">Please provide a reason for moving this record to archives.</p>

            <textarea name="reason" required class="w-full bg-slate-50 border-none rounded-2xl p-4 text-sm font-bold focus:ring-2 focus:ring-rose-500 outline-none mb-6" rows="4" placeholder="Termination, Resignation, End of Contract..."></textarea>

            <div class="flex gap-3">
                <button type="button" onclick="closeStatusModal()" class="flex-1 bg-slate-100 text-slate-500 py-4 rounded-2xl font-black uppercase text-[10px] tracking-widest">Cancel</button>
                <button type="submit" class="flex-1 bg-rose-600 text-white py-4 rounded-2xl font-black uppercase text-[10px] tracking-widest shadow-lg shadow-rose-500/20">Archive Record</button>
            </div>
        </form>
    </div>
</div>

<!-- Reactivate hidden form (POST + antiforgery) -->
<form id="reactivateForm" action="@Url.Action("UpdateStatus", "Employees", new { area = "Client" })" method="post" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="reactivateId" />
    <input type="hidden" name="newStatus" value="Active" />
    <input type="hidden" name="reason" value="Reactivation" />
</form>

<!-- Side panel overlay -->
<div id="sidePanelOverlay" onclick="closeProfile()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>

<!-- Side panel -->
<div id="sidePanel" class="fixed inset-y-0 right-0 w-full max-w-md bg-white dark:bg-slate-900 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 dark:border-slate-800">
    <div class="h-full flex flex-col p-8">

        <div class="flex justify-between items-start mb-8">
            <div id="panelHeader">
                <div class="w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center text-2xl font-black text-white uppercase mb-4" id="panelInitial"></div>
                <h2 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter" id="panelName"></h2>
                <p class="text-blue-600 font-bold text-xs uppercase" id="panelRole"></p>
            </div>

            <div class="flex gap-2">
                <button onclick="toggleEditMode()" id="editBtn" class="p-2 hover:bg-blue-50 dark:hover:bg-blue-900/30 text-blue-600 rounded-xl transition-all" title="Edit Profile">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-width="2.5" stroke-linecap="round" /></svg>
                </button>
                <button onclick="closeProfile()" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">
                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" /></svg>
                </button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto pr-2">

            <div id="viewMode" class="space-y-6">
                <section>
                    <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Professional Bio</h3>
                    <p id="panelBio" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed"></p>
                </section>
                <section>
                    <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">Core Expertise</h3>
                    <div id="panelSkills" class="flex flex-wrap gap-2"></div>
                </section>

                <hr class="border-slate-100 dark:border-slate-800" />

                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50">
                        <p class="text-[9px] font-black uppercase text-slate-400">Utilization</p>
                        <p id="panelUtil" class="text-lg font-black text-slate-900 dark:text-white"></p>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50">
                        <p class="text-[9px] font-black uppercase text-slate-400">Performance</p>
                        <p id="panelPerf" class="text-lg font-black text-slate-900 dark:text-white"></p>
                    </div>
                </div>
            </div>

            <form id="editMode" action="@Url.Action("UpdateEmployee", "Employees", new { area = "Client" })" method="post" class="hidden space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div>
                    <label class="text-[9px] font-black uppercase text-slate-400 ml-1">Full Name</label>
                    <input type="text" name="name" id="editName" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all" />
                </div>
                <div>
                    <label class="text-[9px] font-black uppercase text-slate-400 ml-1">Work Email</label>
                    <input type="email" name="email" id="editEmail" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all" />
                </div>
                <div>
                    <label class="text-[9px] font-black uppercase text-slate-400 ml-1">Role</label>
                    <input type="text" name="role" id="editRole" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all" />
                </div>
                <div>
                    <label class="text-[9px] font-black uppercase text-slate-400 ml-1">Bio</label>
                    <textarea name="bio" id="editBio" rows="4" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-xl px-4 py-3 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none transition-all resize-none"></textarea>
                </div>

                <div class="flex gap-3 pt-4">
                    <button type="button" onclick="toggleEditMode()" class="flex-1 bg-slate-100 dark:bg-slate-800 text-slate-500 py-4 rounded-2xl font-black uppercase text-[10px] tracking-widest hover:bg-slate-200 transition-all">Cancel</button>
                    <button type="submit" class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black uppercase text-[10px] tracking-widest shadow-lg shadow-blue-500/20 hover:bg-blue-700 transition-all">Save Changes</button>
                </div>
            </form>
        </div>

        <div id="panelFooter" class="mt-auto pt-8">
            <button type="button" class="w-full bg-slate-900 dark:bg-white dark:text-slate-900 text-white py-4 rounded-2xl font-black uppercase text-xs tracking-widest hover:scale-[1.02] transition-transform">
                Generate Performance Report
            </button>
        </div>
    </div>
</div>

<script>
    let isEditMode = false;
    const searchInput = document.getElementById('empSearch');
    const statusFilter = document.getElementById('statusFilter');

    function filterEmployees() {
        const searchTerm = searchInput.value.toLowerCase();
        const statusTerm = statusFilter.value.toLowerCase();

        document.querySelectorAll('.emp-row').forEach(row => {
            const name = row.querySelector('.emp-name').innerText.toLowerCase();
            const role = row.querySelector('.emp-role').innerText.toLowerCase();
            const status = row.querySelector('.emp-status').innerText.toLowerCase();
            const matchesSearch = name.includes(searchTerm) || role.includes(searchTerm);
            const matchesStatus = statusTerm === "" || status.includes(statusTerm);
            row.style.display = (matchesSearch && matchesStatus) ? "" : "none";
        });
    }

    searchInput.addEventListener('input', filterEmployees);
    statusFilter.addEventListener('change', filterEmployees);

    function resetFilters() {
        searchInput.value = "";
        statusFilter.value = "";
        filterEmployees();
    }

    function openProfile(emp) {
        isEditMode = false;
        document.getElementById('viewMode').classList.remove('hidden');
        document.getElementById('editMode').classList.add('hidden');
        document.getElementById('panelFooter').classList.remove('hidden');
        document.getElementById('editBtn').classList.remove('bg-blue-600', 'text-white');
        document.getElementById('editBtn').classList.add('text-blue-600');

        document.getElementById('panelName').innerText = emp.name ?? "";
        document.getElementById('panelRole').innerText = (emp.role ?? "Employee") + " • " + (emp.department ?? "N/A");
        document.getElementById('panelInitial').innerText = (emp.name ?? "??").substring(0, 2);
        document.getElementById('panelBio').innerText = emp.bio ?? "No biography available.";
        document.getElementById('panelUtil').innerText = emp.utilization ?? "0%";
        document.getElementById('panelPerf').innerText = (emp.performance ?? 0) + "%";

        document.getElementById('editId').value = emp.userId ?? emp.id ?? "";
        document.getElementById('editName').value = emp.name ?? "";
        document.getElementById('editEmail').value = emp.email ?? "";
        document.getElementById('editRole').value = emp.role ?? "Employee";
        document.getElementById('editBio').value = emp.bio ?? "";

        const skillsContainer = document.getElementById('panelSkills');
        skillsContainer.innerHTML = '';
        if (emp.skills && emp.skills.length) {
            emp.skills.forEach(skill => {
                skillsContainer.innerHTML += `<span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/20 text-blue-600 text-[10px] font-black uppercase rounded-lg border border-blue-100 dark:border-blue-800">${skill}</span>`;
            });
        } else {
            skillsContainer.innerHTML = `<span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 text-[10px] font-black uppercase rounded-lg border border-slate-200 dark:border-slate-700">No skills set</span>`;
        }

        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.replace('opacity-0', 'opacity-100'), 10);
        panel.classList.remove('translate-x-full');
    }

    function closeProfile() {
        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        panel.classList.add('translate-x-full');
        overlay.classList.replace('opacity-100', 'opacity-0');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function openDeployModal() {
        const overlay = document.getElementById('deployModalOverlay');
        const modal = document.getElementById('deployModal');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.replace('opacity-0', 'opacity-100');
            modal.classList.replace('scale-95', 'scale-100');
        }, 10);
    }

    function closeDeployModal() {
        const overlay = document.getElementById('deployModalOverlay');
        const modal = document.getElementById('deployModal');
        overlay.classList.replace('opacity-100', 'opacity-0');
        modal.classList.replace('scale-100', 'scale-95');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function toggleStatus(id, currentStatus) {
        if (currentStatus === "Active") {
            document.getElementById('statusEmpId').value = id;
            const overlay = document.getElementById('statusModalOverlay');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.add('opacity-100'), 10);
        } else {
            if (confirm("Reactivate this employee?")) {
                document.getElementById('reactivateId').value = id;
                document.getElementById('reactivateForm').submit();
            }
        }
    }

    function closeStatusModal() {
        const overlay = document.getElementById('statusModalOverlay');
        overlay.classList.remove('opacity-100');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function toggleEditMode() {
        isEditMode = !isEditMode;
        const viewDiv = document.getElementById('viewMode');
        const editForm = document.getElementById('editMode');
        const footer = document.getElementById('panelFooter');
        const editBtn = document.getElementById('editBtn');

        if (isEditMode) {
            viewDiv.classList.add('hidden');
            footer.classList.add('hidden');
            editForm.classList.remove('hidden');
            editBtn.classList.replace('text-blue-600', 'bg-blue-600');
            editBtn.classList.add('text-white');
        } else {
            viewDiv.classList.remove('hidden');
            footer.classList.remove('hidden');
            editForm.classList.add('hidden');
            editBtn.classList.replace('bg-blue-600', 'text-blue-600');
            editBtn.classList.remove('text-white');
        }
    }
</script>