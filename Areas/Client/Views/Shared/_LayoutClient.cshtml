@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@{
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Client User";
    var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[parts.Length - 1][0]}".ToUpperInvariant()
        : (parts.Length == 1 && parts[0].Length > 0 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant() : "CU");
    var roleLabel = "Organization Member";
    if (User.IsInRole("SuperAdmin")) { roleLabel = "Super Admin"; }
    else if (User.IsInRole("Admin")) { roleLabel = "Admin"; }
    else if (User.IsInRole("Employee")) { roleLabel = "Employee"; }
    else if (User.IsInRole("Manager")) { roleLabel = "Manager"; }
    else if (User.IsInRole("ProcurementOfficer")) { roleLabel = "Procurement Officer"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentro Client</title>

    <link rel="stylesheet" href="~/css/theme-sentro.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/theme.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    width: {
                        'sidebar-expanded': '260px',
                        'sidebar-collapsed': '80px'
                    }
                }
            }
        }
    </script>

    <style>
        /* ============ Smooth layout transitions ============ */
        .sidebar-transition {
            transition: width 260ms cubic-bezier(0.4, 0, 0.2, 1), transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        .content-transition {
            transition: margin-left 260ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ============ Scrollbar ============ */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 10px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
        }

        /* ============ Typography (sidebar) – 14px, Title Case, same as nav items ============ */
        :root {
            --sb-text-size: 14px;
            --sb-font-weight: 500;
            --sb-section-weight: 600;
            --sb-tracking: 0.02em;
        }

        .sb-text {
            font-size: var(--sb-text-size);
            font-weight: var(--sb-font-weight);
            letter-spacing: var(--sb-tracking);
            line-height: 1.35rem;
        }

        .sb-section {
            font-size: var(--sb-text-size);
            font-weight: var(--sb-section-weight);
            letter-spacing: var(--sb-tracking);
            text-transform: none; /* Title Case in markup, no uppercase */
        }

        /* ============ Sidebar collapsed behavior ============ */
        .sidebar-collapsed .sidebar-label,
        .sidebar-collapsed .sidebar-header-text {
            display: none;
        }

        .sidebar-collapsed .sidebar-nav-item {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }

        .logo-img {
            max-width: 180px;
        }

        .sidebar-collapsed .logo-img {
            height: 32px;
            max-width: 40px;
            object-position: left;
        }

        .sidebar-collapsed .accordion-panel {
            display: none !important;
        }

        /* ============ Menu item (active + hover) ============ */
        .nav-item {
            transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
            will-change: transform;
        }

            .nav-item:hover {
                transform: translateY(-1px);
            }

            /* active: use .sentro-nav-active for background + left border (no ::before) */
            .nav-item.is-active {
                position: relative;
                padding-left: 13px; /* 3px border + 10px */
            }
            .nav-item.is-active::before { display: none; }

        /* ============ Accordion smooth open/close ============ */
        .accordion-panel {
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            transform: translateY(-4px);
            transition: max-height 220ms cubic-bezier(0.4, 0, 0.2, 1), opacity 180ms ease, transform 180ms ease;
        }

            .accordion-panel.is-open {
                opacity: 1;
                transform: translateY(0);
            }

        .main-content-wrap {
            animation: mainContentFadeIn 220ms ease-out;
        }
        @@keyframes mainContentFadeIn {
            from

        {
            opacity: .65;
        }

        to {
            opacity: 1;
        }

        }

        .content-spinner { position: absolute; top: 4rem; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 10; }
        .content-spinner .spinner { width: 28px; height: 28px; border: 3px solid #e2e8f0; border-top-color: #0ea5e9; border-radius: 50%; animation: spin .6s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .save-btn-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .5s linear infinite; vertical-align: middle; margin-right: 6px; }
        .nav-leaving .main-content-wrap {
            opacity: .65;
            transition: opacity 140ms ease;
        }

        /* ============ Focus ring (brand primary) ============ */
        .focus-ring:focus-visible {
            outline: none;
            box-shadow: var(--focus-ring);
        }

        /* ============ Cards: token-based shadow and border ============ */
        .shadow-card {
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }
        .dark .shadow-card {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
        }
        .hover\:shadow-card-hover:hover {
            box-shadow: var(--shadow-card-hover);
        }
        .dark .hover\:shadow-card-hover:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.35), 0 4px 6px -4px rgba(0, 0, 0, 0.25);
        }
    </style>
</head>

<body class="sentro-bg-page text-slate-900 transition-colors duration-300 dark:bg-slate-900 dark:text-slate-100 overflow-x-hidden">

    @{
        string IsActive(string path)
        {
            var currentPath = Context.Request.Path.ToString();

            var isActive = currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);

            return isActive
            ? "is-active sentro-nav-active border-transparent dark:border-transparent"
            : "sentro-nav-inactive border-transparent dark:border-transparent";
        }

        string IsGroupActive(params string[] prefixes)
        {
            var p = Context.Request.Path.ToString();
            return prefixes.Any(x => p.StartsWith(x, StringComparison.OrdinalIgnoreCase)) ? "true" : "false";
        }
    }

    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden md:hidden"></div>

    <div class="flex min-h-screen relative">
