            <button onclick="toggleSidebar()"
                    class="absolute -right-3 top-10 flex h-6 w-6 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text-secondary)] shadow-md transition-colors hover:bg-[var(--nav-hover-bg)] hover:text-[var(--brand-accent)] focus-ring dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-emerald-400"
                    id="sidebarToggleBtn" type="button">
