                        <!-- Intelligence Accordion -->
                        <div class="pt-4">
                            <button type="button"
                                    class="sidebar-nav-item nav-item sb-text focus-ring w-full flex items-center gap-3 rounded-xl px-4 py-2.5 border border-transparent sentro-nav-inactive dark:border-transparent"
                                    onclick="toggleAccordion('intelAccordion')"
                                    aria-controls="intelAccordion"
                                    aria-expanded="false"
                                    data-acc-btn="intelAccordion">
                                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                                <span class="sidebar-label sb-section whitespace-nowrap flex-1 text-left sentro-text-secondary">Intelligence</span>
                                <svg id="intelChevron" class="w-4 h-4 shrink-0 transition-transform sidebar-label" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>

                            <div id="intelAccordion" class="accordion-panel mt-1 space-y-1 pl-2">
                                <a data-nav href="@Url.Action("Index", "Reports", new { area = "Client" })"
                                   class="sidebar-nav-item nav-item sb-text focus-ring flex items-center gap-3 rounded-xl px-4 py-2.5 border @IsActive("/Client/Reports")">
                                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <span class="sidebar-label">Executive Reports</span>
                                </a>

                                <a data-nav href="/Client/Sites"
                                   class="sidebar-nav-item nav-item sb-text focus-ring flex items-center gap-3 rounded-xl px-4 py-2.5 border @IsActive("/Client/Sites")">
                                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                    </svg>
                                    <span class="sidebar-label">Site Identity</span>
                                </a>
                            </div>
                        </div>

                        <div class="pt-4">
                            <a data-nav href="@Url.Action("Index", "Audit", new { area = "Client" })"
                               class="sidebar-nav-item nav-item sb-text focus-ring flex items-center gap-3 rounded-xl px-4 py-2.5 border @IsActive("/Client/Audit")">
                                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span class="sidebar-label">Audit</span>
                            </a>
                        </div>
                    }
                </nav>

                <div class="mt-auto pt-4 sentro-border-t dark:border-t dark:border-slate-800 shrink-0">
                    <button type="button" onclick="window.__toggleTheme()"
                            class="sidebar-nav-item nav-item sb-text focus-ring flex w-full items-center gap-3 rounded-xl px-4 py-3 border border-transparent sentro-nav-inactive dark:border-transparent">
                        <span class="dark:hidden flex items-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                            </svg>
                            <span class="sidebar-label">Dark</span>
                        </span>
                        <span class="hidden dark:flex items-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span class="sidebar-label">Light</span>
                        </span>
                    </button>
                </div>
            </div>
        </aside>

        <main class="main-content-wrap flex-1 flex flex-col min-w-0 bg-inherit content-transition relative">
            <header class="sentro-navbar flex h-16 items-center justify-between px-4 md:px-8 dark:bg-slate-900 sticky top-0 z-30">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="md:hidden p-2 sentro-text-secondary dark:text-slate-300 focus-ring rounded-lg" type="button">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                        </svg>
                    </button>
                    <div class="text-xs font-normal sentro-text-secondary truncate">
                        <span class="sentro-text-secondary">@(User.IsInRole("Employee") ? "Employee" : "Client") Portal</span> / <span id="pageTitleHeader" class="sentro-text-primary dark:text-slate-200 font-medium">@ViewData["Title"]</span>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <div class="relative" id="notificationBellWrap">
                        <button type="button" onclick="toggleNotificationDropdown()" id="notificationBellBtn" class="flex items-center justify-center h-10 w-10 rounded-xl sentro-text-secondary hover:bg-[var(--nav-hover-bg)] dark:text-slate-400 dark:hover:bg-slate-800 focus:outline-none focus-ring rounded-xl transition-colors relative" title="Notifications" aria-label="Notifications" aria-expanded="false">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                            </svg>
                            <span id="notificationBadge" class="absolute -top-0.5 -right-0.5 h-4 min-w-[1rem] items-center justify-center rounded-full bg-rose-500 px-1 text-[10px] font-bold text-white hidden" aria-hidden="true">0</span>
                        </button>
                        <div id="notificationDropdown" class="absolute right-0 mt-2 w-[360px] max-h-[80vh] overflow-hidden rounded-2xl sentro-card shadow-xl dark:border-slate-800 dark:bg-slate-900 hidden z-50 flex flex-col border border-slate-200 dark:border-slate-700">
                            <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-slate-800">
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Notifications</span>
                                <a href="@Url.Action("Index", "Notifications", new { area = "Client" })" class="text-[10px] font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400">View all</a>
                            </div>
                            <div id="notificationDropdownList" class="overflow-y-auto custom-scrollbar max-h-[320px] p-2">
                                <div id="notificationDropdownLoading" class="flex items-center justify-center py-8 text-slate-400 text-sm">Loading…</div>
                                <div id="notificationDropdownEmpty" class="hidden py-8 text-center text-sm text-slate-500 dark:text-slate-400">No notifications.</div>
                            </div>
                        </div>
                    </div>
                    <div class="relative">
                        <button onclick="toggleUserDropdown()" id="userDropdownBtn" class="flex items-center gap-4 hover:opacity-80 transition-opacity focus:outline-none group focus-ring rounded-xl p-1" type="button">
                            <div class="hidden sm:flex flex-col items-end mr-2">
                                <span class="text-xs font-medium max-w-[140px] truncate" title="@displayName">@displayName</span>
                                <span class="text-[10px] font-medium" style="color: var(--brand-accent);">@roleLabel</span>
                            </div>
                            <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-slate-200 to-slate-300 dark:from-slate-700 dark:to-slate-800 border border-slate-300 dark:border-slate-600 flex items-center justify-center font-semibold text-slate-500 text-sm">
                                @initials
                            </div>
                        </button>

                    <div id="userDropdown" class="absolute right-0 mt-3 w-48 rounded-2xl sentro-card p-2 shadow-lg dark:border-slate-800 dark:bg-slate-900 hidden animate-in fade-in zoom-in duration-200">
                        <a data-nav href="/Client/Account" class="sb-text focus-ring flex items-center gap-3 rounded-xl px-4 py-2.5 sentro-text-primary hover:bg-[var(--nav-hover-bg)] dark:text-slate-300 dark:hover:bg-slate-800">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            My Account
                        </a>
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                        <button type="button" onclick="openLogoutModal()"
                                class="sb-text focus-ring flex w-full items-center gap-3 rounded-xl px-4 py-2.5 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/20">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            Logout
                        </button>
                    </div>
                    </div>
                </div>
            </header>

            <div id="main-content" class="p-4 md:p-8 animate-in fade-in slide-in-from-bottom-2 duration-500 sentro-bg-page dark:bg-slate-900">
                @RenderBody()
            </div>
            <div id="main-content-spinner" class="content-spinner hidden" aria-hidden="true"><div class="flex flex-col items-center gap-2"><div class="spinner"></div><span class="text-sm text-slate-500 dark:text-slate-400">Loading</span></div></div>
        </main>
    </div>

    <!-- Logout modal -->
    <div id="logoutModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
        <div class="relative w-full max-w-sm rounded-[2.5rem] sentro-card p-8 shadow-xl dark:border-slate-800 dark:bg-slate-900 animate-in zoom-in duration-200">
            <div class="text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-100 text-rose-600 dark:bg-rose-500/10">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Signing Out?</h3>
                <p class="mt-2 text-sm font-normal text-slate-500 dark:text-slate-400">Are you sure you want to end your session?</p>
            </div>
            <div class="mt-8 flex flex-col gap-3">
                <button onclick="confirmLogout()" class="w-full rounded-2xl bg-rose-500 py-4 text-xs font-semibold uppercase tracking-widest text-white transition-all hover:bg-rose-600 focus-ring" type="button">Log Me Out</button>
                <button onclick="closeLogoutModal()" class="btn-secondary w-full rounded-2xl py-4 text-xs font-medium uppercase tracking-widest transition-all dark:border-slate-800 dark:text-slate-400 focus-ring" type="button">Cancel</button>
            </div>
        </div>
    </div>

    <form id="clientLogoutForm" action="/Identity/Account/Logout" method="post" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="/" />
    </form>

    <script>
        const sidebar = document.getElementById('mainSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleIcon = document.getElementById('toggleIcon');
        const dropdown = document.getElementById('userDropdown');

        function measurePanel(panel) {
            panel.style.maxHeight = 'none';
            const h = panel.scrollHeight;
            panel.style.maxHeight = '';
            return h;
        }

        function setAccordionOpen(id, open) {
            const panel = document.getElementById(id);
            if (!panel) return;

            const chevronId = id.replace('Accordion', 'Chevron');
            const chevron = document.getElementById(chevronId);
            const btn = document.querySelector(`[data-acc-btn="${id}"]`);

            if (open) {
                panel.classList.add('is-open');
                panel.style.maxHeight = measurePanel(panel) + 'px';
                if (chevron) chevron.classList.add('rotate-90');
                if (btn) btn.setAttribute('aria-expanded', 'true');
            } else {
                panel.classList.remove('is-open');
                panel.style.maxHeight = '0px';
                if (chevron) chevron.classList.remove('rotate-90');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        }

        function toggleAccordion(id) {
            const panel = document.getElementById(id);
            if (!panel) return;

            if (sidebar.classList.contains('sidebar-collapsed')) return;

            const willOpen = !panel.classList.contains('is-open');
            setAccordionOpen(id, willOpen);
        }

        function toggleSidebar() {
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
                sidebar.classList.toggle('-translate-x-full');
                overlay.classList.toggle('hidden');
            } else {
                const isExpanded = sidebar.classList.contains('w-sidebar-expanded');

                if (isExpanded) {
                    sidebar.classList.remove('w-sidebar-expanded');
                    sidebar.classList.add('w-sidebar-collapsed', 'sidebar-collapsed');
                    toggleIcon.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>`;

                    setAccordionOpen('rmAccordion', false);
                    setAccordionOpen('opsAccordion', false);
                    setAccordionOpen('intelAccordion', false);
                    setAccordionOpen('spAccordion', false);
                } else {
                    sidebar.classList.remove('w-sidebar-collapsed', 'sidebar-collapsed');
                    sidebar.classList.add('w-sidebar-expanded');
                    toggleIcon.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path></svg>`;

                    ['rmAccordion', 'opsAccordion', 'intelAccordion', 'spAccordion'].forEach(id => {
                        const p = document.getElementById(id);
                        if (p && p.classList.contains('is-open')) p.style.maxHeight = measurePanel(p) + 'px';
                    });
                }
            }
        }

        function toggleUserDropdown() {
            dropdown?.classList.toggle('hidden');
            document.getElementById('notificationDropdown')?.classList.add('hidden');
            document.getElementById('notificationBellBtn')?.setAttribute('aria-expanded', 'false');
        }

        let notificationDropdownLoaded = false;
        function markAllNotificationsRead() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;
            fetch('/Client/Notifications/ApiMarkAllRead', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            }).catch(() => {});
        }
        function toggleNotificationDropdown() {
            const panel = document.getElementById('notificationDropdown');
            const btn = document.getElementById('notificationBellBtn');
            if (!panel || !btn) return;
            const isOpen = !panel.classList.contains('hidden');
            if (isOpen) {
                panel.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
            } else {
                document.getElementById('userDropdown')?.classList.add('hidden');
                panel.classList.remove('hidden');
                btn.setAttribute('aria-expanded', 'true');
                updateNotificationBadge(0);
                markAllNotificationsRead();
                loadNotificationDropdown();
            }
        }
        function loadNotificationDropdown() {
            const listEl = document.getElementById('notificationDropdownList');
            const loadingEl = document.getElementById('notificationDropdownLoading');
            const emptyEl = document.getElementById('notificationDropdownEmpty');
            if (!listEl || !loadingEl || !emptyEl) return;
            loadingEl.classList.remove('hidden');
            emptyEl.classList.add('hidden');
            listEl.querySelectorAll('.notification-item').forEach(n => n.remove());
            fetch('/Client/Notifications/ApiDropdown', { credentials: 'same-origin' })
                .then(r => r.json())
                .then(data => {
                    loadingEl.classList.add('hidden');
                    const items = data.items || [];
                    if (items.length === 0) {
                        emptyEl.classList.remove('hidden');
                        return;
                    }
                    items.forEach(item => {
                        const unread = !item.readAt;
                        const created = item.createdAt ? new Date(item.createdAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '';
                        const link = item.actionUrl ? item.actionUrl : '@Url.Action("Index", "Notifications", new { area = "Client" })';
                        const div = document.createElement(item.actionUrl ? 'a' : 'div');
                        div.className = 'notification-item block rounded-xl px-3 py-2.5 ' + (unread ? 'bg-indigo-50/80 dark:bg-indigo-900/20' : 'hover:bg-slate-50 dark:hover:bg-slate-800/50') + ' transition-colors';
                        if (item.actionUrl) {
                            div.href = link;
                            div.addEventListener('click', function(e) {
                                e.preventDefault();
                                if (item.notificationId) markNotificationRead(item.notificationId);
                                window.location.href = link;
                            });
                        }
                        div.innerHTML = '<div class="font-semibold text-slate-900 dark:text-white text-xs">' + escapeHtml(item.title || '') + '</div><div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-2">' + escapeHtml(item.message || '') + '</div><div class="text-[10px] text-slate-400 mt-1">' + escapeHtml(created) + '</div>';
                        listEl.appendChild(div);
                    });
                    notificationDropdownLoaded = true;
                })
                .catch(() => {
                    loadingEl.classList.add('hidden');
                    emptyEl.classList.remove('hidden');
                    emptyEl.textContent = 'Could not load notifications.';
                });
        }
        function updateNotificationBadge(count) {
            const badge = document.getElementById('notificationBadge');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.remove('hidden');
                badge.classList.add('flex');
                badge.setAttribute('aria-hidden', 'false');
            } else {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
                badge.setAttribute('aria-hidden', 'true');
            }
        }
        function markNotificationRead(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) return;
            fetch('/Client/Notifications/ApiMarkRead', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'id=' + id + '&__RequestVerificationToken=' + encodeURIComponent(token)
            }).catch(() => {});
        }
        function escapeHtml(s) {
            const div = document.createElement('div');
            div.textContent = s;
            return div.innerHTML;
        }
        document.addEventListener('DOMContentLoaded', function() {
            fetch('/Client/Notifications/ApiDropdown', { credentials: 'same-origin' })
                .then(r => r.json())
                .then(data => { updateNotificationBadge(data.unreadCount || 0); })
                .catch(() => {});
            document.addEventListener('click', function(e) {
                const wrap = document.getElementById('notificationBellWrap');
                if (wrap && !wrap.contains(e.target)) {
                    document.getElementById('notificationDropdown')?.classList.add('hidden');
                    document.getElementById('notificationBellBtn')?.setAttribute('aria-expanded', 'false');
                }
            });
        });

        function openLogoutModal() {
            dropdown?.classList.add('hidden');
            document.getElementById('logoutModal').classList.replace('hidden', 'flex');
            document.body.style.overflow = 'hidden';
        }

        function closeLogoutModal() {
            document.getElementById('logoutModal').classList.replace('flex', 'hidden');
            document.body.style.overflow = 'auto';
        }

        function confirmLogout() {
            document.getElementById('clientLogoutForm').submit();
        }

        const TITLE_SUFFIX = ' - Sentro Client';

        function getOpenAccordionIds() {
            return ['rmAccordion', 'opsAccordion', 'spAccordion', 'intelAccordion']
                .filter(id => document.getElementById(id)?.classList.contains('is-open'));
        }

        function pathStartsWith(targetPath, prefix) {
            if (!targetPath || !prefix) return false;
            const t = targetPath.toLowerCase();
            const p = prefix.toLowerCase();
            return t === p || t.startsWith(p + '/');
        }

        function getSectionState(path) {
            const p = (path || '').toLowerCase();
            return {
                rm: pathStartsWith(p, '/client/risks') || pathStartsWith(p, '/client/mitigation') || pathStartsWith(p, '/client/incidents') || pathStartsWith(p, '/client/riskanalytics'),
                ops: pathStartsWith(p, '/client/archive') || pathStartsWith(p, '/client/audit') || pathStartsWith(p, '/client/employees'),
                sp: pathStartsWith(p, '/client/supplier') || pathStartsWith(p, '/client/suppliers') || pathStartsWith(p, '/client/purchaseorders') || pathStartsWith(p, '/client/budget') || pathStartsWith(p, '/client/expenses'),
                intel: pathStartsWith(p, '/client/reports') || pathStartsWith(p, '/client/sites')
            };
        }

        function updateNavActiveState(path) {
            const targetPath = (path || '').toLowerCase();
            const activeClass = ['is-active', 'sentro-nav-active'];
            const inactiveClass = ['sentro-nav-inactive'];

            document.querySelectorAll('a[data-nav].nav-item').forEach(link => {
                const href = link.getAttribute('href');
                if (!href) return;
                const linkPath = new URL(href, window.location.origin).pathname.toLowerCase();
                const isActive = pathStartsWith(targetPath, linkPath);

                if (isActive) {
                    inactiveClass.forEach(c => link.classList.remove(c));
                    activeClass.forEach(c => link.classList.add(c));
                } else {
                    activeClass.forEach(c => link.classList.remove(c));
                    if (!link.classList.contains('sentro-nav-inactive')) link.classList.add('sentro-nav-inactive');
                }
            });
        }

        function syncSidebarState(path, preserveOpenIds) {
            const isCollapsed = sidebar.classList.contains('sidebar-collapsed');
            const state = getSectionState(path);
            const preserved = new Set(preserveOpenIds || []);

            if (isCollapsed) {
                setAccordionOpen('rmAccordion', false);
                setAccordionOpen('opsAccordion', false);
                setAccordionOpen('spAccordion', false);
                setAccordionOpen('intelAccordion', false);
                return;
            }

            setAccordionOpen('rmAccordion', state.rm || preserved.has('rmAccordion'));
            setAccordionOpen('opsAccordion', state.ops || preserved.has('opsAccordion'));
            setAccordionOpen('spAccordion', state.sp || preserved.has('spAccordion'));
            setAccordionOpen('intelAccordion', state.intel || preserved.has('intelAccordion'));
        }

        function enableSoftNav() {
            const mainContent = document.getElementById('main-content');
            const pageTitleHeader = document.getElementById('pageTitleHeader');
            if (!mainContent) return;

            document.addEventListener('click', async (e) => {
                const a = e.target.closest('a[data-nav]');
                if (!a) return;
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                const href = a.getAttribute('href');
                if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

                const current = window.location.pathname + window.location.search;
                const targetUrl = new URL(href, window.location.origin);
                if (current === targetUrl.pathname + targetUrl.search) { e.preventDefault(); return; }

                e.preventDefault();
                document.documentElement.classList.add('nav-leaving');
                const spinner = document.getElementById('main-content-spinner');
                const targetPath = targetUrl.pathname.toLowerCase();
                const useOverlaySpinner = !(
                    targetPath.startsWith('/client/risks/identification') ||
                    targetPath.startsWith('/client/mitigation') ||
                    targetPath.startsWith('/client/risks/monitoring') ||
                    targetPath.startsWith('/client/incidents') ||
                    targetPath.startsWith('/client/riskanalytics') ||
                    targetPath.startsWith('/client/reports') ||
                    targetPath.startsWith('/client/sites') ||
                    targetPath.startsWith('/client/archive') ||
                    targetPath.startsWith('/client/audit') ||
                    targetPath.startsWith('/client/supplier') ||
                    targetPath.startsWith('/client/suppliers') ||
                    targetPath.startsWith('/client/purchaseorders') ||
                    targetPath.startsWith('/client/budget') ||
                    targetPath.startsWith('/client/expenses') ||
                    targetPath.startsWith('/client/employees') ||
                    targetPath.startsWith('/client/organization')
                );
                
                // Special Skeleton for Organization
                if (targetPath.startsWith('/client/organization')) {
                    mainContent.innerHTML = `
                        <div class="settings-shell min-h-screen animate-pulse">
                            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
                                <div class="mb-8">
                                    <div class="settings-card overflow-hidden px-6 py-6 sm:px-8">
                                        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                                            <div class="min-w-0 space-y-3">
                                                <div class="h-4 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                <div class="h-8 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                <div class="flex gap-3">
                                                    <div class="h-5 w-24 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                    <div class="h-5 w-24 rounded-full bg-slate-200 dark:bg-slate-700"></div>
                                                </div>
                                            </div>
                                            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                                                <div class="h-16 w-32 rounded-2xl bg-slate-50 dark:bg-slate-800"></div>
                                                <div class="h-16 w-32 rounded-2xl bg-slate-50 dark:bg-slate-800"></div>
                                                <div class="h-16 w-32 rounded-2xl bg-slate-50 dark:bg-slate-800 col-span-2 sm:col-span-1"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">
                                    <aside class="xl:col-span-3">
                                        <div class="settings-card p-4 space-y-4">
                                            <div class="h-4 w-20 rounded bg-slate-200 dark:bg-slate-700"></div>
                                            <div class="space-y-2">
                                                <div class="h-12 w-full rounded-xl bg-slate-100 dark:bg-slate-800"></div>
                                                <div class="h-12 w-full rounded-xl bg-slate-100 dark:bg-slate-800"></div>
                                                <div class="h-12 w-full rounded-xl bg-slate-100 dark:bg-slate-800"></div>
                                                <div class="h-12 w-full rounded-xl bg-slate-100 dark:bg-slate-800"></div>
                                                <div class="h-12 w-full rounded-xl bg-slate-100 dark:bg-slate-800"></div>
                                            </div>
                                        </div>
                                    </aside>
                                    <main class="xl:col-span-9">
                                        <div class="settings-card overflow-hidden">
                                            <div class="border-b border-slate-200/80 px-6 py-5 dark:border-slate-800">
                                                <div class="h-5 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                <div class="mt-2 h-4 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
                                            </div>
                                            <div class="px-6 py-6 space-y-8">
                                                <div class="grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
                                                    <div class="space-y-2">
                                                        <div class="h-4 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                        <div class="h-3 w-48 rounded bg-slate-200 dark:bg-slate-700"></div>
                                                    </div>
                                                    <div class="upload-box rounded-3xl p-5 h-32 bg-slate-50 dark:bg-slate-800/50"></div>
                                                </div>
                                                <div class="border-t border-slate-200/80 pt-8 dark:border-slate-800 grid gap-8 sm:grid-cols-2">
                                                    <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                                    <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                                    <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 sm:col-span-2"></div>
                                                    <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                                    <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </main>
                                </div>
                            </div>
                        </div>
                    `;
                }

                if (spinner && useOverlaySpinner) spinner.classList.remove('hidden');
                const openAccordions = getOpenAccordionIds();

                try {
                    const res = await fetch(href, {
                        headers: { 'X-Partial-Content': 'main' },
                        credentials: 'same-origin'
                    });
                    if (!res.ok) { window.location.href = href; return; }
                    const html = await res.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const nextMainContent = doc.getElementById('main-content');
                    if (!nextMainContent) { window.location.href = href; return; }

                    const titleText = (doc.title || '').replace(TITLE_SUFFIX, '').trim() || 'Client';
                    mainContent.innerHTML = nextMainContent.innerHTML;
                    mainContent.querySelectorAll('script').forEach(oldScript => {
                        const script = document.createElement('script');
                        if (oldScript.src) { script.src = oldScript.src; } else { script.textContent = oldScript.textContent; }
                        oldScript.parentNode.replaceChild(script, oldScript);
                    });
                    document.title = titleText + TITLE_SUFFIX;
                    if (pageTitleHeader) pageTitleHeader.textContent = titleText;
                    history.pushState({ partial: true }, '', href);
                    updateNavActiveState(targetUrl.pathname);
                    syncSidebarState(targetUrl.pathname, openAccordions);
                    document.documentElement.classList.remove('nav-leaving');
                } catch (_) {
                    window.location.href = href;
                } finally {
                    if (spinner && useOverlaySpinner) spinner.classList.add('hidden');
                }
            }, true);
        }

        window.addEventListener('popstate', function () {
            window.location.reload();
        });

        document.addEventListener('DOMContentLoaded', () => {
            enableSoftNav();

            const path = window.location.pathname.toLowerCase();
            updateNavActiveState(path);
            syncSidebarState(path);
        });

        window.addEventListener('click', function (e) {
            const btn = document.getElementById('userDropdownBtn');
            if (dropdown && btn && !btn.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });

        window.addEventListener('resize', () => {
            ['rmAccordion', 'opsAccordion', 'spAccordion', 'intelAccordion'].forEach(id => {
                const p = document.getElementById(id);
                if (p && p.classList.contains('is-open') && !sidebar.classList.contains('sidebar-collapsed')) {
                    p.style.maxHeight = measurePanel(p) + 'px';
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
