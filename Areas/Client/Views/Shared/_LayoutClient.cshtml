                        <!-- Intelligence Accordion -->
                        <div class="pt-4">
                            <button type="button"
                                    class="sidebar-nav-item nav-item sb-text focus-ring w-full flex items-center gap-3 rounded-xl px-4 py-2.5 border border-transparent sentro-nav-inactive dark:border-transparent"
                                    onclick="toggleAccordion('intelAccordion')"
