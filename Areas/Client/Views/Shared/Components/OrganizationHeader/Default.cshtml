@using WEB_Sentro.ViewComponents
@model OrganizationHeaderViewModel

<div class="flex items-center justify-center gap-2 shrink-0 px-2 h-16 w-full">
    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
    {
        <img src="@Model.LogoPath" alt="@Model.OrgName logo" class="logo-img h-8 w-8 object-contain rounded-lg" />
    }
    <span class="sidebar-label text-lg font-bold tracking-tight text-slate-900 dark:text-white truncate max-w-[140px]" title="@Model.OrgName">@Model.OrgName</span>
</div>
