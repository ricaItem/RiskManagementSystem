@model Web_Sentro.Areas.Client.Models.PagedResult<WEB_Sentro.Data.Entities.CostCode>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Cost Codes";
}

@if (TempData["Message"] != null)
{
    <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
        <div class="bg-emerald-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="text-sm font-medium">@TempData["Message"]</span>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
        <div class="bg-red-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="text-sm font-medium">@TempData["Error"]</span>
        </div>
    </div>
}

<div class="min-h-screen space-y-6">
    <!-- Header -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Cost Codes
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage project cost codes and divisions</p>
        </div>
        <div>
            <a href="@Url.Action("Create", "CostCodes", new { area = "Client" })" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                New Cost Code
            </a>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" action="@Url.Action("Index", "CostCodes", new { area = "Client" })" class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800 w-full max-w-sm">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search codes or descriptions..." class="border-0 bg-transparent p-0 text-xs font-semibold text-slate-900 focus:ring-0 w-full dark:text-white placeholder:text-slate-400">
        </div>
        <button type="submit" class="hidden">Search</button>
        
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
             <a href="@Url.Action("Index", "CostCodes", new { area = "Client" })" class="rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-500" title="Clear Search">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
        }
    </form>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/20">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Master List</h3>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                @Model.TotalCount Items
            </span>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 text-xs font-medium text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3 font-medium w-32">Code</th>
                        <th class="px-6 py-3 font-medium">Description</th>
                        <th class="px-6 py-3 font-medium w-24 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="h-12 w-12 rounded-full bg-slate-50 flex items-center justify-center mb-3 dark:bg-slate-800">
                                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 6h16M4 10h16M4 14h16M4 18h16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    </div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">No cost codes found</p>
                                    <p class="text-xs text-slate-500 mt-1 dark:text-slate-400">Start by creating a new one or importing standards.</p>
                                    
                                    <div class="flex gap-3 mt-4">
                                        <a href="@Url.Action("Create", "CostCodes", new { area = "Client" })" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Create New</a>
                                        <span class="text-slate-300">|</span>
                                        <form action="@Url.Action("ImportMasterFormat", "CostCodes", new { area = "Client" })" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Import MasterFormat (16 Div)</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var isParent = item.ParentCostCodeId == null;
                        <tr class="group hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs font-semibold @(isParent ? "text-slate-900 dark:text-white" : "text-slate-600 dark:text-slate-400 ml-4")">@item.Code</span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm @(isParent ? "font-semibold text-slate-900 dark:text-white" : "text-slate-600 dark:text-slate-400")">@item.Description</div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Edit", "CostCodes", new { area = "Client", id = item.CostCodeId })" class="text-xs font-medium text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <p class="text-xs text-slate-500 dark:text-slate-400">Page @Model.PageNumber of @Model.TotalPages</p>
                <div class="flex gap-2">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", "CostCodes", new { area = "Client", page = Model.PageNumber - 1, pageSize = Model.PageSize, search = ViewBag.Search })" class="px-3 py-1 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">Previous</a>
                    }
                    else 
                    {
                        <span class="px-3 py-1 text-xs font-medium text-slate-400 bg-slate-50 border border-slate-200 rounded-md cursor-not-allowed dark:bg-slate-800/50 dark:border-slate-700/50">Previous</span>
                    }
                    
                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", "CostCodes", new { area = "Client", page = Model.PageNumber + 1, pageSize = Model.PageSize, search = ViewBag.Search })" class="px-3 py-1 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">Next</a>
                    }
                    else
                    {
                         <span class="px-3 py-1 text-xs font-medium text-slate-400 bg-slate-50 border border-slate-200 rounded-md cursor-not-allowed dark:bg-slate-800/50 dark:border-slate-700/50">Next</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        const toast = document.getElementById('toastAlert');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    })();
</script>
