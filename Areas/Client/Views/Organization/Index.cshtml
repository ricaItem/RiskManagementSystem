                                                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zm.75 3a.75.75 0 00-1.5 0v3c0 .414.336.75.75.75h2a.75.75 0 000-1.5h-1.25v-2.25z" /></svg>
                                                    </div>

