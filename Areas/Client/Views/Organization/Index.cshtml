                                            </span>

                                            <span class="soft-badge @(user.IsActive
                                                                                                  ? "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-500/20"
                                                                                                  : "bg-rose-50 text-rose-700 ring-1 ring-rose-200 dark:bg-rose-500/10 dark:text-rose-300 dark:ring-rose-500/20")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>

                                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                                                Added @user.CreatedAt.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                                }

                            @if (!Model.Users.Any())
                            {
                                <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-800/40 dark:text-slate-400">
                                    No users found.
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.ActiveTab == "audit")
                {
                    <div class="settings-card overflow-hidden">
                        <div class="border-b border-slate-200/80 px-6 py-5 dark:border-slate-800">
                            <h2 class="section-title">Audit Log</h2>
                            <p class="section-subtitle mt-1">A timeline of organization activity and system changes.</p>
                        </div>

                        <div class="px-6 py-6">
                            @if (Model.AuditEntries.Any())
                            {
                                <ul role="list" class="space-y-1">
                                    @for (int i = 0; i < Model.AuditEntries.Count; i++)
                                    {
                                        var entry = Model.AuditEntries[i];
                                        var isLast = i == Model.AuditEntries.Count - 1;

                                        <li class="relative pl-12">
                                            @if (!isLast)
                                            {
                                                <span class="timeline-line" aria-hidden="true"></span>
                                            }

                                            <span class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-white text-emerald-600 ring-4 ring-emerald-50 dark:bg-slate-900 dark:text-emerald-400 dark:ring-emerald-500/10">
                                                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                                            </span>

                                            <div class="mb-5 rounded-3xl bg-slate-50/80 p-4 ring-1 ring-slate-200 dark:bg-slate-800/40 dark:ring-slate-700/80">
                                                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                                    <div class="min-w-0">
                                                        <p class="text-sm text-slate-600 dark:text-slate-300">
                                                            @entry.Message
                                                            <span class="font-bold text-slate-900 dark:text-white">(@entry.EntityType)</span>
                                                        </p>
                                                        <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">
                                                            @entry.ActionType • by @entry.UserId
                                                        </p>
                                                    </div>

                                                    <div class="whitespace-nowrap text-xs font-semibold text-slate-500 dark:text-slate-400">
                                                        <time datetime="@entry.CreatedAt.ToString("o")">@entry.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</time>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-800/40 dark:text-slate-400">
                                    No activity recorded.
                                </div>
                            }
                        </div>
                    </div>
                }
            </main>
        </div>
    </div>
</div>

<script>
    (function () {
        function toggleReadonlyAppearance(field, editing) {
            // Handle file inputs separately as they don't have the floating-field wrapper
            if (field.type === 'file') {
                field.disabled = !editing;
                return;
            }

            const wrapper = field.closest('.floating-field');
            if (!wrapper) return;

            wrapper.classList.toggle('readonly-field', !editing);
            field.readOnly = !editing;
        }

        function setEditing(form, editing) {
            const fields = form.querySelectorAll('[data-edit-field]');
            fields.forEach(function (field) {
                toggleReadonlyAppearance(field, editing);
            });

            var editTrigger = form.querySelector('[data-edit-start]');
            var editActions = form.querySelector('[data-edit-actions]');

            if (editTrigger) editTrigger.classList.toggle('hidden', editing);
            if (editActions) editActions.classList.toggle('hidden', !editing);
        }

        function initOrgSettingsForms() {
            var forms = document.querySelectorAll('.org-settings-form');

            // Attach skeleton loader to nav pills
            var navPills = document.querySelectorAll('.nav-pill[data-nav]');
            navPills.forEach(function (pill) {
                // To avoid duplicate listeners, we can clone and replace, 
                // OR we can rely on a data attribute to check if initialized.
                // Cloning is safer for removing old anonymous listeners but tricky if other things depend on the element reference.
                // Given this is a simple page, cloning works.
                
                // IMPORTANT: Since `softNav` attaches listeners to `document`, we don't need to worry about losing IT's listener 
                // because it uses delegation. But we want OUR listener to run first or alongside.
                
                // However, replacing the element might break if some other script attached a direct listener.
                // Let's just add the listener and use a flag to prevent adding it multiple times.
                
                if (pill.dataset.skeletonInitialized) return;
                pill.dataset.skeletonInitialized = "true";
                
                pill.addEventListener('click', function (e) {
                     // Check if this is a modified click (ctrl/meta) - let default browser behavior handle it
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                    
                    // Inject skeleton content immediately
                    var mainCol = document.querySelector('.xl\\:col-span-9');
                    if (mainCol) {
                        mainCol.innerHTML = `
                            <div class="settings-card overflow-hidden animate-pulse">
                                <div class="border-b border-slate-200/80 px-6 py-5 dark:border-slate-800">
                                    <div class="h-5 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                                    <div class="mt-2 h-4 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
                                </div>
                                <div class="px-6 py-6 space-y-8">
                                    <div class="grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
                                         <div class="space-y-2">
                                            <div class="h-4 w-32 rounded bg-slate-200 dark:bg-slate-700"></div>
                                            <div class="h-3 w-48 rounded bg-slate-200 dark:bg-slate-700"></div>
                                         </div>
                                         <div class="upload-box rounded-3xl p-5 h-32 bg-slate-50 dark:bg-slate-800/50"></div>
                                    </div>
                                    <div class="border-t border-slate-200/80 pt-8 dark:border-slate-800 grid gap-8 sm:grid-cols-2">
                                        <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                        <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                        <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 sm:col-span-2"></div>
                                        <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                        <div class="h-14 rounded-2xl bg-slate-100 dark:bg-slate-800"></div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                    
                    // Set active state on sidebar visually immediately
                    // We need to re-query pills because the node list 'navPills' is static from earlier
                    var allPills = document.querySelectorAll('.nav-pill[data-nav]');
                    
                    allPills.forEach(p => {
                         // Remove active classes
                         p.classList.remove('bg-emerald-50', 'text-emerald-900', 'font-semibold', 'shadow-sm', 'ring-1', 'ring-emerald-200', 'dark:bg-emerald-500/10', 'dark:text-emerald-300', 'dark:ring-emerald-500/20');
                         // Add inactive classes
                         p.classList.add('text-slate-500', 'hover:bg-white', 'hover:text-slate-800', 'dark:text-slate-400', 'dark:hover:bg-slate-800/70', 'dark:hover:text-slate-200');
                    });
                    
                    // Activate current pill
                    pill.classList.remove('text-slate-500', 'hover:bg-white', 'hover:text-slate-800', 'dark:text-slate-400', 'dark:hover:bg-slate-800/70', 'dark:hover:text-slate-200');
                    pill.classList.add('bg-emerald-50', 'text-emerald-900', 'font-semibold', 'shadow-sm', 'ring-1', 'ring-emerald-200', 'dark:bg-emerald-500/10', 'dark:text-emerald-300', 'dark:ring-emerald-500/20');
                });
            });

            forms.forEach(function (form) {
                // Attach save loading animation
                // Check if listener attached
                if (form.dataset.submitListenerAttached) return;
                form.dataset.submitListenerAttached = "true";
                
                form.addEventListener('submit', function() {
                    var saveBtn = form.querySelector('button[type="submit"]');
                    if (saveBtn && !saveBtn.disabled) {
                        saveBtn.disabled = true;
                        // Keep width to avoid layout shift
                        saveBtn.style.minWidth = saveBtn.offsetWidth + 'px';
                        saveBtn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Saving...`;
                    }
                });

                const fields = form.querySelectorAll('[data-edit-field]');
                fields.forEach(function (field) {
                    toggleReadonlyAppearance(field, false);
                });

                var editBtn = form.querySelector('[data-edit-start]');
                var cancelBtn = form.querySelector('[data-edit-cancel]');

                if (editBtn) {
                    // Remove existing listeners to prevent duplicates if function runs multiple times
                    var newEditBtn = editBtn.cloneNode(true);
                    editBtn.parentNode.replaceChild(newEditBtn, editBtn);
                    editBtn = newEditBtn;

                    editBtn.addEventListener('click', function () {
                        setEditing(form, true);
                    });
                }

                if (cancelBtn) {
                    // Remove existing listeners
                    var newCancelBtn = cancelBtn.cloneNode(true);
                    cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);
                    cancelBtn = newCancelBtn;

                    cancelBtn.addEventListener('click', function () {
                        form.reset();

                        var fileField = form.querySelector('input[type="file"]');
                        if (fileField) fileField.value = '';

                        setEditing(form, false);
                    });
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initOrgSettingsForms);
        } else {
            initOrgSettingsForms();
        }
    })();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
