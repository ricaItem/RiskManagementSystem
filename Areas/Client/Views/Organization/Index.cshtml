                                                <div class="rounded-2xl bg-white/80 p-4 ring-1 ring-slate-200 dark:bg-slate-900/50 dark:ring-slate-700">
                                                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Interval</p>
