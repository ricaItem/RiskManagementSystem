                                                                <form method="post" asp-action="CancelScheduledDowngrade" asp-controller="Organization" asp-area="Client">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="ghost-btn">Cancel downgrade</button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-800/40 dark:text-slate-400">
                                        No active subscription found.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Plans -->
