                                    {
                                        <div class="relative flex flex-col rounded-3xl border p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg @(plan.IsCurrent ? "plan-card-current" : "border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/60")">
