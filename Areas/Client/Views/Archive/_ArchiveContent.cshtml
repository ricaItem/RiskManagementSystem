@model IEnumerable<Web_Sentro.Areas.Client.Controllers.ArchivedEmployeeVm>

<div class="animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-6 duration-700">
    @if (TempData["Alert"] != null)
    {
        var isSuccess = string.Equals(TempData["AlertType"]?.ToString(), "success", StringComparison.OrdinalIgnoreCase);
        var toastBg = isSuccess ? "bg-emerald-500" : "bg-rose-500";
        var toastIcon = isSuccess
            ? "<path d=\"M5 13l4 4L19 7\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />"
            : "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />";
        <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
            <div class="@toastBg text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">@Html.Raw(toastIcon)</svg>
                <span class="text-xs font-black uppercase tracking-widest">@TempData["Alert"]</span>
            </div>
        </div>
    }

    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                System Archive
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Archived items & history</p>
        </div>
        <div class="text-right">
            <span class="inline-flex items-center rounded-md bg-rose-50 px-2 py-1 text-xs font-medium text-rose-600 ring-1 ring-inset ring-rose-600/10 dark:bg-rose-900/20 dark:text-rose-400 dark:ring-rose-500/20">
                @Model.Count() Archived Items
            </span>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" /></svg>
                </span>
                <input type="text" id="logSearch" placeholder="Search by Name, Email, Role..."
                       class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg pl-10 pr-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all placeholder:text-slate-400">
            </div>

            <div class="md:col-span-3">
                <select id="severityFilter" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-600 dark:text-slate-300">
                    <option value="">All Categories</option>
                    <option value="Employee">Employee</option>
                </select>
            </div>

            <div class="md:col-span-3">
                <input type="date" id="dateFilter" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-600 dark:text-slate-300">
            </div>

            <div class="md:col-span-1">
                <button onclick="resetLogs()" class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-lg hover:bg-slate-200 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/20">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Archive List</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 text-xs font-medium text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3 font-medium">Reference</th>
                        <th class="px-6 py-3 font-medium">Employee & Details</th>
                        <th class="px-6 py-3 font-medium">Role</th>
                        <th class="px-6 py-3 font-medium">Archived On</th>
                        <th class="px-6 py-3 font-medium text-right">Actions</th>
                    </tr>
                </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-20 text-center">
                            <div class="flex flex-col items-center opacity-20">
                                <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                <p class="text-xs font-medium uppercase tracking-widest">Archive is empty</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="archive-row hover:bg-rose-50/30 dark:hover:bg-rose-500/5 transition-colors group" data-category="Employee">
                        <td class="px-6 py-4">
                            <div class="text-xs font-medium text-slate-500">@(item.UserId.Length > 8 ? item.UserId.Substring(0, 8) + "…" : item.UserId)</div>
                            <div class="text-[10px] font-medium uppercase px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 w-fit mt-1">@item.Module</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-medium text-slate-900 dark:text-white">@item.Name</div>
                            <div class="text-xs text-slate-500">@item.Email</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-xs font-medium text-slate-700 dark:text-slate-300 uppercase">@item.Role</div>
                        </td>
                        <td class="px-6 py-4 text-xs font-medium text-rose-600/70">
                            @item.CreatedAt.ToString("dd MMM yyyy")
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex justify-end gap-2">
                                <button type="button" class="btn-restore-archive inline-flex items-center rounded-md bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-100 ring-1 ring-inset ring-emerald-600/10 dark:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-500/20 dark:ring-emerald-500/20 transition-all"
                                        data-user-id="@item.UserId"
                                        data-user-name="@item.Name">
                                    Restore
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="noResultsRow" style="display: none;">
                    <td colspan="5" class="px-6 py-20 text-center">
                        <div class="flex flex-col items-center opacity-20">
                            <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <p class="text-xs font-medium uppercase tracking-widest">No matching items found</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Restore confirmation modal -->
<div id="restoreModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[70] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-2xl shadow-xl p-6 border border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Restore Employee</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
            Are you sure you want to restore <strong id="restoreModalName" class="text-slate-900 dark:text-white"></strong>? They will reappear in Employee records with status <span class="text-emerald-600 font-medium">Active</span>.
        </p>
        <div class="flex gap-3 justify-end">
            <button type="button" id="restoreModalCancel" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors">Cancel</button>
            <button type="button" id="restoreModalConfirm" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition-colors">Confirm Restore</button>
        </div>
    </div>
</div>

<!-- Hidden form for restore (submitted after confirmation) -->
<form id="restoreForm" action="@Url.Action("RestoreEmployee", "Archive", new { area = "Client" })" method="post" class="hidden">
    
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="restoreEmployeeId" />
</form>

<script>
    (function () {
        const toast = document.getElementById('toastAlert');
        if (toast) {
            toast.style.transition = 'opacity 0.4s ease';
            setTimeout(function () {
                toast.style.opacity = '0';
                setTimeout(function () { toast.style.display = 'none'; }, 400);
            }, 4000);
        }
    })();

    const searchInput = document.getElementById('logSearch');
    const categoryFilter = document.getElementById('severityFilter');
    const dateFilter = document.getElementById('dateFilter');
    const noResultsRow = document.getElementById('noResultsRow');
    const tableRows = document.querySelectorAll('tbody tr.archive-row');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedCategory = categoryFilter.value.toLowerCase();
        const selectedDate = dateFilter.value;

        let visibleCount = 0;

        tableRows.forEach(row => {
            const category = (row.getAttribute('data-category') || '').toLowerCase();
            const detailsCell = row.querySelector('td:nth-child(2)');
            const roleCell = row.querySelector('td:nth-child(3)');
            const searchableText = [detailsCell, roleCell].map(c => c ? c.textContent : '').join(' ').toLowerCase();
            const archivedOn = row.querySelector('td:nth-child(4)') ? row.querySelector('td:nth-child(4)').textContent.trim() : '';

            const matchesSearch = !searchTerm || searchableText.includes(searchTerm);
            const matchesCategory = !selectedCategory || category === selectedCategory;
            const matchesDate = !selectedDate || formatDateToMatch(archivedOn).includes(selectedDate);

            if (matchesSearch && matchesCategory && matchesDate) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        noResultsRow.style.display = (visibleCount === 0) ? '' : 'none';
    }

    function formatDateToMatch(dateString) {
        if (!dateString) return "";
        const date = new Date(dateString);
        return isNaN(date.getTime()) ? "" : date.toISOString().split('T')[0];
    }

    searchInput.addEventListener('input', filterTable);
    categoryFilter.addEventListener('change', filterTable);
    dateFilter.addEventListener('input', filterTable);

    function resetLogs() {
        document.getElementById('logSearch').value = '';
        document.getElementById('severityFilter').selectedIndex = 0;
        document.getElementById('dateFilter').value = '';

        const event = new Event('input');
        document.getElementById('logSearch').dispatchEvent(event);
    }

    function openRestoreModal(userId, userName) {
        document.getElementById('restoreEmployeeId').value = userId;
        document.getElementById('restoreModalName').textContent = userName || 'this employee';
        const overlay = document.getElementById('restoreModalOverlay');
        overlay.classList.remove('hidden');
        setTimeout(function () { overlay.classList.add('opacity-100'); }, 10);
    }

    function closeRestoreModal() {
        const overlay = document.getElementById('restoreModalOverlay');
        overlay.classList.remove('opacity-100');
        setTimeout(function () { overlay.classList.add('hidden'); }, 300);
    }

    document.querySelectorAll('.btn-restore-archive').forEach(function (btn) {
        btn.addEventListener('click', function () {
            openRestoreModal(this.getAttribute('data-user-id'), this.getAttribute('data-user-name'));
        });
    });

    document.getElementById('restoreModalCancel').addEventListener('click', closeRestoreModal);
    document.getElementById('restoreModalConfirm').addEventListener('click', function () {
        document.getElementById('restoreForm').submit();
    });
</script>
