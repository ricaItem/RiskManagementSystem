@{
    ViewData["Title"] = "System Archive";
    Layout = "_LayoutClient";
}

<div id="archive-skeleton" class="animate-pulse min-h-screen space-y-6">

    <!-- Header Section Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <div class="h-8 w-48 bg-slate-200 rounded-md dark:bg-slate-700"></div>
            <div class="h-4 w-64 bg-slate-100 rounded-md mt-2 dark:bg-slate-800"></div>
        </div>
        <div>
            <div class="h-6 w-32 bg-slate-100 rounded-full dark:bg-slate-800"></div>
        </div>
    </div>

    <!-- Filter Bar Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-3">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-3">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-1">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
        </div>
    </div>

    <!-- Table Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50">
            <div class="h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>
        <div class="p-6 space-y-4">
            <!-- Table Header -->
            <div class="flex justify-between border-b border-slate-100 pb-2 dark:border-slate-800">
                <div class="h-4 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-32 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-16 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-16 bg-slate-100 rounded dark:bg-slate-800"></div>
            </div>
            <!-- Table Rows -->
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center justify-between py-4">
                    <div class="space-y-1 w-1/6">
                        <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-2 w-12 bg-slate-50 rounded dark:bg-slate-900"></div>
                    </div>
                    <div class="space-y-1 w-1/4">
                        <div class="h-3 w-32 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-2 w-40 bg-slate-50 rounded dark:bg-slate-900"></div>
                    </div>
                    <div class="h-3 w-16 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-6 w-16 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
                </div>
                @if (i < 4)
                {
                    <div class="border-b border-slate-50 dark:border-slate-800"></div>
                }
            }
        </div>
    </div>
</div>

<div id="archive-content" class="hidden"></div>

<script>
    function initArchivePage() {
        const contentDiv = document.getElementById('archive-content');
        if (!contentDiv || contentDiv.dataset.loaded === '1') return;

        fetch('@Url.Action("ArchiveContent", "Archive", new { area = "Client" })')
            .then(response => {
                if (!response.ok) {
                    throw new Error(`ArchiveContent request failed: ${response.status}`);
                }
                return response.text();
            })
            .then(html => {
                contentDiv.innerHTML = html;

                const scripts = Array.from(contentDiv.getElementsByTagName('script'));
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                    } else {
                        newScript.text = oldScript.innerText;
                    }
                    document.body.appendChild(newScript);
                });

                const skeleton = document.getElementById('archive-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.dataset.loaded = '1';
            })
            .catch(error => {
                console.error('Error fetching archive content:', error);
                const skeleton = document.getElementById('archive-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.innerHTML = '<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-300">Failed to load Archive content. Please refresh the page.</div>';
                contentDiv.dataset.loaded = '1';
            });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initArchivePage);
    } else {
        initArchivePage();
    }
</script>
