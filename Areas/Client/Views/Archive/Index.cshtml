@model IEnumerable<dynamic>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "System Archive";
}

<div class="max-w-full mx-auto space-y-6 animate-in fade-in duration-700">
    <div class="flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight">System <span class="text-rose-600">Archive</span></h1>
        </div>
        <div class="text-right">
            <span class="bg-rose-100 dark:bg-rose-900/30 text-rose-600 text-[10px] font-black px-3 py-1 rounded-full uppercase">
                @Model.Count() Archived Items
            </span>
        </div>
    </div>


    <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 backdrop-blur-md mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2.5" stroke-linecap="round" /></svg>
                </span>
                <input type="text" id="logSearch" placeholder="Search by Category, Project Details..."
                       class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500 transition-all">
            </div>

            <div class="md:col-span-3">
                <select id="severityFilter" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Categories</option>
                    <option value="success">Expense</option>
                    <option value="warning">Employee</option>
                    <option value="critical">Risk</option>
                    <option value="critical">Supplier</option>
                </select>
            </div>

            <div class="md:col-span-3">
                <input type="date" id="dateFilter" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="md:col-span-1">
                <button onclick="resetLogs()" class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-xl hover:bg-slate-200 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <table class="w-full text-left">
            <thead>
                <tr class="text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100 dark:border-slate-800">
                    <th class="px-6 py-4">Original ID</th>
                    <th class="px-6 py-4">Project & Details</th>
                    <th class="px-6 py-4">Financials</th>
                    <th class="px-6 py-4">Deleted On</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-20 text-center">
                            <div class="flex flex-col items-center opacity-20">
                                <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                <p class="text-xs font-black uppercase tracking-widest">Archive is empty</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-rose-50/20 dark:hover:bg-rose-500/5 transition-all group">
                        <td class="px-6 py-5">
                            <div class="text-[10px] font-black text-slate-400">#@item.Id</div>
                            <div class="text-[9px] font-black uppercase px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 w-fit">Expense</div>
                        </td>
                        <td class="px-6 py-5">
                            <div class="font-black text-slate-900 dark:text-white text-xs">@item.ProjectName</div>
                            <div class="text-[10px] font-bold text-slate-400">@item.Vendor - @item.Description</div>
                        </td>
                        <td class="px-6 py-5">
                            <div class="font-black text-slate-700 dark:text-slate-300">$@item.Amount.ToString("N2")</div>
                        </td>
                        <td class="px-6 py-5 text-[11px] font-bold text-rose-500/70">
                            @item.DeletedAt?.ToString("dd MMM yyyy, HH:mm")
                        </td>
                        <td class="px-6 py-5 text-right">
                            <div class="flex justify-end gap-2">
                                <form asp-controller="Archive" asp-action="Restore" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="bg-emerald-500/10 hover:bg-emerald-500 text-emerald-600 hover:text-white px-4 py-1.5 rounded-xl text-[10px] font-black uppercase transition-all">
                                        Restore
                                    </button>
                                </form>

                                <form asp-controller="Archive" asp-action="PermanentDelete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('WARNING: This action cannot be undone. Permanent delete?')">
                                    <button type="submit" class="p-2 text-slate-300 hover:text-rose-600 transition-all">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="5" class="px-6 py-20 text-center">
                            <div class="flex flex-col items-center opacity-20">
                                <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <p class="text-xs font-black uppercase tracking-widest">No matching items found</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('logSearch');
        const categoryFilter = document.getElementById('severityFilter');
        const dateFilter = document.getElementById('dateFilter');
        const noResultsRow = document.getElementById('noResultsRow');

        const tableRows = document.querySelectorAll('tbody tr:not(#noResultsRow)');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const selectedCategory = categoryFilter.options[categoryFilter.selectedIndex].text.toLowerCase();
            const selectedDate = dateFilter.value;

            let visibleCount = 0;

            tableRows.forEach(row => {
                const categoryElement = row.querySelector('td:nth-child(1) div:last-child');
                const category = categoryElement ? categoryElement.textContent.toLowerCase().trim() : "";

                const projectDetails = row.querySelector('td:nth-child(2)') ? row.querySelector('td:nth-child(2)').textContent.toLowerCase() : "";

                const deletedOn = row.querySelector('td:nth-child(4)') ? row.querySelector('td:nth-child(4)').textContent.trim() : "";

                const matchesSearch = projectDetails.includes(searchTerm);
                const matchesCategory = selectedCategory === "all categories" || category === selectedCategory;
                const matchesDate = !selectedDate || formatDateToMatch(deletedOn).includes(selectedDate);

                if (matchesSearch && matchesCategory && matchesDate) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            noResultsRow.style.display = (visibleCount === 0) ? '' : 'none';
        }

        function formatDateToMatch(dateString) {
            if (!dateString) return "";
            const date = new Date(dateString);
            return isNaN(date.getTime()) ? "" : date.toISOString().split('T')[0];
        }

        searchInput.addEventListener('input', filterTable);
        categoryFilter.addEventListener('change', filterTable);
        dateFilter.addEventListener('input', filterTable);
    });

    function resetLogs() {
        document.getElementById('logSearch').value = '';
        document.getElementById('severityFilter').selectedIndex = 0;
        document.getElementById('dateFilter').value = '';

        const event = new Event('input');
        document.getElementById('logSearch').dispatchEvent(event);
    }
</script>