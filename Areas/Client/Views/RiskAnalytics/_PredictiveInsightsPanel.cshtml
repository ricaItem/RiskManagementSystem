@using WEB_Sentro.Areas.Client.Models
@model RiskAnalyticsViewModel
@{
    var insights = Model?.PredictiveInsights;
}
<section aria-label="Predictive insights">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/20 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Predictive Insights</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Forward-looking signals based on trends and monitoring data</p>
            </div>
            <a href="#" class="inline-flex items-center gap-1.5 text-xs font-medium text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
                Learn more
            </a>
        </div>
        
        <div class="grid gap-px bg-slate-100 dark:bg-slate-800 sm:grid-cols-2 lg:grid-cols-3">
            @* Card 1: Risk Escalation *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Escalation Forecast</span>
                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">7 days</span>
                </div>
                <div class="space-y-3">
                    <div class="flex items-baseline gap-2">
                         <span class="text-2xl font-bold text-slate-900 dark:text-white">@(insights?.EscalationHigh ?? 0)</span>
                         <span class="text-sm font-medium text-rose-600 dark:text-rose-400">High Risk Candidates</span>
                    </div>
                    <div class="flex gap-4 text-xs text-slate-500 dark:text-slate-400">
                        <span>Medium: <strong class="text-slate-700 dark:text-slate-200">@(insights?.EscalationMedium ?? 0)</strong></span>
                        <span>Low: <strong class="text-slate-700 dark:text-slate-200">@(insights?.EscalationLow ?? 0)</strong></span>
                    </div>
                    <p class="text-xs text-slate-400 dark:text-slate-500">@(insights?.EscalationHint ?? "Top candidates will appear here")</p>
                </div>
            </div>

            @* Card 2: Flood Probability *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Flood Probability</span>
                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">Site-based</span>
                </div>
                <div class="space-y-3">
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold text-slate-900 dark:text-white">@(insights?.FloodProbabilityPercent.HasValue == true ? insights.FloodProbabilityPercent + "%" : "—%")</span>
                         <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Index</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 dark:bg-slate-800 overflow-hidden">
                        <div class="h-2 rounded-full @(insights?.FloodProbabilityPercent > 75 ? "bg-rose-500" : insights?.FloodProbabilityPercent > 50 ? "bg-amber-500" : "bg-emerald-500")" style="width: @(insights?.FloodProbabilityPercent ?? 0)%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-400 uppercase font-bold tracking-wider">
                        <span>Low</span>
                        <span>Moderate</span>
                        <span>High</span>
                        <span>Critical</span>
                    </div>
                </div>
            </div>

            @* Card 3: Momentum *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Risk Momentum</span>
                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">Rolling</span>
                </div>
                <div class="space-y-4">
                    @{ var momentum = (insights?.MomentumStatus ?? "Stable").ToLowerInvariant(); }
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-slate-900 dark:text-white">Current State</span>
                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium @(momentum == "stable" ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300" : momentum == "watchlist" ? "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300" : "bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-300")">
                            <span class="h-1.5 w-1.5 rounded-full @(momentum == "stable" ? "bg-emerald-500" : momentum == "watchlist" ? "bg-amber-500" : "bg-rose-500")"></span>
                            @(insights?.MomentumStatus ?? "Stable")
                        </span>
                    </div>
                    <div class="flex rounded-lg bg-slate-100 p-1 dark:bg-slate-800">
                        <div class="flex-1 rounded py-1 text-center text-[10px] font-bold uppercase tracking-wider transition-all @(momentum == "stable" ? "bg-white text-emerald-600 shadow-sm dark:bg-slate-700 dark:text-emerald-400" : "text-slate-400")">Stable</div>
                        <div class="flex-1 rounded py-1 text-center text-[10px] font-bold uppercase tracking-wider transition-all @(momentum == "watchlist" ? "bg-white text-amber-600 shadow-sm dark:bg-slate-700 dark:text-amber-400" : "text-slate-400")">Watch</div>
                        <div class="flex-1 rounded py-1 text-center text-[10px] font-bold uppercase tracking-wider transition-all @(momentum == "escalating" ? "bg-white text-rose-600 shadow-sm dark:bg-slate-700 dark:text-rose-400" : "text-slate-400")">Escalating</div>
                    </div>
                </div>
            </div>

            @* Card 4: Cost Forecast *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Cost Exposure</span>
                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">30 days</span>
                </div>
                 <div class="space-y-2">
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-bold text-slate-900 dark:text-white">@(insights?.CostForecastAmount.HasValue == true ? "₱" + insights.CostForecastAmount.Value.ToString("N0") : "—")</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Projected impact based on risk-linked expenses and probability.</p>
                </div>
            </div>

            @* Card 5: Closure Estimates *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Resolution Time</span>
                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">Forecast</span>
                </div>
                <div class="space-y-3">
                    @foreach (var row in (insights?.ClosureBySeverity ?? new List<ClosureBySeverityRowViewModel> { new() { Severity = "Critical" }, new() { Severity = "High" } }).Take(2))
                    {
                        <div class="flex items-center justify-between text-sm">
                            <span class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                                <span class="h-1.5 w-1.5 rounded-full @(row.Severity == "Critical" ? "bg-rose-500" : "bg-amber-500")"></span>
                                @row.Severity
                            </span>
                            <span class="font-medium text-slate-900 dark:text-white">@(row.EtaWindow ?? "—")</span>
                        </div>
                    }
                     <div class="pt-2 border-t border-slate-50 dark:border-slate-800">
                        <a href="#" class="text-xs font-medium text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300">View all severities &rarr;</a>
                    </div>
                </div>
            </div>

            @* Card 6: Early Warnings *@
            <div class="bg-white p-6 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Early Warnings</span>
                    <span class="flex h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
                </div>
                 <ul class="space-y-3">
                    @{
                        var warnings = insights?.EarlyWarnings ?? new List<EarlyWarningRowViewModel>();
                    }
                    @foreach (var w in warnings.Take(3))
                    {
                        <li class="flex items-start gap-3">
                             @if (w.IsWarning)
                            {
                                <svg class="h-4 w-4 shrink-0 text-amber-500 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4 shrink-0 text-emerald-500 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            }
                            <div>
                                <p class="text-sm font-medium text-slate-900 dark:text-white">@w.Title</p>
                                @if (w.StatusPill != null)
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Status: @w.StatusPill</p>
                                }
                            </div>
                        </li>
                    }
                 </ul>
            </div>
        </div>
    </div>
</section>
}