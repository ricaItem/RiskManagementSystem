@using Microsoft.AspNetCore.Mvc.Rendering
@using WEB_Sentro.Areas.Client.Models
@model RiskAnalyticsViewModel
@{
    ViewData["Title"] = "Risk Analytics";
    Layout = "_LayoutClient";
    var lastUpdated = Model?.LastUpdatedHumanized ?? "Just now";
    var sites = Model?.Sites ?? new List<SelectListItem>();
    var categories = Model?.Categories ?? new List<SelectListItem>();
    var qSource = Context.Request.Query["source"].FirstOrDefault() ?? "all";
    var qStatus = Context.Request.Query["status"].FirstOrDefault() ?? "all";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-1000 relative" id="risk-analytics-root">
    
    @* ---------- Header ---------- *@
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Risk Analytics
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Multi-site risk performance, mitigation effectiveness, and trends.</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-slate-400 dark:text-slate-500">Last updated: @lastUpdated</span>
            <button type="button" id="btn-print" class="rounded-lg bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700 dark:hover:bg-slate-700/80 transition-all">
                Print Report
            </button>
            <button type="button" id="btn-export" class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:hover:bg-indigo-400 transition-all">
                Export Data
            </button>
        </div>
    </div>

    @* ---------- Filters Card ---------- *@
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 relative overflow-hidden">
        <div class="flex flex-wrap items-end gap-6">
            <div class="space-y-1.5">
                <label for="filter-date-range" class="text-xs font-medium text-slate-500 dark:text-slate-400">Time Period</label>
                <select id="filter-date-range" name="dateRange" class="block w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 min-w-[140px]">
                    <option value="7" @(Context.Request.Query["dateRange"] == "7" ? "selected" : "")>Last 7 days</option>
                    <option value="30" @(Context.Request.Query["dateRange"] != "7" && Context.Request.Query["dateRange"] != "90" ? "selected" : "")>Last 30 days</option>
                    <option value="90" @(Context.Request.Query["dateRange"] == "90" ? "selected" : "")>Last 90 days</option>
                </select>
            </div>
            
            <div class="space-y-1.5">
                <label for="filter-site" class="text-xs font-medium text-slate-500 dark:text-slate-400">Site</label>
                <select id="filter-site" name="siteId" class="block w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 min-w-[160px]">
                    <option value="">All Sites</option>
                    @foreach (var s in sites.Where(x => !string.IsNullOrEmpty(x.Value)))
                    {
                        <option value="@s.Value" @(Context.Request.Query["siteId"] == s.Value ? "selected" : "")>@s.Text</option>
                    }
                </select>
            </div>

            <div class="space-y-1.5">
                <label for="filter-category" class="text-xs font-medium text-slate-500 dark:text-slate-400">Risk Category</label>
                <select id="filter-category" name="category" class="block w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 min-w-[160px]">
                    <option value="">All Categories</option>
                    @foreach (var c in categories.Where(x => !string.IsNullOrEmpty(x.Value)))
                    {
                        <option value="@c.Value" @(Context.Request.Query["category"] == c.Value ? "selected" : "")>@c.Text</option>
                    }
                </select>
            </div>

            <div class="space-y-1.5 hidden sm:block">
                 <label class="text-xs font-medium text-slate-500 dark:text-slate-400">Source</label>
                 <div class="flex rounded-lg bg-slate-100 p-1 dark:bg-slate-800" role="group">
                    <button type="button" class="segment-btn rounded-md px-3 py-1.5 text-xs font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 @(qSource == "all" ? "bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white" : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200")" data-segment="source" data-value="all">All</button>
                    <button type="button" class="segment-btn rounded-md px-3 py-1.5 text-xs font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 @(qSource == "manual" ? "bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white" : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200")" data-segment="source" data-value="manual">Manual</button>
                    <button type="button" class="segment-btn rounded-md px-3 py-1.5 text-xs font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 @(qSource == "weather" ? "bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white" : "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200")" data-segment="source" data-value="weather">Weather</button>
                </div>
            </div>

            <div class="ml-auto">
                <button type="button" id="btn-refresh" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-600 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 transition-all">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    @* ---------- Content ---------- *@
    <main id="content-main" class="space-y-8">
        
        @* ---------- KPI Cards ---------- *@
        <section aria-label="Key metrics">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
                @{
                    var kpiList = Model?.Kpis?.KpiCards ?? new List<KpiCardViewModel>();
                }
                @foreach (var k in kpiList)
                {
                    <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-900/40">
                        <dt class="truncate text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">@k.Label</dt>
                        <dd class="mt-2 flex items-baseline gap-2">
                            <span class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">@k.Value</span>
                            <span class="text-xs font-medium @(k.DeltaUp ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                                @(string.IsNullOrEmpty(k.DeltaText) ? "—" : k.DeltaText)
                            </span>
                        </dd>
                    </div>
                }
            </div>
        </section>

        @* ---------- Charts Section ---------- *@
        <section aria-label="Charts" class="grid gap-6 lg:grid-cols-12">
            @* Risks Over Time *@
            <div class="lg:col-span-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Risk Trends</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">New risks identified over time</p>
                    </div>
                </div>
                <div class="h-72 w-full">
                    <canvas id="canvas-risks-over-time" aria-label="Line chart of risks over time"></canvas>
                </div>
            </div>

            @* Category Distribution *@
            <div class="lg:col-span-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Risk Categories</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Distribution by type</p>
                    </div>
                </div>
                <div class="h-72 w-full">
                    <canvas id="canvas-risks-by-category" aria-label="Bar chart of risks by category"></canvas>
                </div>
            </div>
        </section>

        @* ---------- Mitigation Effectiveness ---------- *@
        <section aria-label="Mitigation effectiveness" class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/20">
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Mitigation Effectiveness</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Impact of control measures on risk scores</p>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-slate-100 dark:divide-slate-800">
                <div class="p-6">
                    <div class="grid grid-cols-2 gap-6 mb-6">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Initial Score</p>
                            <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-white">@(Model?.Mitigation?.AvgInitialScore ?? 0)</p>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Residual Score</p>
                            <p class="mt-1 text-3xl font-bold text-emerald-600 dark:text-emerald-400">@(Model?.Mitigation?.AvgResidualScore ?? 0)</p>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-xs font-medium mb-1">
                                <span class="text-slate-600 dark:text-slate-300">Reduction</span>
                                <span class="text-emerald-600 dark:text-emerald-400">@(Model?.Mitigation?.AvgReductionPercent ?? 0)%</span>
                            </div>
                            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800">
                                <div class="h-2 rounded-full bg-emerald-500" style="width: @(Model?.Mitigation?.AvgReductionPercent ?? 0)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-medium mb-1">
                                <span class="text-slate-600 dark:text-slate-300">Reassessed</span>
                                <span class="text-indigo-600 dark:text-indigo-400">@(Model?.Mitigation?.ReassessedPercent ?? 0)%</span>
                            </div>
                            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800">
                                <div class="h-2 rounded-full bg-indigo-500" style="width: @(Model?.Mitigation?.ReassessedPercent ?? 0)%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-span-2 p-6">
                     <div class="h-48 w-full">
                        <canvas id="canvas-mitigation-pre-post" aria-label="Pre vs post mitigation chart"></canvas>
                    </div>
                </div>
            </div>
        </section>
        
        @await Html.PartialAsync("_PredictiveInsightsPanel")

        @* ---------- Site Ranking Table ---------- *@
        <section aria-label="Site rankings">
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/20 flex justify-between items-center">
                    <div>
                        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Site Risk Performance</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Comparative analysis across locations</p>
                    </div>
                    <div class="hidden sm:block">
                        <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-500/20">Ranked by Criticality</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500 dark:bg-slate-800/50 dark:text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-3">Site Name</th>
                                <th scope="col" class="px-6 py-3 text-center">Active Risks</th>
                                <th scope="col" class="px-6 py-3 text-center">Critical</th>
                                <th scope="col" class="px-6 py-3 text-right">Avg Score</th>
                                <th scope="col" class="px-6 py-3 text-center">Trend</th>
                                <th scope="col" class="px-6 py-3 text-right">Avg Close Time</th>
                                <th scope="col" class="px-6 py-3 text-right">On-time %</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-transparent">
                            @foreach (var row in Model?.SiteRankings ?? new List<SiteRankingRowViewModel>())
                            {
                                <tr class="group hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="px-6 py-4 font-medium text-slate-900 dark:text-white">@row.SiteName</td>
                                    <td class="px-6 py-4 text-center text-slate-600 dark:text-slate-300">@row.ActiveRisks</td>
                                    <td class="px-6 py-4 text-center">
                                        @if(row.CriticalCount > 0) {
                                            <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-1 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-600/10 dark:bg-rose-900/20 dark:text-rose-400 dark:ring-rose-500/20">@row.CriticalCount</span>
                                        } else {
                                            <span class="text-slate-400">-</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right font-medium text-slate-700 dark:text-slate-300">@row.AvgScore.ToString("F1")</td>
                                    <td class="px-6 py-4 text-center">
                                        @if(row.TrendUp) {
                                            <span class="text-rose-500" title="Risk increasing">↑</span>
                                        } else {
                                            <span class="text-emerald-500" title="Risk decreasing">↓</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right text-slate-600 dark:text-slate-400">@row.AvgCloseTimeDays d</td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <span class="text-slate-700 dark:text-slate-300">@row.OnTimeMitigationPercent%</span>
                                            <div class="w-16 h-1.5 bg-slate-100 rounded-full overflow-hidden dark:bg-slate-800">
                                                <div class="h-full @(row.OnTimeMitigationPercent > 80 ? "bg-emerald-500" : row.OnTimeMitigationPercent > 50 ? "bg-amber-500" : "bg-rose-500")" style="width: @row.OnTimeMitigationPercent%"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!(Model?.SiteRankings?.Any() ?? false))
                            {
                                <tr>
                                    <td colspan="7" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">No site data available for the selected period.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        @* ---------- Top Risks Table ---------- *@
        <section aria-label="Top risks">
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/20">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">High Priority Risks</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Items requiring immediate attention</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500 dark:bg-slate-800/50 dark:text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-3">Risk Details</th>
                                <th scope="col" class="px-6 py-3">Category</th>
                                <th scope="col" class="px-6 py-3">Severity</th>
                                <th scope="col" class="px-6 py-3">Score</th>
                                <th scope="col" class="px-6 py-3">Status</th>
                                <th scope="col" class="px-6 py-3">Owner</th>
                                <th scope="col" class="px-6 py-3">Age</th>
                                <th scope="col" class="px-6 py-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-transparent">
                            @foreach (var r in Model?.TopRisks ?? new List<TopRiskRowViewModel>())
                            {
                                <tr class="group hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col">
                                            <span class="font-medium text-slate-900 dark:text-white">@r.RiskName</span>
                                            <div class="flex items-center gap-1.5 text-xs text-slate-500 mt-0.5">
                                                <span class="font-mono">@r.RiskCode</span>
                                                <span>·</span>
                                                <span>@r.SiteName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@r.Category</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium @GetSeverityBadgeClass(r.Severity)">@r.Severity</span>
                                    </td>
                                    <td class="px-6 py-4 font-semibold text-slate-700 dark:text-slate-300">@(r.CurrentScore?.ToString("F1") ?? "-")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1.5">
                                            <span class="h-1.5 w-1.5 rounded-full @(r.Status == "Open" ? "bg-amber-500" : "bg-emerald-500")"></span>
                                            <span class="text-slate-600 dark:text-slate-300">@r.Status</span>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">
                                        <div class="flex items-center gap-2">
                                            <div class="h-6 w-6 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                                @((r.Owner ?? "U").Substring(0, 1))
                                            </div>
                                            <span>@(r.Owner ?? "Unassigned")</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">@r.DaysOpen days</td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="@Url.Action("Assess", "Risks", new { area = "Client", id = r.RiskId })" class="text-indigo-600 hover:text-indigo-900 font-medium text-xs dark:text-indigo-400 dark:hover:text-indigo-300">View</a>
                                    </td>
                                </tr>
                            }
                             @if (!(Model?.TopRisks?.Any() ?? false))
                            {
                                <tr>
                                    <td colspan="8" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">No high priority risks found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </main>
</div>

@functions {
    public static string GetSeverityBadgeClass(string? severity)
    {
        if (string.IsNullOrEmpty(severity)) return "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400";
        switch (severity.ToLowerInvariant())
        {
            case "critical": return "bg-rose-100 text-rose-700 dark:bg-rose-900/20 dark:text-rose-400";
            case "high": return "bg-amber-100 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400";
            case "medium": return "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-400";
            case "low": return "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-400";
            default: return "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400";
        }
    }
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const isDark = document.documentElement.classList.contains('dark');
        const textColor = isDark ? '#94a3b8' : '#64748b';
        const gridColor = isDark ? '#334155' : '#e2e8f0';

        const chartConfig = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: isDark ? '#1e293b' : '#ffffff',
                    titleColor: isDark ? '#f1f5f9' : '#0f172a',
                    bodyColor: isDark ? '#cbd5e1' : '#334155',
                    borderColor: isDark ? '#334155' : '#e2e8f0',
                    borderWidth: 1,
                    padding: 10,
                    cornerRadius: 8,
                    displayColors: true
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: textColor, font: { size: 10 } }
                },
                y: {
                    grid: { color: gridColor, borderDash: [4, 4] },
                    ticks: { color: textColor, font: { size: 10 } },
                    beginAtZero: true
                }
            }
        };

        // Risks Over Time
        new Chart(document.getElementById('canvas-risks-over-time'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Charts?.RisksOverTimeLabels ?? new List<string>())),
                datasets: [{
                    label: 'New Risks',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Charts?.RisksOverTimeValues ?? new List<int>())),
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79, 70, 229, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 4
                }]
            },
            options: chartConfig
        });

        // Risks by Category
        new Chart(document.getElementById('canvas-risks-by-category'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Charts?.RisksByCategoryLabels ?? new List<string>())),
                datasets: [{
                    label: 'Risks',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Charts?.RisksByCategoryValues ?? new List<int>())),
                    backgroundColor: [
                        '#4f46e5', '#0ea5e9', '#10b981', '#f59e0b', '#f43f5e', '#8b5cf6', '#ec4899', '#64748b'
                    ],
                    borderRadius: 4,
                    barThickness: 20
                }]
            },
            options: chartConfig
        });

        // Mitigation Pre/Post
        new Chart(document.getElementById('canvas-mitigation-pre-post'), {
            type: 'bar',
            data: {
                labels: ['Avg Initial', 'Avg Residual'],
                datasets: [{
                    label: 'Risk Score',
                    data: [@(Model?.Mitigation?.AvgInitialScore ?? 0), @(Model?.Mitigation?.AvgResidualScore ?? 0)],
                    backgroundColor: ['#f43f5e', '#10b981'],
                    borderRadius: 6,
                    barThickness: 40
                }]
            },
            options: {
                ...chartConfig,
                indexAxis: 'y',
                scales: {
                    x: { ...chartConfig.scales.x, max: 25 },
                    y: { ...chartConfig.scales.y, grid: { display: false } }
                }
            }
        });

        // Filter Logic
        document.getElementById('btn-refresh').addEventListener('click', function() {
            const form = document.createElement('form');
            form.method = 'GET';
            
            ['filter-date-range', 'filter-site', 'filter-category'].forEach(id => {
                const el = document.getElementById(id);
                if (el && el.value) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = el.name;
                    input.value = el.value;
                    form.appendChild(input);
                }
            });

            const sourceBtn = document.querySelector('.segment-btn[data-segment="source"][class*="bg-white"]');
            if (sourceBtn) {
                 const input = document.createElement('input');
                 input.type = 'hidden';
                 input.name = 'source';
                 input.value = sourceBtn.getAttribute('data-value');
                 form.appendChild(input);
            }

            document.body.appendChild(form);
            form.submit();
        });

        // Segment Buttons
        document.querySelectorAll('.segment-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const group = this.closest('[role="group"]');
                group.querySelectorAll('.segment-btn').forEach(b => {
                    b.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-700', 'dark:text-white');
                    b.classList.add('text-slate-500', 'hover:text-slate-900', 'dark:text-slate-400', 'dark:hover:text-slate-200');
                });
                this.classList.remove('text-slate-500', 'hover:text-slate-900', 'dark:text-slate-400', 'dark:hover:text-slate-200');
                this.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-700', 'dark:text-white');
            });
        });
    });
</script>
}