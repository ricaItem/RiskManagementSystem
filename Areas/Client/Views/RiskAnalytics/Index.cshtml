@using Microsoft.AspNetCore.Mvc.Rendering
@using WEB_Sentro.Areas.Client.Models
@model RiskAnalyticsViewModel
@{
    ViewData["Title"] = "Risk Analytics";
    Layout = "_LayoutClient";
    var lastUpdated = Model?.LastUpdatedHumanized ?? "Just now";
    var sites = Model?.Sites ?? new List<SelectListItem>();
    var categories = Model?.Categories ?? new List<SelectListItem>();
    var qSource = Context.Request.Query["source"].FirstOrDefault() ?? "all";
    var qStatus = Context.Request.Query["status"].FirstOrDefault() ?? "all";
}

<div class="min-h-screen bg-slate-50 dark:bg-slate-900/50" id="risk-analytics-root">
    @* ---------- Sticky Header + Filters ---------- *@
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur dark:border-slate-700 dark:bg-slate-900/95" id="analytics-header">
        <div class="mx-auto max-w-[1600px] px-4 py-4 sm:px-6 lg:px-8">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Risk Analytics</h1>
                    <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">Multi-site risk performance and mitigation effectiveness</p>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 lg:order-3">Last updated: @lastUpdated</p>
            </div>

            <div class="mt-4 flex flex-col gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    <select id="filter-date-range" name="dateRange" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:focus:border-emerald-400">
                        <option value="7" @(Context.Request.Query["dateRange"] == "7" ? "selected" : "")>Last 7 days</option>
                        <option value="30" @(Context.Request.Query["dateRange"] != "7" && Context.Request.Query["dateRange"] != "90" ? "selected" : "")>Last 30 days</option>
                        <option value="90" @(Context.Request.Query["dateRange"] == "90" ? "selected" : "")>Last 90 days</option>
                    </select>
                    <select id="filter-site" name="siteId" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">All Sites</option>
                        @foreach (var s in sites.Where(x => !string.IsNullOrEmpty(x.Value)))
                        {
                            <option value="@s.Value" @(Context.Request.Query["siteId"] == s.Value ? "selected" : "")>@s.Text</option>
                        }
                        @if (!sites.Any())
                        {
                            <option value="1">Site A</option>
                            <option value="2">Site B</option>
                        }
                    </select>
                    <select id="filter-category" name="category" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">All categories</option>
                        @foreach (var c in categories.Where(x => !string.IsNullOrEmpty(x.Value)))
                        {
                            <option value="@c.Value" @(Context.Request.Query["category"] == c.Value ? "selected" : "")>@c.Text</option>
                        }
                        @if (!categories.Any())
                        {
                            <option>Safety</option>
                            <option>Weather</option>
                            <option>Supply</option>
                        }
                    </select>
                    <div class="flex rounded-xl border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-600 dark:bg-slate-800" role="group" aria-label="Risk source">
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qSource == "all" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="source" data-value="all">All</button>
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qSource == "manual" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="source" data-value="manual">Manual</button>
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qSource == "weather" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="source" data-value="weather">Weather</button>
                    </div>
                    <div class="flex rounded-xl border border-slate-200 bg-slate-50 p-0.5 dark:border-slate-600 dark:bg-slate-800" role="group" aria-label="Status">
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qStatus == "all" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="status" data-value="all">All</button>
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qStatus == "open" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="status" data-value="open">Open</button>
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qStatus == "mitigated" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="status" data-value="mitigated">Mitigated</button>
                        <button type="button" class="segment-btn rounded-lg px-3 py-1.5 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 @(qStatus == "closed" ? "active bg-white shadow-sm dark:bg-slate-700" : "")" data-segment="status" data-value="closed">Closed</button>
                    </div>
                    <select id="filter-severity" name="severity" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">All severity</option>
                        <option value="low" @(Context.Request.Query["severity"] == "low" ? "selected" : "")>Low</option>
                        <option value="medium" @(Context.Request.Query["severity"] == "medium" ? "selected" : "")>Medium</option>
                        <option value="high" @(Context.Request.Query["severity"] == "high" ? "selected" : "")>High</option>
                        <option value="critical" @(Context.Request.Query["severity"] == "critical" ? "selected" : "")>Critical</option>
                    </select>
                    <input type="search" id="filter-search" placeholder="Search risk name / code…" class="min-w-[200px] rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm transition placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:placeholder:text-slate-500" />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" id="btn-refresh" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:focus:ring-offset-slate-900" aria-label="Refresh data">
                        <span aria-hidden="true">↻</span> Refresh
                    </button>
                    <div class="relative" id="export-dropdown">
                        <button type="button" id="btn-export" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700" aria-expanded="false" aria-haspopup="true">Export ▾</button>
                        <div id="export-menu" class="absolute right-0 top-full z-10 mt-1 hidden w-40 rounded-xl border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-600 dark:bg-slate-800" role="menu">
                            <button type="button" class="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700" role="menuitem">CSV</button>
                            <button type="button" class="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700" role="menuitem">PDF</button>
                        </div>
                    </div>
                    <button type="button" id="btn-print" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Print</button>
                </div>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
        @* ---------- Content (default visible) ---------- *@
        <div id="content-main">
            @* ---------- KPI Cards ---------- *@
            <section class="mb-8" aria-label="Key metrics">
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
                    @{
                        var kpiList = Model?.Kpis?.KpiCards?.Any() == true
                            ? Model.Kpis.KpiCards
                            : new List<KpiCardViewModel>
                            {
                                new() { Label = "Active Risks", Value = Model?.Kpis?.ActiveRisks ?? 0, DeltaText = "—", DeltaUp = false },
                                new() { Label = "Critical Risks", Value = Model?.Kpis?.CriticalRisks ?? 0, DeltaText = "—", DeltaUp = false },
                                new() { Label = "Created in Period", Value = Model?.Kpis?.CreatedInPeriod ?? 0, DeltaText = "—", DeltaUp = false },
                                new() { Label = "Weather-triggered", Value = Model?.Kpis?.WeatherTriggered ?? 0, DeltaText = "—", DeltaUp = false },
                                new() { Label = "Avg Time to Close (days)", Value = Model?.Kpis?.AvgTimeToCloseDays ?? 0, DeltaText = "—", DeltaUp = false },
                                new() { Label = "Avg Risk Reduction (%)", Value = Model?.Kpis?.AvgRiskReductionPercent ?? 0, DeltaText = "—", DeltaUp = false }
                            };
                    }
                    @foreach (var k in kpiList)
                    {
                        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md dark:border-slate-700 dark:bg-slate-800/80">
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">@k.Label</p>
                            <p class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">@k.Value</p>
                            <p class="mt-0.5 text-xs @(k.DeltaUp ? "text-emerald-600 dark:text-emerald-400" : "text-slate-500 dark:text-slate-400")">@(string.IsNullOrEmpty(k.DeltaText) ? "—" : k.DeltaText)</p>
                        </div>
                    }
                </div>
            </section>

            @* ---------- Charts ---------- *@
            <section class="mb-8" aria-label="Charts">
                <div class="grid gap-6 lg:grid-cols-12">
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80 lg:col-span-8">
                        <div class="flex items-center justify-between">
                            <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Risks Over Time</h2>
                            <span class="text-slate-400 dark:text-slate-500" title="Count of risks by date">ⓘ</span>
                        </div>
                        <div class="mt-3 h-64 rounded-lg bg-slate-100 dark:bg-slate-700/50" id="chart-risks-over-time">
                            <canvas id="canvas-risks-over-time" class="h-full w-full" aria-label="Line chart placeholder"></canvas>
                        </div>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80 lg:col-span-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Risks by Category</h2>
                            <span class="text-slate-400 dark:text-slate-500" title="Distribution by category">ⓘ</span>
                        </div>
                        <div class="mt-3 h-64 rounded-lg bg-slate-100 dark:bg-slate-700/50" id="chart-risks-by-category">
                            <canvas id="canvas-risks-by-category" class="h-full w-full" aria-label="Bar chart placeholder"></canvas>
                        </div>
                    </div>
                </div>
                <div class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80 lg:max-w-sm">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Open vs Closed</h2>
                        <span class="text-slate-400 dark:text-slate-500" title="Open and closed counts">ⓘ</span>
                    </div>
                    <div class="mt-3 h-48 rounded-lg bg-slate-100 dark:bg-slate-700/50" id="chart-open-closed">
                        <canvas id="canvas-open-closed" class="h-full w-full" aria-label="Donut chart placeholder"></canvas>
                    </div>
                </div>
            </section>

            @* ---------- Mitigation Effectiveness ---------- *@
            <section class="mb-8" aria-label="Mitigation effectiveness">
                <h2 class="mb-4 text-base font-semibold text-slate-900 dark:text-white">Mitigation Effectiveness (Pre vs Post)</h2>
                <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">Initial score is the risk score before mitigation; residual score is after mitigation. Lower residual indicates effective mitigation.</p>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Avg Initial Score</p>
                        <p class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">@(Model?.Mitigation?.AvgInitialScore ?? 6.2)</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Avg Residual Score</p>
                        <p class="mt-1 text-2xl font-bold text-emerald-600 dark:text-emerald-400">@(Model?.Mitigation?.AvgResidualScore ?? 2.1)</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Avg reduction %</p>
                        <p class="mt-1 text-xl font-bold text-slate-900 dark:text-white">@(Model?.Mitigation?.AvgReductionPercent ?? 34)%</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">% reassessed after mitigation</p>
                        <p class="mt-1 text-xl font-bold text-slate-900 dark:text-white">@(Model?.Mitigation?.ReassessedPercent ?? 78)%</p>
                    </div>
                </div>
                <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80" id="chart-mitigation-pre-post">
                    <div class="h-48">
                        <canvas id="canvas-mitigation-pre-post" class="h-full w-full" aria-label="Pre vs post mitigation score comparison"></canvas>
                    </div>
                </div>
            </section>

            @await Html.PartialAsync("_PredictiveInsightsPanel")

            @* ---------- Site Risk Ranking Table ---------- *@
            <section class="mb-8" aria-label="Site risk ranking">
                <h2 class="mb-4 text-base font-semibold text-slate-900 dark:text-white">Site Risk Ranking</h2>
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[800px] text-left text-sm" role="grid">
                            <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
                                <tr>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Site</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Active Risks</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Critical</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Avg Score</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Trend</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Avg Close Time</th>
                                    <th class="cursor-pointer px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">On-time Mitigation %</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Total Risk Cost <span class="font-normal text-slate-500">(if expenses enabled)</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sitesData = Model?.SiteRankings ?? new List<SiteRankingRowViewModel>();
                                }
                                @if (sitesData.Any())
                                {
                                    @foreach (var row in sitesData)
                                    {
                                        <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 focus-within:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50 dark:focus-within:bg-slate-700/50" tabindex="0" role="button" data-drawer-type="site" data-id="@row.SiteId" data-name="@row.SiteName">
                                            <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">@row.SiteName</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@row.ActiveRisks</td>
                                            <td class="px-4 py-3"><span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800 dark:bg-rose-900/30 dark:text-rose-300">@row.CriticalCount</span></td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@row.AvgScore.ToString("F1")</td>
                                            <td class="px-4 py-3">@(row.TrendUp ? "↑" : "↓")</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@row.AvgCloseTimeDays d</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@row.OnTimeMitigationPercent%</td>
                                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@(row.TotalRiskCost?.ToString("N0") ?? "—")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50" tabindex="0" role="button" data-drawer-type="site" data-id="1" data-name="North Site">
                                        <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">North Site</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">12</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800 dark:bg-rose-900/30 dark:text-rose-300">1</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">4.2</td>
                                        <td class="px-4 py-3">↓</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">11 d</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">85%</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-400">—</td>
                                    </tr>
                                    <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50" tabindex="0" role="button" data-drawer-type="site" data-id="2" data-name="South Site">
                                        <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">South Site</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">8</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800 dark:bg-rose-900/30 dark:text-rose-300">0</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">3.1</td>
                                        <td class="px-4 py-3">↑</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">9 d</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">92%</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-400">—</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            @* ---------- Top High-Priority Risks Table ---------- *@
            <section class="mb-8" aria-label="Top high-priority risks">
                <h2 class="mb-4 text-base font-semibold text-slate-900 dark:text-white">Top High-Priority Risks</h2>
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[900px] text-left text-sm" role="grid">
                            <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
                                <tr>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Risk Code / Name</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Site</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Category</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Source</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Severity</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Score</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Status</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Owner</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Created</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Days Open</th>
                                    <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300" scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var risks = Model?.TopRisks ?? new List<TopRiskRowViewModel>();
                                }
                                @if (risks.Any())
                                {
                                    @foreach (var r in risks)
                                    {
                                        var isCritical = (r.Severity ?? "").Equals("Critical", StringComparison.OrdinalIgnoreCase);
                                        var isOverdue = r.DaysOpen > 30;
                                        <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 focus-within:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50 @(isCritical ? "bg-rose-50/50 dark:bg-rose-900/10" : "") @(isOverdue ? "border-l-4 border-l-amber-400" : "")" tabindex="0" role="button" data-drawer-type="risk" data-id="@r.RiskId" data-name="@r.RiskName">
                                            <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">@r.RiskCode / @r.RiskName</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@r.SiteName</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@r.Category</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@(r.Source ?? "Manual")</td>
                                            <td class="px-4 py-3">
                                                <span class="severity-badge inline-flex rounded-full px-2 py-0.5 text-xs font-medium @GetSeverityBadgeClass(r.Severity)">@(r.Severity ?? "—")</span>
                                            </td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@(r.CurrentScore?.ToString("F1") ?? "—")</td>
                                            <td class="px-4 py-3"><span class="status-badge inline-flex rounded-full px-2 py-0.5 text-xs font-medium @GetStatusBadgeClass(r.Status)">@(r.Status ?? "Open")</span></td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@(r.Owner ?? "—")</td>
                                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@(r.CreatedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@(r.DaysOpen?.ToString() ?? "—")</td>
                                            <td class="px-4 py-3"><button type="button" class="view-risk-btn rounded-lg px-2 py-1 text-xs font-medium text-emerald-600 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-900/20" data-id="@r.RiskId">View</button></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50" tabindex="0" role="button" data-drawer-type="risk" data-id="101" data-name="Flood exposure">
                                        <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">R-101 / Flood exposure</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">North Site</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Weather</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Weather</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800 dark:bg-rose-900/30 dark:text-rose-300">Critical</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">8.2</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/30 dark:text-amber-300">Open</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">J. Smith</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-400">Feb 15, 2025</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">13</td>
                                        <td class="px-4 py-3"><button type="button" class="view-risk-btn rounded-lg px-2 py-1 text-xs font-medium text-emerald-600 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-900/20" data-id="101">View</button></td>
                                    </tr>
                                    <tr class="drawer-row border-b border-slate-100 transition hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/50 border-l-4 border-l-amber-400" tabindex="0" role="button" data-drawer-type="risk" data-id="102" data-name="Crane safety">
                                        <td class="px-4 py-3 font-medium text-slate-900 dark:text-white">R-102 / Crane safety</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">South Site</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Safety</td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">Manual</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-900/30 dark:text-orange-300">High</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">6.5</td>
                                        <td class="px-4 py-3"><span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/30 dark:text-amber-300">Open</span></td>
                                        <td class="px-4 py-3 text-slate-700 dark:text-slate-300">M. Lee</td>
                                        <td class="px-4 py-3 text-slate-600 dark:text-slate-400">Jan 10, 2025</td>
                                        <td class="px-4 py-3 font-medium text-amber-600 dark:text-amber-400">49</td>
                                        <td class="px-4 py-3"><button type="button" class="view-risk-btn rounded-lg px-2 py-1 text-xs font-medium text-emerald-600 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-900/20" data-id="102">View</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>

        @* ---------- Loading skeleton ---------- *@
        <div id="state-loading" class="hidden space-y-6" aria-live="polite" aria-busy="true">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800/80">
                        <div class="h-3 w-24 animate-pulse rounded bg-slate-200 dark:bg-slate-600"></div>
                        <div class="mt-2 h-8 w-32 animate-pulse rounded bg-slate-200 dark:bg-slate-600"></div>
                        <div class="mt-2 h-4 w-20 animate-pulse rounded bg-slate-200 dark:bg-slate-600"></div>
                        <div class="mt-2 h-8 w-full animate-pulse rounded bg-slate-200 dark:bg-slate-600"></div>
                    </div>
                }
            </div>
            <div class="grid gap-6 lg:grid-cols-12">
                <div class="h-64 animate-pulse rounded-xl bg-slate-200 dark:bg-slate-700 lg:col-span-8"></div>
                <div class="h-64 animate-pulse rounded-xl bg-slate-200 dark:bg-slate-700 lg:col-span-4"></div>
            </div>
            <div class="h-32 animate-pulse rounded-xl bg-slate-200 dark:bg-slate-700"></div>
        </div>

        @* ---------- Empty state ---------- *@
        <div id="state-empty" class="hidden flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white py-16 dark:border-slate-700 dark:bg-slate-800/80" aria-live="polite">
            <p class="text-5xl opacity-50" aria-hidden="true">📊</p>
            <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">No data for selected filters</h3>
            <p class="mt-2 max-w-sm text-center text-sm text-slate-500 dark:text-slate-400">Try adjusting the date range, site, or category to see risk analytics.</p>
        </div>

        @* ---------- Error state ---------- *@
        <div id="state-error" class="hidden flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white py-16 dark:border-slate-700 dark:bg-slate-800/80" aria-live="assertive">
            <p class="text-5xl opacity-50" aria-hidden="true">⚠️</p>
            <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Something went wrong</h3>
            <p class="mt-2 max-w-sm text-center text-sm text-slate-500 dark:text-slate-400">We couldn't load the analytics. Please try again.</p>
            <button type="button" id="btn-retry" class="mt-4 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Retry</button>
        </div>
    </main>

    @* ---------- Drill-down Drawer ---------- *@
    <div id="drawer-overlay" class="fixed inset-0 z-40 bg-slate-900/40 opacity-0 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
    <aside id="drawer-panel" class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md flex-col border-l border-slate-200 bg-white shadow-2xl transition-transform duration-300 ease-out dark:border-slate-700 dark:bg-slate-900 translate-x-full" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700">
            <h2 id="drawer-title" class="text-lg font-semibold text-slate-900 dark:text-white">Drill-down</h2>
            <button type="button" id="drawer-close" class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:hover:bg-slate-700 dark:hover:text-slate-200" aria-label="Close panel">✕</button>
        </div>
        <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
            <div class="space-y-4">
                <div class="grid grid-cols-3 gap-2">
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2 text-center dark:border-slate-700 dark:bg-slate-800">
                        <p class="text-xs text-slate-500 dark:text-slate-400">Active</p>
                        <p id="drawer-stat-active" class="text-lg font-bold text-slate-900 dark:text-white">—</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2 text-center dark:border-slate-700 dark:bg-slate-800">
                        <p class="text-xs text-slate-500 dark:text-slate-400">Critical</p>
                        <p id="drawer-stat-critical" class="text-lg font-bold text-slate-900 dark:text-white">—</p>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-2 text-center dark:border-slate-700 dark:bg-slate-800">
                        <p class="text-xs text-slate-500 dark:text-slate-400">Avg Score</p>
                        <p id="drawer-stat-score" class="text-lg font-bold text-slate-900 dark:text-white">—</p>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Recent monitoring alerts</h3>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Weather-related alerts appear here when applicable.</p>
                    <ul id="drawer-alerts" class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-300"></ul>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Mitigation status</h3>
                    <div class="mt-2 flex gap-2">
                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs dark:bg-slate-600">To Do: 0</span>
                        <span class="rounded-full bg-amber-200 px-2 py-0.5 text-xs dark:bg-amber-900/30">In Progress: 0</span>
                        <span class="rounded-full bg-emerald-200 px-2 py-0.5 text-xs dark:bg-emerald-900/30">Done: 0</span>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Assessment history</h3>
                    <ul id="drawer-history" class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-300">
                        <li>—</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="border-t border-slate-200 p-4 dark:border-slate-700">
            <div class="flex flex-wrap gap-2">
                <a id="drawer-btn-risk" href="#" class="inline-flex rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:bg-slate-700 dark:hover:bg-slate-600">Go to Risk</a>
                <a id="drawer-btn-kanban" href="#" class="inline-flex rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Go to Kanban</a>
                <button type="button" id="drawer-btn-report" class="inline-flex rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Download Site Report</button>
            </div>
        </div>
    </aside>
</div>

@* Helper: severity badge class (inline in view; no C# file) *@
@functions {
    public static string GetSeverityBadgeClass(string? severity)
    {
        if (string.IsNullOrEmpty(severity)) return "bg-slate-100 text-slate-700 dark:bg-slate-600 dark:text-slate-300";
        switch (severity.ToLowerInvariant())
        {
            case "critical": return "bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-300";
            case "high": return "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300";
            case "medium": return "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300";
            case "low": return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300";
            default: return "bg-slate-100 text-slate-700 dark:bg-slate-600 dark:text-slate-300";
        }
    }
    public static string GetStatusBadgeClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-slate-100 text-slate-700 dark:bg-slate-600 dark:text-slate-300";
        switch (status.ToLowerInvariant())
        {
            case "open": return "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300";
            case "mitigated": return "bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300";
            case "closed": return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300";
            default: return "bg-slate-100 text-slate-700 dark:bg-slate-600 dark:text-slate-300";
        }
    }
}

@section Scripts {
<script>
(function () {
    'use strict';

    var chartsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        risksOverTimeLabels = Model?.Charts?.RisksOverTimeLabels ?? new List<string>(),
        risksOverTimeValues = Model?.Charts?.RisksOverTimeValues ?? new List<int>(),
        risksByCategoryLabels = Model?.Charts?.RisksByCategoryLabels ?? new List<string>(),
        risksByCategoryValues = Model?.Charts?.RisksByCategoryValues ?? new List<int>(),
        openCount = Model?.Charts?.OpenCount ?? 0,
        closedCount = Model?.Charts?.ClosedCount ?? 0,
        mitigationAvgInitialScore = Model?.Mitigation?.AvgInitialScore ?? 0,
        mitigationAvgResidualScore = Model?.Mitigation?.AvgResidualScore ?? 0
    }));

    // Segment toggles (Source / Status)
    document.querySelectorAll('.segment-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var segment = this.getAttribute('data-segment');
            var value = this.getAttribute('data-value');
            var group = this.closest('[role="group"]');
            if (!group) return;
            group.querySelectorAll('.segment-btn').forEach(function (b) { b.classList.remove('active', 'bg-white', 'shadow-sm', 'dark:bg-slate-700'); });
            this.classList.add('active', 'bg-white', 'shadow-sm', 'dark:bg-slate-700');
        });
    });

    // Drawer open/close
    var overlay = document.getElementById('drawer-overlay');
    var panel = document.getElementById('drawer-panel');
    var drawerTitle = document.getElementById('drawer-title');
    var drawerClose = document.getElementById('drawer-close');
    var openDrawer = function (type, id, name) {
        drawerTitle.textContent = name || (type === 'site' ? 'Site' : 'Risk');
        document.getElementById('drawer-stat-active').textContent = '—';
        document.getElementById('drawer-stat-critical').textContent = '—';
        document.getElementById('drawer-stat-score').textContent = '—';
        document.getElementById('drawer-btn-risk').href = '#';
        document.getElementById('drawer-btn-kanban').href = '#';
        panel.setAttribute('aria-hidden', 'false');
        overlay.setAttribute('aria-hidden', 'false');
        overlay.classList.remove('pointer-events-none');
        overlay.classList.add('pointer-events-auto', 'opacity-100');
        panel.classList.remove('translate-x-full');
    };
    var closeDrawer = function () {
        panel.setAttribute('aria-hidden', 'true');
        overlay.setAttribute('aria-hidden', 'true');
        overlay.classList.add('pointer-events-none');
        overlay.classList.remove('pointer-events-auto', 'opacity-100');
        panel.classList.add('translate-x-full');
    };
    document.querySelectorAll('.drawer-row').forEach(function (el) {
        el.addEventListener('click', function (e) {
            if (e.target.closest('.view-risk-btn')) return;
            openDrawer(el.getAttribute('data-drawer-type'), el.getAttribute('data-id'), el.getAttribute('data-name'));
        });
    });
    document.querySelectorAll('.view-risk-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var row = btn.closest('tr');
            if (row) openDrawer(row.getAttribute('data-drawer-type'), row.getAttribute('data-id'), row.getAttribute('data-name'));
        });
    });
    drawerClose.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);
    panel.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });

    // Export dropdown
    var exportBtn = document.getElementById('btn-export');
    var exportMenu = document.getElementById('export-menu');
    if (exportBtn && exportMenu) {
        exportBtn.addEventListener('click', function () {
            exportMenu.classList.toggle('hidden');
            exportBtn.setAttribute('aria-expanded', exportMenu.classList.contains('hidden') ? 'false' : 'true');
        });
        document.addEventListener('click', function (e) {
            if (!exportBtn.contains(e.target) && !exportMenu.contains(e.target)) { exportMenu.classList.add('hidden'); exportBtn.setAttribute('aria-expanded', 'false'); }
        });
    }

    // State toggles (for demo: Refresh = loading then content; Retry = error -> content)
    var contentMain = document.getElementById('content-main');
    var stateLoading = document.getElementById('state-loading');
    var stateEmpty = document.getElementById('state-empty');
    var stateError = document.getElementById('state-error');
    function showContent() { contentMain.classList.remove('hidden'); stateLoading.classList.add('hidden'); stateEmpty.classList.add('hidden'); stateError.classList.add('hidden'); }
    function showLoading() { contentMain.classList.add('hidden'); stateEmpty.classList.add('hidden'); stateError.classList.add('hidden'); stateLoading.classList.remove('hidden'); }
    function showEmpty() { contentMain.classList.add('hidden'); stateLoading.classList.add('hidden'); stateError.classList.add('hidden'); stateEmpty.classList.remove('hidden'); }
    function showError() { contentMain.classList.add('hidden'); stateLoading.classList.add('hidden'); stateEmpty.classList.add('hidden'); stateError.classList.remove('hidden'); }

    var btnRefresh = document.getElementById('btn-refresh');
    if (btnRefresh) btnRefresh.addEventListener('click', function () {
        var dateRange = document.getElementById('filter-date-range');
        var siteId = document.getElementById('filter-site');
        var category = document.getElementById('filter-category');
        var severity = document.getElementById('filter-severity');
        var sourceBtn = document.querySelector('[data-segment="source"].active, [data-segment="source"].segment-btn.active');
        var statusBtn = document.querySelector('[data-segment="status"].active, [data-segment="status"].segment-btn.active');
        var params = new URLSearchParams();
        if (dateRange && dateRange.value) params.set('dateRange', dateRange.value);
        if (siteId && siteId.value) params.set('siteId', siteId.value);
        if (category && category.value) params.set('category', category.value);
        if (severity && severity.value) params.set('severity', severity.value);
        var srcEl = document.querySelector('[data-segment="source"].active') || document.querySelector('[data-segment="source"]');
        var src = srcEl ? srcEl.getAttribute('data-value') : 'all';
        if (src && src !== 'all') params.set('source', src);
        var stEl = document.querySelector('[data-segment="status"].active') || document.querySelector('[data-segment="status"]');
        var st = stEl ? stEl.getAttribute('data-value') : 'all';
        if (st && st !== 'all') params.set('status', st);
        window.location = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    });
    var btnRetry = document.getElementById('btn-retry');
    if (btnRetry) btnRetry.addEventListener('click', showContent);

    // Segment active style (ensure visible state)
    document.querySelectorAll('.segment-btn.active').forEach(function (b) {
        b.classList.add('bg-white', 'shadow-sm', 'dark:bg-slate-700');
    });

    if (typeof Chart !== 'undefined') {
        var lineCtx = document.getElementById('canvas-risks-over-time');
        if (lineCtx) {
            var lineLabels = chartsData.risksOverTimeLabels && chartsData.risksOverTimeLabels.length ? chartsData.risksOverTimeLabels : ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
            var lineValues = chartsData.risksOverTimeValues && chartsData.risksOverTimeValues.length ? chartsData.risksOverTimeValues : [0, 0, 0, 0];
            new Chart(lineCtx.getContext('2d'), {
                type: 'line',
                data: { labels: lineLabels, datasets: [{ label: 'Risks', data: lineValues, borderColor: '#059669', tension: 0.3, fill: true }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        }
        var barCtx = document.getElementById('canvas-risks-by-category');
        if (barCtx) {
            var barLabels = chartsData.risksByCategoryLabels && chartsData.risksByCategoryLabels.length ? chartsData.risksByCategoryLabels : ['Safety', 'Weather', 'Supply', 'Quality'];
            var barValues = chartsData.risksByCategoryValues && chartsData.risksByCategoryValues.length ? chartsData.risksByCategoryValues : [0, 0, 0, 0];
            new Chart(barCtx.getContext('2d'), {
                type: 'bar',
                data: { labels: barLabels, datasets: [{ label: 'Count', data: barValues, backgroundColor: '#0f172a' }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        }
        var donutCtx = document.getElementById('canvas-open-closed');
        if (donutCtx) {
            var openCount = chartsData.openCount != null ? chartsData.openCount : 0;
            var closedCount = chartsData.closedCount != null ? chartsData.closedCount : 0;
            new Chart(donutCtx.getContext('2d'), {
                type: 'doughnut',
                data: { labels: ['Open', 'Closed'], datasets: [{ data: [openCount, closedCount], backgroundColor: ['#f59e0b', '#059669'] }] },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
        var prePostCtx = document.getElementById('canvas-mitigation-pre-post');
        if (prePostCtx) {
            var avgInitial = chartsData.mitigationAvgInitialScore != null ? chartsData.mitigationAvgInitialScore : 0;
            var avgResidual = chartsData.mitigationAvgResidualScore != null ? chartsData.mitigationAvgResidualScore : 0;
            new Chart(prePostCtx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['Initial (pre-mitigation)', 'Residual (post-mitigation)'],
                    datasets: [
                        { label: 'Score', data: [avgInitial, avgResidual], backgroundColor: ['#64748b', '#059669'] }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, max: Math.max(10, Math.ceil(Math.max(avgInitial, avgResidual) * 1.2)) },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    }
})();
</script>
}
