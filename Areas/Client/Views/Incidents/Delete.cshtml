@model WEB_Sentro.Data.Entities.Incident

@{
    ViewData["Title"] = "Delete Incident";
    Layout = "_LayoutClient";
}

<div class="mx-auto max-w-2xl px-4 py-16">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900/50">
        <div class="border-b border-rose-100 bg-rose-50 px-6 py-6 dark:border-rose-900/30 dark:bg-rose-900/20">
            <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600 dark:bg-rose-900/50 dark:text-rose-400">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">Delete Incident Report?</h3>
                    <p class="mt-1 text-sm font-medium text-rose-600 dark:text-rose-400">This action cannot be undone.</p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="rounded-xl border border-slate-100 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-800/50">
                <dl class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <dt class="font-bold text-slate-500 dark:text-slate-400">Date</dt>
                        <dd class="font-bold text-slate-900 dark:text-white">@Model.IncidentDate.ToString("MMM dd, yyyy")</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="font-bold text-slate-500 dark:text-slate-400">Title</dt>
                        <dd class="font-bold text-slate-900 dark:text-white">@Model.Title</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="font-bold text-slate-500 dark:text-slate-400">Type</dt>
                        <dd class="font-bold text-slate-900 dark:text-white">@Model.Type</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="font-bold text-slate-500 dark:text-slate-400">Severity</dt>
                        <dd>
                            @{
                                var sevClass = Model.Severity switch
                                {
                                    "Critical" => "text-rose-600 dark:text-rose-400",
                                    "High" => "text-orange-600 dark:text-orange-400",
                                    _ => "text-slate-900 dark:text-white"
                                };
                            }
                            <span class="font-black uppercase @sevClass">@Model.Severity</span>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 bg-slate-50 px-6 py-4 dark:bg-slate-800/50">
            <form asp-action="Delete">
                <input type="hidden" asp-for="IncidentId" />
                <a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancel</a>
                <button type="submit" class="ml-2 rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg transition hover:bg-rose-700 hover:-translate-y-0.5">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>