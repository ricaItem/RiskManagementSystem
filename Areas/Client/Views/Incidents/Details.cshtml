@model WEB_Sentro.Data.Entities.Incident

@{
    ViewData["Title"] = "Incident Details";
    Layout = "_LayoutClient";
}

<div class="mx-auto max-w-7xl px-4 py-8 animate-in fade-in duration-500">
    <!-- Header -->
    <div class="mb-8 flex flex-col justify-between gap-6 md:flex-row md:items-center">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Incident <span class="text-rose-500">#@Model.IncidentId</span></h1>
                @{
                    var statusClass = Model.Status switch
                    {
                        "Closed" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
                        "Investigating" => "bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-400",
                        _ => "bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300"
                    };
                }
                <span class="rounded-full px-3 py-1 text-xs font-black uppercase tracking-wide @statusClass">
                    @Model.Status
                </span>
            </div>
            <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                Reported on <span class="font-bold text-slate-700 dark:text-slate-300">@Model.ReportedAt.ToString("MMM dd, yyyy h:mm tt")</span> 
                by <span class="font-bold text-slate-700 dark:text-slate-300">@ViewBag.ReportedByName</span>
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Index", "Incidents", new { area = "Client" })" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Back to List</a>
            @if (Model.Status != "Closed")
            {
                <a href="@Url.Action("Edit", "Incidents", new { area = "Client", id = Model.IncidentId })" class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-lg transition hover:bg-slate-800 hover:-translate-y-0.5 dark:bg-slate-700 dark:hover:bg-slate-600">
                    Edit Incident
                </a>
            }
        </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Details Card -->
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50">
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/30">
                    <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Incident Details</h2>
                </div>
                <div class="p-6">
                    <div class="mb-6">
                        <h3 class="mb-2 text-lg font-bold text-slate-900 dark:text-white">@Model.Title</h3>
                        <div class="prose prose-slate max-w-none text-sm text-slate-600 dark:prose-invert dark:text-slate-300">
                            <p>@(Model.Description ?? "No description provided.")</p>
                        </div>
                    </div>

                    <div class="grid gap-6 md:grid-cols-2">
                        <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/50">
                            <h4 class="mb-1 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Root Cause</h4>
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@(Model.RootCause ?? "Pending investigation")</p>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/50">
                            <h4 class="mb-1 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Corrective Actions</h4>
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@(Model.CorrectiveActions ?? "None recorded")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Overview Card -->
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50">
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/30">
                    <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Overview</h2>
                </div>
                <div class="divide-y divide-slate-100 dark:divide-slate-800">
                    <div class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Project Site</p>
                        <div class="mt-1 flex items-center gap-2">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                            <span class="font-bold text-slate-700 dark:text-slate-200">@(Model.Site?.SiteName ?? "Unknown")</span>
                        </div>
                    </div>
                    <div class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Date Occurred</p>
                        <div class="mt-1 flex items-center gap-2">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            <span class="font-bold text-slate-700 dark:text-slate-200">@Model.IncidentDate.ToString("MMM dd, yyyy h:mm tt")</span>
                        </div>
                    </div>
                    <div class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Type</p>
                        <div class="mt-1 font-bold text-slate-700 dark:text-slate-200">@Model.Type</div>
                    </div>
                    <div class="px-6 py-4">
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Severity</p>
                        <div class="mt-1">
                            @{
                                var sevClass = Model.Severity switch
                                {
                                    "Critical" => "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400",
                                    "High" => "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
                                    "Medium" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
                                    _ => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400"
                                };
                            }
                            <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-black uppercase @sevClass">
                                @Model.Severity
                            </span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.WeatherConditions))
                    {
                        <div class="px-6 py-4">
                            <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Weather</p>
                            <div class="mt-1 flex items-center gap-2 text-slate-700 dark:text-slate-200">
                                <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                                <span class="font-bold">@Model.WeatherConditions</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions Card -->
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/50">
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 dark:border-slate-800 dark:bg-slate-800/30">
                    <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Actions</h2>
                </div>
                <div class="p-6 space-y-3">
                    @if (Model.Status != "Closed")
                    {
                        <a href="@Url.Action("Edit", "Incidents", new { area = "Client", id = Model.IncidentId })" class="flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600 px-4 py-3 text-sm font-bold text-white transition hover:bg-violet-700 hover:-translate-y-0.5 shadow-md">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                            Update Investigation
                        </a>
                    }
                    else
                    {
                        <div class="rounded-xl bg-emerald-50 px-4 py-3 text-center text-sm font-bold text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-800">
                            <div class="flex items-center justify-center gap-2">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                Incident Closed
                            </div>
                        </div>
                    }
                    
                    <a href="@Url.Action("Identification", "Risks", new { area = "Client", createFromIncidentId = Model.IncidentId })" class="flex w-full items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-bold text-rose-700 transition hover:bg-rose-100 dark:border-rose-900 dark:bg-rose-900/20 dark:text-rose-300 dark:hover:bg-rose-900/40">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        Convert to Risk
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>