@model Web_Sentro.Areas.Client.Models.IncidentEditViewModel

@{
    ViewData["Title"] = "Edit Incident";
    Layout = "_LayoutClient";
}

<div class="animate-in fade-in min-h-screen flex items-center justify-center p-4 duration-500">
    <div class="w-full max-w-3xl bg-white dark:bg-slate-900 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Edit Incident</h2>
                    <p class="text-xs text-slate-500 mt-1">Update incident details and investigation</p>
                </div>
                <a href="@Url.Action("Index", "Incidents", new { area = "Client" })" class="text-slate-400 hover:text-slate-500 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </a>
            </div>

            <form asp-action="Edit" method="post" class="space-y-6">
                <input type="hidden" asp-for="IncidentId" />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="SiteId" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Project Site <span class="text-rose-500">*</span></label>
                        <select asp-for="SiteId" asp-items="ViewBag.Sites" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="">Select a Site...</option>
                        </select>
                        <span asp-validation-for="SiteId" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="IncidentDate" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Date & Time <span class="text-rose-500">*</span></label>
                        <input asp-for="IncidentDate" type="datetime-local" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all" />
                        <span asp-validation-for="IncidentDate" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Type" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Type <span class="text-rose-500">*</span></label>
                        <select asp-for="Type" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Near Miss">Near Miss</option>
                            <option value="Injury">Injury</option>
                            <option value="Property Damage">Property Damage</option>
                            <option value="Environmental">Environmental</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div>
                         <label asp-for="Severity" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Severity <span class="text-rose-500">*</span></label>
                        <select asp-for="Severity" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>
                </div>
                
                <div>
                     <label asp-for="Status" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Status <span class="text-rose-500">*</span></label>
                     <select asp-for="Status" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                        <option value="Open">Open</option>
                        <option value="Investigating">Investigating</option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>

                <div>
                    <label asp-for="Title" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Title <span class="text-rose-500">*</span></label>
                    <input asp-for="Title" required placeholder="Brief description (e.g., Forklift collision near Gate 3)" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all" />
                    <span asp-validation-for="Title" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Description" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Detailed Description</label>
                    <textarea asp-for="Description" rows="4" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                
                <div>
                     <label asp-for="WeatherConditions" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Weather Conditions</label>
                     <input asp-for="WeatherConditions" placeholder="e.g., Heavy rain" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all" />
                </div>
                
                <!-- Investigation -->
                <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-100 dark:border-slate-800 space-y-4">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Investigation Findings</p>
                    
                     <div>
                        <label asp-for="RootCause" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Root Cause</label>
                        <textarea asp-for="RootCause" rows="3" class="w-full bg-white dark:bg-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all"></textarea>
                    </div>
                     <div>
                        <label asp-for="CorrectiveActions" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Corrective Actions</label>
                        <textarea asp-for="CorrectiveActions" rows="3" class="w-full bg-white dark:bg-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-rose-500 focus:border-transparent outline-none transition-all"></textarea>
                    </div>
                </div>

                <div class="pt-4 flex gap-3">
                    <a href="@Url.Action("Index", "Incidents", new { area = "Client" })" class="flex-1 px-4 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors text-center dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600 dark:hover:bg-slate-700">Cancel</a>
                    <button type="submit" class="flex-1 px-4 py-2.5 text-sm font-medium text-white bg-rose-600 rounded-lg hover:bg-rose-700 shadow-sm transition-colors">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}