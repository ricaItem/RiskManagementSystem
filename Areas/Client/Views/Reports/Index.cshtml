@model WEB_Sentro.Areas.Client.Models.ReportsViewModel
@{
    ViewData["Title"] = "Executive Reports";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<div id="reports-skeleton" class="animate-pulse min-h-screen space-y-8 p-6">
    <div class="flex flex-col justify-between gap-6 border-b border-slate-200 pb-6 dark:border-slate-800 lg:flex-row lg:items-end">
        <div>
            <div class="h-9 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
            <div class="mt-3 h-4 w-[26rem] rounded bg-slate-100 dark:bg-slate-800"></div>
        </div>
        <div class="flex gap-3">
            <div class="h-10 w-36 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
            <div class="h-10 w-28 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="h-36 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
        }
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        @for (var i = 0; i < 4; i++)
        {
            <div class="h-80 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
        }
        <div class="h-80 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40 lg:col-span-2"></div>
    </div>
</div>

<div id="reports-content" class="hidden animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-8 duration-700">

    @* ---------- Header ---------- *@
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Executive Reports
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Comprehensive analysis of financial, safety, and operational performance.</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-slate-400 dark:text-slate-500">Last updated: Just now</span>
            <a id="btnExportPdf" href="@Url.Action("ExportPdf", "Reports", new { Area = "Client", range = Model.DateRange == "Last 30 Days" ? "30" : Model.DateRange == "Last Quarter" ? "90" : "YTD", site = Model.Site })" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:hover:bg-indigo-400 transition-all inline-block">
                Export PDF
            </a>
        </div>
    </div>

    @* ---------- Filters Card ---------- *@
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 relative overflow-hidden">
        <div class="flex flex-wrap items-end gap-6">
            <div class="space-y-1.5">
                <label for="rangeFilter" class="text-xs font-medium text-slate-500 dark:text-slate-400">Time Period</label>
                <select id="rangeFilter" name="range" class="block w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 min-w-[140px]">
                    <option value="30" selected="@(Model.DateRange == "Last 30 Days")">Last 30 Days</option>
                    <option value="90" selected="@(Model.DateRange == "Last Quarter")">Last Quarter</option>
                    <option value="YTD" selected="@(Model.DateRange == "Year to Date")">Year to Date</option>
                </select>
            </div>
            
            <div class="space-y-1.5">
                <label for="siteFilter" class="text-xs font-medium text-slate-500 dark:text-slate-400">Site</label>
                <select id="siteFilter" name="site" class="block w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 min-w-[160px]">
                    <option value="All" selected="@(Model.Site == "All")">All Sites</option>
                    <option value="Site Alpha" selected="@(Model.Site == "Site Alpha")">Site Alpha</option>
                    <option value="Site Beta" selected="@(Model.Site == "Site Beta")">Site Beta</option>
                </select>
            </div>
        </div>
    </div>

    <div id="reports-dashboard-data">
        @await Html.PartialAsync("_ReportsContent", Model)
    </div>
 </div>

<script>
    (function () {
        let activeCharts = {};

        function initCharts() {
            if (typeof Chart === 'undefined') {
                setTimeout(initCharts, 200);
                return;
            }

            // Destroy existing charts to avoid overlaps
            Object.values(activeCharts).forEach(chart => chart.destroy());
            activeCharts = {};

            const commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 8,
                            usePointStyle: true,
                            font: { size: 11, family: "'Inter', sans-serif" },
                            padding: 20,
                            color: '#64748b'
                        }
                    }
                },
                scales: {
                    x: { 
                        grid: { display: false },
                        border: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 10 } }
                    },
                    y: {
                        grid: { color: 'rgba(148, 163, 184, 0.1)', borderDash: [5, 5] },
                        border: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 10 } }
                    }
                }
            };

            const data = window.reportsChartData || {};

            // 1. Financial Chart (Bar)
            const financialChartEl = document.getElementById('financialChart');
            if (financialChartEl && data.financialLabels) {
                activeCharts['financial'] = new Chart(financialChartEl, {
                    type: 'bar',
                    data: {
                        labels: data.financialLabels,
                        datasets: [{
                            label: 'Spend ($)',
                            data: data.financialData,
                            backgroundColor: data.financialColors,
                            borderRadius: 6,
                            barThickness: 24
                        }]
                    },
                    options: commonOptions
                });
            }

            // 2. Burn Rate Chart (Line)
            const burnChartEl = document.getElementById('burnRateChart');
            const burnCtx = burnChartEl ? burnChartEl.getContext('2d') : null;
            if (burnCtx && data.burnLabels) {
                const burnGradient = burnCtx.createLinearGradient(0, 0, 0, 300);
                burnGradient.addColorStop(0, 'rgba(99, 102, 241, 0.2)'); // Indigo
                burnGradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

                activeCharts['burn'] = new Chart(burnCtx, {
                    type: 'line',
                    data: {
                        labels: data.burnLabels,
                        datasets: [{
                            label: 'Monthly Burn',
                            data: data.burnData,
                            borderColor: '#6366f1',
                            borderWidth: 3,
                            backgroundColor: burnGradient,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: commonOptions
                });
            }

            // 3. Safety Chart (Line)
            const safetyChartEl = document.getElementById('safetyChart');
            const safetyCtx = safetyChartEl ? safetyChartEl.getContext('2d') : null;
            if (safetyCtx) {
                activeCharts['safety'] = new Chart(safetyCtx, {
                    type: 'line',
                    data: {
                        labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                        datasets: [{
                            label: 'Incidents',
                            data: [2, 0, 3, 1],
                            borderColor: '#f43f5e',
                            borderWidth: 3,
                            tension: 0.4,
                            pointRadius: 4
                        }]
                    },
                    options: commonOptions
                });
            }

            // 4. Supplier Chart (Doughnut)
            const supplierChartEl = document.getElementById('supplierChart');
            if (supplierChartEl && data.supplierLabels) {
                activeCharts['supplier'] = new Chart(supplierChartEl, {
                    type: 'doughnut',
                    data: {
                        labels: data.supplierLabels,
                        datasets: [{
                            data: data.supplierData,
                            backgroundColor: data.supplierColors,
                            borderWidth: 0,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        ...commonOptions,
                        cutout: '75%',
                        scales: { x: { display: false }, y: { display: false } }
                    }
                });
            }

            // 5. Compliance Chart (Area)
            const complianceChartEl = document.getElementById('complianceChart');
            const compCtx = complianceChartEl ? complianceChartEl.getContext('2d') : null;
            if (compCtx) {
                const compGradient = compCtx.createLinearGradient(0, 0, 0, 300);
                compGradient.addColorStop(0, 'rgba(16, 185, 129, 0.2)'); // Emerald
                compGradient.addColorStop(1, 'rgba(16, 185, 129, 0)');

                activeCharts['compliance'] = new Chart(compCtx, {
                    type: 'line',
                    data: {
                        labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                        datasets: [{
                            label: 'Audit Issues',
                            data: [12, 8, 5, 2],
                            borderColor: '#10b981',
                            borderWidth: 3,
                            backgroundColor: compGradient,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: commonOptions
                });
            }
        }

        function reloadData() {
            const site = document.getElementById('siteFilter').value;
            const range = document.getElementById('rangeFilter').value;
            const container = document.getElementById('reports-dashboard-data');

            // Update Export PDF link
            const exportBtn = document.getElementById('btnExportPdf');
            const url = new URL(exportBtn.href);
            url.searchParams.set('range', range);
            url.searchParams.set('site', site);
            exportBtn.href = url.toString();

            // Fetch new data
            container.classList.add('opacity-50', 'pointer-events-none');
            
            fetch(`?range=${encodeURIComponent(range)}&site=${encodeURIComponent(site)}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                // Execute inline scripts to update window.reportsChartData
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const scripts = tempDiv.querySelectorAll('script');
                
                container.innerHTML = html;
                
                scripts.forEach(script => {
                    if(script.innerText) {
                        eval(script.innerText);
                    }
                });

                container.classList.remove('opacity-50', 'pointer-events-none');
                initCharts();
            })
            .catch(err => {
                console.error('Failed to load report data', err);
                container.classList.remove('opacity-50', 'pointer-events-none');
            });
        }

        function initExecutiveReportsPage() {
            const content = document.getElementById('reports-content');
            if (!content || content.dataset.loaded === '1') return;

            setTimeout(function () {
                const skeleton = document.getElementById('reports-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                content.classList.remove('hidden');

                initCharts();
                content.dataset.loaded = '1';
                
                document.getElementById('siteFilter').addEventListener('change', reloadData);
                document.getElementById('rangeFilter').addEventListener('change', reloadData);
            }, 300);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initExecutiveReportsPage);
        } else {
            initExecutiveReportsPage();
        }
    })();
</script>
