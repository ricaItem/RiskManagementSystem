@model WEB_Sentro.Data.Entities.ChangeOrder
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Change Order Details";
    var totalAmount = Model.LineItems?.Sum(l => l.Amount) ?? 0;
    
    var statusColor = Model.Status switch 
    {
        "Approved" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-900/20 dark:text-emerald-400",
        "Rejected" => "bg-red-50 text-red-700 ring-red-600/20 dark:bg-red-900/20 dark:text-red-400",
        "Pending" => "bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-900/20 dark:text-blue-400",
        _ => "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/20 dark:text-amber-400"
    };
}

<div class="animate-in fade-in min-h-screen space-y-6 max-w-5xl mx-auto p-6 duration-700">
    
    @if (TempData["Message"] != null)
    {
        <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
            <div class="bg-emerald-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="text-sm font-medium">@TempData["Message"]</span>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
            <div class="bg-red-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="text-sm font-medium">@TempData["Error"]</span>
            </div>
        </div>
    }

    <!-- Header / Nav -->
    <div class="flex items-center justify-between">
        <a href="@Url.Action("Index", "ChangeOrders", new { area = "Client" })" class="flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Back to Change Orders
        </a>
        <div class="flex gap-2">
            @if (Model.Status == "Draft")
            {
                <a href="@Url.Action("Edit", "ChangeOrders", new { area = "Client", id = Model.ChangeOrderId })" class="rounded-lg bg-white border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-700 transition-colors">
                    Edit
                </a>
                <form method="post" action="@Url.Action("Submit", "ChangeOrders", new { area = "Client", id = Model.ChangeOrderId })" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 transition-colors">
                        Submit for Approval
                    </button>
                </form>
            }
            else if (Model.Status == "Pending")
            {
                 <form method="post" action="@Url.Action("Approve", "ChangeOrders", new { area = "Client", id = Model.ChangeOrderId })" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 transition-colors">
                        Approve
                    </button>
                </form>
                 <form method="post" action="@Url.Action("Reject", "ChangeOrders", new { area = "Client", id = Model.ChangeOrderId })" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg bg-rose-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-rose-700 dark:bg-rose-500 dark:hover:bg-rose-600 transition-colors">
                        Reject
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
        
        <!-- Header -->
        <div class="p-8 border-b border-slate-100 dark:border-slate-800">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">@Model.Title</h1>
                        <span class="inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset @statusColor">
                            @Model.Status
                        </span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Created on @Model.CreatedAt.ToString("MMMM d, yyyy")</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-4 text-sm text-slate-600 dark:text-slate-300">
                    @Model.Description
                </div>
            }
        </div>

        <!-- Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 p-8 bg-slate-50/50 dark:bg-slate-800/20">
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Project Information</h3>
                <div class="space-y-4">
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Site</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.Site?.SiteName ?? "—")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Project</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.Project?.Name ?? "—")</span>
                    </div>
                </div>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Approval Details</h3>
                <div class="space-y-4">
                     <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Approved By</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(ViewBag.ApproverName ?? "—")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Approved Date</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.ApprovedAt?.ToString("MMM d, yyyy") ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="p-8">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-6">Line Items</h3>
            
            <div class="overflow-hidden ring-1 ring-slate-200 dark:ring-slate-800 sm:rounded-lg">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-slate-900 dark:text-white sm:pl-6">Cost Code</th>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-slate-900 dark:text-white sm:pl-6">Description</th>
                            <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold text-slate-900 dark:text-white">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                        @if (Model.LineItems?.Any() == true)
                        {
                            @foreach (var line in Model.LineItems)
                            {
                                <tr>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-slate-500 dark:text-slate-400 sm:pl-6">
                                        @(line.CostCode != null ? $"{line.CostCode.Code} - {line.CostCode.Description}" : "—")
                                    </td>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 dark:text-white sm:pl-6">
                                        @(line.Description ?? "Item")
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-right font-medium text-slate-900 dark:text-white">
                                        @line.Amount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-8 text-center text-sm text-slate-500 dark:text-slate-400 italic">
                                    No line items added yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-50 dark:bg-slate-800/50">
                            <td colspan="2" class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Total Amount</td>
                            <td class="px-3 py-4 text-right text-sm font-bold text-indigo-600 dark:text-indigo-400">
                                @totalAmount.ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const toast = document.getElementById('toastAlert');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    });
</script>