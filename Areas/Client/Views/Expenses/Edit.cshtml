@model WEB_Sentro.Data.Entities.Expense
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Edit Expense";
    var sites = ViewBag.Sites as IEnumerable<WEB_Sentro.Data.Entities.Site> ?? new List<WEB_Sentro.Data.Entities.Site>();
    var purchaseOrders = ViewBag.PurchaseOrders as IEnumerable<dynamic> ?? new List<dynamic>();
    var risks = ViewBag.Risks as IEnumerable<dynamic> ?? new List<dynamic>();
    var costCodes = ViewBag.CostCodes as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="animate-in fade-in min-h-screen flex items-center justify-center p-4 duration-500">
    <div class="w-full max-w-3xl bg-white dark:bg-slate-900 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Edit Expense</h2>
                    <p class="text-xs text-slate-500 mt-1">Update details for expense on @Model.Date.ToString("MMM d, yyyy")</p>
                </div>
                <div class="flex items-center gap-2">
                    <form method="post" action="@Url.Action("Delete", "Expenses", new { area = "Client", id = Model.ExpenseId })" onsubmit="return confirm('Are you sure you want to delete this expense? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-rose-500 hover:text-rose-600 transition-colors p-2 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20" title="Delete Expense">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </form>
                    <a href="@Url.Action("Index", "Expenses", new { area = "Client" })" class="text-slate-400 hover:text-slate-500 transition-colors p-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                    </a>
                </div>
            </div>

            <form method="post" action="@Url.Action("Edit", "Expenses", new { area = "Client", id = Model.ExpenseId })" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExpenseId" value="@Model.ExpenseId" />
                
                <!-- Site & Amount -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="SiteId" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Site <span class="text-rose-500">*</span></label>
                        <select id="SiteId" name="SiteId" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            @foreach (var s in sites) { <option value="@s.SiteId" selected="@(Model.SiteId == s.SiteId)">@s.SiteName (@s.SiteCode)</option> }
                        </select>
                    </div>
                    <div>
                        <label for="Amount" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Amount <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="absolute left-3 top-2 text-slate-400 text-sm">$</span>
                            <input type="number" id="Amount" name="Amount" step="0.01" min="0.01" value="@Model.Amount.ToString("F2")" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg pl-7 pr-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all font-mono" placeholder="0.00" />
                        </div>
                    </div>
                </div>

                <!-- Cost Code & Date -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="CostCodeId" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Cost Code <span class="text-rose-500">*</span></label>
                        <select id="CostCodeId" name="CostCodeId" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="">Select Cost Code...</option>
                            @foreach (var c in costCodes)
                            {
                                <option value="@c.CostCodeId" selected="@(Model.CostCodeId == c.CostCodeId)">@c.Code - @c.Description</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="Date" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Date Incurred</label>
                        <input type="date" id="Date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                    </div>
                </div>

                <!-- Linking (Optional) -->
                <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-100 dark:border-slate-800 space-y-4">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Optional Linking</p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="PurchaseOrderId" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Link to Purchase Order</label>
                            <select id="PurchaseOrderId" name="PurchaseOrderId" class="w-full bg-white dark:bg-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                                <option value="">None</option>
                                @foreach (var p in purchaseOrders) { <option value="@p.PurchaseOrderId" selected="@(Model.PurchaseOrderId == p.PurchaseOrderId)">@p.OrderNumber ($@p.Total.ToString("N2"))</option> }
                            </select>
                        </div>
                        <div>
                            <label for="RiskId" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Link to Risk</label>
                            <select id="RiskId" name="RiskId" class="w-full bg-white dark:bg-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                                <option value="">None</option>
                                @foreach (var r in risks) { <option value="@r.RiskId" selected="@(Model.RiskId == r.RiskId)">@r.Title</option> }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- File Attachment -->
                <div>
                    <label for="attachment" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Receipt / Invoice</label>
                    
                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="mb-3 flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-100 rounded-lg dark:bg-emerald-900/20 dark:border-emerald-800">
                            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span class="text-sm text-emerald-700 dark:text-emerald-300 font-medium">Current file attached</span>
                            <a href="@Model.AttachmentPath" target="_blank" class="text-xs underline text-emerald-600 hover:text-emerald-800 dark:text-emerald-400">View File</a>
                        </div>
                    }

                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 dark:border-slate-700 border-dashed rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors cursor-pointer relative">
                        <div class="space-y-1 text-center">
                            <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <div class="flex text-sm text-slate-600 dark:text-slate-400 justify-center">
                                <label for="attachment" class="relative cursor-pointer bg-transparent rounded-md font-medium text-indigo-600 hover:text-indigo-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500">
                                    <span>@(string.IsNullOrEmpty(Model.AttachmentPath) ? "Upload a file" : "Replace file")</span>
                                    <input id="attachment" name="attachment" type="file" class="sr-only" onchange="document.getElementById('fileNameDisplay').innerText = this.files[0].name">
                                </label>
                                <p class="pl-1">or drag and drop</p>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-500">
                                PNG, JPG, PDF up to 10MB
                            </p>
                            <p id="fileNameDisplay" class="text-sm font-semibold text-indigo-600 mt-2 h-5"></p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex gap-3">
                    <a href="@Url.Action("Index", "Expenses", new { area = "Client" })" class="flex-1 px-4 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors text-center dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600 dark:hover:bg-slate-700">Cancel</a>
                    <button type="submit" class="flex-1 px-4 py-2.5 text-sm font-medium text-white bg-slate-900 rounded-lg hover:bg-slate-800 shadow-sm transition-colors dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
