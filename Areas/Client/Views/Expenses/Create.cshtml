@model WEB_Sentro.Data.Entities.Expense
@{
    Layout = "_LayoutClient";
    var sites = ViewBag.Sites as IEnumerable<WEB_Sentro.Data.Entities.Site> ?? new List<WEB_Sentro.Data.Entities.Site>();
    var purchaseOrders = ViewBag.PurchaseOrders as IEnumerable<dynamic> ?? new List<dynamic>();
    var risks = ViewBag.Risks as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            New <span class="text-indigo-500 dark:text-indigo-400 italic">Expense</span>
        </h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Record expense per site · optional link to Risk or PO</p>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 max-w-2xl">
        <form method="post" asp-action="Create" asp-controller="Expenses" asp-area="Client">
            @Html.AntiForgeryToken()
            <div class="space-y-4">
                <div>
                    <label for="SiteId" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Site *</label>
                    <select id="SiteId" name="SiteId" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">Select site</option>
                        @foreach (var s in sites) { <option value="@s.SiteId" selected="@(Model?.SiteId == s.SiteId)">@s.SiteName (@s.SiteCode)</option> }
                    </select>
                </div>
                <div>
                    <label for="Amount" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Amount *</label>
                    <input type="number" id="Amount" name="Amount" value="@Model?.Amount" step="0.01" min="0.01" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                    @if (ViewData.ModelState["Amount"]?.Errors?.Any() == true)
                    {
                        <p class="mt-1 text-xs text-rose-600 dark:text-rose-400">@ViewData.ModelState["Amount"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                    }
                </div>
                <div>
                    <label for="Category" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Category</label>
                    <select id="Category" name="Category" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="Labor" selected="@(Model?.Category == "Labor")">Labor</option>
                        <option value="Materials" selected="@(Model?.Category == "Materials")">Materials</option>
                        <option value="Equipment" selected="@(Model?.Category == "Equipment")">Equipment</option>
                        <option value="Mitigation" selected="@(Model?.Category == "Mitigation")">Mitigation</option>
                    </select>
                </div>
                <div>
                    <label for="Date" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Date</label>
                    <input type="date" id="Date" name="Date" value="@(Model?.Date.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="PurchaseOrderId" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Link to Purchase Order (optional)</label>
                    <select id="PurchaseOrderId" name="PurchaseOrderId" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">None</option>
                        @foreach (dynamic po in purchaseOrders) { <option value="@po.PurchaseOrderId" selected="@(Model?.PurchaseOrderId == (int?)po.PurchaseOrderId)">@po.OrderNumber</option> }
                    </select>
                </div>
                <div>
                    <label for="RiskId" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Link to Risk (optional)</label>
                    <select id="RiskId" name="RiskId" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">None</option>
                        @foreach (dynamic r in risks) { var title = (string)r.Title ?? ""; <option value="@r.RiskId" selected="@(Model?.RiskId == (int?)r.RiskId)">@(title.Length > 50 ? title.Substring(0, 50) + "…" : title)</option> }
                    </select>
                </div>
            </div>
            <div class="mt-6 flex gap-3">
                <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-xs font-bold text-white hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200">Create</button>
                <a href="@Url.Action("Index", "Expenses", new { area = "Client" })" class="rounded-xl border border-slate-200/70 bg-white px-6 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
            </div>
        </form>
    </div>
</div>
