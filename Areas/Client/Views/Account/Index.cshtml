@model WEB_Sentro.Areas.Client.Models.MyAccountViewModel
@{
    ViewData["Title"] = "My Account";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrEmpty(fullName)) { fullName = Model.Email ?? ""; }
    var first = Model.FirstName?.Trim().FirstOrDefault();
    var last = Model.LastName?.Trim().FirstOrDefault();
    var initials = (first != default && last != default)
        ? $"{first}{last}".ToUpperInvariant()
        : (fullName.Length >= 2 ? $"{fullName[0]}{fullName[^1]}".ToUpperInvariant() : (fullName.Length == 1 ? fullName.ToUpperInvariant() : "??"));
    var roleSubtext = Model.AccountLevelDisplay.ToUpperInvariant();
    var hasProfilePhoto = !string.IsNullOrWhiteSpace(Model.ProfileImagePath);
}

<div class="max-w-4xl mx-auto space-y-8 animate-in fade-in duration-500">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="rounded-2xl bg-emerald-100 dark:bg-emerald-900/30 border border-emerald-300 dark:border-emerald-700 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">
            @Model.Message
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="rounded-2xl bg-rose-100 dark:bg-rose-900/30 border border-rose-300 dark:border-rose-700 px-4 py-3 text-sm font-medium text-rose-800 dark:text-rose-200">
            @Model.Error
        </div>
    }

    <div class="flex items-center gap-6">
        <div class="relative group">
            <div class="h-24 w-24 rounded-[2rem] bg-gradient-to-tr from-emerald-500 to-sky-500 p-1">
                @if (hasProfilePhoto)
                {
                    <img src="@Model.ProfileImagePath" alt="Profile photo" class="h-full w-full rounded-[1.8rem] object-cover bg-white dark:bg-slate-900" />
                }
                else
                {
                    <div class="h-full w-full rounded-[1.8rem] bg-white dark:bg-slate-900 flex items-center justify-center text-3xl font-black text-slate-300">
                        @initials
                    </div>
                }
            </div>
            <form asp-area="Client" asp-controller="Account" asp-action="UpdateProfilePhoto" method="post" enctype="multipart/form-data" class="absolute -bottom-2 -right-2">
                @Html.AntiForgeryToken()
                <label class="bg-white dark:bg-slate-800 p-2 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 hover:scale-110 transition-transform cursor-pointer block" title="Upload profile photo">
                    <input type="file" name="profilePhoto" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="hidden" onchange="this.form.submit()" />
                    📸
                </label>
            </form>
        </div>
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">@(string.IsNullOrEmpty(fullName) ? "My Account" : fullName)</h1>
            <p class="text-sm font-bold text-emerald-600 uppercase tracking-widest">@roleSubtext</p>
        </div>
    </div>

    <div class="grid gap-8 md:grid-cols-12">
        <div class="md:col-span-8 space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900/50 shadow-sm">
                <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white mb-6">Personal Details</h3>
                <form asp-area="Client" asp-controller="Account" asp-action="UpdateProfile" method="post" class="grid gap-4 md:grid-cols-2">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="profile_FirstName">First Name</label>
                        <input type="text" id="profile_FirstName" name="FirstName" value="@Model.FirstName" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="profile_LastName">Last Name</label>
                        <input type="text" id="profile_LastName" name="LastName" value="@Model.LastName" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required />
                    </div>
                    <div class="md:col-span-2 space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="profile_Email">Email Address</label>
                        <input type="email" id="profile_Email" name="Email" value="@Model.Email" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required />
                    </div>
                    <div class="md:col-span-2 pt-4">
                        <button type="submit" class="rounded-xl bg-slate-900 px-6 py-3 text-xs font-black text-white dark:bg-emerald-600 transition-all hover:shadow-lg hover:shadow-emerald-500/20">
                            Update Profile
                        </button>
                    </div>
                </form>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900/50 shadow-sm">
                <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white mb-6">Security</h3>
                <div class="mb-6 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-700 dark:bg-slate-900/60">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-200">Two-Factor Authentication</p>
                            <p class="mt-1 text-xs font-semibold @(Model.IsTwoFactorEnabled ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400")">
                                @(Model.IsTwoFactorEnabled ? "Enabled" : "Not enabled")
                            </p>
                        </div>
                        @if (!Model.IsTwoFactorEnabled)
                        {
                            <form asp-area="Client" asp-controller="Account" asp-action="EnableTwoFactor" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700">
                                    Set up 2FA
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Client" asp-controller="Account" asp-action="DisableTwoFactor" method="post" onsubmit="return confirm('Disable two-factor authentication for your account?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center rounded-xl border border-rose-300 bg-rose-50 px-4 py-2 text-xs font-black uppercase tracking-widest text-rose-700 transition hover:bg-rose-100 dark:border-rose-700/60 dark:bg-rose-900/20 dark:text-rose-300 dark:hover:bg-rose-900/30">
                                    Disable 2FA
                                </button>
                            </form>
                        }
                    </div>
                </div>

                @if (Model.ShowTwoFactorSetup && !Model.IsTwoFactorEnabled)
                {
                    <div class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900/80">
                        <p class="text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-200">Complete setup</p>
                        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">1) Scan the QR code. 2) Enter the 6-digit code from your authenticator app.</p>

                        @if (!string.IsNullOrWhiteSpace(Model.TwoFactorQrCodeImage))
                        {
                            <div class="mt-4 inline-flex rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700">
                                <img src="@Model.TwoFactorQrCodeImage" alt="2FA setup QR code" class="h-52 w-52 rounded-lg" />
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.TwoFactorSharedKey))
                        {
                            <div class="mt-4">
                                <p class="text-[10px] font-black uppercase text-slate-400">Manual key</p>
                                <code class="mt-1 block break-all rounded-xl border border-dashed border-slate-300 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200">@Model.TwoFactorSharedKey</code>
                            </div>
                        }

                        <details class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                            <summary class="cursor-pointer">Show otpauth URI</summary>
                            <code class="mt-2 block break-all rounded-lg bg-slate-50 p-2 dark:bg-slate-800/80">@Model.TwoFactorOtpAuthUri</code>
                        </details>

                        <form asp-area="Client" asp-controller="Account" asp-action="VerifyTwoFactor" method="post" class="mt-4 space-y-3">
                            @Html.AntiForgeryToken()
                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="twoFactorCode">Verification Code</label>
                                <input id="twoFactorCode" name="code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" class="w-full max-w-[240px] rounded-xl border border-slate-200 bg-slate-50 p-3 text-center text-sm font-bold tracking-[0.25em] dark:border-slate-800 dark:bg-slate-950 dark:text-white" required />
                            </div>
                            <button type="submit" class="rounded-xl bg-slate-900 px-6 py-3 text-xs font-black text-white dark:bg-emerald-600 transition-all hover:shadow-lg hover:shadow-emerald-500/20">
                                Verify and enable 2FA
                            </button>
                        </form>
                    </div>
                }

                <form asp-area="Client" asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="pwd_CurrentPassword">Current Password</label>
                        <input type="password" id="pwd_CurrentPassword" name="CurrentPassword" placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="pwd_NewPassword">New Password</label>
                        <input type="password" id="pwd_NewPassword" name="NewPassword" placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required minlength="12" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1" for="pwd_ConfirmPassword">Confirm New Password</label>
                        <input type="password" id="pwd_ConfirmPassword" name="ConfirmPassword" placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white" required minlength="12" />
                    </div>
                    <button type="submit" class="rounded-xl border border-slate-200 px-6 py-3 text-xs font-black text-slate-600 dark:border-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
                        Change Password
                    </button>
                </form>
            </div>
        </div>

        <div class="md:col-span-4 space-y-6">
            <div class="rounded-3xl bg-emerald-600 p-6 text-white shadow-xl shadow-emerald-500/20">
                <h4 class="text-xs font-black uppercase tracking-widest opacity-80 mb-4">Account Level</h4>
                <div class="text-xl font-black mb-2">@Model.AccountLevelDisplay</div>
                <p class="text-[10px] font-bold opacity-90 leading-relaxed">
                    @Model.AccountLevelDescription
                </p>
                <div class="mt-6 pt-6 border-t border-white/20">
                    <div class="text-[10px] font-black uppercase mb-1">Last Login</div>
                    <div class="text-xs font-bold">@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("MMM dd, yyyy • hh:mm tt") : "—")</div>
                </div>
            </div>

            <form action="/Identity/Account/Logout" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full rounded-2xl border-2 border-rose-100 p-4 text-xs font-black uppercase tracking-widest text-rose-500 transition-all hover:bg-rose-500 hover:text-white dark:border-rose-900/30">
                    Terminate Session
                </button>
            </form>
        </div>
    </div>
</div>
