@model WEB_Sentro.Areas.Client.Controllers.MonitoringSiteEditViewModel
@{
    Layout = "_LayoutClient";
    var siteList = ViewBag.Sites as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}
<div class="animate-in fade-in min-h-screen space-y-8 duration-500">
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="text-xs font-bold tracking-widest text-slate-500 uppercase transition hover:text-emerald-600">← Monitoring Sites</a>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Edit <span class="text-emerald-500 italic">@Model.Name</span></h1>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 max-w-xl">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MonitoringSiteId" />
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="Latitude" />
            <input type="hidden" asp-for="Longitude" />
            <div class="space-y-4">
                <div>
                    <label asp-for="SiteId" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Project Site</label>
                    <select asp-for="SiteId" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                        @foreach (var item in siteList)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.SiteId?.ToString())">@item.Text</option>
                        }
                    </select>
                    <p class="mt-1 text-[10px] text-slate-400">Link this weather monitoring site to a project site. Auto-created risks will be assigned to that site.</p>
                </div>
                <div class="flex gap-3 pt-2">
                    <a asp-action="Index" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
                    <button type="submit" class="rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-emerald-700">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>
