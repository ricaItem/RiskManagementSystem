@{
    Layout = "_LayoutClient";
}

<div id="mitigation-skeleton" class="animate-pulse min-h-screen space-y-6 p-6">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div class="space-y-2">
            <div class="h-8 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-4 w-80 rounded bg-slate-100 dark:bg-slate-800"></div>
        </div>
        <div class="h-10 w-40 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
    </div>

    <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="h-24 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
        <div class="h-24 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
        <div class="h-24 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
        <div class="h-24 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <div class="h-10 w-56 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-10 w-36 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-10 w-44 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
        </div>
        <div class="h-10 w-40 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @for (var i = 0; i < 8; i++)
        {
            <div class="h-56 rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/40">
                <div class="mb-4 h-3 w-20 rounded bg-slate-100 dark:bg-slate-800"></div>
                <div class="mb-2 h-5 w-full rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-5 w-4/5 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="mt-12 h-2 w-full rounded bg-slate-100 dark:bg-slate-800"></div>
                <div class="mt-6 flex justify-between">
                    <div class="h-7 w-16 rounded bg-slate-100 dark:bg-slate-800"></div>
                    <div class="h-7 w-7 rounded bg-slate-100 dark:bg-slate-800"></div>
                </div>
            </div>
        }
    </div>
</div>

<div id="mitigation-content" class="hidden"></div>

<script>
    function initMitigationPage() {
        const contentDiv = document.getElementById('mitigation-content');
        if (!contentDiv || contentDiv.dataset.loaded === '1') return;

        const searchParams = new URLSearchParams(window.location.search);
        const url = '@Url.Action("IndexContent", "Mitigation", new { area = "Client" })' + '?' + searchParams.toString();

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error(`Mitigation content request failed: ${response.status}`);
                return response.text();
            })
            .then(html => {
                contentDiv.innerHTML = html;

                const scripts = Array.from(contentDiv.getElementsByTagName('script'));
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    if (oldScript.src) newScript.src = oldScript.src;
                    else newScript.text = oldScript.innerHTML;
                    document.body.appendChild(newScript);
                });

                const skeleton = document.getElementById('mitigation-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.dataset.loaded = '1';
            })
            .catch(error => {
                console.error('Error loading mitigation content:', error);
                const skeleton = document.getElementById('mitigation-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.innerHTML = '<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-300">Failed to load Mitigation Planning. Please refresh the page.</div>';
                contentDiv.dataset.loaded = '1';
            });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMitigationPage);
    } else {
        initMitigationPage();
    }
</script>
