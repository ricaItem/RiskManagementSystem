@model IEnumerable<Web_Sentro.Areas.Client.Models.MitigationRiskCardViewModel>
@{
    Layout = "_LayoutClient";
    var currentFilter = ViewBag.Filter as string ?? "active";

    string PriorityTone(string? p)
    {
        p ??= "";
        if (p.Contains("Critical", StringComparison.OrdinalIgnoreCase)) return "critical";
        if (p.Contains("High", StringComparison.OrdinalIgnoreCase)) return "high";
        if (p.Contains("Medium", StringComparison.OrdinalIgnoreCase)) return "medium";
        if (p.Contains("Low", StringComparison.OrdinalIgnoreCase)) return "low";
        return "normal";
    }

    string PriorityLabel(string? p) => string.IsNullOrWhiteSpace(p) ? "NORMAL" : p.Trim().ToUpperInvariant();

    string PriorityDotClass(string tone) => tone switch
    {
        "critical" => "bg-[#E2445C]",
        "high" => "bg-[#FDAB3D]",
        "medium" => "bg-[#A25DDC]",
        "low" => "bg-[#00C875]",
        _ => "bg-slate-300"
    };

    int ClampPercent(int p) => Math.Max(0, Math.Min(100, p));

    int PriorityRank(string? p)
    {
        p ??= "";
        if (p.Contains("Critical", StringComparison.OrdinalIgnoreCase)) return 4;
        if (p.Contains("High", StringComparison.OrdinalIgnoreCase)) return 3;
        if (p.Contains("Medium", StringComparison.OrdinalIgnoreCase)) return 2;
        if (p.Contains("Low", StringComparison.OrdinalIgnoreCase)) return 1;
        return 0;
    }

    // Summary numbers (server-side)
    var total = Model.Count();
    var avgProgress = total == 0 ? 0 : (int)Math.Round(Model.Average(x => ClampPercent(x.ProgressPercent)));
    var criticalCount = Model.Count(x => (x.Priority ?? "").Contains("Critical", StringComparison.OrdinalIgnoreCase));
    var archivedCount = Model.Count(x => x.IsArchived);
    var activeCount = total - archivedCount;
}

@Html.AntiForgeryToken()

<div class="animate-in fade-in min-h-screen w-full duration-1000">
    <div class="w-full">
        <!-- Title, KPI cards, and search bar with consistent spacing -->
        <div class="space-y-5">
            <!-- Page title -->
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                    Mitigation <span class="italic" style="color: var(--brand-accent);">Planning</span>
                </h1>
                <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Strategy execution</p>
            </div>

            <!-- KPI strip -->
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                <p class="font-black tracking-widest text-[9px] text-slate-400 uppercase dark:text-slate-500">Total</p>
                <p class="mt-1 text-2xl font-black text-slate-900 dark:text-white">@total</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                <p class="font-black tracking-widest text-[9px] text-slate-400 uppercase dark:text-slate-500">Avg progress</p>
                <p class="mt-1 text-2xl font-black text-slate-900 dark:text-white">@avgProgress%</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                <p class="font-black tracking-widest text-[9px] text-slate-400 uppercase dark:text-slate-500">Critical</p>
                <p class="mt-1 text-2xl font-black text-rose-600 dark:text-rose-400">@criticalCount</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/80">
                <p class="font-black tracking-widest text-[9px] text-slate-400 uppercase dark:text-slate-500">Active</p>
                <p class="mt-1 text-2xl font-black text-emerald-600 dark:text-emerald-400">@activeCount</p>
            </div>
            </div>

            <!-- Search bar group (below KPI cards) -->
            <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/90 px-4 py-3 dark:border-slate-700/80 dark:bg-slate-900/50">
            <select id="statusFilter" class="h-9 rounded-xl border border-slate-200 bg-white px-3.5 text-[10px] font-black uppercase tracking-wider outline-none focus:ring-2 focus:ring-[var(--brand-accent)] dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"
                    onchange="window.location.href = '@Url.Action("Index", "Mitigation", new { area = "Client" })' + '?filter=' + this.value;">
                <option value="active" @(currentFilter == "active" ? "selected" : "")>Active</option>
                <option value="archived" @(currentFilter == "archived" ? "selected" : "")>Archived</option>
            </select>
            <div class="relative min-w-[160px] max-w-[220px] flex-1">
                <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" id="riskSearch" placeholder="Search strategy..." class="h-9 w-full rounded-xl border border-slate-200 bg-slate-50/80 py-2 pl-9 pr-3 text-xs font-bold outline-none focus:ring-2 focus:ring-[var(--brand-accent)] dark:border-slate-600 dark:bg-slate-800/80 dark:text-white" />
            </div>
            <select id="categoryFilter" class="h-9 rounded-xl border border-slate-200 bg-white px-3.5 text-[10px] font-black uppercase tracking-wider outline-none focus:ring-2 focus:ring-[var(--brand-accent)] dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                <option value="">All categories</option>
                <option value="Operational">Operational</option>
                <option value="Financial">Financial</option>
                <option value="Safety">Safety</option>
            </select>
            <select id="sortBy" class="h-9 rounded-xl border border-slate-200 bg-white px-3.5 text-[10px] font-black uppercase tracking-wider outline-none focus:ring-2 focus:ring-[var(--brand-accent)] dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                <option value="recent">Recent</option>
                <option value="title_asc">Title A–Z</option>
                <option value="priority_desc">Priority ↓</option>
                <option value="progress_desc">Progress ↓</option>
            </select>
            <div class="ml-auto flex items-center gap-2">
                <div class="flex rounded-xl border border-slate-200 bg-slate-100/80 p-0.5 dark:border-slate-600 dark:bg-slate-800/80">
                    <button type="button" onclick="switchView('grid')" id="gridBtn" class="rounded-lg p-2 transition-all bg-white shadow-sm text-indigo-600 dark:bg-slate-700 dark:text-indigo-300" aria-label="Grid view">
                        <svg class="h-4 w-4 text-indigo-600 dark:text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                    </button>
                    <button type="button" onclick="switchView('list')" id="listBtn" class="rounded-lg p-2 text-slate-400 transition-all hover:text-slate-600 dark:hover:text-slate-200" aria-label="List view">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                </div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400"><span id="visibleCount">@total</span> / @total</span>
            </div>
            </div>
        </div>

        <!-- Main content (full width) -->
        <div class="mt-6">
                <!-- Empty results -->
                <div id="noResults" class="hidden mb-6 rounded-xl border border-dashed border-slate-200 bg-white p-6 text-center">
                    <div class="text-sm font-black text-slate-800">No results</div>
                    <div class="mt-1 text-xs font-bold text-slate-500">Try clearing search / category filters.</div>
                    <button type="button" onclick="clearFilters()"
                            class="mt-4 inline-flex h-9 items-center rounded-lg bg-slate-900 px-4 text-[10px] font-black uppercase tracking-widest text-white">
                        Clear filters
                    </button>
                </div>

                <!-- YOUR GRID (UNCHANGED CARD MARKUP INSIDE) -->
                <div id="gridView" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    @foreach (var risk in Model)
                    {
                        var tone = PriorityTone(risk.Priority);
                        var pct = ClampPercent(risk.ProgressPercent);
                        var boardUrl = risk.IsArchived ? "#" : Url.Action("Board", "Mitigation", new { area = "Client", riskId = risk.RiskId });

                        // Added ONLY data attributes for filtering/sorting; card HTML untouched
                        <div class="mitigation-item group relative flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:border-slate-300"
                             data-title="@risk.Title"
                             data-category="@risk.Category"
                             data-plan-id="@risk.PlanId"
                             data-priority="@PriorityLabel(risk.Priority)"
                             data-priority-rank="@PriorityRank(risk.Priority)"
                             data-progress="@pct">

                            <div class="flex items-center justify-between mb-4">
                                <span class="font-black tracking-widest text-[9px] text-slate-400 uppercase">@risk.Category</span>
                                <div class="flex items-center gap-2">
                                    @if (tone == "critical")
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-black uppercase tracking-wide text-rose-600 dark:bg-rose-900/30 dark:text-rose-400">
                                            <span class="h-2 w-2 rounded-full bg-rose-500"></span>@PriorityLabel(risk.Priority)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[8px] font-black uppercase text-slate-400">@PriorityLabel(risk.Priority)</span>
                                        <div class="h-2.5 w-2.5 rounded-full @PriorityDotClass(tone)"></div>
                                    }
                                    @if (!risk.IsArchived)
                                    {
                                        <div class="relative">
                                            <button type="button" onclick="event.stopPropagation(); toggleCardMenu(this)" aria-label="Options" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600">
                                                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" /></svg>
                                            </button>
                                            <div class="card-dropdown absolute right-0 top-full z-20 mt-1 hidden min-w-[140px] rounded-xl border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-800">
                                                <button type="button" onclick="event.stopPropagation(); openArchivePlanConfirm(this)" class="flex w-full items-center gap-2 px-4 py-2.5 text-left text-xs font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-700 dark:text-slate-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-300">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                                                    Archive plan
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <h3 class="mb-6 text-[18px] font-bold text-slate-800">@risk.Title</h3>

                            <div class="mb-6">
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-[9px] font-black uppercase text-slate-400">Done</span>
                                    <span class="text-[10px] font-black text-slate-600">@pct%</span>
                                </div>
                                <div class="h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full bg-[#00C875]" style="width: @(pct + "%")"></div>
                                </div>
                            </div>

                            <div class="h-px w-full bg-slate-100 mb-4"></div>

                            <div class="flex items-center justify-between">
                                <div class="flex -space-x-2">
                                    @foreach (var name in risk.AssignedToDisplayNames.Take(3))
                                    {
                                        <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-indigo-100 text-[10px] font-black text-indigo-700">
                                            @name[0]
                                        </div>
                                    }
                                </div>
                                <a href="@boardUrl" class="rounded-md bg-[#1e293b] px-4 py-2 text-[10px] font-black tracking-widest text-white uppercase hover:bg-slate-700">
                                    View Board
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- YOUR LIST VIEW (card untouched; only data attributes + filtering/sorting will work) -->
                <div id="listView" class="hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Strategy</th>
                                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Priority</th>
                                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Progress</th>
                                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100" id="listTbody">
                            @foreach (var risk in Model)
                            {
                                var tone = PriorityTone(risk.Priority);
                                var pct = ClampPercent(risk.ProgressPercent);
                                var boardUrl = risk.IsArchived ? "#" : Url.Action("Board", "Mitigation", new { area = "Client", riskId = risk.RiskId });

                                <tr class="mitigation-item hover:bg-slate-50 transition-colors"
                                    data-title="@risk.Title"
                                    data-category="@risk.Category"
                                    data-priority="@PriorityLabel(risk.Priority)"
                                    data-priority-rank="@PriorityRank(risk.Priority)"
                                    data-progress="@pct">
                                    <td class="px-6 py-4">
                                        <div class="text-[9px] font-black text-indigo-500 uppercase">@risk.Category</div>
                                        <div class="text-sm font-bold text-slate-800">@risk.Title</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (tone == "critical")
                                        {
                                            <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase text-rose-600 dark:text-rose-400">
                                                <span class="h-2 w-2 rounded-full bg-rose-500"></span>@PriorityLabel(risk.Priority)
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="flex items-center gap-2">
                                                <div class="h-2 w-2 rounded-full @PriorityDotClass(tone)"></div>
                                                <span class="text-[10px] font-black uppercase text-slate-600">@PriorityLabel(risk.Priority)</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 w-48">
                                        <div class="flex items-center gap-3">
                                            <div class="h-1.5 flex-1 rounded-full bg-slate-100 overflow-hidden">
                                                <div class="h-full bg-[#00C875]" style="width: @(pct + "%")"></div>
                                            </div>
                                            <span class="text-[10px] font-black text-slate-500">@pct%</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="@boardUrl" class="inline-block rounded-md bg-[#1e293b] px-4 py-2 text-[10px] font-black tracking-widest text-white uppercase hover:bg-slate-700">
                                            View Board
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
    </div>
</div>

<!-- Archive plan confirmation (unchanged) -->
<div id="archivePlanConfirmModal" class="fixed inset-0 z-[70] hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeArchivePlanConfirm()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-lg font-black text-slate-900 dark:text-white">Archive this mitigation plan?</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">The plan will be moved to Archived. You can view it under the Archived filter.</p>
            <div class="mt-6 flex gap-3">
                <button type="button" onclick="closeArchivePlanConfirm()" class="flex-1 rounded-xl bg-slate-100 py-3 font-black text-[10px] uppercase text-slate-600 dark:bg-slate-700 dark:text-slate-200">Cancel</button>
                <button type="button" id="archivePlanConfirmBtn" class="flex-1 rounded-xl bg-amber-600 py-3 font-black text-[10px] uppercase text-white">Archive</button>
            </div>
        </div>
    </div>
</div>

<script>
    function switchView(type) {
        const gView = document.getElementById('gridView');
        const lView = document.getElementById('listView');
        const gBtn = document.getElementById('gridBtn');
        const lBtn = document.getElementById('listBtn');

        const activeClasses = ['bg-white', 'shadow-sm', 'text-indigo-600', 'dark:bg-slate-700', 'dark:text-indigo-300'];
        const inactiveClasses = ['text-slate-400'];
        function setActive(btn) { activeClasses.forEach(c => btn.classList.add(c)); inactiveClasses.forEach(c => btn.classList.remove(c)); }
        function setInactive(btn) { activeClasses.forEach(c => btn.classList.remove(c)); inactiveClasses.forEach(c => btn.classList.add(c)); }
        if (type === 'grid') {
            gView.classList.remove('hidden');
            lView.classList.add('hidden');
            setActive(gBtn);
            setInactive(lBtn);
        } else {
            lView.classList.remove('hidden');
            gView.classList.add('hidden');
            setActive(lBtn);
            setInactive(gBtn);
        }
        updateVisibleCount();
    }

    // --- NEW: unified filtering (search + category) ---
    const searchEl = document.getElementById('riskSearch');
    const categoryEl = document.getElementById('categoryFilter');
    const sortEl = document.getElementById('sortBy');

    function applyFilters() {
        const val = (searchEl.value || '').toLowerCase().trim();
        const cat = (categoryEl.value || '').toLowerCase().trim();

        document.querySelectorAll('.mitigation-item').forEach(item => {
            const title = (item.dataset.title || '').toLowerCase();
            const category = (item.dataset.category || '').toLowerCase();

            const okSearch = !val || title.includes(val) || category.includes(val);
            const okCat = !cat || category === cat;

            item.style.display = (okSearch && okCat) ? '' : 'none';
        });

        updateVisibleCount();
        toggleNoResults();
    }

    function updateVisibleCount() {
        const visible = Array.from(document.querySelectorAll('.mitigation-item'))
            .filter(el => el.style.display !== 'none').length;

        const c = document.getElementById('visibleCount');
        if (c) c.textContent = visible.toString();
    }

    function toggleNoResults() {
        const box = document.getElementById('noResults');
        if (!box) return;

        const anyVisible = Array.from(document.querySelectorAll('#gridView .mitigation-item'))
            .some(el => el.style.display !== 'none');

        box.classList.toggle('hidden', anyVisible);
    }

    // --- NEW: sorting (grid + list) ---
    function sortItems() {
        const mode = sortEl.value;

        // grid sorting
        const grid = document.getElementById('gridView');
        if (grid) {
            const cards = Array.from(grid.querySelectorAll('.mitigation-item'));
            const sorted = sortArray(cards, mode);
            sorted.forEach(n => grid.appendChild(n));
        }

        // list sorting
        const tbody = document.getElementById('listTbody');
        if (tbody) {
            const rows = Array.from(tbody.querySelectorAll('.mitigation-item'));
            const sortedRows = sortArray(rows, mode);
            sortedRows.forEach(n => tbody.appendChild(n));
        }
    }

    function sortArray(arr, mode) {
        // NOTE: "recent" uses existing order (no change)
        if (mode === 'recent') return arr;

        const copy = arr.slice();
        copy.sort((a, b) => {
            const at = (a.dataset.title || '').toLowerCase();
            const bt = (b.dataset.title || '').toLowerCase();

            const apr = parseInt(a.dataset.priorityRank || '0', 10);
            const bpr = parseInt(b.dataset.priorityRank || '0', 10);

            const apg = parseInt(a.dataset.progress || '0', 10);
            const bpg = parseInt(b.dataset.progress || '0', 10);

            if (mode === 'title_asc') return at.localeCompare(bt);
            if (mode === 'priority_desc') return bpr - apr;
            if (mode === 'progress_desc') return bpg - apg;

            return 0;
        });
        return copy;
    }

    function clearFilters() {
        searchEl.value = '';
        categoryEl.value = '';
        sortEl.value = 'recent';
        applyFilters();
        sortItems();
    }

    searchEl.addEventListener('input', applyFilters);
    categoryEl.addEventListener('change', applyFilters);
    sortEl.addEventListener('change', () => { sortItems(); applyFilters(); });

    // Keep your existing dropdown + archive logic
    function toggleCardMenu(btn) {
        const dropdown = btn.nextElementSibling;
        if (!dropdown || !dropdown.classList.contains('card-dropdown')) return;
        document.querySelectorAll('.card-dropdown').forEach(d => d.classList.add('hidden'));
        dropdown.classList.toggle('hidden');
    }
    document.addEventListener('click', function() {
        document.querySelectorAll('.card-dropdown').forEach(d => d.classList.add('hidden'));
    });

    const __archivePlanUrl = '@Url.Action("SoftDeletePlan", "Mitigation", new { area = "Client" })';
    let __archivePlanId = null;

    function openArchivePlanConfirm(btn) {
        const card = btn.closest('.mitigation-item');
        if (!card) return;
        __archivePlanId = card.getAttribute('data-plan-id');
        if (!__archivePlanId) return;
        document.querySelectorAll('.card-dropdown').forEach(d => d.classList.add('hidden'));
        document.getElementById('archivePlanConfirmModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    function closeArchivePlanConfirm() {
        document.getElementById('archivePlanConfirmModal').classList.add('hidden');
        document.body.style.overflow = '';
        __archivePlanId = null;
    }
    document.getElementById('archivePlanConfirmBtn').addEventListener('click', function() {
        if (!__archivePlanId) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        if (!token) return;
        const body = '__RequestVerificationToken=' + encodeURIComponent(token) + '&planId=' + encodeURIComponent(__archivePlanId);
        this.disabled = true;
        fetch(__archivePlanUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
            .then(r => r.json())
            .then(data => { if (data && data.ok) { closeArchivePlanConfirm(); window.location.reload(); } })
            .finally(() => { this.disabled = false; });
    });

    // initial
    applyFilters();
    sortItems();
</script>