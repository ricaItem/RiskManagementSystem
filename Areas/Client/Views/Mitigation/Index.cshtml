@model IEnumerable<Web_Sentro.Areas.Client.Models.MitigationRiskCardViewModel>
@{
    Layout = "_LayoutClient";
}
<div class="h-[calc(100vh-120px)] flex flex-col space-y-6 animate-in fade-in zoom-in duration-500">
    <div class="px-2">
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            Mitigation <span class="text-indigo-600">Planning</span>
        </h1>
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Risks requiring mitigation — open a risk to manage its plan</p>
    </div>

    <div class="flex-1 overflow-y-auto pb-4 custom-scrollbar">
        @if (!Model.Any())
        {
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 p-8 text-center text-slate-500">
                <p class="font-semibold">No risks in mitigation</p>
                <p class="text-sm mt-1">Risks with status <strong>Mitigation Required</strong> will appear here. Complete an assessment and choose mitigation to add risks.</p>
            </div>
        }
        else
        {
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var risk in Model)
                {
                    var boardUrl = Url.Action("Board", "Mitigation", new { area = "Client", riskId = risk.RiskId });
                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-indigo-500/50 dark:hover:border-indigo-400/50 transition-all group">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-[9px] font-black px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 uppercase">@(risk.Priority ?? "—")</span>
                            @if (!string.IsNullOrEmpty(risk.Category))
                            {
                                <span class="text-[9px] text-slate-400">@risk.Category</span>
                            }
                        </div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200 leading-snug">@risk.Title</h3>
                        <p class="text-[10px] text-slate-400 mt-2">Added @risk.CreatedAt.ToString("MMM d, yyyy")</p>
                        <a href="@boardUrl" class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-wider hover:bg-indigo-500 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
                            Open Board
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
