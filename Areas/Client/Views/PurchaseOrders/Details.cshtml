@model WEB_Sentro.Data.Entities.PurchaseOrder
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "PO Details";
    var totalLines = Model.LineItems?.Sum(l => l.Total) ?? 0;
    
    var statusColor = Model.Status switch 
    {
        "Received" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-900/20 dark:text-emerald-400",
        "Cancelled" => "bg-slate-100 text-slate-700 ring-slate-600/20 dark:bg-slate-800 dark:text-slate-400",
        "Sent" => "bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-900/20 dark:text-blue-400",
        _ => "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/20 dark:text-amber-400"
    };
}

<div class="animate-in fade-in min-h-screen space-y-6 max-w-5xl mx-auto p-6 duration-700">
    
    @if (TempData["Message"] != null)
    {
        <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
            <div class="bg-emerald-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="text-sm font-medium">@TempData["Message"]</span>
            </div>
        </div>
    }

    <!-- Header / Nav -->
    <div class="flex items-center justify-between">
        <a href="@Url.Action("Index", "PurchaseOrders", new { area = "Client" })" class="flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Back to Orders
        </a>
        <div class="flex gap-2">
            <a href="@Url.Action("Edit", "PurchaseOrders", new { area = "Client", id = Model.PurchaseOrderId })" class="rounded-lg bg-white border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-700 transition-colors">
                Edit Details
            </a>
            @if (Model.Status != "Cancelled" && Model.Status != "Received")
            {
                <a href="@Url.Action("Index", "Expenses", new { area = "Client", purchaseOrderId = Model.PurchaseOrderId })" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Add Expense
                </a>
            }
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
        
        <!-- Order Header -->
        <div class="p-8 border-b border-slate-100 dark:border-slate-800">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">@Model.OrderNumber</h1>
                        <span class="inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset @statusColor">
                            @Model.Status
                        </span>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Created on @Model.OrderDate.ToString("MMMM d, yyyy")</p>
                </div>
                
                @if (Model.Status != "Cancelled" && Model.Status != "Received")
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-500 uppercase tracking-wide mr-2">Update Status:</span>
                        @foreach (var s in new[] { "Draft", "Sent", "Received", "Cancelled" }.Where(s => s != Model.Status))
                        {
                            <form method="post" action="@Url.Action("UpdateStatus", "PurchaseOrders", new { area = "Client", id = Model.PurchaseOrderId })" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="@s" />
                                <button type="submit" class="px-3 py-1.5 text-xs font-medium rounded-md border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 transition-colors dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">@s</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 p-8 bg-slate-50/50 dark:bg-slate-800/20">
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Order Information</h3>
                <div class="space-y-4">
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Site</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.Site?.SiteName ?? "—")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Supplier</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.Supplier?.Name ?? "—")</span>
                    </div>
                </div>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Dates & Logistics</h3>
                <div class="space-y-4">
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Expected Delivery</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.ExpectedDeliveryDate?.ToString("MMM d, yyyy") ?? "—")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-200/50 dark:border-slate-700/50">
                        <span class="text-sm text-slate-500">Last Updated</span>
                        <span class="text-sm font-medium text-slate-900 dark:text-white">@(Model.UpdatedAt.ToString("MMM d, yyyy") ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="p-8">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-6">Line Items & Expenses</h3>
            
            <div class="overflow-hidden ring-1 ring-slate-200 dark:ring-slate-800 sm:rounded-lg">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
                    <thead class="bg-slate-50 dark:bg-slate-800">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-slate-900 dark:text-white sm:pl-6">Description</th>
                            <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold text-slate-900 dark:text-white">Qty</th>
                            <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold text-slate-900 dark:text-white">Unit Cost</th>
                            <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold text-slate-900 dark:text-white">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                        @if (Model.LineItems?.Any() == true)
                        {
                            @foreach (var line in Model.LineItems)
                            {
                                <tr>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 dark:text-white sm:pl-6">
                                        @(line.Description ?? "Item")
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-slate-500 dark:text-slate-400">
                                        @line.Quantity.ToString("N2")
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-slate-500 dark:text-slate-400">
                                        @line.UnitCost.ToString("N2")
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-right font-medium text-slate-900 dark:text-white">
                                        @line.Total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-sm text-slate-500 dark:text-slate-400 italic">
                                    No line items added yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-slate-50 dark:bg-slate-800/50">
                            <td colspan="3" class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Total Amount</td>
                            <td class="px-3 py-4 text-right text-sm font-bold text-indigo-600 dark:text-indigo-400">
                                @totalLines.ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const toast = document.getElementById('toastAlert');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    });
</script>