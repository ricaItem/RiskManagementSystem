@model WEB_Sentro.Data.Entities.PurchaseOrder
@{
    Layout = "_LayoutClient";
    var totalLines = Model.LineItems?.Sum(l => l.Total) ?? 0;
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    @if (TempData["Message"] != null)
    {
        <div class="rounded-xl bg-emerald-100 px-4 py-3 text-sm text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">@TempData["Message"]</div>
    }
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                <span class="text-indigo-500 dark:text-indigo-400 italic">@Model.OrderNumber</span>
            </h1>
            <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">@Model.Site?.SiteName · @Model.Supplier?.Name</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("Edit", "PurchaseOrders", new { area = "Client", id = Model.PurchaseOrderId })" class="rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Edit</a>
            <a href="@Url.Action("Index", "PurchaseOrders", new { area = "Client" })" class="rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Back to list</a>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <h3 class="text-xs font-black tracking-widest text-slate-500 uppercase dark:text-slate-400 mb-4">Details</h3>
            <dl class="space-y-2 text-sm">
                <div><dt class="text-[10px] font-bold text-slate-400 uppercase">Site</dt><dd class="font-medium text-slate-900 dark:text-white">@(Model.Site?.SiteName ?? "—")</dd></div>
                <div><dt class="text-[10px] font-bold text-slate-400 uppercase">Supplier</dt><dd class="font-medium text-slate-900 dark:text-white">@(Model.Supplier?.Name ?? "—")</dd></div>
                <div><dt class="text-[10px] font-bold text-slate-400 uppercase">Order date</dt><dd class="font-medium text-slate-900 dark:text-white">@Model.OrderDate.ToString("d")</dd></div>
                <div><dt class="text-[10px] font-bold text-slate-400 uppercase">Status</dt><dd><span class="rounded-lg bg-indigo-500/10 px-2 py-1 text-[10px] font-bold text-indigo-600 dark:text-indigo-400">@Model.Status</span></dd></div>
            </dl>
            @if (Model.Status != "Cancelled" && Model.Status != "Received")
            {
                <div class="mt-4 pt-4 border-t border-slate-200/70 dark:border-slate-800">
                    <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase mb-2">Update status</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var s in new[] { "Draft", "Sent", "Received", "Cancelled" }.Where(s => s != Model.Status))
                        {
                            <form method="post" action="@Url.Action("UpdateStatus", "PurchaseOrders", new { area = "Client", id = Model.PurchaseOrderId })" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="@s" />
                                <button type="submit" class="rounded-lg border border-slate-200/70 bg-white px-3 py-1.5 text-[10px] font-bold text-slate-600 hover:bg-indigo-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700">@s</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <h3 class="text-xs font-black tracking-widest text-slate-500 uppercase dark:text-slate-400 mb-4">Line items</h3>
            @if (Model.LineItems?.Any() == true)
            {
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200/70 text-[10px] font-bold text-slate-500 uppercase dark:border-slate-800 dark:text-slate-400">
                            <th class="pb-2">Description</th>
                            <th class="pb-2 text-right">Qty</th>
                            <th class="pb-2 text-right">Unit cost</th>
                            <th class="pb-2 text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200/70 dark:divide-slate-800">
                        @foreach (var line in Model.LineItems)
                        {
                            <tr>
                                <td class="py-2 text-slate-700 dark:text-slate-300">@(line.Description ?? "—")</td>
                                <td class="py-2 text-right text-slate-700 dark:text-slate-300">@line.Quantity.ToString("N2")</td>
                                <td class="py-2 text-right text-slate-700 dark:text-slate-300">@line.UnitCost.ToString("N2")</td>
                                <td class="py-2 text-right font-medium text-slate-900 dark:text-white">@line.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="mt-3 text-right font-bold text-slate-900 dark:text-white">Total: @totalLines.ToString("N2")</p>
            }
            else
            {
                <p class="text-sm text-slate-500 dark:text-slate-400">No line items.</p>
            }
        </div>
    </div>
</div>
