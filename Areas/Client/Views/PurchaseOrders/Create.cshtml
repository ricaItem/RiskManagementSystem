@model WEB_Sentro.Data.Entities.PurchaseOrder
@{
    Layout = "_LayoutClient";
    var sites = ViewBag.Sites as IEnumerable<WEB_Sentro.Data.Entities.Site> ?? new List<WEB_Sentro.Data.Entities.Site>();
    var suppliers = ViewBag.Suppliers as IEnumerable<WEB_Sentro.Data.Entities.Supplier> ?? new List<WEB_Sentro.Data.Entities.Supplier>();
    var suggested = ViewBag.SuggestedOrderNumber as string ?? "PO-001";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            New <span class="text-indigo-500 dark:text-indigo-400 italic">Purchase Order</span>
        </h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Create PO per site</p>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 max-w-2xl">
        <form method="post" asp-action="Create" asp-controller="PurchaseOrders" asp-area="Client">
            @Html.AntiForgeryToken()
            <div class="space-y-4">
                <div>
                    <label for="SiteId" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Site *</label>
                    <select id="SiteId" name="SiteId" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">Select site</option>
                        @foreach (var s in sites) { <option value="@s.SiteId" selected="@(Model?.SiteId == s.SiteId)">@s.SiteName (@s.SiteCode)</option> }
                    </select>
                </div>
                <div>
                    <label for="SupplierId" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Supplier *</label>
                    <select id="SupplierId" name="SupplierId" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">Select supplier</option>
                        @foreach (var s in suppliers) { <option value="@s.SupplierId" selected="@(Model?.SupplierId == s.SupplierId)">@s.Name</option> }
                    </select>
                </div>
                <div>
                    <label for="OrderNumber" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Order number *</label>
                    <input type="text" id="OrderNumber" name="OrderNumber" value="@(Model?.OrderNumber ?? suggested)" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="OrderDate" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Order date</label>
                    <input type="date" id="OrderDate" name="OrderDate" value="@(Model?.OrderDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="Status" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Status</label>
                    <select id="Status" name="Status" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="Draft" selected>Draft</option>
                        <option value="Sent">Sent</option>
                        <option value="Received">Received</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="pt-4 border-t border-slate-200/70 dark:border-slate-800">
                    <p class="text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">First line item (optional)</p>
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
                        <input type="text" name="lineDescription" placeholder="Description" class="rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 md:col-span-3" />
                        <input type="number" name="lineQuantity" step="0.01" min="0" placeholder="Quantity" class="rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                        <input type="number" name="lineUnitCost" step="0.01" min="0" placeholder="Unit cost" class="rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                    </div>
                </div>
            </div>
            <div class="mt-6 flex gap-3">
                <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-xs font-bold text-white hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200">Create PO</button>
                <a href="@Url.Action("Index", "PurchaseOrders", new { area = "Client" })" class="rounded-xl border border-slate-200/70 bg-white px-6 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
            </div>
        </form>
    </div>
</div>
