@model WEB_Sentro.Data.Entities.Supplier
@{
    Layout = "_LayoutClient";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Delete <span class="text-rose-500 dark:text-rose-400 italic">Supplier</span>
        </h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">This action cannot be undone.</p>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 max-w-xl">
        <p class="text-sm text-slate-600 dark:text-slate-300">Are you sure you want to delete supplier <strong class="text-slate-900 dark:text-white">@Model.Name</strong>?</p>
        <form method="post" asp-action="Delete" asp-controller="Suppliers" asp-area="Client" class="mt-6 flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.SupplierId" />
            <button type="submit" class="rounded-xl bg-rose-500 px-6 py-2.5 text-xs font-bold text-white hover:bg-rose-600">Delete</button>
            <a href="@Url.Action("Index", "Suppliers", new { area = "Client" })" class="rounded-xl border border-slate-200/70 bg-white px-6 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
        </form>
    </div>
</div>
