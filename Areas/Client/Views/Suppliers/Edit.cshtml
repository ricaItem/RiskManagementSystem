@model WEB_Sentro.Data.Entities.Supplier
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Edit Supplier";
}

<div class="animate-in fade-in min-h-screen flex items-center justify-center p-4 duration-500">
    <div class="w-full max-w-lg proj-card overflow-hidden">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Edit Supplier</h2>
                    <p class="text-xs text-slate-500 mt-1">Update vendor details and contact info</p>
                </div>
                <a href="@Url.Action("Index", "Suppliers", new { area = "Client" })" class="text-slate-400 hover:text-slate-500 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </a>
            </div>

            <form method="post" asp-action="Edit" asp-controller="Suppliers" asp-area="Client" class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SupplierId" value="@Model.SupplierId" />
                
                <div>
                    <label for="Name" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Supplier Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="Name" name="Name" value="@Model.Name" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" />
                    @if (ViewData.ModelState["Name"]?.Errors?.Any() == true)
                    {
                        <p class="mt-1 text-xs text-rose-600 dark:text-rose-400">@ViewData.ModelState["Name"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                    }
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="ContactPerson" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Contact Person</label>
                        <input type="text" id="ContactPerson" name="ContactPerson" value="@Model.ContactPerson" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" />
                    </div>
                    <div>
                        <label for="Category" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Category</label>
                        <select id="Category" name="Category" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Materials" selected="@(Model.Category == "Materials")">Materials</option>
                            <option value="Equipment" selected="@(Model.Category == "Equipment")">Equipment</option>
                            <option value="Services" selected="@(Model.Category == "Services")">Services</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label for="Email" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Email Address</label>
                    <input type="email" id="Email" name="Email" value="@Model.Email" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" />
                </div>

                <div>
                    <label for="Phone" class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Phone Number</label>
                    <input type="text" id="Phone" name="Phone" value="@Model.Phone" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" />
                </div>

                <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-800 flex gap-3">
                    <a href="@Url.Action("Index", "Suppliers", new { area = "Client" })" class="flex-1 px-4 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors text-center dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600 dark:hover:bg-slate-700">Cancel</a>
                    <button type="submit" class="flex-1 px-4 py-2.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 shadow-sm transition-colors">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
