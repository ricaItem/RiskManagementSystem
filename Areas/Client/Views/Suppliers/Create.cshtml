@model WEB_Sentro.Data.Entities.Supplier
@{
    Layout = "_LayoutClient";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            New <span class="text-indigo-500 dark:text-indigo-400 italic">Supplier</span>
        </h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Add a supplier to your organization</p>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 max-w-2xl">
        <form method="post" asp-action="Create" asp-controller="Suppliers" asp-area="Client">
            @Html.AntiForgeryToken()
            <div class="space-y-4">
                <div>
                    <label for="Name" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Name *</label>
                    <input type="text" id="Name" name="Name" value="@Model?.Name" required class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                    @if (ViewData.ModelState["Name"]?.Errors?.Any() == true)
                    {
                        <p class="mt-1 text-xs text-rose-600 dark:text-rose-400">@ViewData.ModelState["Name"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                    }
                </div>
                <div>
                    <label for="ContactPerson" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Contact person</label>
                    <input type="text" id="ContactPerson" name="ContactPerson" value="@Model?.ContactPerson" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="Email" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Email</label>
                    <input type="email" id="Email" name="Email" value="@Model?.Email" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="Phone" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Phone</label>
                    <input type="text" id="Phone" name="Phone" value="@Model?.Phone" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                </div>
                <div>
                    <label for="Category" class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-1">Category</label>
                    <select id="Category" name="Category" class="w-full rounded-xl border border-slate-200/70 bg-white px-4 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        <option value="Materials" selected="@(Model?.Category == "Materials")">Materials</option>
                        <option value="Equipment" selected="@(Model?.Category == "Equipment")">Equipment</option>
                        <option value="Services" selected="@(Model?.Category == "Services")">Services</option>
                    </select>
                </div>
            </div>
            <div class="mt-6 flex gap-3">
                <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-xs font-bold text-white hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200">Create</button>
                <a href="@Url.Action("Index", "Suppliers", new { area = "Client" })" class="rounded-xl border border-slate-200/70 bg-white px-6 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
            </div>
        </form>
    </div>
</div>
