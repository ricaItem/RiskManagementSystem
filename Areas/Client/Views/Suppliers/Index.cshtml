@model Web_Sentro.Areas.Client.Models.PagedResult<WEB_Sentro.Data.Entities.Supplier>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Supplier Directory";
    var categories = ViewBag.Categories as string[] ?? new[] { "Materials", "Equipment", "Services" };
    var categoryFilter = ViewBag.CategoryFilter as string;
    var search = ViewBag.Search as string;

    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = null // Keep PascalCase to match JS usage if needed, or stick to default
    };
}

@if (TempData["Message"] != null)
{
    <div id="toastAlert" class="fixed top-6 right-6 z-[100] animate-in slide-in-from-right duration-500" role="alert">
        <div class="bg-emerald-500 text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="text-sm font-medium">@TempData["Message"]</span>
        </div>
    </div>
}

<!-- Loading Skeleton -->
<div id="supplier-skeleton" class="animate-pulse min-h-screen space-y-6 p-6">
    <!-- Header Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <div class="h-8 w-48 bg-slate-200 rounded-md dark:bg-slate-700"></div>
            <div class="h-4 w-64 bg-slate-100 rounded-md mt-2 dark:bg-slate-800"></div>
        </div>
        <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
    </div>
    <!-- Filter Bar Skeleton -->
    <div class="flex flex-wrap items-center gap-3">
        <div class="h-10 w-64 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
        <div class="h-10 w-32 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
        <div class="h-10 w-10 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
    </div>
    <!-- Table Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50">
            <div class="h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>
        <div class="p-4 space-y-4">
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3 w-1/4">
                        <div class="h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                        <div class="h-3 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                    </div>
                    <div class="h-3 w-32 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                    <div class="h-3 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                </div>
                @if (i < 4) { <div class="border-b border-slate-50 dark:border-slate-800"></div> }
            }
        </div>
    </div>
</div>

<!-- Main Content -->
<div id="supplier-content" class="hidden animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-6 duration-700">
    
    <!-- Header -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Supplier Management
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage supplier directory, contracts, and categories</p>
        </div>
        <div>
            <button onclick="openCreateModal()" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Add Supplier
            </button>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" action="@Url.Action("Index", "Suppliers", new { area = "Client" })" id="supplierFilterForm" class="flex flex-wrap items-center gap-3">
        <!-- Search -->
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800 flex-1 lg:flex-none lg:w-80">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" /></svg>
            <input type="text" name="search" value="@search" placeholder="Search name, contact, email..."
                   class="w-full border-0 bg-transparent p-0 text-xs font-semibold text-slate-700 placeholder-slate-400 focus:ring-0 dark:text-slate-300">
        </div>

        <!-- Category Filter -->
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <span class="text-xs font-medium text-slate-500">Category</span>
            <select name="category" onchange="this.form.submit()" class="border-0 bg-transparent p-0 text-xs font-semibold text-slate-700 focus:ring-0 dark:text-slate-300 cursor-pointer">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c" selected="@(categoryFilter == c)">@c</option>
                }
            </select>
        </div>
        
        <!-- Reset Button -->
        <a href="@Url.Action("Index", "Suppliers", new { area = "Client" })" class="rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-500" title="Reset Filters">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </form>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/20">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Directory List</h3>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                @Model.TotalCount Suppliers
            </span>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/30 text-xs font-medium text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-3 font-medium">Supplier</th>
                        <th class="px-6 py-3 font-medium">Contact Person</th>
                        <th class="px-6 py-3 font-medium">Contact Info</th>
                        <th class="px-6 py-3 font-medium">Category</th>
                        <th class="px-6 py-3 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="h-12 w-12 rounded-full bg-slate-50 flex items-center justify-center mb-3 dark:bg-slate-800">
                                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                    </div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">No suppliers found</p>
                                    <p class="text-xs text-slate-500 mt-1 dark:text-slate-400">Get started by adding a new supplier.</p>
                                    <button onclick="openCreateModal()" class="mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-700">Add Supplier &rarr;</button>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model.Items)
                    {
                        var initials = (s.Name ?? "??");
                        initials = initials.Length >= 2 ? initials.Substring(0, 2).ToUpper() : initials.ToUpper();
                        var supplierJson = System.Text.Json.JsonSerializer.Serialize(s, jsonOptions);
                        
                        <tr onclick='openSidePanel(@Html.Raw(supplierJson))' class="group hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors cursor-pointer">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded-full bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase shrink-0">
                                        @initials
                                    </div>
                                    <div class="text-sm font-medium text-slate-900 dark:text-slate-200">@s.Name</div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-xs text-slate-500 dark:text-slate-400">@(s.ContactPerson ?? "—")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-0.5">
                                    <span class="text-xs text-slate-600 dark:text-slate-300">@(s.Email ?? "—")</span>
                                    <span class="text-[10px] text-slate-400">@(s.Phone ?? "—")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10 dark:bg-slate-800 dark:text-slate-400 dark:ring-slate-700">
                                    @(s.Category ?? "Uncategorized")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button onclick="event.stopPropagation(); openSidePanel(@Html.Raw(supplierJson)); toggleEditMode();" class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors dark:hover:bg-indigo-900/20" title="Edit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-width="2" stroke-linecap="round" /></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <p class="text-xs text-slate-500 dark:text-slate-400">Page @Model.PageNumber of @Model.TotalPages</p>
                <div class="flex gap-2">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", "Suppliers", new { area = "Client", page = Model.PageNumber - 1, pageSize = Model.PageSize, category = categoryFilter, search = search })" class="px-3 py-1 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">Previous</a>
                    }
                    else 
                    {
                        <span class="px-3 py-1 text-xs font-medium text-slate-400 bg-slate-50 border border-slate-200 rounded-md cursor-not-allowed dark:bg-slate-800/50 dark:border-slate-700/50">Previous</span>
                    }
                    
                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", "Suppliers", new { area = "Client", page = Model.PageNumber + 1, pageSize = Model.PageSize, category = categoryFilter, search = search })" class="px-3 py-1 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-md hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">Next</a>
                    }
                    else
                    {
                         <span class="px-3 py-1 text-xs font-medium text-slate-400 bg-slate-50 border border-slate-200 rounded-md cursor-not-allowed dark:bg-slate-800/50 dark:border-slate-700/50">Next</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div id="createModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-300" id="createModal">
        <form action="@Url.Action("Create", "Suppliers", new { area = "Client" })" method="post" class="p-8">
            @Html.AntiForgeryToken()
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Add New Supplier</h2>
                    <p class="text-xs text-slate-500 mt-1">Register a new vendor for procurement</p>
                </div>
                <button type="button" onclick="closeCreateModal()" class="text-slate-400 hover:text-slate-500 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Supplier Name <span class="text-rose-500">*</span></label>
                    <input type="text" name="Name" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" placeholder="e.g. Acme Corp" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Contact Person</label>
                        <input type="text" name="ContactPerson" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" placeholder="e.g. John Doe" />
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Category</label>
                        <select name="Category" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Materials">Materials</option>
                            <option value="Equipment">Equipment</option>
                            <option value="Services">Services</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Email Address</label>
                    <input type="email" name="Email" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" placeholder="contact@supplier.com" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Phone Number</label>
                    <input type="text" name="Phone" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all placeholder-slate-400" placeholder="+1 (555) 000-0000" />
                </div>
            </div>

            <div class="mt-8">
                <button type="submit" class="w-full bg-slate-900 text-white py-2.5 rounded-lg text-sm font-semibold shadow hover:bg-slate-800 transition-colors disabled:opacity-70 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">
                    Create Supplier
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Side Panel Overlay -->
<div id="sidePanelOverlay" onclick="closeSidePanel()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Side Panel -->
<div id="sidePanel" class="fixed inset-y-0 right-0 w-full max-w-md bg-white dark:bg-slate-900 shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 dark:border-slate-800">
    <div class="h-full flex flex-col p-6">
        
        <!-- Panel Header -->
        <div class="flex justify-between items-start mb-8">
            <div class="flex items-center gap-4">
                <div id="panelInitial" class="h-16 w-16 rounded-full bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-xl font-bold text-indigo-600 dark:text-indigo-400 uppercase"></div>
                <div>
                    <h2 id="panelName" class="text-xl font-bold text-slate-900 dark:text-white"></h2>
                    <p id="panelCategory" class="text-sm text-slate-500 dark:text-slate-400 font-medium"></p>
                </div>
            </div>
            <div class="flex gap-1">
                <button onclick="toggleEditMode()" id="editBtn" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors dark:hover:bg-indigo-900/20" title="Edit Supplier">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
                <button onclick="closeSidePanel()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors dark:hover:bg-slate-800">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
            
            <!-- View Mode -->
            <div id="viewMode" class="space-y-6">
                <section>
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Contact Information</h3>
                    <div class="space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-slate-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                            <div>
                                <p class="text-xs text-slate-500">Contact Person</p>
                                <p id="viewContact" class="text-sm font-medium text-slate-900 dark:text-white">--</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-slate-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                            <div>
                                <p class="text-xs text-slate-500">Email</p>
                                <p id="viewEmail" class="text-sm font-medium text-slate-900 dark:text-white">--</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 text-slate-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                            <div>
                                <p class="text-xs text-slate-500">Phone</p>
                                <p id="viewPhone" class="text-sm font-medium text-slate-900 dark:text-white">--</p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 dark:bg-slate-800/50 dark:border-slate-700/50">
                        <div class="flex items-center gap-3 mb-2">
                             <div class="h-8 w-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                             </div>
                             <p class="text-xs font-medium text-slate-500 uppercase">Status</p>
                        </div>
                        <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">Active Supplier</p>
                        <p class="text-xs text-slate-400 mt-1">This supplier is currently active and approved for procurement.</p>
                    </div>
                </div>
            </div>

            <!-- Edit Mode -->
            <form id="editMode" method="post" class="hidden space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SupplierId" id="editId" />
                
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Supplier Name</label>
                    <input type="text" name="Name" id="editName" required class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                </div>
                 <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Contact Person</label>
                        <input type="text" name="ContactPerson" id="editContact" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                    </div>
                     <div>
                        <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Category</label>
                        <select name="Category" id="editCategory" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                            <option value="Materials">Materials</option>
                            <option value="Equipment">Equipment</option>
                            <option value="Services">Services</option>
                        </select>
                    </div>
                 </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Email Address</label>
                    <input type="email" name="Email" id="editEmail" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5 block">Phone Number</label>
                    <input type="text" name="Phone" id="editPhone" class="w-full bg-slate-50 dark:bg-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all" />
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800 mt-6">
                    <button type="button" onclick="toggleEditMode()" class="flex-1 px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">Cancel</button>
                    <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 shadow-sm transition-colors">Save Changes</button>
                </div>
            </form>
        </div>
        
        <!-- Panel Footer (Delete) -->
        <div id="panelFooter" class="mt-auto pt-6 border-t border-slate-100 dark:border-slate-800">
             <button type="button" onclick="openDeleteModal()" class="w-full bg-white border border-rose-200 text-rose-600 py-2.5 rounded-lg text-sm font-semibold hover:bg-rose-50 transition-colors dark:bg-slate-800 dark:border-rose-900/30 dark:text-rose-400 dark:hover:bg-rose-900/20">
                Delete Supplier
            </button>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[80] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-sm rounded-xl shadow-xl p-6 border border-slate-200 dark:border-slate-700" id="deleteModal">
         <div class="h-12 w-12 rounded-full bg-rose-50 flex items-center justify-center mx-auto mb-4 dark:bg-rose-900/20">
            <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        </div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white text-center">Delete Supplier</h2>
        <p class="text-sm text-slate-500 mt-2 text-center">Are you sure you want to delete <strong id="deleteName"></strong>? This action cannot be undone.</p>

        <form method="post" id="deleteForm" class="mt-6 flex gap-3">
            @Html.AntiForgeryToken()
            <button type="button" onclick="closeDeleteModal()" class="flex-1 px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors dark:bg-slate-800 dark:text-slate-300 dark:border-slate-600 dark:hover:bg-slate-700">Cancel</button>
            <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-rose-600 rounded-lg hover:bg-rose-700 shadow-sm transition-colors">Delete</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        setTimeout(function() {
            const skeleton = document.getElementById('supplier-skeleton');
            const content = document.getElementById('supplier-content');
            
            if(skeleton && content) {
                skeleton.classList.add('hidden');
                content.classList.remove('hidden');
            }
        }, 300);

        const toast = document.getElementById('toastAlert');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    });

    let currentSupplierId = null;
    let isEditMode = false;

    // Create Modal
    function openCreateModal() {
        const overlay = document.getElementById('createModalOverlay');
        const modal = document.getElementById('createModal');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.replace('opacity-0', 'opacity-100');
            modal.classList.replace('scale-95', 'scale-100');
        }, 10);
    }

    function closeCreateModal() {
        const overlay = document.getElementById('createModalOverlay');
        const modal = document.getElementById('createModal');
        overlay.classList.replace('opacity-100', 'opacity-0');
        modal.classList.replace('scale-100', 'scale-95');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    // Side Panel
    function openSidePanel(supplier) {
        currentSupplierId = supplier.SupplierId;
        isEditMode = false;
        
        // Reset Edit/View state
        document.getElementById('viewMode').classList.remove('hidden');
        document.getElementById('editMode').classList.add('hidden');
        document.getElementById('panelFooter').classList.remove('hidden');
        const editBtn = document.getElementById('editBtn');
        editBtn.classList.remove('bg-indigo-50', 'text-indigo-600');
        editBtn.classList.add('text-slate-400');

        // Populate View
        document.getElementById('panelInitial').innerText = (supplier.Name || "??").substring(0, 2).toUpperCase();
        document.getElementById('panelName').innerText = supplier.Name || "";
        document.getElementById('panelCategory').innerText = supplier.Category || "Uncategorized";
        document.getElementById('viewContact').innerText = supplier.ContactPerson || "—";
        document.getElementById('viewEmail').innerText = supplier.Email || "—";
        document.getElementById('viewPhone').innerText = supplier.Phone || "—";

        // Populate Edit Form
        document.getElementById('editId').value = supplier.SupplierId;
        document.getElementById('editName').value = supplier.Name || "";
        document.getElementById('editContact').value = supplier.ContactPerson || "";
        document.getElementById('editCategory').value = supplier.Category || "Materials";
        document.getElementById('editEmail').value = supplier.Email || "";
        document.getElementById('editPhone').value = supplier.Phone || "";
        
        // Set Form Actions dynamically
        const editAction = '@Url.Action("Edit", "Suppliers", new { area = "Client" })?id=' + supplier.SupplierId;
        document.getElementById('editMode').action = editAction;
        
        // Delete setup
        document.getElementById('deleteName').innerText = supplier.Name || "";
        const deleteAction = '@Url.Action("Delete", "Suppliers", new { area = "Client" })/' + supplier.SupplierId;
        document.getElementById('deleteForm').action = deleteAction;

        // Animate open
        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.replace('opacity-0', 'opacity-100'), 10);
        panel.classList.remove('translate-x-full');
    }

    function closeSidePanel() {
        const panel = document.getElementById('sidePanel');
        const overlay = document.getElementById('sidePanelOverlay');
        panel.classList.add('translate-x-full');
        overlay.classList.replace('opacity-100', 'opacity-0');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }

    function toggleEditMode() {
        isEditMode = !isEditMode;
        const viewDiv = document.getElementById('viewMode');
        const editForm = document.getElementById('editMode');
        const footer = document.getElementById('panelFooter');
        const editBtn = document.getElementById('editBtn');

        if (isEditMode) {
            viewDiv.classList.add('hidden');
            footer.classList.add('hidden');
            editForm.classList.remove('hidden');
            editBtn.classList.add('bg-indigo-50', 'text-indigo-600');
            editBtn.classList.remove('text-slate-400');
        } else {
            viewDiv.classList.remove('hidden');
            footer.classList.remove('hidden');
            editForm.classList.add('hidden');
            editBtn.classList.remove('bg-indigo-50', 'text-indigo-600');
            editBtn.classList.add('text-slate-400');
        }
    }

    // Delete Modal
    function openDeleteModal() {
        // Close side panel first (optional, but cleaner)
        // closeSidePanel(); 
        
        const overlay = document.getElementById('deleteModalOverlay');
        const modal = document.getElementById('deleteModal');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.replace('opacity-0', 'opacity-100');
            modal.classList.add('scale-100'); // Optional pop effect if class exists
        }, 10);
    }

    function closeDeleteModal() {
        const overlay = document.getElementById('deleteModalOverlay');
        overlay.classList.replace('opacity-100', 'opacity-0');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }
</script>
