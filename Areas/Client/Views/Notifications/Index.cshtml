@model List<Web_Sentro.Areas.Client.Controllers.NotificationRowVm>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Notifications";
}
<div class="animate-in fade-in min-h-screen space-y-8 duration-700">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Notifications</h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Risk lifecycle events</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-5 shadow-card dark:border-slate-700 dark:bg-slate-800/90">
        @if (Model == null || !Model.Any())
        {
            <p class="text-sm text-slate-500 dark:text-slate-400">No notifications yet.</p>
        }
        else
        {
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var n in Model)
                {
                    <li class="py-4 @(n.ReadAt == null ? "bg-indigo-50/50 dark:bg-indigo-900/10" : "")">
                        <div class="font-bold text-slate-900 dark:text-white">@n.Title</div>
                        <div class="text-sm text-slate-600 dark:text-slate-300 mt-1">@n.Message</div>
                        <div class="flex items-center justify-between mt-2">
                            <span class="text-[10px] text-slate-400">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                            @if (!string.IsNullOrEmpty(n.ActionUrl))
                            {
                                <a href="@n.ActionUrl" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400">View action →</a>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
