@model WEB_Sentro.Areas.Client.Controllers.SiteDetailsViewModel
@{
    Layout = "_LayoutClient";
    var statusCls = Model.Status == "Active" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400" :
        Model.Status == "OnHold" ? "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400" :
        Model.Status == "Completed" ? "bg-slate-200 text-slate-700 dark:bg-slate-600 dark:text-slate-300" :
        "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400";
}
<div class="animate-in fade-in min-h-screen space-y-8 duration-500">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="text-xs font-bold tracking-widest text-slate-500 uppercase transition hover:text-emerald-600">← Sites</a>
            <div>
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">@Model.SiteName</h1>
                <p class="mt-1 font-mono text-sm font-bold text-slate-500 dark:text-slate-400">@Model.SiteCode</p>
            </div>
            <span class="rounded-xl px-3 py-1.5 text-xs font-black uppercase @statusCls">@Model.Status</span>
        </div>
        @if (Model.Status != "Archived")
        {
            <a asp-action="Edit" asp-route-id="@Model.SiteId" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Edit</a>
        }
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="rounded-xl border border-slate-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-slate-700 dark:bg-emerald-900/20 dark:text-emerald-300">@TempData["Message"]</div>
    }

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
            <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">Active Risks</p>
            <p class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@Model.ActiveRisksCount</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
            <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">Critical Risks</p>
            <p class="mt-2 text-3xl font-black @(Model.CriticalRisksCount > 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-900 dark:text-white")">@Model.CriticalRisksCount</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 sm:col-span-2">
            <p class="text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">Latest weather</p>
            <p class="mt-2 text-sm font-bold text-slate-700 dark:text-slate-300">@Model.LatestWeatherCondition</p>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
        <h2 class="mb-4 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Details</h2>
        <dl class="grid gap-3 sm:grid-cols-2">
            @if (!string.IsNullOrEmpty(Model.AddressLine)) { <div><dt class="text-[10px] font-black uppercase text-slate-400">Address</dt><dd class="text-sm font-medium text-slate-900 dark:text-white">@Model.AddressLine</dd></div> }
            @if (!string.IsNullOrEmpty(Model.City)) { <div><dt class="text-[10px] font-black uppercase text-slate-400">City</dt><dd class="text-sm font-medium text-slate-900 dark:text-white">@Model.City</dd></div> }
            @if (!string.IsNullOrEmpty(Model.Province)) { <div><dt class="text-[10px] font-black uppercase text-slate-400">Province</dt><dd class="text-sm font-medium text-slate-900 dark:text-white">@Model.Province</dd></div> }
            @if (Model.Latitude.HasValue && Model.Longitude.HasValue) { <div><dt class="text-[10px] font-black uppercase text-slate-400">Coordinates</dt><dd class="text-sm font-medium text-slate-900 dark:text-white">@Model.Latitude?.ToString("F4"), @Model.Longitude?.ToString("F4")</dd></div> }
            @if (Model.BudgetAllocated.HasValue) { <div><dt class="text-[10px] font-black uppercase text-slate-400">Budget</dt><dd class="text-sm font-medium text-slate-900 dark:text-white">@Model.BudgetAllocated?.ToString("N2")</dd></div> }
        </dl>
    </div>

    <div class="flex flex-wrap gap-3">
        <a asp-controller="Risks" asp-action="Identification" asp-route-siteId="@Model.SiteId" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow transition hover:bg-slate-800 dark:bg-slate-700">View Risks</a>
        <a asp-controller="Risks" asp-action="Monitoring" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">View Monitoring</a>
    </div>
</div>
