@model WEB_Sentro.Areas.Client.Controllers.SiteEditViewModel
@{
    Layout = "_LayoutClient";
}
<div class="animate-in fade-in min-h-screen space-y-8 duration-500">
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="text-xs font-bold tracking-widest text-slate-500 uppercase transition hover:text-emerald-600">← Sites</a>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Edit <span class="text-emerald-500 italic">@Model.SiteName</span></h1>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800/90 max-w-2xl">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SiteId" />
            <div asp-validation-summary="All" class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/20 dark:text-rose-300"></div>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="SiteCode" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="SiteCode" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="30" />
                    <span asp-validation-for="SiteCode" class="text-xs text-rose-600 dark:text-rose-400"></span>
                </div>
                <div>
                    <label asp-for="SiteName" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="SiteName" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="150" />
                    <span asp-validation-for="SiteName" class="text-xs text-rose-600 dark:text-rose-400"></span>
                </div>
            </div>
            <div>
                <label asp-for="Status" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                <select asp-for="Status" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                    <option value="Active">Active</option>
                    <option value="OnHold">On Hold</option>
                    <option value="Completed">Completed</option>
                    <option value="Archived">Archived</option>
                </select>
            </div>
            <div>
                <label asp-for="AddressLine" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                <input asp-for="AddressLine" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="200" />
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="City" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="City" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="80" />
                </div>
                <div>
                    <label asp-for="Province" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="Province" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="80" />
                </div>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Latitude" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="Latitude" type="number" step="0.000001" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                    <label asp-for="Longitude" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                    <input asp-for="Longitude" type="number" step="0.000001" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>
            <div>
                <label asp-for="BudgetAllocated" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400"></label>
                <input asp-for="BudgetAllocated" type="number" step="0.01" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div class="flex gap-3 pt-2">
                <a asp-action="Details" asp-route-id="@Model.SiteId" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</a>
                <button type="submit" class="rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-emerald-700">Save</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
