@model WEB_Sentro.Areas.Client.Controllers.SiteEditViewModel
@{
    Layout = "_LayoutClient";
}
<div class="animate-in fade-in min-h-screen space-y-6 duration-500">
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-700 transition dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">New Site</h1>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 max-w-2xl">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/20 dark:text-rose-300"></div>
            
            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="SiteCode" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Site Code</label>
                    <input asp-for="SiteCode" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. SITE-001" maxlength="30" />
                    <span asp-validation-for="SiteCode" class="text-xs text-rose-600 dark:text-rose-400"></span>
                </div>
                <div>
                    <label asp-for="SiteName" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Site Name</label>
                    <input asp-for="SiteName" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Site name" maxlength="150" />
                    <span asp-validation-for="SiteName" class="text-xs text-rose-600 dark:text-rose-400"></span>
                </div>
            </div>
            
            <div>
                <label asp-for="Status" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Status</label>
                <select asp-for="Status" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                    <option value="Active">Active</option>
                    <option value="OnHold">On Hold</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            
            <div>
                <label asp-for="AddressLine" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Address</label>
                <input asp-for="AddressLine" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="200" />
            </div>
            
            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="City" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">City</label>
                    <input asp-for="City" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="80" />
                </div>
                <div>
                    <label asp-for="Province" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Province</label>
                    <input asp-for="Province" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" maxlength="80" />
                </div>
            </div>
            
            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="Latitude" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Latitude</label>
                    <input asp-for="Latitude" type="number" step="0.000001" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                    <label asp-for="Longitude" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Longitude</label>
                    <input asp-for="Longitude" type="number" step="0.000001" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>
            
            <div>
                <label asp-for="BudgetAllocated" class="mb-1 block text-xs font-medium text-slate-500 dark:text-slate-400">Budget Allocated</label>
                <input asp-for="BudgetAllocated" type="number" step="0.01" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            
            <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <a asp-action="Index" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancel</a>
                <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">Create Site</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
