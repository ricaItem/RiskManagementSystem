@model WEB_Sentro.Areas.Client.Controllers.SiteIndexViewModel
@{
    Layout = "_LayoutClient";
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) : 1;
}
<div class="animate-in fade-in min-h-screen space-y-8 duration-500">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Project <span class="text-emerald-500 italic">Sites</span></h1>
            <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Manage sites and locations</p>
        </div>
        <button type="button" onclick="openAddSiteModal()" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition-all hover:bg-emerald-700 hover:-translate-y-0.5">+ New Site</button>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="rounded-xl border border-slate-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-slate-700 dark:bg-emerald-900/20 dark:text-emerald-300">@TempData["Message"]</div>
    }

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
        <form method="get" action="@Url.Action("Index", "Sites", new { area = "Client" })" class="flex flex-wrap items-center gap-3">
            <input type="text" name="search" value="@Model.Search" placeholder="Search by name or code..." class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white w-64" />
            <select name="status" class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="">All statuses</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                <option value="OnHold" selected="@(Model.StatusFilter == "OnHold")">On Hold</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Archived" selected="@(Model.StatusFilter == "Archived")">Archived</option>
            </select>
            <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-800 dark:bg-slate-700">Filter</button>
        </form>
    </div>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/90">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 font-black tracking-tighter text-[10px] text-slate-500 uppercase dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-400">
                        <th class="px-4 py-3">Code</th>
                        <th class="px-4 py-3">Name</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Manager</th>
                        <th class="px-4 py-3">Location</th>
                        <th class="px-4 py-3 text-center">Active Risks</th>
                        <th class="px-4 py-3 text-center">Critical</th>
                        <th class="px-4 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @foreach (var s in Model.Items)
                    {
                        var statusCls = s.Status == "Active" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400" :
                            s.Status == "OnHold" ? "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400" :
                            s.Status == "Completed" ? "bg-slate-200 text-slate-700 dark:bg-slate-600 dark:text-slate-300" :
                            "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400";
                        <tr class="transition hover:bg-slate-50 dark:hover:bg-slate-800/50">
                            <td class="px-4 py-3 font-mono font-bold text-slate-900 dark:text-white">@s.SiteCode</td>
                            <td class="px-4 py-3 font-bold text-slate-900 dark:text-white">@s.SiteName</td>
                            <td class="px-4 py-3"><span class="rounded-lg px-2.5 py-1 text-[10px] font-black uppercase @statusCls">@s.Status</span></td>
                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@(s.ManagerName ?? "—")</td>
                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400 max-w-[180px] truncate">@(s.Location ?? "—")</td>
                            <td class="px-4 py-3 text-center font-bold text-slate-700 dark:text-slate-300">@s.ActiveRisks</td>
                            <td class="px-4 py-3 text-center"><span class="font-bold @(s.CriticalRisks > 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-400")">@s.CriticalRisks</span></td>
                            <td class="px-4 py-3">
                                <div class="flex justify-end gap-2">
                                    <a href="@Url.Action("Details", "Sites", new { area = "Client", id = s.SiteId })" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">View</a>
                                    @if (s.Status != "Archived")
                                    {
                                        <a href="@Url.Action("Edit", "Sites", new { area = "Client", id = s.SiteId })" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">Edit</a>
                                        <form action="@Url.Action("Archive", "Sites", new { area = "Client", id = s.SiteId })" method="post" class="inline" onsubmit="return confirm('Archive this site?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 dark:border-slate-600 dark:hover:bg-slate-700">Archive</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Items.Count == 0)
        {
            <p class="px-4 py-8 text-center text-sm text-slate-500 dark:text-slate-400">No sites found.</p>
        }
        @if (totalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-slate-200 px-4 py-3 dark:border-slate-700">
                <p class="text-xs text-slate-500 dark:text-slate-400">Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount</p>
                <div class="flex gap-2">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@Url.Action("Index", "Sites", new { area = "Client", page = Model.PageNumber - 1, search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize })" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold dark:border-slate-600">Previous</a>
                    }
                    @if (Model.PageNumber < totalPages)
                    {
                        <a href="@Url.Action("Index", "Sites", new { area = "Client", page = Model.PageNumber + 1, search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize })" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold dark:border-slate-600">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Site Modal -->
<div id="addSiteModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="addSiteModalTitle">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-300" id="addSiteModal">
        <form action="@Url.Action("Create", "Sites", new { area = "Client" })" method="post" class="p-6 space-y-5" onsubmit="var b=document.getElementById('addSiteSubmitBtn');if(b){b.disabled=true;b.textContent='Creating...';}">
            @Html.AntiForgeryToken()
            <div class="flex justify-between items-center">
                <h2 id="addSiteModalTitle" class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">New <span class="text-emerald-500 italic">Site</span></h2>
                <button type="button" onclick="closeAddSiteModal()" class="text-slate-400 hover:text-rose-500 transition-colors p-1" aria-label="Close">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" stroke-linecap="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            @if (ViewData["CreateError"] != null)
            {
                <div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/20 dark:text-rose-300">@ViewData["CreateError"]</div>
            }
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="addSite_SiteCode" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Site Code</label>
                    <input type="text" id="addSite_SiteCode" name="SiteCode" required maxlength="30" placeholder="e.g. SITE-001" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                    <label for="addSite_SiteName" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Site Name</label>
                    <input type="text" id="addSite_SiteName" name="SiteName" required maxlength="150" placeholder="Site name" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>
            <div>
                <label for="addSite_Status" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Status</label>
                <select id="addSite_Status" name="Status" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                    <option value="Active">Active</option>
                    <option value="OnHold">On Hold</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            <div>
                <label for="addSite_AddressLine" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Address</label>
                <input type="text" id="addSite_AddressLine" name="AddressLine" maxlength="200" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="addSite_City" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">City</label>
                    <input type="text" id="addSite_City" name="City" maxlength="80" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                    <label for="addSite_Province" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Province</label>
                    <input type="text" id="addSite_Province" name="Province" maxlength="80" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>
            <div>
                <label for="addSite_BudgetAllocated" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Budget Allocated</label>
                <input type="number" id="addSite_BudgetAllocated" name="BudgetAllocated" step="0.01" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="closeAddSiteModal()" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</button>
                <button type="submit" id="addSiteSubmitBtn" class="rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-emerald-700">Create Site</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddSiteModal() {
        var overlay = document.getElementById('addSiteModalOverlay');
        var modal = document.getElementById('addSiteModal');
        if (!overlay || !modal) return;
        overlay.classList.remove('hidden');
        setTimeout(function() {
            overlay.classList.replace('opacity-0', 'opacity-100');
            modal.classList.replace('scale-95', 'scale-100');
        }, 10);
    }
    function closeAddSiteModal() {
        var overlay = document.getElementById('addSiteModalOverlay');
        var modal = document.getElementById('addSiteModal');
        if (!overlay || !modal) return;
        overlay.classList.replace('opacity-100', 'opacity-0');
        modal.classList.replace('scale-100', 'scale-95');
        setTimeout(function() { overlay.classList.add('hidden'); }, 300);
    }
    var overlayEl = document.getElementById('addSiteModalOverlay');
    if (overlayEl) overlayEl.addEventListener('click', function(e) {
        if (e.target === this) closeAddSiteModal();
    });
</script>
