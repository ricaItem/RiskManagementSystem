@model WEB_Sentro.Areas.Client.Controllers.SiteIndexViewModel
@{
    Layout = "_LayoutClient";
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) : 1;
}

<div id="sites-skeleton" class="animate-pulse min-h-screen space-y-8 p-6">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <div class="h-8 w-52 rounded bg-slate-200 dark:bg-slate-700"></div>
            <div class="mt-2 h-4 w-80 rounded bg-slate-100 dark:bg-slate-800"></div>
        </div>
        <div class="h-10 w-32 rounded-xl bg-slate-200 dark:bg-slate-700"></div>
    </div>

    <div class="h-36 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" style="min-height: 600px;">
        <div class="h-[600px] rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40 lg:col-span-8"></div>
        <div class="h-[600px] rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40 lg:col-span-4"></div>
    </div>
</div>

<div id="sites-content" class="hidden animate-in fade-in min-h-screen space-y-8 duration-1000 relative">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Project Sites
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage sites and geographical locations</p>
        </div>
        <button type="button" onclick="openAddSiteModal()" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-slate-800 transition-all dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            New Site
        </button>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900/30 dark:bg-emerald-900/10 dark:text-emerald-300 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            @TempData["Message"]
        </div>
    }

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 relative overflow-hidden">
        <div class="relative z-10 flex flex-wrap items-center gap-6">
            <div class="flex-1 min-w-[200px]">
                <form method="get" action="@Url.Action("Index", "Sites", new { area = "Client" })" class="flex flex-wrap items-end gap-4">
                    <div class="flex-1">
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400 block mb-1.5">Search</label>
                        <input type="text" name="search" value="@Model.Search" placeholder="Search by name or code..." class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" />
                    </div>
                    <div class="w-48">
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400 block mb-1.5">Status</label>
                        <select name="status" asp-items="@(new SelectList(new[] { "Active", "OnHold", "Completed", "Archived" }, Model.StatusFilter))" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-700 text-sm font-medium px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            <option value="">All statuses</option>
                        </select>
                    </div>
                    <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 h-[38px]">Filter</button>
                </form>
            </div>
            
            <div class="h-10 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>
            
            <div class="flex gap-6">
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Total Sites</p>
                    <p class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">@Model.TotalCount</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Active</p>
                    <p class="text-2xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">@Model.Items.Count(s => s.Status == "Active")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6" style="min-height: 600px;">
        <!-- Map Section -->
        <div class="lg:col-span-8 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm dark:border-slate-800 dark:bg-slate-900/40 relative min-h-[400px]">
            <div id="sites-map" class="w-full h-full"></div>
            <!-- Map Controls/Overlay if needed -->
             <div class="absolute top-4 left-4 flex flex-col gap-2 z-[400]">
                <div class="rounded-lg border border-slate-200 bg-white/90 px-3 py-2 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/80 flex flex-wrap gap-3 items-center">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Map Layer</span>
                </div>
            </div>
        </div>

        <!-- List Section -->
        <div class="lg:col-span-4 flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/30 dark:bg-slate-800/20">
                <div>
                    <h2 class="text-base font-semibold text-slate-800 dark:text-slate-100">Site List</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@Model.TotalCount sites found</p>
                </div>
            </div>
            
            <div id="sites-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800" style="max-height: 600px;">
                @foreach (var s in Model.Items)
                {
                    var hasCoords = s.Latitude.HasValue && s.Longitude.HasValue;
                    var statusColor = s.Status == "Active" ? "bg-emerald-500" : s.Status == "OnHold" ? "bg-amber-500" : "bg-slate-400";
                    
                    <div class="sites-list-item group relative flex items-start gap-4 p-5 hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors cursor-pointer"
                         data-site-id="@s.SiteId"
                         data-lat="@(hasCoords ? s.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                         data-lng="@(hasCoords ? s.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")">
                        
                        <div class="flex-shrink-0 relative mt-1">
                            <div class="h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-sm shadow-sm ring-1 ring-slate-900/5 dark:ring-slate-100/10 font-bold text-slate-600 dark:text-slate-300">
                                @(s.SiteName?.Substring(0, 1).ToUpper() ?? "S")
                            </div>
                            <span class="absolute -bottom-0.5 -right-0.5 block h-2.5 w-2.5 rounded-full @statusColor ring-2 ring-white dark:ring-slate-900"></span>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2 mb-0.5">
                                <h4 class="text-sm font-medium text-slate-900 dark:text-white truncate">@s.SiteName</h4>
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">@s.Status</span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mb-2">@s.SiteCode</p>
                            
                            <div class="flex items-center gap-3">
                                @if (hasCoords)
                                {
                                    <span class="text-[10px] text-slate-400 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        Mapped
                                    </span>
                                }
                                <div class="flex gap-2 ml-auto">
                                    <a href="@Url.Action("Details", "Sites", new { area = "Client", id = s.SiteId })" class="text-[10px] font-bold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 uppercase tracking-wide">View</a>
                                    @if (s.Status != "Archived")
                                    {
                                        <span class="text-slate-300 dark:text-slate-700">|</span>
                                        <a href="@Url.Action("Edit", "Sites", new { area = "Client", id = s.SiteId })" class="text-[10px] font-bold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 uppercase tracking-wide">Edit</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                
                @if (Model.Items.Count == 0)
                {
                    <div class="p-8 text-center">
                        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">No sites found</p>
                        <p class="text-xs text-slate-400 mt-1">Try adjusting your search or filters</p>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 dark:bg-slate-800/30 dark:border-slate-800 flex items-center justify-between">
                    <p class="text-[10px] text-slate-500 dark:text-slate-400">Page @Model.PageNumber of @totalPages</p>
                    <div class="flex gap-1">
                         @if (Model.PageNumber > 1)
                        {
                            <a href="@Url.Action("Index", "Sites", new { area = "Client", page = Model.PageNumber - 1, search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize })" class="rounded px-2 py-1 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700">Prev</a>
                        }
                        @if (Model.PageNumber < totalPages)
                        {
                            <a href="@Url.Action("Index", "Sites", new { area = "Client", page = Model.PageNumber + 1, search = Model.Search, status = Model.StatusFilter, pageSize = Model.PageSize })" class="rounded px-2 py-1 text-[10px] font-bold text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-700">Next</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Site Modal: (Preserved functionality, updated generic styles inherited from main css) -->
<div id="addSiteModalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[1100] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="addSiteModalTitle">
    <div class="bg-white dark:bg-slate-900 w-full max-w-2xl max-h-[90vh] rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col relative z-[1101]" id="addSiteModal">
        <form action="@Url.Action("Create", "Sites", new { area = "Client" })" method="post" class="flex flex-col flex-1 min-h-0" onsubmit="var b=document.getElementById('addSiteSubmitBtn');if(b){b.disabled=true;b.textContent='Creating...';}">
            @Html.AntiForgeryToken()
            <div class="flex justify-between items-center flex-shrink-0 px-6 pt-5 pb-2">
                <h2 id="addSiteModalTitle" class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-tight">New <span class="text-indigo-600 dark:text-indigo-400">Site</span></h2>
                <button type="button" onclick="closeAddSiteModal()" class="text-slate-400 hover:text-rose-500 transition-colors p-1" aria-label="Close">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" stroke-linecap="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto px-6 pb-6 space-y-5">
                @if (ViewData["CreateError"] != null)
                {
                    <div class="rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/20 dark:text-rose-300">@ViewData["CreateError"]</div>
                }
                <!-- Map: address search (auto-picker) + click/drag to set location; address fields auto-filled -->
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Location on map</label>
                    <div class="mb-2 flex gap-2">
                        <div class="relative flex-1">
                            <input type="text" id="addSite_AddressSearch" placeholder="Search address or place..." maxlength="200"
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-20 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                            <button type="button" id="addSite_SearchBtn" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-indigo-700">Search</button>
                        </div>
                        <button type="button" id="addSite_MyLocationBtn" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" title="Use my location">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </button>
                    </div>
                    <div id="addSite_SearchResults" class="mb-2 hidden max-h-40 overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-800"></div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">Click on the map or drag the marker to set the site location. Address fields below will auto-fill.</p>
                    <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-slate-100 dark:bg-slate-800" style="height: 220px;">
                        <div id="addSiteMap" class="w-full h-full"></div>
                    </div>
                    <input type="hidden" name="Latitude" id="addSite_Latitude" />
                    <input type="hidden" name="Longitude" id="addSite_Longitude" />
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="addSite_SiteCode" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Site Code</label>
                        <input type="text" id="addSite_SiteCode" name="SiteCode" required maxlength="30" placeholder="e.g. SITE-001" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label for="addSite_SiteName" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Site Name</label>
                        <input type="text" id="addSite_SiteName" name="SiteName" required maxlength="150" placeholder="Site name" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                </div>
                <div>
                    <label for="addSite_Status" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Status</label>
                    <select id="addSite_Status" name="Status" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                        <option value="Active">Active</option>
                        <option value="OnHold">On Hold</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>
                <div>
                    <label for="addSite_AddressLine" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Address</label>
                    <input type="text" id="addSite_AddressLine" name="AddressLine" maxlength="200" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="addSite_City" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">City</label>
                        <input type="text" id="addSite_City" name="City" maxlength="80" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label for="addSite_Province" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Province</label>
                        <input type="text" id="addSite_Province" name="Province" maxlength="80" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                </div>
                <div>
                    <label for="addSite_BudgetAllocated" class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Budget Allocated</label>
                    <input type="number" id="addSite_BudgetAllocated" name="BudgetAllocated" step="0.01" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>
            <div class="flex gap-3 px-6 py-4 border-t border-slate-200 dark:border-slate-700 flex-shrink-0 bg-slate-50/50 dark:bg-slate-800/30">
                <button type="button" onclick="closeAddSiteModal()" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</button>
                <button type="submit" id="addSiteSubmitBtn" class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-400">Create Site</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Leaflet monitoring site markers: bouncing pin + radio-wave pulse - Adapted for Sites Module */
    .site-marker {
        position: relative;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transform-origin: center bottom;
    }
    .site-marker .pin {
        position: relative;
        z-index: 10;
        width: 14px;
        height: 14px;
        border-radius: 9999px;
        background: #10b981;
        border: 2px solid #ffffff;
        box-shadow: 0 6px 10px rgba(15, 23, 42, 0.45);
    }
    .site-marker .pulse {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 18px;
        height: 18px;
        border-radius: 9999px;
        border: 2px solid currentColor;
        transform: translate(-50%, -50%) scale(0.6);
        opacity: 0;
        pointer-events: none;
        z-index: 1;
    }
    .site-marker .pulse::before,
    .site-marker .pulse::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: inherit;
        transform: scale(0.6);
        opacity: 0;
        pointer-events: none;
    }

    /* Status colors */
    .site-marker.status-Active { color: #10b981; }
    .site-marker.status-Active .pin { background: #10b981; }
    
    .site-marker.status-OnHold { color: #f59e0b; }
    .site-marker.status-OnHold .pin { background: #f59e0b; }
    
    .site-marker.status-Completed { color: #64748b; }
    .site-marker.status-Completed .pin { background: #64748b; }
    
    .site-marker.status-Archived { color: #94a3b8; }
    .site-marker.status-Archived .pin { background: #94a3b8; }

    /* Bounce animation for selected */
    @@keyframes site-marker-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
    .site-marker.selected .pin {
        animation: site-marker-bounce 1.2s ease-in-out infinite;
        border-color: #4f46e5;
        border-width: 3px;
    }
    .site-marker.selected .pulse {
        animation: site-marker-pulse 2s ease-out infinite;
        opacity: 1;
    }
     @@keyframes site-marker-pulse {
        0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0.55; }
        100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; }
    }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
    (function () {
        var addSiteMapInstance = null;
        var addSiteMarker = null;
        var mainSitesMap = null;
        var ADD_SITE_DEFAULT_LAT = 7.0707, ADD_SITE_DEFAULT_LNG = 125.6083;
        var NOMINATIM_HEADERS = { 'Accept': 'application/json', 'User-Agent': 'SentroSitePicker/1.0' };

        function addSiteSetMarkerAndCoords(lat, lng) {
            var latInput = document.getElementById('addSite_Latitude');
            var lngInput = document.getElementById('addSite_Longitude');
            if (latInput) latInput.value = lat.toFixed(6);
            if (lngInput) lngInput.value = lng.toFixed(6);
            if (addSiteMarker) {
                addSiteMarker.setLatLng([lat, lng]);
            } else if (addSiteMapInstance) {
                addSiteMarker = L.marker([lat, lng], { draggable: true }).addTo(addSiteMapInstance);
                addSiteMarker.on('dragend', function () {
                    var pos = addSiteMarker.getLatLng();
                    addSiteSetMarkerAndCoords(pos.lat, pos.lng);
                    addSiteReverseGeocode(pos.lat, pos.lng);
                });
            }
            if (addSiteMapInstance) addSiteMapInstance.setView([lat, lng], Math.max(addSiteMapInstance.getZoom(), 14));
        }

        function addSiteReverseGeocode(lat, lng) {
            var addressEl = document.getElementById('addSite_AddressLine');
            var cityEl = document.getElementById('addSite_City');
            var provinceEl = document.getElementById('addSite_Province');
            fetch('https://nominatim.openstreetmap.org/reverse?lat=' + lat + '&lon=' + lng + '&format=json', { headers: NOMINATIM_HEADERS })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || !data.address) return;
                    var a = data.address;
                    var road = [a.house_number, a.road].filter(Boolean).join(' ');
                    var city = a.city || a.town || a.village || a.municipality || a.county || '';
                    var state = a.state || a.province || '';
                    if (addressEl) addressEl.value = road || data.display_name || '';
                    if (cityEl) cityEl.value = city;
                    if (provinceEl) provinceEl.value = state;
                })
                .catch(function () { });
        }

        function initAddSiteMap() {
            var mapEl = document.getElementById('addSiteMap');
            if (!mapEl || typeof L === 'undefined' || addSiteMapInstance) return;

            addSiteMapInstance = L.map('addSiteMap').setView([ADD_SITE_DEFAULT_LAT, ADD_SITE_DEFAULT_LNG], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(addSiteMapInstance);

            addSiteMapInstance.on('click', function (e) {
                var lat = e.latlng.lat;
                var lng = e.latlng.lng;
                if (!addSiteMarker) {
                    addSiteMarker = L.marker([lat, lng], { draggable: true }).addTo(addSiteMapInstance);
                    addSiteMarker.on('dragend', function () {
                        var pos = addSiteMarker.getLatLng();
                        addSiteSetMarkerAndCoords(pos.lat, pos.lng);
                        addSiteReverseGeocode(pos.lat, pos.lng);
                    });
                } else {
                    addSiteMarker.setLatLng(e.latlng);
                }
                addSiteSetMarkerAndCoords(lat, lng);
                addSiteReverseGeocode(lat, lng);
            });

            var searchInput = document.getElementById('addSite_AddressSearch');
            var searchBtn = document.getElementById('addSite_SearchBtn');
            var resultsEl = document.getElementById('addSite_SearchResults');
            function doSearch() {
                var q = (searchInput && searchInput.value) ? searchInput.value.trim() : '';
                if (!q) return;
                if (resultsEl) { resultsEl.classList.add('hidden'); resultsEl.innerHTML = ''; }
                fetch('https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(q) + '&format=json&limit=5', { headers: NOMINATIM_HEADERS })
                    .then(function (r) { return r.json(); })
                    .then(function (list) {
                        if (!resultsEl || !list || list.length === 0) return;
                        resultsEl.innerHTML = list.map(function (item) {
                            return '<button type="button" class="block w-full px-4 py-2.5 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-700" data-lat="' + item.lat + '" data-lng="' + item.lon + '">' + (item.display_name || '').replace(/</g, '&lt;') + '</button>';
                        }).join('');
                        resultsEl.classList.remove('hidden');
                        resultsEl.querySelectorAll('button').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                var lat = parseFloat(btn.getAttribute('data-lat'));
                                var lng = parseFloat(btn.getAttribute('data-lng'));
                                addSiteSetMarkerAndCoords(lat, lng);
                                addSiteReverseGeocode(lat, lng);
                                if (searchInput) searchInput.value = btn.textContent.trim();
                                resultsEl.classList.add('hidden');
                            });
                        });
                    })
                    .catch(function () { });
            }

            if (searchBtn) searchBtn.addEventListener('click', doSearch);
            if (searchInput) searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
            });

            var myLocBtn = document.getElementById('addSite_MyLocationBtn');
            if (myLocBtn) {
                myLocBtn.addEventListener('click', function () {
                    if (!navigator.geolocation) { alert('Geolocation is not supported'); return; }
                    myLocBtn.disabled = true;
                    navigator.geolocation.getCurrentPosition(
                        function (pos) {
                            var lat = pos.coords.latitude;
                            var lng = pos.coords.longitude;
                            addSiteSetMarkerAndCoords(lat, lng);
                            addSiteReverseGeocode(lat, lng);
                            myLocBtn.disabled = false;
                        },
                        function () {
                            alert('Could not get your location');
                            myLocBtn.disabled = false;
                        }
                    );
                });
            }
        }

        window.openAddSiteModal = function () {
            var overlay = document.getElementById('addSiteModalOverlay');
            var modal = document.getElementById('addSiteModal');
            if (!overlay || !modal) return;
            overlay.classList.remove('hidden');
            setTimeout(function () {
                overlay.classList.replace('opacity-0', 'opacity-100');
                modal.classList.replace('scale-95', 'scale-100');
            }, 10);
            setTimeout(initAddSiteMap, 100);
        };

        window.closeAddSiteModal = function () {
            var overlay = document.getElementById('addSiteModalOverlay');
            var modal = document.getElementById('addSiteModal');
            if (!overlay || !modal) return;
            overlay.classList.replace('opacity-100', 'opacity-0');
            modal.classList.replace('scale-100', 'scale-95');
            setTimeout(function () {
                overlay.classList.add('hidden');
                if (addSiteMapInstance) {
                    addSiteMapInstance.remove();
                    addSiteMapInstance = null;
                    addSiteMarker = null;
                }
            }, 300);
        };

        function initSitesMapAndList() {
            var sites = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(s => new { id = s.SiteId, code = s.SiteCode, name = s.SiteName, status = s.Status, lat = s.Latitude, lng = s.Longitude }).ToList()));
            var mapEl = document.getElementById('sites-map');
            var listEl = document.getElementById('sites-list');
            if (!mapEl || typeof L === 'undefined') return;

            var DEFAULT_LAT = 7.0707, DEFAULT_LNG = 125.6083, FOCUS_ZOOM = 15;
            var markerBySiteId = new Map();
            var markersLayer = L.layerGroup();

            mainSitesMap = L.map('sites-map').setView([DEFAULT_LAT, DEFAULT_LNG], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(mainSitesMap);
            markersLayer.addTo(mainSitesMap);

            var sitesWithCoords = sites.filter(function (s) { return s.lat != null && s.lng != null; });
            sitesWithCoords.forEach(function (s) {
                var lat = Number(s.lat), lng = Number(s.lng);
                var popupContent = '<strong>' + (s.name || '').replace(/</g, '&lt;') + '</strong>' + (s.code ? ' <span class="text-slate-500">(' + (s.code || '').replace(/</g, '&lt;') + ')</span>' : '');

                var icon = L.divIcon({
                    className: 'monitoring-site-icon',
                    html: '<div class="site-marker status-' + s.status + '"><div class="pin"></div><div class="pulse"></div></div>',
                    iconSize: [20, 20],
                    iconAnchor: [10, 20],
                    popupAnchor: [0, -20]
                });

                var marker = L.marker([lat, lng], { icon: icon }).bindPopup(popupContent);
                marker.on('click', function () { selectSite(s.id); });
                markersLayer.addLayer(marker);
                markerBySiteId.set(String(s.id), marker);
            });

            if (sitesWithCoords.length > 0) {
                var bounds = L.latLngBounds(sitesWithCoords.map(function (s) { return [Number(s.lat), Number(s.lng)]; }));
                mainSitesMap.fitBounds(bounds, { padding: [24, 24], maxZoom: 14 });
            }
            setTimeout(function () { if (mainSitesMap) mainSitesMap.invalidateSize(); }, 50);

            function selectSite(siteId) {
                if (listEl) {
                    listEl.querySelectorAll('.sites-list-item').forEach(function (el) {
                        var id = el.getAttribute('data-site-id');
                        if (id === String(siteId)) {
                            el.classList.add('bg-indigo-50', 'dark:bg-indigo-900/20', 'ring-1', 'ring-indigo-500/30');
                            el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                        } else {
                            el.classList.remove('bg-indigo-50', 'dark:bg-indigo-900/20', 'ring-1', 'ring-indigo-500/30');
                        }
                    });
                }
                markerBySiteId.forEach(function (m, id) {
                    var el = m.getElement();
                    if (!el) return;
                    var inner = el.querySelector('.site-marker');
                    if (!inner) return;
                    if (id === String(siteId)) inner.classList.add('selected');
                    else inner.classList.remove('selected');
                });
            }

            if (listEl) {
                listEl.querySelectorAll('.sites-list-item').forEach(function (el) {
                    el.addEventListener('click', function () {
                        var siteId = el.getAttribute('data-site-id');
                        var lat = el.getAttribute('data-lat'), lng = el.getAttribute('data-lng');
                        selectSite(siteId);
                        if (lat && lng && mainSitesMap) {
                            var latNum = parseFloat(lat), lngNum = parseFloat(lng);
                            mainSitesMap.flyTo([latNum, lngNum], FOCUS_ZOOM);
                            var m = markerBySiteId.get(String(siteId));
                            if (m) m.openPopup();
                        }
                    });
                });
            }
        }

        function initSitesPage() {
            var content = document.getElementById('sites-content');
            if (!content || content.dataset.loaded === '1') return;

            setTimeout(function () {
                var skeleton = document.getElementById('sites-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                content.classList.remove('hidden');

                if (typeof L === 'undefined') {
                    setTimeout(initSitesPage, 200);
                    return;
                }

                var overlayEl = document.getElementById('addSiteModalOverlay');
                if (overlayEl) {
                    overlayEl.addEventListener('click', function (e) {
                        if (e.target === this) window.closeAddSiteModal();
                    });
                }

                initSitesMapAndList();
                content.dataset.loaded = '1';
            }, 300);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSitesPage);
        } else {
            initSitesPage();
        }

        window.addEventListener('beforeunload', function () {
            if (mainSitesMap) mainSitesMap.remove();
            if (addSiteMapInstance) addSiteMapInstance.remove();
        });
    })();
</script>
