                <button type="button" id="viewTabControls" class="view-tab rounded-t-lg border-b-2 border-transparent px-4 py-2 text-xs font-bold uppercase text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300" data-tab="controls">Controls</button>
