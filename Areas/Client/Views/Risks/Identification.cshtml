<script>
    (function () {
        var isEmployeeOnly = @(ViewBag.IsEmployeeOnly == true ? "true" : "false");
        var currentUserId = "@(ViewBag.CurrentUserId ?? "")";
        var isAdmin = @(ViewBag.IsAdmin == true ? "true" : "false");
        var isRiskManager = @(ViewBag.IsRiskManager == true ? "true" : "false");
        window.__isEmployeeOnly = isEmployeeOnly;
        window.__currentUserId = currentUserId;
        window.__isAdmin = isAdmin;
        window.__isRiskManager = isRiskManager;
    })();

    var addMap, editMap, addMarker, editMarker;

    function initMap(mapId, lat, lng) {
        lat = lat || 7.0707; lng = lng || 125.6087;
        var map = L.map(mapId).setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        var marker = L.marker([lat, lng]).addTo(map);
        return { map: map, marker: marker };
    }

    function toggleNewRiskModal() {
        var modal = document.getElementById('newRiskModal');
        modal.classList.toggle('hidden');
        if (!modal.classList.contains('hidden') && !addMap) {
            setTimeout(function () { var res = initMap('addMap'); addMap = res.map; addMarker = res.marker; }, 200);
        }
    }

    function toggleEditModal() {
        var modal = document.getElementById('editRiskModal');
        modal.classList.toggle('hidden');
        if (!modal.classList.contains('hidden') && !editMap) {
            setTimeout(function () { var res = initMap('editMap'); editMap = res.map; editMarker = res.marker; }, 200);
        }
    }

    function toggleViewModal() {
        document.getElementById('viewRiskModal').classList.toggle('hidden');
    }

    function toggleDropdown(btn) {
        var dd = btn.closest('.more-dropdown');
        var panel = dd.querySelector('.dropdown-panel');
        var isOpen = panel.classList.contains('hidden');
        document.querySelectorAll('.dropdown-panel').forEach(function (p) { p.classList.add('hidden'); });
        document.querySelectorAll('.more-dropdown').forEach(function (d) { d.classList.remove('open'); });
        if (isOpen) {
            panel.classList.remove('hidden');
            dd.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
        } else {
            btn.setAttribute('aria-expanded', 'false');
        }
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.more-dropdown')) {
            document.querySelectorAll('.dropdown-panel').forEach(function (p) { p.classList.add('hidden'); });
            document.querySelectorAll('.more-dropdown').forEach(function (d) { d.classList.remove('open'); });
        }
    });

    function openViewModal(btn) {
        var riskData = null;
        var tr = btn && btn.closest ? btn.closest('tr') : null;
        if (tr && tr.getAttribute && tr.getAttribute('data-risk')) riskData = tr.getAttribute('data-risk');
        else if (btn && btn.getAttribute && btn.getAttribute('data-risk')) riskData = btn.getAttribute('data-risk');
        if (!riskData) return;
        try { window._currentViewRisk = JSON.parse(riskData); } catch (e) { return; }
        var risk = window._currentViewRisk;
        document.getElementById('viewTitle').textContent = risk.Title || '';
        document.getElementById('viewCategory').textContent = risk.Category || '';
        document.getElementById('viewPriority').textContent = risk.Priority || 'Unassessed';
        document.getElementById('viewStatus').textContent = risk.Status || 'Draft';
        document.getElementById('viewSourceType').textContent = risk.SourceType || '—';
        document.getElementById('viewProjectSite').textContent = risk.ProjectSite || '';
        document.getElementById('viewDateReported').textContent = risk.DateReported || '';
        document.getElementById('viewReportedBy').textContent = risk.ReportedBy || '—';
        var container = document.getElementById('viewAttachments');
        container.innerHTML = '';
        if (risk.Attachments && risk.Attachments.length > 0) {
            risk.Attachments.forEach(function (path) {
                var img = document.createElement('img');
                img.src = path.indexOf('/') === 0 ? path : '/' + path;
                img.alt = 'Attachment';
                img.className = 'w-20 h-20 object-cover rounded-lg border border-slate-200 dark:border-slate-700';
                container.appendChild(img);
            });
        } else {
            container.textContent = 'No attachments';
        }
        var canEdit = risk.Status === 'Draft' && (!window.__isEmployeeOnly || (risk.ReportByUserId && risk.ReportByUserId === window.__currentUserId));
        document.getElementById('viewModalFooter').classList.toggle('hidden', !canEdit);
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');

        var actionStatus = (risk.Status === 'For review' || risk.Status === 'Submitted' || risk.Status === 'Reviewed' || risk.Status === 'For_Review') ? 'For_Review' : (risk.Status || 'Draft');
        var canSubmitDraft = actionStatus === 'Draft' && (risk.ReportByUserId && risk.ReportByUserId === window.__currentUserId);
        var canAssess = actionStatus === 'For_Review' && window.__isRiskManager;
        var canReject = actionStatus === 'For_Review' && window.__isAdmin;
        var actionsBar = document.getElementById('viewModalActions');
        var submitForm = document.getElementById('viewModalSubmitForm');
        var submitRiskIdInput = document.getElementById('viewModalSubmitRiskId');
        var assessLink = document.getElementById('viewModalAssessLink');
        var rejectBtn = document.getElementById('viewModalRejectBtn');
        var bottomBar = document.getElementById('viewModalBottomBar');
        if (canSubmitDraft || canAssess || canReject || canEdit) {
            if (bottomBar) bottomBar.classList.remove('hidden');
            if (canSubmitDraft || canAssess || canReject) {
            actionsBar.classList.remove('hidden');
            if (canSubmitDraft) {
                submitRiskIdInput.value = risk.Id;
                submitForm.classList.remove('hidden');
                assessLink.classList.add('hidden');
                rejectBtn.classList.add('hidden');
            } else {
                submitForm.classList.add('hidden');
                if (canAssess) {
                    assessLink.href = '@Url.Action("Assess", "Risks", new { area = "Client" })/' + risk.Id;
                    assessLink.classList.remove('hidden');
                } else {
                    assessLink.classList.add('hidden');
                }
                if (canReject) {
                    rejectBtn.setAttribute('data-risk-id', risk.Id);
                    rejectBtn.classList.remove('hidden');
                } else {
                    rejectBtn.classList.add('hidden');
                }
            }
            } else {
                actionsBar.classList.add('hidden');
            }
        } else {
            if (bottomBar) bottomBar.classList.add('hidden');
            actionsBar.classList.add('hidden');
        }

        var stepper = document.getElementById('viewWorkflowStepper');
        stepper.querySelectorAll('.step').forEach(function (el) {
            el.classList.remove('bg-emerald-600', 'text-white', 'px-2', 'py-0.5', 'rounded');
            el.classList.add('text-slate-500', 'dark:text-slate-400');
        });
        var status = risk.Status || 'Draft';
        var currentStep = status;
        if (status === 'Approved' || status === 'Rejected') currentStep = status === 'Rejected' ? 'Closed_Invalid' : 'Monitoring';
        else if (status === 'Reviewed') currentStep = 'Submitted';
        else if (status === 'Closed_Controlled') currentStep = 'Closed_Invalid';
        var currentEl = stepper.querySelector('.step[data-step="' + currentStep + '"]');
        if (currentEl) {
            currentEl.classList.add('bg-emerald-600', 'text-white', 'px-2', 'py-0.5', 'rounded');
            currentEl.classList.remove('text-slate-500', 'dark:text-slate-400');
        }

        toggleViewModal();
    }

    document.getElementById('viewModalRejectBtn').addEventListener('click', function () {
        var riskId = this.getAttribute('data-risk-id');
        if (riskId) {
            document.getElementById('rejectRiskId').value = riskId;
            document.getElementById('rejectRemarks').value = '';
            toggleViewModal();
            document.getElementById('rejectModal').classList.remove('hidden');
        }
    });

    document.getElementById('risksTable').addEventListener('click', function (e) {
        var viewBtn = e.target.closest('[data-action="view"]');
        if (viewBtn) {
            e.preventDefault();
            var tr = viewBtn.closest('tr');
            if (tr && tr.getAttribute('data-risk')) {
                var fakeBtn = document.createElement('button');
                fakeBtn.setAttribute('data-risk', tr.getAttribute('data-risk'));
                openViewModal(fakeBtn);
            }
            document.querySelectorAll('.dropdown-panel').forEach(function (p) { p.classList.add('hidden'); });
        }
        var editBtn = e.target.closest('.row-action-edit');
        if (editBtn) {
            e.preventDefault();
            var id = editBtn.getAttribute('data-risk-id');
            var title = editBtn.getAttribute('data-title');
            var category = editBtn.getAttribute('data-category');
            var priority = editBtn.getAttribute('data-priority');
            var site = editBtn.getAttribute('data-site');
            var date = editBtn.getAttribute('data-date');
            document.getElementById('editRiskId').value = id || '';
            document.getElementById('editTitle').value = title || '';
            document.getElementById('editProjectSite').value = site || '';
            document.getElementById('editDate').value = date || '';
            toggleEditModal();
            document.querySelectorAll('.dropdown-panel').forEach(function (p) { p.classList.add('hidden'); });
        }
        var hdBtn = e.target.closest('.row-action-harddelete');
        if (hdBtn) {
            e.preventDefault();
            document.getElementById('hardDeleteRiskId').value = hdBtn.getAttribute('data-risk-id') || '';
            document.getElementById('hardDeleteOrgId').value = hdBtn.getAttribute('data-org-id') || '';
            document.getElementById('hardDeleteModal').classList.remove('hidden');
            document.querySelectorAll('.dropdown-panel').forEach(function (p) { p.classList.add('hidden'); });
        }
    });

    function switchViewModalToEdit() {
        var risk = window._currentViewRisk;
        if (!risk) return;
        document.getElementById('viewEditRiskId').value = risk.Id || '';
        document.getElementById('viewEditDate').value = risk.DateReported || '';
        document.getElementById('viewEditCategory').value = risk.Category || 'Operational';
        document.getElementById('viewEditTitle').value = risk.Title || '';
        document.getElementById('viewEditSourceType').value = risk.SourceType || '';
        document.getElementById('viewEditStatus').value = risk.Status || 'Draft';
        document.getElementById('viewEditReportedBy').value = risk.ReportedBy || '—';
        document.getElementById('viewEditProjectSite').value = risk.ProjectSite || '';
        document.getElementById('viewRiskContent').classList.add('hidden');
        document.getElementById('viewModalFooter').classList.add('hidden');
        document.getElementById('viewModalEditPanel').classList.remove('hidden');
    }

    function switchViewModalToView() {
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalFooter').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');
    }

    function openRejectModal(riskId) {
        document.getElementById('rejectRiskId').value = riskId;
        document.getElementById('rejectRemarks').value = '';
        document.getElementById('rejectModal').classList.remove('hidden');
    }
    function closeRejectModal() {
        document.getElementById('rejectModal').classList.add('hidden');
    }

    function openHardDeleteModal(riskId, orgId) {
        document.getElementById('hardDeleteRiskId').value = riskId;
        document.getElementById('hardDeleteOrgId').value = orgId;
        document.getElementById('hardDeleteModal').classList.remove('hidden');
    }
    function closeHardDeleteModal() {
        document.getElementById('hardDeleteModal').classList.add('hidden');
    }

    function applyNeedsActionFilter() {
        var rows = document.querySelectorAll('#risksTable .risk-row');
        rows.forEach(function (row) {
            var status = row.getAttribute('data-status');
            var deleted = row.getAttribute('data-deleted') === '1';
            var show = !deleted && (status === 'Draft' || status === 'For review');
            row.style.display = show ? '' : 'none';
        });
    }
    var statusFilter = document.getElementById('statusFilter');
    if (statusFilter) {
        statusFilter.addEventListener('change', function () {
            if (this.value === 'NeedsAction') {
                applyNeedsActionFilter();
            } else {
                document.getElementById('filterForm').submit();
            }
        });
    }
    var filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.addEventListener('submit', function (e) {
            if (statusFilter && statusFilter.value === 'NeedsAction') {
                e.preventDefault();
                applyNeedsActionFilter();
            }
        });
    }

    async function autoDetectLocation(inputId, mapKey) {
        var inputField = document.getElementById(inputId);
        var marker = mapKey === 'addMap' ? addMarker : editMarker;
        var map = mapKey === 'addMap' ? addMap : editMap;
        if (!navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(async function (pos) {
            var lat = pos.coords.latitude;
            var lon = pos.coords.longitude;
            map.setView([lat, lon], 16);
            marker.setLatLng([lat, lon]);
            try {
                var res = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon);
                var data = await res.json();
                inputField.value = data.display_name || (lat + ', ' + lon);
            } catch (err) {
                inputField.value = lat + ', ' + lon;
            }
        });
    }
</script>
