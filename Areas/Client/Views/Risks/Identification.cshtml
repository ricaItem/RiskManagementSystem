                <div class="space-y-1">
                    <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Attachments</label>
                    <input type="file" name="Attachments" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-xs file:font-bold file:text-emerald-700 dark:border-slate-700 dark:bg-slate-800 dark:file:bg-emerald-900/30 dark:file:text-emerald-300" />
                </div>
                @if (TempData["AttachmentError"] != null) { <p class="text-xs text-rose-600 dark:text-rose-400">@TempData["AttachmentError"]</p> }
                <div class="flex gap-3 pt-2">
                    <button type="button" data-risk-submit="Draft" class="flex-1 rounded-2xl bg-slate-200 py-3.5 text-xs font-black tracking-widest text-slate-700 uppercase shadow disabled:opacity-70 dark:bg-slate-700 dark:text-slate-300">Save Draft</button>
                    <button type="button" data-risk-submit="Submit" class="flex-1 rounded-2xl bg-emerald-500 py-3.5 text-xs font-black tracking-widest text-white uppercase shadow-lg disabled:opacity-70">Submit Risk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Risk Modal -->
