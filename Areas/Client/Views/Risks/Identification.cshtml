@model IEnumerable<Web_Sentro.Areas.Client.Models.RiskIdentificationViewModel>
@{
    Layout = "_LayoutClient";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="max-w-full mx-auto space-y-6 animate-in fade-in duration-700">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
                Risk <span class="text-emerald-600">Identification</span>
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="toggleNewRiskModal()" class="flex items-center gap-2 bg-gradient-to-br from-emerald-600 to-teal-600 text-white px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest shadow-lg shadow-emerald-500/20 hover:scale-[1.02] active:scale-95 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                New Risk Entry
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var stat in new[] {
                new { Label = "Total Risks", Value = "10", Color = "emerald", Icon = "M2.25 18L9 11.25l4.306 4.307L15 13.5l3 3m-3-12h4.5m0 0v4.5m0-4.5L13.5 13.5" },
                new { Label = "Uncategorized", Value = "03", Color = "amber", Icon = "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" },
                new { Label = "Critical Priority", Value = "05", Color = "rose", Icon = "M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" },
                new { Label = "Site Pins", Value = "10", Color = "blue", Icon = "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" }
                })
        {
            <div class="relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-2xl shadow-sm group transition-all hover:shadow-md">
                <div class="relative z-10 flex justify-between items-start">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">@stat.Label</p>
                        <h3 class="text-3xl font-black text-slate-900 dark:text-white">@stat.Value</h3>
                    </div>
                    <div class="h-10 w-10 rounded-xl bg-@stat.Color-500/10 flex items-center justify-center text-@stat.Color-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="@stat.Icon" />
                        </svg>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-0 bg-@stat.Color-500 group-hover:w-full transition-all duration-500"></div>
            </div>
        }
    </div>

    <div class="flex flex-wrap items-center gap-4 bg-white/50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
        <div class="flex-1 min-w-[240px] relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <input type="text" placeholder="Search risks, locations, or tags..." class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-10 pr-4 py-2 text-xs font-normal focus:ring-2 focus:ring-emerald-500 outline-none transition-all">
        </div>
        <select class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-emerald-500">
            <option>All Categories</option>
            <option>Operational</option>
            <option>Financial</option>
            <option>Safety</option>
        </select>
        <select class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-emerald-500">
            <option>All Priorities</option>
            <option>Critical</option>
            <option>Medium</option>
            <option>Low</option>
        </select>
    </div>

    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="text-[10px] font-black uppercase tracking-[0.15em] text-slate-400 border-b border-slate-100 dark:border-slate-800">
                        <th class="px-6 py-4">Risk Detail</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Project/Site</th>
                        <th class="px-6 py-4">Priority</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Date Reported</th>
                        <th class="px-6 py-4">Reported by</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                    @foreach (var risk in Model)
                    {
                        var status = risk.Status ?? "Draft";
                        var dateReported = risk.DateReported ?? risk.DateLogged;
                        var reportedBy = risk.ReportedBy ?? risk.DetectedBy ?? "";
                        var riskJson = System.Text.Json.JsonSerializer.Serialize(new {
                            risk.Id,
                            Title = risk.Title ?? "",
                            risk.Category,
                            Priority = risk.Priority ?? "Medium",
                            Status = status,
                            risk.SourceType,
                            ProjectSite = risk.ProjectSite ?? "",
                            DateReported = dateReported.ToString("yyyy-MM-dd"),
                            ReportedBy = reportedBy,
                            ReportByUserId = risk.ReportByUserId,
                            Attachments = risk.Attachments ?? new List<string>()
                        });
                        var canSubmitThisDraft = status == "Draft" && (!(bool)(ViewBag.IsEmployeeOnly ?? true) || risk.ReportByUserId == ViewBag.CurrentUserId);
                        <tr class="group hover:bg-slate-50/50 dark:hover:bg-emerald-500/5 transition-all" data-risk="@Html.Raw(System.Net.WebUtility.HtmlEncode(riskJson))">
                            <td class="px-6 py-5">
                                <div class="font-medium text-slate-900 dark:text-white mb-0.5 max-w-[200px] truncate" title="@(risk.Title ?? "")">@(risk.Title ?? "")</div>
                                @if (risk.AttachmentsCount > 0)
                                {
                                    <span class="text-[10px] text-slate-400">@risk.AttachmentsCount file(s)</span>
                                }
                            </td>
                            <td class="px-6 py-5">
                                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-[10px] font-medium uppercase tracking-tighter">@(risk.Category ?? "")</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 max-w-[120px] truncate block" title="@(risk.ProjectSite ?? "")">@(risk.ProjectSite ?? "")</span>
                            </td>
                            <td class="px-6 py-5">
                                @{
                                    var priorityCls = (risk.Priority ?? "Medium") == "Critical" ? "text-rose-500" : (risk.Priority ?? "Medium") == "High" ? "text-orange-500" : "text-amber-500";
                                }
                                <span class="text-[10px] font-semibold @priorityCls uppercase">@(risk.Priority ?? "Medium")</span>
                            </td>
                            <td class="px-6 py-5">
                                @{
                                    var statusBadgeClass = status == "Submitted" ? "bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400" :
                                        status == "Reviewed" ? "bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400" :
                                        status == "Approved" ? "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400" :
                                        status == "Rejected" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400" :
                                        status == "MitigationRequired" ? "bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400" :
                                        "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400";
                                }
                                <span class="px-2.5 py-1 rounded-lg @statusBadgeClass text-[10px] font-bold uppercase tracking-tighter">@status</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 uppercase">@dateReported.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-600 dark:text-slate-300">@(reportedBy != "" ? reportedBy : "—")</span>
                            </td>
                            <td class="px-6 py-5 text-right">
                                @if (canSubmitThisDraft)
                                {
                                    <form action="@Url.Action("SubmitRisk", "Risks", new { area = "Client" })" method="post" class="inline-block mr-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RiskId" value="@risk.Id" />
                                        <button type="submit" class="p-2 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 transition-all text-slate-400 hover:text-emerald-600" title="Submit">Submit</button>
                                    </form>
                                }
                                <button type="button" onclick="openViewModal(this)" class="p-2 hover:bg-white dark:hover:bg-slate-700 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 transition-all text-slate-400 hover:text-blue-500" title="View">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <p class="text-[10px] font-medium text-slate-400 uppercase">Showing 1 to 10 of 24 entries</p>
            <div class="flex gap-2">
                <button class="px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 text-[10px] font-medium uppercase text-slate-400 hover:bg-slate-50 transition-all">Prev</button>
                <button class="px-3 py-1 rounded-lg bg-emerald-600 text-white text-[10px] font-semibold uppercase shadow-md shadow-emerald-500/20">1</button>
                <button class="px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 text-[10px] font-medium uppercase text-slate-400 hover:bg-slate-50 transition-all">2</button>
                <button class="px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 text-[10px] font-medium uppercase text-slate-400 hover:bg-slate-50 transition-all">Next</button>
            </div>
        </div>
    </div>
</div>

<div id="newRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleNewRiskModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl scale-100 transform rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase">Identify New Risk</h2>
                <button type="button" onclick="toggleNewRiskModal()" class="text-slate-400 hover:text-rose-500"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            </div>
            <form action="@Url.Action("IdentifyNewRisk", "Risks", new { area = "Client" })" method="post" enctype="multipart/form-data" class="space-y-4" onsubmit="var btns=this.querySelectorAll('button[type=submit]');btns.forEach(function(b){b.disabled=true;});">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Date Reported</label>
                        <input type="date" name="ReportedDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Risk Category</label>
                        <select name="Category" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option>Operational</option>
                            <option>Financial</option>
                            <option>Safety</option>
                        </select>
                    </div>
                </div>
                <input type="text" name="Title" placeholder="Risk Description" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Source Type</label>
                        <select name="SourceType" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option value="Inspection">Inspection</option>
                            <option value="Incident">Incident</option>
                            <option value="Audit">Audit</option>
                            <option value="Observation">Observation</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Status</label>
                        <input type="text" readonly value="Draft" class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Reported By</label>
                    <input type="text" readonly value="Auto-filled" class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                </div>
                <div class="space-y-2">
                    <div class="relative">
                        <input type="text" id="addProjectSite" name="ProjectSite" placeholder="Job Site Location" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 pr-12 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                        <button type="button" onclick="autoDetectLocation('addProjectSite', 'addMap')" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-emerald-500 hover:scale-110 transition-transform">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2" /><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" stroke-width="2" /></svg>
                        </button>
                    </div>
                    <div id="addMap" class="h-40 w-full rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden"></div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Attachments</label>
                    <input type="file" name="Attachments" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-xs file:font-bold file:text-emerald-700 dark:file:bg-emerald-900/30 dark:file:text-emerald-300" />
                </div>
                @if (TempData["AttachmentError"] != null)
                {
                    <p class="text-rose-600 dark:text-rose-400 text-xs">@TempData["AttachmentError"]</p>
                }
                <div class="flex gap-3 pt-2">
                    <button type="submit" name="submitType" value="Draft" id="newRiskSubmitBtn" class="flex-1 rounded-xl bg-slate-200 dark:bg-slate-700 py-3.5 text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-300 shadow disabled:opacity-70">Save Draft</button>
                    <button type="submit" name="submitType" value="Submit" class="flex-1 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-600 py-3.5 text-xs font-black uppercase tracking-widest text-white shadow-lg disabled:opacity-70">Submit Risk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="viewRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleViewModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl scale-100 transform rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase">Risk <span class="text-emerald-600">Details</span></h2>
                <button type="button" onclick="toggleViewModal()" class="p-2 text-slate-400 hover:text-rose-500 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-all"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></button>
            </div>
            <div id="viewRiskContent" class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Title</label>
                    <div id="viewTitle" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Category</label>
                        <div id="viewCategory" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Priority</label>
                        <div id="viewPriority" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Status</label>
                        <div id="viewStatus" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Source Type</label>
                        <div id="viewSourceType" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Project/Site</label>
                    <div id="viewProjectSite" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white min-h-[2.75rem]"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Date Reported</label>
                        <div id="viewDateReported" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Reported By</label>
                        <div id="viewReportedBy" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 text-sm font-bold text-slate-900 dark:text-white"></div>
                    </div>
                </div>
                <div id="viewAttachmentsWrap" class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1 block">Attachments</label>
                    <div id="viewAttachments" class="flex flex-wrap gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-sm text-slate-500 dark:text-slate-400"></div>
                </div>
            </div>
            <div id="viewModalEditPanel" class="hidden space-y-4">
                <form id="viewModalEditForm" action="@Url.Action("UpdateRisk", "Risks", new { area = "Client" })" method="post" enctype="multipart/form-data" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RiskId" id="viewEditRiskId" />
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Date Reported</label>
                            <input type="date" id="viewEditDate" name="ReportedDate" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Risk Category</label>
                            <select id="viewEditCategory" name="Category" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700">
                                <option value="Operational">Operational</option>
                                <option value="Financial">Financial</option>
                                <option value="Safety">Safety</option>
                            </select>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Title</label>
                        <input type="text" id="viewEditTitle" name="Title" placeholder="Risk Description" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Source Type</label>
                            <select id="viewEditSourceType" name="SourceType" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700">
                                <option value="Inspection">Inspection</option>
                                <option value="Incident">Incident</option>
                                <option value="Audit">Audit</option>
                                <option value="Observation">Observation</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Status</label>
                            <input type="text" id="viewEditStatus" readonly class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                        </div>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Reported By</label>
                        <input type="text" id="viewEditReportedBy" readonly class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Project/Site</label>
                        <input type="text" id="viewEditProjectSite" name="ProjectSite" placeholder="Job Site Location" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Priority</label>
                        <select id="viewEditPriority" name="Priority" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700">
                            <option value="Critical">Critical</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Attachments</label>
                        <input type="file" name="Attachments" multiple accept="image/*" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-xs file:font-bold file:text-emerald-700 dark:file:bg-emerald-900/30 dark:file:text-emerald-300" />
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="switchViewModalToView()" class="flex-1 rounded-xl bg-slate-100 dark:bg-slate-800 py-3.5 text-xs font-black uppercase text-slate-500 dark:text-slate-400">Cancel</button>
                        <button type="submit" class="flex-[2] rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 py-3.5 text-xs font-black uppercase text-white shadow-lg">Save Changes</button>
                    </div>
                </form>
            </div>
            <div id="viewModalFooter" class="mt-4 flex justify-end">
                <button type="button" onclick="switchViewModalToEdit()" class="rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white px-5 py-2.5 text-xs font-black uppercase tracking-widest shadow-lg">Edit</button>
            </div>
        </div>
    </div>
</div>

<div id="editRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleEditModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl scale-100 transform rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase">Edit <span class="text-blue-600">Risk Details</span></h2>
                <button type="button" onclick="toggleEditModal()" class="text-slate-400 hover:text-rose-500"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
            </div>
            <form action="@Url.Action("UpdateRisk", "Risks", new { area = "Client" })" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RiskId" id="editRiskId" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Reported Date</label>
                        <input type="date" id="editDate" name="ReportedDate" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Risk Priority</label>
                        <select id="editPriority" name="Priority" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option value="Critical">Critical</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                    </div>
                </div>
                <input type="text" id="editTitle" name="Title" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Job Site</label>
                    <div class="relative">
                        <input type="text" id="editProjectSite" name="ProjectSite" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 pr-12 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                        <button type="button" onclick="autoDetectLocation('editProjectSite', 'editMap')" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-blue-500">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2" /><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" stroke-width="2" /></svg>
                        </button>
                    </div>
                    <div id="editMap" class="h-40 w-full rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden mt-2"></div>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="toggleEditModal()" class="flex-1 rounded-xl bg-slate-100 dark:bg-slate-800 py-3.5 text-xs font-black uppercase text-slate-500">Cancel</button>
                    <button type="submit" class="flex-[2] rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 py-3.5 text-xs font-black uppercase text-white shadow-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let addMap, editMap, addMarker, editMarker;
    window.__isEmployeeOnly = @(ViewBag.IsEmployeeOnly == true ? "true" : "false");
    window.__currentUserId = "@(ViewBag.CurrentUserId ?? "")";

    function initMap(mapId, lat = 7.0707, lng = 125.6087) {
        const map = L.map(mapId).setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        const marker = L.marker([lat, lng]).addTo(map);
        return { map, marker };
    }

    function toggleNewRiskModal() {
        const modal = document.getElementById('newRiskModal');
        modal.classList.toggle('hidden');
        if (!modal.classList.contains('hidden') && !addMap) {
            setTimeout(() => { const res = initMap('addMap'); addMap = res.map; addMarker = res.marker; }, 200);
        }
    }

    function toggleEditModal() {
        const modal = document.getElementById('editRiskModal');
        modal.classList.toggle('hidden');
        if (!modal.classList.contains('hidden') && !editMap) {
            setTimeout(() => { const res = initMap('editMap'); editMap = res.map; editMarker = res.marker; }, 200);
        }
    }

    function toggleViewModal() {
        const modal = document.getElementById('viewRiskModal');
        modal.classList.toggle('hidden');
    }

    function openViewModal(btn) {
        const tr = btn.closest('tr');
        if (!tr || !tr.dataset.risk) return;
        const risk = JSON.parse(tr.dataset.risk);
        window._currentViewRisk = risk;
        document.getElementById('viewTitle').textContent = risk.Title || '';
        document.getElementById('viewCategory').textContent = risk.Category || '';
        document.getElementById('viewPriority').textContent = risk.Priority || '';
        document.getElementById('viewStatus').textContent = risk.Status || 'Draft';
        document.getElementById('viewSourceType').textContent = risk.SourceType || '—';
        document.getElementById('viewProjectSite').textContent = risk.ProjectSite || '';
        document.getElementById('viewDateReported').textContent = risk.DateReported || '';
        document.getElementById('viewReportedBy').textContent = risk.ReportedBy || '—';
        const container = document.getElementById('viewAttachments');
        container.innerHTML = '';
        if (risk.Attachments && risk.Attachments.length > 0) {
            risk.Attachments.forEach(function (path) {
                const img = document.createElement('img');
                img.src = path.startsWith('/') ? path : '/' + path;
                img.alt = 'Attachment';
                img.className = 'w-20 h-20 object-cover rounded-lg border border-slate-200 dark:border-slate-700';
                container.appendChild(img);
            });
        } else {
            container.textContent = 'No attachments';
        }
        var canEdit = risk.Status === 'Draft' && (!window.__isEmployeeOnly || (risk.ReportByUserId && risk.ReportByUserId === window.__currentUserId));
        document.getElementById('viewModalFooter').classList.toggle('hidden', !canEdit);
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');
        toggleViewModal();
    }

    function switchViewModalToEdit() {
        var risk = window._currentViewRisk;
        if (!risk) return;
        document.getElementById('viewEditRiskId').value = risk.Id || '';
        document.getElementById('viewEditDate').value = risk.DateReported || '';
        document.getElementById('viewEditCategory').value = risk.Category || 'Operational';
        document.getElementById('viewEditTitle').value = risk.Title || '';
        document.getElementById('viewEditSourceType').value = risk.SourceType || '';
        document.getElementById('viewEditStatus').value = risk.Status || 'Draft';
        document.getElementById('viewEditReportedBy').value = risk.ReportedBy || '—';
        document.getElementById('viewEditProjectSite').value = risk.ProjectSite || '';
        document.getElementById('viewEditPriority').value = risk.Priority || 'Medium';
        document.getElementById('viewRiskContent').classList.add('hidden');
        document.getElementById('viewModalFooter').classList.add('hidden');
        document.getElementById('viewModalEditPanel').classList.remove('hidden');
    }

    function switchViewModalToView() {
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalFooter').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');
    }

    function openEditModal(id, title, category, priority, site, date) {
        document.getElementById('editRiskId').value = id || '';
        document.getElementById('editTitle').value = title || '';
        document.getElementById('editPriority').value = priority || 'Medium';
        document.getElementById('editProjectSite').value = site || '';
        document.getElementById('editDate').value = date || '';
        toggleEditModal();
    }

    async function autoDetectLocation(inputId, mapKey) {
        const inputField = document.getElementById(inputId);
        const marker = mapKey === 'addMap' ? addMarker : editMarker;
        const map = mapKey === 'addMap' ? addMap : editMap;
        navigator.geolocation.getCurrentPosition(async (pos) => {
            const { latitude, longitude } = pos.coords;
            map.setView([latitude, longitude], 16);
            marker.setLatLng([latitude, longitude]);
            const res = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + latitude + '&lon=' + longitude);
            const data = await res.json();
            inputField.value = data.display_name || (latitude + ', ' + longitude);
        });
    }
</script>
