@model Web_Sentro.Areas.Client.Models.PagedResult<Web_Sentro.Areas.Client.Models.RiskIdentificationViewModel>
@{
    Layout = "_LayoutClient";
    var isAdmin = ViewBag.IsAdmin == true;
    var isRiskManager = ViewBag.IsRiskManager == true;
    var query = Context.Request.Query;
    var baseUrl = Url.Action("Identification", "Risks", new { area = "Client", search = query["search"], status = query["status"], category = query["category"], siteId = query["siteId"], showDeleted = query["showDeleted"] });
    var siteFilterList = ViewBag.SiteFilterList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var sitesForRiskForm = ViewBag.SitesForRiskForm as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
    .glass-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
    }
    .dark .glass-card {
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .step-active {
        color: var(--brand-accent);
        border-bottom: 2px solid var(--brand-accent);
    }
</style>

<div class="animate-in fade-in min-h-screen space-y-8 duration-1000">
    @if (TempData["RejectError"] != null)
    {
        <div class="rounded-xl bg-rose-100 px-4 py-3 text-sm text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">@TempData["RejectError"]</div>
    }
    @if (TempData["ReviewError"] != null)
    {
        <div class="rounded-xl bg-amber-100 px-4 py-3 text-sm text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">@TempData["ReviewError"]</div>
    }
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                Risk <span class="italic" style="color: var(--brand-accent);">Identification</span>
            </h1>
            </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("ExportExcel", "Risks", new { area = "Client" })" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Export Excel</a>
            <button onclick="toggleNewRiskModal()"
                    class="btn-primary group relative flex items-center gap-3 rounded-xl px-6 py-3 shadow-card transition-all hover:-translate-y-0.5 hover:shadow-card-hover active:scale-95">
                + New Risk Entry
            </button>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        @foreach (var stat in new[] {
                new { Label = "Total Risks", Value = "12", Color = "emerald", Desc = "Active cases" },
                new { Label = "Uncategorized", Value = "03", Color = "amber", Desc = "Review needed" },
                new { Label = "Critical", Value = "05", Color = "rose", Desc = "Immediate action" },
                new { Label = "Site Pins", Value = "08", Color = "blue", Desc = "Geo-tagged" }
                })
        {
            <div class="kpi-card group rounded-xl sentro-card p-4 transition-all hover:-translate-y-0.5 hover:shadow-card-hover dark:border-slate-700 dark:bg-slate-800/90">
                <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">@stat.Label</p>
                <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@stat.Value</h3>
                <p class="mt-2 w-fit rounded-md px-1.5 py-0.5 font-bold tracking-tighter text-[9px] uppercase @(stat.Color == "rose" ? "bg-rose-50 text-rose-500 dark:bg-rose-500/10" : stat.Color == "amber" ? "bg-amber-50 text-amber-600 dark:bg-amber-500/10" : stat.Color == "blue" ? "bg-sky-50 text-sky-600 dark:bg-sky-500/10" : "bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10")">@stat.Desc</p>
            </div>
        }
    </div>

    <form method="get" action="@Url.Action("Identification", "Risks", new { area = "Client" })" id="filterForm" class="flex flex-wrap items-center gap-2 rounded-3xl sentro-card p-2 dark:border-slate-800 dark:bg-slate-900/90">
        <div class="flex min-w-[300px] flex-1 items-center rounded-2xl border border-transparent px-4 transition-all focus-within:ring-2 focus-within:ring-[var(--brand-primary)] focus-within:ring-opacity-20 dark:bg-slate-800/50" style="background: var(--bg-page);">
            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="3" stroke-linecap="round" /></svg>
            <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search global registry..." class="w-full bg-transparent p-4 text-xs font-bold outline-none dark:text-white">
        </div>
        @if (isAdmin)
        {
            <select name="status" id="statusFilter" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
                <option value="">All</option>
                <option value="NeedsAction">Needs Action</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        else
        {
            <select name="status" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
                <option value="">All Statuses</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        <select name="category" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
            <option value="">All Categories</option>
            <option value="Operational" @(Context.Request.Query["category"] == "Operational" ? "selected" : "")>Operational</option>
            <option value="Financial" @(Context.Request.Query["category"] == "Financial" ? "selected" : "")>Financial</option>
            <option value="Safety" @(Context.Request.Query["category"] == "Safety" ? "selected" : "")>Safety</option>
        </select>
        <select name="siteId" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
            @foreach (var item in siteFilterList)
            {
                <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedSiteId?.ToString())">@item.Text</option>
            }
        </select>
        @if (isAdmin)
        {
            <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-400">
                <input type="checkbox" name="showDeleted" value="true" @(ViewBag.ShowDeleted == true ? "checked" : "") onchange="this.form.submit()" />
                Show deleted
            </label>
        }
        <button type="submit" class="btn-accent rounded-2xl px-8 py-4 text-sm font-semibold tracking-wide transition-all">
            Apply Filters
        </button>
    </form>

    <div class="rounded-xl sentro-card p-5 dark:border-slate-700 dark:bg-slate-800/90">
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="risksTable">
                <thead>
                    <tr class="border-b border-slate-100 font-black tracking-tighter text-[10px] text-slate-400 uppercase dark:border-slate-800">
                        <th class="pb-2 pr-4">Risk Identity</th>
                        <th class="pb-2 pr-4">Category</th>
                        <th class="pb-2 pr-4">Site</th>
                        <th class="pb-2 pr-4 text-center">Priority</th>
                        <th class="pb-2 pr-4 text-center">Status</th>
                        <th class="pb-2 pr-4">Date Reported</th>
                        <th class="pb-2 pr-4">Next Review</th>
                        <th class="pb-2 pr-4">Reported by</th>
                        <th class="w-48 pb-2 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 dark:divide-slate-800">
                    @foreach (var risk in Model.Items)
                    {
                        var status = risk.Status ?? "Draft";
                        var statusDisplay = status == "Rejected" ? "Rejected" : status == "For_Review" || status == "Submitted" || status == "Reviewed" ? "For review" : status == "Approved" ? "Monitoring" : status == "Closed_Invalid" ? "Closed_Invalid" : status;
                        var actionStatus = status == "Submitted" || status == "Reviewed" ? "For_Review" : status;
                        var dateReported = risk.DateReported ?? risk.DateLogged;
                        var reportedBy = risk.ReportedBy ?? risk.DetectedBy ?? "";
                        var isDeleted = risk.DeletedAt.HasValue;
                        var priorityVal = risk.Priority ?? "Unassessed";
                        var riskJson = System.Text.Json.JsonSerializer.Serialize(new {
                            risk.Id,
                            Title = risk.Title ?? "",
                            risk.Category,
                            Priority = priorityVal,
                            Status = statusDisplay,
                            risk.SourceType,
                            ProjectSite = risk.ProjectSite ?? "",
                            SiteId = risk.SiteId,
                            SiteName = risk.SiteName ?? "Unassigned",
                            DateReported = dateReported.ToString("yyyy-MM-dd"),
                            ReportedBy = reportedBy,
                            ReportByUserId = risk.ReportByUserId,
                            risk.OrgId,
                            DeletedAt = risk.DeletedAt,
                            Attachments = risk.Attachments ?? new List<string>(),
                            NextReviewDate = risk.NextReviewDate?.ToString("yyyy-MM-dd"),
                            OverdueFlag = risk.OverdueFlag
                        });
                        <tr class="risk-row group cursor-default transition-all hover:bg-slate-50/50 dark:hover:bg-white/5 @(isDeleted ? "opacity-60" : "")" data-risk="@Html.Raw(System.Net.WebUtility.HtmlEncode(riskJson))" data-status="@statusDisplay" data-priority="@priorityVal" data-deleted="@(isDeleted ? "1" : "0")">
                            <td class="py-3 pr-4">
                                <div class="flex items-center gap-4">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-emerald-500/10 text-xs font-black text-emerald-600">
                                        @(risk.Category?.Length > 0 ? risk.Category.Substring(0, 1) : "?")
                                    </div>
                                    <div>
                                        <div class="mb-1 max-w-[200px] truncate text-sm font-black tracking-tight text-slate-900 dark:text-white" title="@(risk.Title ?? "")">@(risk.Title ?? "")</div>
                                        @if (risk.AttachmentsCount > 0) { <span class="text-[10px] text-slate-400">@risk.AttachmentsCount file(s)</span> }
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 pr-4">
                                <span class="rounded-lg bg-slate-100 px-2.5 py-1 font-medium text-slate-600 text-[10px] uppercase dark:bg-slate-800 dark:text-slate-400">@(risk.Category ?? "")</span>
                            </td>
                            <td class="py-3 pr-4 max-w-[120px] truncate font-medium text-[11px] text-slate-600 dark:text-slate-400" title="@(risk.SiteName ?? "Unassigned")">@(risk.SiteName ?? "Unassigned")</td>
                            <td class="py-3 pr-4 text-center">
                                @{ var priorityCls = priorityVal == "Critical" ? "text-rose-500" : priorityVal == "High" ? "text-orange-500" : priorityVal == "Medium" ? "text-amber-500" : priorityVal == "Low" ? "text-emerald-500" : "text-slate-400"; }
                                <span class="rounded-lg px-3 py-1 font-black text-[10px] uppercase @(priorityVal == "Critical" ? "bg-rose-500/10 text-rose-500" : "bg-slate-100 dark:bg-slate-800 text-slate-500")">@priorityVal</span>
                            </td>
                            <td class="py-3 pr-4 text-center">
                                @{
                                    var statusBadgeClass = statusDisplay == "For review" ? "bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400" :
                                        statusDisplay == "Rejected" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400" :
                                        statusDisplay == "Monitoring" ? "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400" :
                                        statusDisplay == "MitigationRequired" ? "bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400" :
                                        statusDisplay == "Closed_Invalid" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400" :
                                        statusDisplay == "Closed_Controlled" ? "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400" :
                                        "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400";
                                }
                                <span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 @statusBadgeClass font-black tracking-widest text-[9px] uppercase">
                                    <span class="h-1.5 w-1.5 rounded-full @(statusDisplay == "For review" || statusDisplay == "Monitoring" ? "animate-pulse bg-current" : "bg-current")"></span>
                                    @statusDisplay
                                </span>
                            </td>
                            <td class="py-3 pr-4">
                                <span class="font-medium text-[10px] text-slate-500 uppercase dark:text-slate-400">@dateReported.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="py-3 pr-4">
                                @if (risk.NextReviewDate.HasValue)
                                {
                                    <span class="font-medium text-[10px] @(risk.OverdueFlag ? "text-rose-600 dark:text-rose-400" : "text-slate-500 dark:text-slate-400")" title="@(risk.OverdueFlag ? "Overdue" : "Due")">@risk.NextReviewDate.Value.ToString("MMM dd, yyyy")@(risk.OverdueFlag ? " ⚠" : "")</span>
                                }
                                else
                                {
                                    <span class="text-[10px] text-slate-400">—</span>
                                }
                            </td>
                            <td class="py-3 pr-4">
                                <span class="font-medium text-[10px] text-slate-600 dark:text-slate-300">@(reportedBy != "" ? reportedBy : "—")</span>
                            </td>
                            <td class="py-3 pr-4">
                                <div class="flex items-center justify-end gap-1">
                                    @if (!isDeleted)
                                    {
                                        <button type="button" onclick="openViewModal(this)" class="rounded-xl border border-slate-200 p-3 transition-all hover:bg-slate-800 hover:text-slate-100 dark:border-slate-700 dark:hover:bg-slate-700 dark:hover:text-slate-100" aria-label="View risk details">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </button>
                                        @if (actionStatus == "Draft" && (risk.ReportByUserId == ViewBag.CurrentUserId || isAdmin))
                                        {
                                            <form action="@Url.Action("HardDelete", "Risks", new { area = "Client" })" method="post" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@risk.Id" />
                                                <input type="hidden" name="orgId" value="@risk.OrgId" />
                                                <button type="submit" class="rounded-xl border border-slate-200 p-3 text-rose-500 transition-all hover:bg-rose-50 dark:border-slate-700 dark:hover:bg-rose-900/20" aria-label="Delete permanently">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </form>
                                        }
                                        else if (actionStatus != "Draft")
                                        {
                                            <form action="@Url.Action("SoftDelete", "Risks", new { area = "Client" })" method="post" class="inline-block">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@risk.Id" />
                                                <button type="submit" class="rounded-xl border border-slate-200 p-3 text-rose-500 transition-all hover:bg-rose-50 dark:border-slate-700 dark:hover:bg-rose-900/20" aria-label="Archive (soft delete)">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </form>
                                        }
                                    }
                                    else if (isAdmin)
                                    {
                                        <form action="@Url.Action("Restore", "Risks", new { area = "Client" })" method="post" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@risk.Id" />
                                            <button type="submit" class="rounded-xl border border-slate-200 p-3 text-emerald-600 transition-all hover:bg-emerald-50 dark:border-slate-700 dark:hover:bg-emerald-900/20" aria-label="Restore risk"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            ViewData["PageNumber"] = Model.PageNumber;
            ViewData["TotalPages"] = Model.TotalPages;
            ViewData["TotalCount"] = Model.TotalCount;
            ViewData["PageSize"] = Model.PageSize;
            ViewData["BaseUrl"] = baseUrl;
        }
        @await Html.PartialAsync("_Pagination")
    </div>
</div>

<!-- New Risk Modal -->
<div id="newRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleNewRiskModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl scale-100 transform rounded-[2.5rem] border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 uppercase dark:text-white">Identify New Risk</h2>
                <button type="button" onclick="toggleNewRiskModal()" class="text-slate-400 hover:text-rose-500" aria-label="Close"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
            </div>
            <form id="identifyRiskForm" action="@Url.Action("IdentifyNewRisk", "Risks", new { area = "Client" })" method="post" enctype="multipart/form-data" class="space-y-4" onsubmit="var btns=this.querySelectorAll('button[type=button][data-risk-submit]');btns.forEach(function(b){b.disabled=true;});">
                @Html.AntiForgeryToken()
                <input type="hidden" name="submitType" id="riskSubmitType" value="Draft" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Date Reported</label>
                        <input type="date" name="ReportedDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" required />
                    </div>
                    <div class="space-y-1">
                        <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Risk Category</label>
                        <select name="Category" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option>Operational</option>
                            <option>Financial</option>
                            <option>Safety</option>
                        </select>
                    </div>
                </div>
                <input type="text" name="Title" placeholder="Risk Description" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" required />
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Source Type</label>
                        <select name="SourceType" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option value="Inspection">Inspection</option>
                            <option value="Incident">Incident</option>
                            <option value="Audit">Audit</option>
                            <option value="Observation">Observation</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Status</label>
                        <input type="text" readonly value="Draft" class="w-full rounded-2xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm font-bold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400" title="Save Draft = Draft; Submit Risk = For review" />
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Site</label>
                    <select name="SiteId" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800">
                        @foreach (var item in sitesForRiskForm)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="ProjectSite" value="" />
                <div class="space-y-1">
                    <label class="ml-1 font-black text-[10px] text-slate-400 uppercase">Reported By</label>
                    <input type="text" readonly value="Auto-filled" class="w-full rounded-2xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm font-bold text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400" />
