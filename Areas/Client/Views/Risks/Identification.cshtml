@section Scripts {
<script>
(function() {
    const assessBaseUrl = '@Url.Action("Assess", "Risks", new { area = "Client" })';
    const isAdmin = @(isAdmin ? "true" : "false");
    const isRiskManager = @(isRiskManager ? "true" : "false");
    const currentUserId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrentUserId ?? ""));
    const isEmployeeOnly = @((ViewBag.IsEmployeeOnly ?? true) ? "true" : "false");

    let _addMapInstance = null;
    let _editMapInstance = null;

    window.toggleNewRiskModal = function() {
        const m = document.getElementById('newRiskModal');
        m.classList.toggle('hidden');
        document.body.style.overflow = m.classList.contains('hidden') ? 'auto' : 'hidden';
    };

    (function initIdentifyRiskForm() {
        const form = document.getElementById('identifyRiskForm');
        if (!form) return;
        form.querySelectorAll('button[data-risk-submit]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var hidden = document.getElementById('riskSubmitType');
                if (hidden) hidden.value = this.getAttribute('data-risk-submit') || 'Draft';
                form.submit();
            });
        });
    })();

    window.toggleViewModal = function() {
        const m = document.getElementById('viewRiskModal');
        m.classList.add('hidden');
        document.body.style.overflow = 'auto';
    };

    window.openViewModal = function(btn) {
        const row = btn.closest('tr.risk-row');
        if (!row) return;
        const json = row.getAttribute('data-risk');
        if (!json) return;
        let risk;
        try { risk = JSON.parse(json); } catch (e) { return; }

        document.getElementById('viewTitle').textContent = risk.Title || '';
        document.getElementById('viewCategory').textContent = risk.Category || '';
        document.getElementById('viewPriority').textContent = risk.Priority || '';
        document.getElementById('viewStatus').textContent = risk.Status || '';
        document.getElementById('viewSourceType').textContent = risk.SourceType || '';
        document.getElementById('viewSiteName').textContent = risk.SiteName || 'Unassigned';
        document.getElementById('viewDateReported').textContent = risk.DateReported || '';
        document.getElementById('viewReportedBy').textContent = risk.ReportedBy || '—';

        const attWrap = document.getElementById('viewAttachmentsWrap');
        const previewEl = document.getElementById('viewAttachmentsPreview');
        const isImage = function (u) {
            const ext = (u || '').split('.').pop()?.toLowerCase();
            return ['jpg', 'jpeg', 'png', 'gif', 'webp'].indexOf(ext || '') >= 0;
        };
        if (risk.Attachments && risk.Attachments.length > 0) {
            attWrap.classList.remove('hidden');
            const imageUrls = risk.Attachments.filter(isImage);
            if (imageUrls.length > 0) {
                previewEl.innerHTML = '<div class="flex flex-wrap items-center justify-center gap-3">' + imageUrls.map(function(url) {
                    return '<img src="' + url + '" alt="Attachment" class="max-h-[220px] max-w-full rounded-lg object-contain shadow-sm" />';
                }).join('') + '</div>';
            } else {
                previewEl.innerHTML = '<div class="flex flex-col items-center gap-2 text-slate-400"><svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" /></svg><span class="text-sm font-medium">File attachment (no preview)</span></div>';
            }
        } else {
            attWrap.classList.remove('hidden');
            previewEl.innerHTML = '<div class="flex flex-col items-center justify-center gap-3 text-slate-400"><div class="flex h-20 w-20 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600"><svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" /></svg></div><span class="text-xs font-medium">No attachment</span></div>';
        }

        document.getElementById('viewEditRiskId').value = risk.Id;
        document.getElementById('viewEditDate').value = risk.DateReported || '';
        document.getElementById('viewEditCategory').value = risk.Category || 'Operational';
        document.getElementById('viewEditTitle').value = risk.Title || '';
        document.getElementById('viewEditSourceType').value = risk.SourceType || 'Inspection';
        document.getElementById('viewEditStatus').value = risk.Status || '';
        document.getElementById('viewEditReportedBy').value = risk.ReportedBy || '';
        document.getElementById('viewEditSiteId').value = risk.SiteId != null ? risk.SiteId.toString() : '';
        var editProjectSiteEl = document.getElementById('viewEditProjectSite');
        if (editProjectSiteEl) editProjectSiteEl.value = risk.ProjectSite || '';

        document.getElementById('viewModalSubmitRiskId').value = risk.Id;
        document.getElementById('viewModalAssessLink').href = assessBaseUrl + '/' + risk.Id;
        var markReviewedInput = document.getElementById('viewModalMarkReviewedRiskId');
        if (markReviewedInput) markReviewedInput.value = risk.Id;
        var markReviewedForm = document.getElementById('viewModalMarkReviewedForm');
        if (markReviewedForm) markReviewedForm.classList.add('hidden');

        const status = risk.Status || 'Draft';
        const actionStatus = (status === 'Submitted' || status === 'Reviewed' || status === 'For review') ? 'For_Review' : status;
        // Draft: Submit + Edit only. For Review: Assess + Reject only.
        const canSubmitDraft = !risk.DeletedAt && actionStatus === 'Draft' && (!isEmployeeOnly || risk.ReportByUserId === currentUserId);
        const canEdit = !risk.DeletedAt && actionStatus === 'Draft' && (risk.ReportByUserId === currentUserId || isAdmin);
        const canAssess = !risk.DeletedAt && actionStatus === 'For_Review' && isRiskManager;
        const canReject = !risk.DeletedAt && actionStatus === 'For_Review' && isAdmin;
        const canMarkReviewed = !risk.DeletedAt && isRiskManager && (actionStatus === 'Monitoring' || actionStatus === 'MitigationRequired' || status === 'Approved');

        const bottomBar = document.getElementById('viewModalBottomBar');
        const submitForm = document.getElementById('viewModalSubmitForm');
        const assessLink = document.getElementById('viewModalAssessLink');
        const rejectBtn = document.getElementById('viewModalRejectBtn');
        const footer = document.getElementById('viewModalFooter');

        if (canSubmitDraft || canEdit || canAssess || canReject || canMarkReviewed) {
            bottomBar.classList.remove('hidden');
            submitForm.classList.toggle('hidden', !canSubmitDraft);
            assessLink.classList.toggle('hidden', !canAssess);
            rejectBtn.classList.toggle('hidden', !canReject);
            footer.classList.toggle('hidden', !canEdit);
            if (markReviewedForm) markReviewedForm.classList.toggle('hidden', !canMarkReviewed);
        } else {
            bottomBar.classList.add('hidden');
        }

        rejectBtn.onclick = function() {
            toggleViewModal();
            openRejectModal(risk.Id);
        };

        document.querySelectorAll('#viewWorkflowStepper .step').forEach(function(s) {
            s.classList.remove('step-active');
            if (s.getAttribute('data-step') === status || (status === 'For review' && s.getAttribute('data-step') === 'Submitted')) s.classList.add('step-active');
        });

        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');
        document.getElementById('viewModalVersionsPanel').classList.add('hidden');
        document.getElementById('viewModalControlsPanel').classList.add('hidden');
        document.querySelectorAll('.view-tab').forEach(function(t){ t.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]'); t.classList.add('border-transparent'); });
        document.getElementById('viewTabDetails').classList.add('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
        document.getElementById('viewTabDetails').classList.remove('border-transparent');

        document.getElementById('viewRiskModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };

    (function initViewTabs() {
        const tabDetails = document.getElementById('viewTabDetails');
        const tabVersions = document.getElementById('viewTabVersions');
        const contentDetails = document.getElementById('viewRiskContent');
        const contentVersions = document.getElementById('viewModalVersionsPanel');
        if (!tabDetails || !tabVersions) return;
        tabDetails.addEventListener('click', function() {
            contentDetails.classList.remove('hidden');
            contentVersions.classList.add('hidden');
            tabDetails.classList.add('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            tabDetails.classList.remove('border-transparent');
            tabVersions.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            tabVersions.classList.add('border-transparent');
        });
        tabVersions.addEventListener('click', function() {
            contentDetails.classList.add('hidden');
            contentVersions.classList.remove('hidden');
            document.getElementById('viewModalControlsPanel').classList.add('hidden');
            tabVersions.classList.add('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            tabVersions.classList.remove('border-transparent');
            tabDetails.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            tabDetails.classList.add('border-transparent');
            document.getElementById('viewTabControls').classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            document.getElementById('viewTabControls').classList.add('border-transparent');
            var riskId = document.getElementById('viewEditRiskId') && document.getElementById('viewEditRiskId').value;
            if (riskId) loadVersions(riskId);
        });
        var tabControls = document.getElementById('viewTabControls');
        var contentControls = document.getElementById('viewModalControlsPanel');
        if (tabControls && contentControls) {
            tabControls.addEventListener('click', function() {
                contentDetails.classList.add('hidden');
                contentVersions.classList.add('hidden');
                contentControls.classList.remove('hidden');
                tabControls.classList.add('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
                tabControls.classList.remove('border-transparent');
                tabDetails.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
                tabDetails.classList.add('border-transparent');
                tabVersions.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
                tabVersions.classList.add('border-transparent');
                var riskId = document.getElementById('viewEditRiskId') && document.getElementById('viewEditRiskId').value;
                if (riskId) loadControls(riskId);
            });
        }
    })();

    function loadControls(riskId) {
        var tbody = document.getElementById('viewControlsTableBody');
        var emptyEl = document.getElementById('viewControlsEmpty');
        var errEl = document.getElementById('viewControlsError');
        var selectEl = document.getElementById('viewControlsSelect');
        if (!tbody) return;
        tbody.innerHTML = '';
        if (emptyEl) emptyEl.classList.add('hidden');
        if (errEl) { errEl.classList.add('hidden'); errEl.textContent = ''; }
        function fetchOpts() { return { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' }; }
        Promise.all([
            fetch('/api/risks/' + riskId + '/controls', fetchOpts()).then(function(r){ return r.ok ? r.json() : []; }),
            fetch('/api/controls', fetchOpts()).then(function(r){ return r.ok ? r.json() : []; })
        ]).then(function(arr) {
            var linked = arr[0] || [];
            var allControls = arr[1] || [];
            var linkedIds = linked.map(function(l){ return l.controlId; });
            if (linked.length === 0) { if (emptyEl) emptyEl.classList.remove('hidden'); } else {
                linked.forEach(function(l) {
                    var tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/50';
                    tr.innerHTML = '<td class="p-2 font-medium">' + (l.controlName || '') + '</td><td class="p-2 max-w-[200px] truncate">' + (l.notes || '—') + '</td><td class="p-2"><button type="button" class="unlink-control text-rose-500 text-xs hover:underline" data-risk-control-id="' + l.riskControlId + '">Unlink</button></td>';
                    tbody.appendChild(tr);
                });
            }
            selectEl.innerHTML = '<option value="">Select control to link...</option>';
            allControls.filter(function(c){ return linkedIds.indexOf(c.controlId) < 0; }).forEach(function(c) {
                var opt = document.createElement('option');
                opt.value = c.controlId;
                opt.textContent = c.name || 'Control ' + c.controlId;
                selectEl.appendChild(opt);
            });
            selectEl.onchange = null;
            tbody.querySelectorAll('.unlink-control').forEach(function(btn) {
                btn.onclick = function() {
                    var rcId = btn.getAttribute('data-risk-control-id');
                    if (!rcId) return;
                    fetch('/api/risks/' + riskId + '/controls/' + rcId, { method: 'DELETE', credentials: 'same-origin' }).then(function(r) { if (r.ok) loadControls(riskId); });
                };
            });
        }).catch(function(e) { if (errEl) { errEl.textContent = e.message || 'Error'; errEl.classList.remove('hidden'); } });
        document.getElementById('viewControlsLinkBtn').onclick = function() {
            var cid = selectEl.value;
            if (!cid) return;
            fetch('/api/risks/' + riskId + '/controls', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ controlId: parseInt(cid, 10), notes: null }) })
                .then(function(r) { if (r.ok) { selectEl.value = ''; loadControls(riskId); } });
        };
    }

    function loadVersions(riskId) {
        var tbody = document.getElementById('viewVersionsTableBody');
        var emptyEl = document.getElementById('viewVersionsEmpty');
        var errEl = document.getElementById('viewVersionsError');
        if (!tbody) return;
        tbody.innerHTML = '';
        if (emptyEl) emptyEl.classList.add('hidden');
        if (errEl) { errEl.classList.add('hidden'); errEl.textContent = ''; }
        fetch('/api/risks/' + riskId + '/versions', { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
            .then(function(r) {
                if (!r.ok) throw new Error(r.status === 404 ? 'Risk not found' : r.status === 403 ? 'Access denied' : 'Failed to load');
                return r.json();
            })
            .then(function(list) {
                if (list.length === 0) {
                    if (emptyEl) { emptyEl.classList.remove('hidden'); }
                    return;
                }
                list.forEach(function(v) {
                    var tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/50';
                    var dateStr = v.changedAt ? new Date(v.changedAt).toLocaleString() : '—';
                    tr.innerHTML = '<td class="p-2 font-bold">' + (v.versionNo || '') + '</td><td class="p-2 text-slate-600 dark:text-slate-400">' + dateStr + '</td><td class="p-2">' + (v.changedByDisplayName || v.changedByUserId || '—') + '</td><td class="p-2 max-w-[200px] truncate" title="' + (v.changeSummary || '').replace(/"/g, '&quot;') + '">' + (v.changeSummary || '—') + '</td>';
                    tbody.appendChild(tr);
                });
            })
            .catch(function(e) {
                if (errEl) { errEl.textContent = e.message || 'Error loading versions'; errEl.classList.remove('hidden'); }
            });
    }

    window.switchViewModalToEdit = function() {
        document.getElementById('viewRiskContent').classList.add('hidden');
        document.getElementById('viewModalBottomBar').classList.add('hidden');
        document.getElementById('viewModalEditPanel').classList.remove('hidden');
    };

    window.switchViewModalToView = function() {
        document.getElementById('viewModalEditPanel').classList.add('hidden');
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalBottomBar').classList.remove('hidden');
    };

    window.openRejectModal = function(riskId) {
        document.getElementById('rejectRiskId').value = riskId;
        document.getElementById('rejectRemarks').value = '';
        document.getElementById('rejectModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };

    window.closeRejectModal = function() {
        document.getElementById('rejectModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    };

    window.openHardDeleteModal = function(riskId, orgId) {
        document.getElementById('hardDeleteRiskId').value = riskId;
        document.getElementById('hardDeleteOrgId').value = orgId;
        document.getElementById('hardDeleteModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };

    window.closeHardDeleteModal = function() {
        document.getElementById('hardDeleteModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    };

    // Auto-fill Job Site Location with user's address via reverse geocoding.
    window.autoDetectLocation = function(inputId, mapId) {
        const input = document.getElementById(inputId);
        const mapEl = document.getElementById(mapId);
        if (!input || !mapEl) return;
        if (!navigator.geolocation) { alert('Geolocation not supported'); return; }
        input.placeholder = 'Detecting location...';
        input.value = '';
        navigator.geolocation.getCurrentPosition(
            function(pos) {
                const lat = pos.coords.latitude;
                const lng = pos.coords.longitude;
                input.placeholder = 'Job Site Location';
                fetch('https://nominatim.openstreetmap.org/reverse?lat=' + lat + '&lon=' + lng + '&format=json', {
                    headers: { 'Accept': 'application/json', 'User-Agent': 'RiskManagementSystem/1.0' }
                })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data && data.display_name) {
                            input.value = data.display_name;
                        } else {
                            input.value = lat.toFixed(6) + ', ' + lng.toFixed(6);
                        }
                    })
                    .catch(function() {
                        input.value = lat.toFixed(6) + ', ' + lng.toFixed(6);
                    });
                if (typeof L !== 'undefined' && mapEl) {
                    if (mapId === 'addMap' && _addMapInstance) { _addMapInstance.remove(); _addMapInstance = null; }
                    if (mapId === 'editMap' && _editMapInstance) { _editMapInstance.remove(); _editMapInstance = null; }
                    const m = L.map(mapId).setView([lat, lng], 15);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(m);
                    L.marker([lat, lng]).addTo(m);
                    if (mapId === 'addMap') _addMapInstance = m; else _editMapInstance = m;
                }
            },
            function() {
                input.placeholder = 'Job Site Location';
                alert('Could not get location');
            }
        );
    };
})();
</script>
}