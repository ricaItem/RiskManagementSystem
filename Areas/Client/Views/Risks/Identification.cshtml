@model Web_Sentro.Areas.Client.Models.PagedResult<Web_Sentro.Areas.Client.Models.RiskIdentificationViewModel>
@{
    Layout = "_LayoutClient";
    var isAdmin = ViewBag.IsAdmin == true;
    var isRiskManager = ViewBag.IsRiskManager == true;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
    .glass-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
    }
    .dark .glass-card {
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .step-active {
        color: var(--brand-accent);
        border-bottom: 2px solid var(--brand-accent);
    }
</style>

<div id="risk-identification-skeleton" class="animate-pulse min-h-screen space-y-8 p-6">
    <!-- Header Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <div class="h-8 w-64 bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>
        <div class="flex items-center gap-3">
            <div class="h-10 w-32 bg-slate-200 rounded-xl dark:bg-slate-700"></div>
            <div class="h-10 w-40 bg-slate-200 rounded-xl dark:bg-slate-700"></div>
        </div>
    </div>

    <!-- KPI Cards Skeleton -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="mb-2 h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-8 w-12 bg-slate-200 rounded dark:bg-slate-700"></div>
                    </div>
                    <div class="h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                </div>
            </div>
        }
    </div>

    <!-- Filters Skeleton -->
    <div class="flex flex-wrap items-center gap-3">
        <div class="h-10 w-48 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
        <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
        <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
        <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
    </div>

    <!-- Table Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50">
             <div class="h-4 w-full bg-slate-100 rounded dark:bg-slate-800"></div>
        </div>
        <div class="p-4 space-y-4">
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center justify-between py-1">
                    <div class="flex items-center gap-3 w-1/3">
                        <div class="h-8 w-8 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
                        <div class="space-y-1 w-full">
                            <div class="h-3 w-3/4 bg-slate-100 rounded dark:bg-slate-800"></div>
                            <div class="h-2 w-1/2 bg-slate-100 rounded dark:bg-slate-800"></div>
                        </div>
                    </div>
                    <div class="h-5 w-16 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                    <div class="h-5 w-16 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                    <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                </div>
                @if (i < 4)
                {
                    <div class="border-b border-slate-50 dark:border-slate-800"></div>
                }
            }
        </div>
    </div>
</div>

<div id="risk-identification-content" class="hidden"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Build the query string from the current URL to preserve filters
            const searchParams = new URLSearchParams(window.location.search);
            const url = '@Url.Action("IdentificationContent", "Risks", new { area = "Client" })' + '?' + searchParams.toString();

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const contentDiv = document.getElementById('risk-identification-content');
                    contentDiv.innerHTML = html;

                    // Execute scripts from the fetched HTML
                    const scripts = contentDiv.getElementsByTagName('script');
                    const scriptsToExecute = [];

                    // Collect scripts first to avoid live collection issues if we modify DOM
                    for (let i = 0; i < scripts.length; i++) {
                        scriptsToExecute.push(scripts[i]);
                    }

                    for (let i = 0; i < scriptsToExecute.length; i++) {
                        const oldScript = scriptsToExecute[i];
                        const newScript = document.createElement('script');
                        
                        Array.from(oldScript.attributes).forEach(attr => {
                            newScript.setAttribute(attr.name, attr.value);
                        });
                        
                        if (oldScript.src) {
                            newScript.src = oldScript.src;
                        } else {
                            newScript.text = oldScript.innerHTML;
                        }
                        
                        // Use appendChild on body or head to ensure execution
                        document.body.appendChild(newScript);
                        // Optional: remove the old script tag
                        // oldScript.parentNode.removeChild(oldScript);
                    }

                    document.getElementById('risk-identification-skeleton').classList.add('hidden');
                    contentDiv.classList.remove('hidden');

                    // Pre-fill form if needed
                    @if (ViewBag.AutoOpenNewRiskModal == true)
                    {
                        <text>
                        setTimeout(() => {
                            const title = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.NewRiskTitle ?? ""));
                            const desc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.NewRiskDescription ?? ""));
                            const siteId = "@ViewBag.NewRiskSiteId";
                            const category = "@ViewBag.NewRiskCategory";
                            const sourceType = "@ViewBag.NewRiskSourceType";

                            if (document.getElementById('identifyRiskTitle')) document.getElementById('identifyRiskTitle').value = title + "\n\n" + desc;
                            if (document.getElementById('identifyRiskCategory')) document.getElementById('identifyRiskCategory').value = category;
                            if (document.getElementById('identifyRiskSourceType')) document.getElementById('identifyRiskSourceType').value = sourceType;
                            if (document.getElementById('identifyRiskSiteId') && siteId) document.getElementById('identifyRiskSiteId').value = siteId;
                            
                            if (typeof toggleNewRiskModal === 'function') toggleNewRiskModal();
                        }, 500);
                        </text>
                    }
                })
                .catch(error => {
                    console.error('Error fetching risk identification content:', error);
                });
        });
    </script>
}
