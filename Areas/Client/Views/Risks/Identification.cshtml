@model IEnumerable<Web_Sentro.Areas.Client.Models.RiskIdentificationViewModel>
@{
    Layout = "_LayoutClient";
    var isAdmin = ViewBag.IsAdmin == true;
    var isRiskManager = ViewBag.IsRiskManager == true;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="max-w-full mx-auto space-y-6 animate-in fade-in duration-700">
    @if (TempData["RejectError"] != null)
    {
        <div class="rounded-xl bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-300 px-4 py-3 text-sm">@TempData["RejectError"]</div>
    }
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
                Risk <span class="text-emerald-600">Identification</span>
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="toggleNewRiskModal()" class="flex items-center gap-2 bg-gradient-to-br from-emerald-600 to-teal-600 text-white px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest shadow-lg shadow-emerald-500/20 hover:scale-[1.02] active:scale-95 transition-all" aria-label="New risk entry">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                New Risk Entry
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var stat in new[] {
                new { Label = "Total Risks", Value = "10", Color = "emerald", Icon = "M2.25 18L9 11.25l4.306 4.307L15 13.5l3 3m-3-12h4.5m0 0v4.5m0-4.5L13.5 13.5" },
                new { Label = "Uncategorized", Value = "03", Color = "amber", Icon = "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" },
                new { Label = "Critical Priority", Value = "05", Color = "rose", Icon = "M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" },
                new { Label = "Site Pins", Value = "10", Color = "blue", Icon = "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" }
                })
        {
            <div class="relative overflow-hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-2xl shadow-sm group transition-all hover:shadow-md">
                <div class="relative z-10 flex justify-between items-start">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">@stat.Label</p>
                        <h3 class="text-3xl font-black text-slate-900 dark:text-white">@stat.Value</h3>
                    </div>
                    <div class="h-10 w-10 rounded-xl bg-@stat.Color-500/10 flex items-center justify-center text-@stat.Color-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="@stat.Icon" />
                        </svg>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-0 bg-@stat.Color-500 group-hover:w-full transition-all duration-500"></div>
            </div>
        }
    </div>

    <form method="get" action="@Url.Action("Identification", "Risks", new { area = "Client" })" id="filterForm" class="flex flex-wrap items-center gap-4 bg-white/50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
        <div class="flex-1 min-w-[200px] relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search risks..." class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-10 pr-4 py-2 text-xs font-normal focus:ring-2 focus:ring-emerald-500 outline-none transition-all">
        </div>
        @if (isAdmin)
        {
            <select name="status" id="statusFilter" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="">All</option>
                <option value="NeedsAction">Needs Action</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        else
        {
            <select name="status" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="">All Statuses</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        <select name="category" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="">All Categories</option>
            <option value="Operational" @(Context.Request.Query["category"] == "Operational" ? "selected" : "")>Operational</option>
            <option value="Financial" @(Context.Request.Query["category"] == "Financial" ? "selected" : "")>Financial</option>
            <option value="Safety" @(Context.Request.Query["category"] == "Safety" ? "selected" : "")>Safety</option>
        </select>
        @if (isAdmin)
        {
            <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-400">
                <input type="checkbox" name="showDeleted" value="true" @(ViewBag.ShowDeleted == true ? "checked" : "") onchange="this.form.submit()" />
                Show deleted
            </label>
        }
        <button type="submit" class="rounded-xl bg-emerald-600 text-white px-4 py-2 text-xs font-bold uppercase">Filter</button>
    </form>

    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="risksTable">
                <thead>
                    <tr class="text-[10px] font-black uppercase tracking-[0.15em] text-slate-400 border-b border-slate-100 dark:border-slate-800">
                        <th class="px-6 py-4">Risk Detail</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Project/Site</th>
                        <th class="px-6 py-4">Priority</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Date Reported</th>
                        <th class="px-6 py-4">Reported by</th>
                        <th class="px-6 py-4 text-right w-48">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                    @foreach (var risk in Model)
                    {
                        var status = risk.Status ?? "Draft";
                        var statusDisplay = status == "Rejected" ? "Rejected" : status == "For_Review" || status == "Submitted" || status == "Reviewed" ? "For review" : status == "Approved" ? "Monitoring" : status == "Closed_Invalid" ? "Closed_Invalid" : status;
                        var actionStatus = status == "Submitted" || status == "Reviewed" ? "For_Review" : status;
                        var dateReported = risk.DateReported ?? risk.DateLogged;
                        var reportedBy = risk.ReportedBy ?? risk.DetectedBy ?? "";
                        var isDeleted = risk.DeletedAt.HasValue;
                        var priorityVal = risk.Priority ?? "Unassessed";
                        var canSubmitDraft = !isDeleted && actionStatus == "Draft" && (!(bool)(ViewBag.IsEmployeeOnly ?? true) || risk.ReportByUserId == ViewBag.CurrentUserId);
                        var canEdit = !isDeleted && ((actionStatus == "Draft" && (risk.ReportByUserId == ViewBag.CurrentUserId || isAdmin)));
                        var canAssess = !isDeleted && actionStatus == "Submitted" && isRiskManager;
                        var canReject = !isDeleted && (actionStatus == "Submitted" || (actionStatus == "Draft" && isAdmin)) && isAdmin;
                        var riskJson = System.Text.Json.JsonSerializer.Serialize(new {
                            risk.Id,
                            Title = risk.Title ?? "",
                            risk.Category,
                            Priority = priorityVal,
                            Status = statusDisplay,
                            risk.SourceType,
                            ProjectSite = risk.ProjectSite ?? "",
                            DateReported = dateReported.ToString("yyyy-MM-dd"),
                            ReportedBy = reportedBy,
                            ReportByUserId = risk.ReportByUserId,
                            risk.OrgId,
                            DeletedAt = risk.DeletedAt,
                            Attachments = risk.Attachments ?? new List<string>()
                        });
                        <tr class="risk-row group hover:bg-slate-50/50 dark:hover:bg-emerald-500/5 transition-all @(isDeleted ? "opacity-60" : "")" data-risk="@Html.Raw(System.Net.WebUtility.HtmlEncode(riskJson))" data-status="@statusDisplay" data-priority="@priorityVal" data-deleted="@(isDeleted ? "1" : "0")">
                            <td class="px-6 py-5">
                                <div class="font-medium text-slate-900 dark:text-white mb-0.5 max-w-[200px] truncate" title="@(risk.Title ?? "")">@(risk.Title ?? "")</div>
                                @if (risk.AttachmentsCount > 0) { <span class="text-[10px] text-slate-400">@risk.AttachmentsCount file(s)</span> }
                            </td>
                            <td class="px-6 py-5">
                                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-[10px] font-medium uppercase tracking-tighter">@(risk.Category ?? "")</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 max-w-[120px] truncate block" title="@(risk.ProjectSite ?? "")">@(risk.ProjectSite ?? "")</span>
                            </td>
                            <td class="px-6 py-5">
                                @{ var priorityCls = priorityVal == "Critical" ? "text-rose-500" : priorityVal == "High" ? "text-orange-500" : priorityVal == "Medium" ? "text-amber-500" : priorityVal == "Low" ? "text-emerald-500" : "text-slate-400"; }
                                <span class="text-[10px] font-semibold @priorityCls uppercase">@priorityVal</span>
                            </td>
                            <td class="px-6 py-5">
                                @{
                                    var statusBadgeClass = statusDisplay == "For review" ? "bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400" :
                                        statusDisplay == "Rejected" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400" :
                                        statusDisplay == "Monitoring" ? "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400" :
                                        statusDisplay == "MitigationRequired" ? "bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400" :
                                        statusDisplay == "Closed_Invalid" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400" :
                                        statusDisplay == "Closed_Controlled" ? "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400" :
                                        "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400";
                                }
                                <span class="px-2.5 py-1 rounded-lg @statusBadgeClass text-[10px] font-bold uppercase tracking-tighter">@statusDisplay</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 uppercase">@dateReported.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="px-6 py-5">
                                <span class="text-[10px] font-medium text-slate-600 dark:text-slate-300">@(reportedBy != "" ? reportedBy : "—")</span>
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    @if (!isDeleted)
                                    {
                                        <button type="button" onclick="openViewModal(this)" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all" aria-label="View risk details">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </button>
                                        @if (actionStatus == "Draft" && (risk.ReportByUserId == ViewBag.CurrentUserId || isAdmin))
                                        {
                                            <form action="@Url.Action("HardDelete", "Risks", new { area = "Client" })" method="post" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@risk.Id" />
                                                <input type="hidden" name="orgId" value="@risk.OrgId" />
                                                <button type="submit" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all" aria-label="Delete permanently">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </form>
                                        }
                                        else if (actionStatus != "Draft")
                                        {
                                            <form action="@Url.Action("SoftDelete", "Risks", new { area = "Client" })" method="post" class="inline-block">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@risk.Id" />
                                                <button type="submit" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all" aria-label="Archive (soft delete)">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </form>
                                        }
                                    }
                                    else if (isAdmin)
                                    {
                                        <form action="@Url.Action("Restore", "Risks", new { area = "Client" })" method="post" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@risk.Id" />
                                            <button type="submit" class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all" aria-label="Restore risk"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <p class="text-[10px] font-medium text-slate-400 uppercase">Risks list</p>
        </div>
    </div>
</div>


<div id="newRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleNewRiskModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-xl scale-100 transform rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 dark:text-white uppercase">Identify New Risk</h2>
                <button type="button" onclick="toggleNewRiskModal()" class="text-slate-400 hover:text-rose-500" aria-label="Close"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></button>
            </div>
            <form action="@Url.Action("IdentifyNewRisk", "Risks", new { area = "Client" })" method="post" enctype="multipart/form-data" class="space-y-4" onsubmit="var btns=this.querySelectorAll('button[type=submit]');btns.forEach(function(b){b.disabled=true;});">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Date Reported</label>
                        <input type="date" name="ReportedDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Risk Category</label>
                        <select name="Category" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option>Operational</option>
                            <option>Financial</option>
                            <option>Safety</option>
                        </select>
                    </div>
                </div>
                <input type="text" name="Title" placeholder="Risk Description" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Source Type</label>
                        <select name="SourceType" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800">
                            <option value="Inspection">Inspection</option>
                            <option value="Incident">Incident</option>
                            <option value="Audit">Audit</option>
                            <option value="Observation">Observation</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Status</label>
                        <input type="text" readonly value="Draft" class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Reported By</label>
                    <input type="text" readonly value="Auto-filled" class="w-full rounded-xl border border-slate-200 bg-slate-100 dark:bg-slate-800 dark:border-slate-700 px-4 py-3 text-sm font-bold text-slate-500 dark:text-slate-400" />
                </div>
                <div class="space-y-2">
                    <div class="relative">
                        <input type="text" id="addProjectSite" name="ProjectSite" placeholder="Job Site Location" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 pr-12 text-sm font-bold dark:bg-slate-800 dark:border-slate-700" required />
                        <button type="button" onclick="autoDetectLocation('addProjectSite', 'addMap')" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-emerald-500 hover:scale-110 transition-transform" aria-label="Detect location"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg></button>
                    </div>
                    <div id="addMap" class="h-40 w-full rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden"></div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Attachments</label>
                    <input type="file" name="Attachments" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:bg-slate-800 dark:border-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-xs file:font-bold file:text-emerald-700 dark:file:bg-emerald-900/30 dark:file:text-emerald-300" />
                </div>
                @if (TempData["AttachmentError"] != null) { <p class="text-rose-600 dark:text-rose-400 text-xs">@TempData["AttachmentError"]</p> }
                <div class="flex gap-3 pt-2">
                    <button type="submit" name="submitType" value="Draft" class="flex-1 rounded-xl bg-slate-200 dark:bg-slate-700 py-3.5 text-xs font-black uppercase tracking-widest text-slate-700 dark:text-slate-300 shadow disabled:opacity-70">Save Draft</button>
