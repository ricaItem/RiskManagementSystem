@model Web_Sentro.Areas.Client.Models.RiskMonitoringViewModel
@{
    Layout = "_LayoutClient";
    var criticalCount = Model.HighPriorityRisks.Count(r => r.Priority == "Critical");
    var pendingCount = Model.HighPriorityRisks.Count(r => r.Priority != "Critical");
    var p = Model.SiteRiskPosture;
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-1000 relative">
    <!-- Map + Site modal: true modal (backdrop covers sidebar), 2-col layout -->
    <div id="monitoring-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <div id="monitoring-modal-backdrop" onclick="closeDrawer()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100]" aria-hidden="true"></div>
        <div class="relative z-[110] w-full max-w-7xl grid grid-cols-1 md:grid-cols-[1fr_320px] gap-4 items-stretch my-auto max-h-[90vh]">
            <div id="monitoring-modal-map-slot" class="min-h-[60vh] rounded-xl overflow-hidden border border-slate-200/70 bg-white dark:border-slate-800 dark:bg-slate-900/40 shadow-xl relative">
                <!-- Map is moved here by JS when modal opens -->
            </div>
            <div id="monitoring-site-panel" class="w-80 max-w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-y-auto flex flex-col">
                <div class="p-6 flex-1">
                    <div class="flex items-center justify-between mb-6">
                        <h2 id="drawer-title" class="text-lg font-black text-slate-900 dark:text-white">Site Details</h2>
                        <button type="button" id="monitoring-modal-close" onclick="closeDrawer()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 focus:outline-none focus-ring-2 focus-ring-indigo-500 rounded p-1" aria-label="Close">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <div id="drawer-loading" class="hidden animate-pulse space-y-4">
                        <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-3/4"></div>
                        <div class="h-32 bg-slate-200 dark:bg-slate-800 rounded"></div>
                        <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-1/2"></div>
                    </div>
                    <div id="drawer-content" class="space-y-6">
                        <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-4">
                            <h4 class="text-xs font-black uppercase text-slate-500 dark:text-slate-400 mb-3">Current Conditions</h4>
                            <div class="flex items-center gap-2 mb-2">
                                <span id="drawer-last-sync" class="text-[10px] text-slate-500 dark:text-slate-400">Last sync: --</span>
                                <span id="drawer-api-health" class="flex items-center gap-1 text-[10px] font-bold hidden"><span class="drawer-health-dot w-2 h-2 rounded-full"></span><span class="drawer-health-label">--</span></span>
                            </div>
                            <div class="flex items-end justify-between">
                                <div>
                                    <div id="drawer-temp" class="text-3xl font-black text-slate-900 dark:text-white">--°C</div>
                                    <div id="drawer-condition" class="text-sm font-medium text-slate-600 dark:text-slate-300">--</div>
                                </div>
                                <div class="text-right">
                                    <div id="drawer-wind" class="text-sm font-bold text-slate-700 dark:text-slate-300">-- km/h</div>
                                    <div class="text-[10px] text-slate-500 uppercase">Wind</div>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                                <h5 class="text-[10px] font-bold uppercase text-slate-400 mb-2">6h Trend (wind / rain vs threshold)</h5>
                                <svg id="drawer-trend-chart" viewBox="0 0 300 60" class="w-full h-16 stroke-2 fill-none" aria-hidden="true"></svg>
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Thresholds: Wind 40 km/h, Rain 10 mm</p>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between gap-3 mb-2">
                                <h4 class="text-xs font-black uppercase text-slate-500 dark:text-slate-400">Active Alerts</h4>
                                <label class="flex items-center gap-2 text-[10px] font-semibold text-slate-500 dark:text-slate-400">
                                    <input type="checkbox" id="drawer-show-resolved" class="h-3 w-3 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 dark:border-slate-600" />
                                    <span>Show resolved</span>
                                </label>
                            </div>
                            <div class="mb-3 inline-flex rounded-full bg-slate-100 p-1 text-[10px] font-black tracking-[0.16em] text-slate-500 dark:bg-slate-800/80 dark:text-slate-300">
                                <button type="button" data-alert-filter="today" class="drawer-filter-tab rounded-full px-3 py-1 bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white">Today</button>
                                <button type="button" data-alert-filter="7d" class="drawer-filter-tab rounded-full px-3 py-1 text-slate-500 hover:text-slate-900 hover:bg-white/60 dark:text-slate-300 dark:hover:bg-slate-900/60 dark:hover:text-white">7 days</button>
                                <button type="button" data-alert-filter="all" class="drawer-filter-tab rounded-full px-3 py-1 text-slate-500 hover:text-slate-900 hover:bg-white/60 dark:text-slate-300 dark:hover:bg-slate-900/60 dark:hover:text-white">All</button>
                            </div>
                            <div id="drawer-alerts-list" class="space-y-2"></div>
                        </div>
                        <div class="pt-4 flex flex-col gap-2">
                            <form id="drawer-sync-form" method="post" action="@Url.Action("MonitoringSync", "Risks", new { area = "Client" })">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="siteId" id="drawer-site-id" />
                                <button type="submit" class="w-full rounded-xl bg-slate-900 py-3 text-xs font-black uppercase tracking-widest text-white shadow-sm hover:bg-indigo-600 dark:bg-white dark:text-slate-900">Sync Now</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">

        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                Risk <span class="text-indigo-500 dark:text-indigo-400 italic">Monitoring Hub</span>
            </h1>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 flex items-center gap-3">
            @if (Model.LastSyncUtc.HasValue)
            {
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400">Last sync: @Model.LastSyncUtc.Value.ToLocalTime().ToString("g")</span>
            }
            <span class="flex items-center gap-1.5">
                <span class="flex h-3 w-3 @(Model.ApiHealthOk ? "bg-emerald-500" : "bg-amber-500") rounded-full @(Model.ApiHealthOk ? "" : "animate-pulse")"></span>
                <span class="text-[10px] font-black uppercase text-slate-500 dark:text-slate-400">@(Model.ApiHealthOk ? "API OK" : "API limited")</span>
            </span>
        </div>
        <div class="relative z-10 flex flex-wrap items-center gap-6">
            <div>
                <label class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 block mb-1">Site</label>
                <form method="get" action="@Url.Action("Monitoring", "Risks", new { area = "Client" })" id="site-form" class="inline">
                    <select name="siteId" id="monitoring-site-select" class="rounded-xl border border-slate-200/70 bg-white text-slate-800 text-sm font-bold px-4 py-2 focus:ring-2 focus:ring-indigo-500 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-200" onchange="this.form.submit()">
                        @foreach (var s in Model.Sites)
                        {       
                            <option value="@s.SiteId" selected="@(s.SiteId == Model.SelectedSiteId)">@s.Name@(s.SiteName != null ? $" ({s.SiteName})" : "")</option>
                        }
                    </select>
                </form>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@Model.ProjectName</p>
                <p class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">@Model.Temperature.ToString("F1")°C</p>
            </div>
            <div class="flex items-center gap-4 rounded-xl border border-slate-200/70 bg-slate-50/50 p-3 dark:border-slate-800 dark:bg-slate-800/50">
                <p class="text-[10px] font-black uppercase text-slate-600 dark:text-slate-400">@Model.WeatherCondition</p>
                <p class="text-xs font-bold text-slate-600 dark:text-slate-300">Wind: @Model.WindSpeed.ToString("F1") km/h</p>
            </div>
        </div>
        @if (Model.ForecastChips.Any())
        {
            <div class="mt-4 pt-4 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap gap-2">
                @foreach (var chip in Model.ForecastChips)
                {
                    <span class="rounded-lg border border-slate-200/70 bg-white/50 px-3 py-1.5 text-[10px] font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300">@chip.Label: @chip.Value</span>
                }
            </div>
        }
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <div id="monitoring-map-original-slot" class="lg:col-span-8 rounded-xl border border-slate-200/70 bg-white/70 overflow-hidden shadow-sm dark:border-slate-800 dark:bg-slate-900/40 h-[500px] relative">
            <div id="monitoring-map" class="w-full h-full" data-lat="@Model.Latitude" data-lon="@Model.Longitude" data-selected-site-id="@Model.SelectedSiteId" data-sites="@(System.Text.Json.JsonSerializer.Serialize(Model.Sites.Select(s => new { siteId = s.SiteId, latitude = s.Latitude, longitude = s.Longitude })))"></div>
            <div class="absolute top-4 left-4 flex flex-col gap-2">
                <div class="rounded-xl border border-slate-200/70 bg-white/80 px-3 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/60 flex flex-wrap gap-3 items-center" id="layer-toggles" role="group" aria-label="Map layers">
                    <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" id="layer-sites" checked class="rounded border-slate-300"> Sites</label>
                    <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" id="layer-geofence" checked class="rounded border-slate-300"> Geofence</label>
                    <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-slate-300"><input type="checkbox" id="layer-risks" class="rounded border-slate-300"> Risks</label>
                </div>
                <div class="rounded-xl border border-slate-200/70 bg-white/80 px-4 py-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/60">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Coordinates</p>
                    <p class="text-xs font-mono font-bold text-slate-700 dark:text-slate-300">@Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</p>
                </div>
            </div>
        </div>

        <div class="space-y-4 lg:col-span-4">
            <div class="rounded-xl border border-slate-200/70 bg-white/70 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <h3 class="mb-4 text-xs font-black tracking-widest text-slate-900 uppercase dark:text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-rose-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    System Alerts
                </h3>
                <div class="space-y-4">
                    @if (Model.SystemAlerts.Any())
                    {
                        @foreach (var a in Model.SystemAlerts)
                        {
                            var isCritical = a.Severity == "Critical";
                            var isHigh = a.Severity == "High";
                            var isResolved = a.Status == "Resolved";
                            var canAck = a.Status == "Active" && !a.AcknowledgedAtUtc.HasValue;
                            var severityPillClass = isCritical ? "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/50" : isHigh ? "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/50" : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/50";
                            <div class="rounded-xl border-l-4 p-4 @(isCritical ? "border-rose-500 bg-rose-500/10 dark:bg-rose-500/10" : "border-amber-500 bg-amber-500/10 dark:bg-amber-500/10") @(isResolved ? "opacity-80" : "")">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="text-xs font-black @(isCritical ? "text-rose-600 dark:text-rose-400" : "text-amber-600 dark:text-amber-400")">@a.RuleName</p>
                                    <span class="rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider @severityPillClass">@a.Severity</span>
                                </div>
                                <p class="text-[10px] font-bold text-slate-600 dark:text-slate-400 mt-1">@a.MeasuredValues</p>
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">@a.TriggeredAt.ToLocalTime().ToString("g") @(isResolved ? "· Resolved" : "")</p>
                                @if (a.AcknowledgedAtUtc.HasValue && a.AcknowledgedByDisplayName != null)
                                {
                                    <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Acknowledged by @a.AcknowledgedByDisplayName at @a.AcknowledgedAtUtc.Value.ToLocalTime().ToString("g")</p>
                                }
                                <div class="mt-3 flex flex-wrap gap-2">
                                    @if (canAck)
                                    {
                                        <form method="post" action="@Url.Action("AcknowledgeAlert", "Risks", new { area = "Client" })" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="alertId" value="@a.AlertId" />
                                            <input type="hidden" name="siteId" value="@Model.SelectedSiteId" />
                                            <button type="submit" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Acknowledge</button>
                                        </form>
                                        <form method="post" action="@Url.Action("ResolveAlert", "Risks", new { area = "Client" })" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="alertId" value="@a.AlertId" />
                                            <input type="hidden" name="siteId" value="@Model.SelectedSiteId" />
                                            <button type="submit" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700">Resolve</button>
                                        </form>
                                    }
                                    <form method="post" action="@Url.Action("CreateMitigationPlanFromAlert", "Risks", new { area = "Client" })" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="alertId" value="@a.AlertId" />
                                        <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white shadow-sm hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200">Create Plan</button>
                                    </form>
                                    @if (a.RiskId.HasValue)
                                    {
                                        <a href="@Url.Action("Assess", "Risks", new { area = "Client", id = a.RiskId })" class="inline-block rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-indigo-600 shadow-sm hover:bg-indigo-50 dark:border-slate-600 dark:bg-slate-800 dark:text-indigo-400 dark:hover:bg-slate-700">Open Risk</a>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400">No alerts. Run sync to evaluate rules.</p>
                    }
                </div>
            </div>

            @if (Model.SelectedSiteId != 0)
            {
                <form method="post" action="@Url.Action("MonitoringSync", "Risks", new { area = "Client" })" id="monitoring-sync-form" class="block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="siteId" value="@Model.SelectedSiteId" />
                    <button type="submit" class="w-full rounded-xl border border-slate-200/70 bg-slate-900 py-3.5 text-xs font-black uppercase tracking-widest text-white shadow-sm transition hover:bg-indigo-600 dark:border-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200 flex items-center justify-center gap-3 group">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-emerald-500 transition-transform group-hover:rotate-180">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                        Sync API for this site
                    </button>
                </form>
                <div class="flex items-center gap-2 mt-3" id="auto-sync-control">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Auto sync (every 10 min)</span>
                    <button type="button" id="auto-sync-off" class="rounded-xl border-2 border-slate-300 bg-slate-200 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 transition dark:border-slate-500 dark:bg-slate-600 dark:text-slate-300">OFF</button>
                    <button type="button" id="auto-sync-on" class="rounded-xl border-2 border-transparent bg-slate-100 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:border-indigo-500/50 dark:bg-slate-700 dark:text-slate-400">ON</button>
                </div>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1 hidden" id="auto-sync-status">Next sync in <span id="auto-sync-countdown">10:00</span></p>
                @if (ViewData["EnableSimulation"] as bool? == true)
                {
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 mt-3 mb-2">DEV: Simulate</p>
                    <div class="flex gap-2">
                        <form method="post" action="@Url.Action("MonitoringSync", "Risks", new { area = "Client", siteId = Model.SelectedSiteId, simulate = "wind" })" class="flex-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full rounded-xl bg-amber-600 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-amber-700">Simulate High Wind</button>
                        </form>
                        <form method="post" action="@Url.Action("MonitoringSync", "Risks", new { area = "Client", siteId = Model.SelectedSiteId, simulate = "storm" })" class="flex-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full rounded-xl bg-rose-600 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-rose-700">Simulate Thunderstorm</button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 overflow-hidden shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
        <div class="p-5 border-b border-slate-200/70 dark:border-slate-800 flex justify-between items-center">
            <div>
                <h2 class="text-xs font-black tracking-widest text-slate-900 uppercase dark:text-white">Active Risk Feed</h2>
                <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400">Real-time status · AUTO = from weather rules</p>
            </div>
            <div class="flex gap-2">
                <span class="rounded-lg bg-rose-500/10 px-3 py-1 text-[10px] font-black text-rose-600 dark:text-rose-400">@criticalCount CRITICAL</span>
                <span class="rounded-lg bg-amber-500/10 px-3 py-1 text-[10px] font-black text-amber-600 dark:text-amber-400">@pendingCount PENDING</span>
            </div>
        </div>
        <div class="divide-y divide-slate-200/70 dark:divide-slate-800">
            @foreach (var risk in Model.HighPriorityRisks)
            {
                <div class="p-6 flex items-center justify-between group hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-all">
                    <div class="flex items-center gap-4">
                        <div class="relative">
                            <div class="h-12 w-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xl">
                                @(risk.Category?.Contains("Weather") == true ? "⛈️" : risk.Category == "Operational" ? "🏗️" : "📉")
                            </div>
                            @if (risk.Priority == "Critical")
                            {
                                <span class="absolute -top-1 -right-1 flex h-3 w-3">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
                                </span>
                            }
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white">@risk.Title</h4>
                                <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-200/70 text-slate-600 font-medium uppercase dark:bg-slate-700 dark:text-slate-300">@risk.Category</span>
                                @if (risk.SourceType == "WeatherAPI")
                                {
                                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-black">AUTO</span>
                                }
                                else
                                {
                                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-300/70 text-slate-600 font-medium dark:bg-slate-600 dark:text-slate-300">MANUAL</span>
                                }
                            </div>
                            <div class="flex items-center gap-3 mt-1 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                                <span class="flex items-center gap-1">📍 @(risk.SiteName ?? risk.ProjectSite ?? "—")</span>
                                <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                <span>Detected by: <span class="text-indigo-500 dark:text-indigo-400 font-bold">@risk.DetectedBy</span></span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-6">
                        <div class="text-right hidden md:block">
                            <p class="text-[10px] font-black uppercase text-slate-500 dark:text-slate-400">Last Update</p>
                            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">@(risk.DateLogged != default ? risk.DateLogged.ToLocalTime().ToString("g") : "—")</p>
                        </div>
                        <div class="flex gap-2">
                            <a href="@Url.Action("Assess", "Risks", new { area = "Client", id = risk.Id })" class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-600 dark:bg-white dark:text-slate-900 dark:hover:bg-indigo-200" title="Open Risk">Open Risk</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="p-4 bg-slate-50/50 dark:bg-slate-800/30 text-center">
            <a href="@Url.Action("Identification", "Risks", new { area = "Client" })" class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all">
                View Full Risk Archive ↓
            </a>
        </div>
    </div>
</div>

<style>
    .monitoring-marker-pulse { animation: monitoring-pulse 1.5s ease-out; }
    @@keyframes monitoring-pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.4); opacity: 0.9; }
        100% { transform: scale(1); opacity: 1; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .monitoring-marker-pulse { animation: none; }
    }

    /* Leaflet monitoring site markers: bouncing pin + radio-wave pulse */
    .monitoring-site-icon {
        pointer-events: auto;
    }
    .site-marker {
        position: relative;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transform-origin: center bottom;
    }
    .site-marker .pin {
        position: relative;
        z-index: 10;
        width: 14px;
        height: 14px;
        border-radius: 9999px;
        background: #10b981;
        border: 2px solid #ffffff;
        box-shadow: 0 6px 10px rgba(15, 23, 42, 0.45);
    }
    .site-marker .pulse {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 18px;
        height: 18px;
        border-radius: 9999px;
        border: 2px solid currentColor;
        transform: translate(-50%, -50%) scale(0.6);
        opacity: 0;
        pointer-events: none;
        z-index: 1;
    }
    .site-marker .pulse::before,
    .site-marker .pulse::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: inherit;
        transform: scale(0.6);
        opacity: 0;
        pointer-events: none;
    }

    /* Severity colors */
    .site-marker.severity-critical {
        color: #ef4444;
    }
    .site-marker.severity-critical .pin {
        background: #ef4444;
        box-shadow: 0 8px 18px rgba(248, 113, 113, 0.65);
    }
    .site-marker.severity-high {
        color: #f59e0b;
    }
    .site-marker.severity-high .pin {
        background: #f59e0b;
        box-shadow: 0 7px 14px rgba(245, 158, 11, 0.55);
    }
    .site-marker.severity-medium {
        color: #22c55e;
    }
    .site-marker.severity-medium .pin {
        background: #22c55e;
    }
    .site-marker.severity-normal {
        color: #10b981;
    }

    /* Bounce animation */
    @@keyframes site-marker-bounce-soft {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
    @@keyframes site-marker-bounce-strong {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* Pulse / radio-wave animation */
    @@keyframes site-marker-pulse {
        0% {
            transform: translate(-50%, -50%) scale(0.6);
            opacity: 0.55;
        }
        70% {
            opacity: 0.08;
        }
        100% {
            transform: translate(-50%, -50%) scale(2.4);
            opacity: 0;
        }
    }

    /* Apply animations by severity + has-alerts */
    .site-marker.has-alerts.severity-normal .pin {
        animation: site-marker-bounce-soft 1.8s ease-in-out infinite;
    }
    .site-marker.has-alerts.severity-medium .pin {
        animation: site-marker-bounce-soft 1.6s ease-in-out infinite;
    }
    .site-marker.has-alerts.severity-high .pin {
        animation: site-marker-bounce-strong 1.4s ease-in-out infinite;
    }
    .site-marker.has-alerts.severity-critical .pin {
        animation: site-marker-bounce-strong 1.1s ease-in-out infinite;
    }

    .site-marker.has-alerts.severity-medium .pulse,
    .site-marker.has-alerts.severity-high .pulse {
        animation: site-marker-pulse 2s ease-out infinite;
    }
    .site-marker.has-alerts.severity-medium .pulse::before,
    .site-marker.has-alerts.severity-high .pulse::before {
        animation: site-marker-pulse 2.4s ease-out infinite;
        animation-delay: 0.4s;
    }
    .site-marker.has-alerts.severity-medium .pulse::after {
        display: none;
    }

    .site-marker.has-alerts.severity-critical .pulse {
        animation: site-marker-pulse 1.6s ease-out infinite;
    }
    .site-marker.has-alerts.severity-critical .pulse::before {
        animation: site-marker-pulse 1.8s ease-out infinite;
        animation-delay: 0.35s;
    }
    .site-marker.has-alerts.severity-critical .pulse::after {
        animation: site-marker-pulse 2s ease-out infinite;
        animation-delay: 0.7s;
    }

    @@media (prefers-reduced-motion: reduce) {
        .site-marker.has-alerts .pin,
        .site-marker.has-alerts .pulse,
        .site-marker.has-alerts .pulse::before,
        .site-marker.has-alerts .pulse::after {
            animation: none !important;
        }
        .site-marker.severity-critical .pulse,
        .site-marker.severity-critical .pulse::before,
        .site-marker.severity-critical .pulse::after {
            opacity: 0.35;
            transform: translate(-50%, -50%) scale(1.2);
        }
    }
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="~/js/monitoring.js" asp-append-version="true"></script>
