@{
    Layout = "_LayoutClient";
}

<div id="monitoring-skeleton" class="animate-pulse min-h-screen space-y-8 p-6">
    <div class="space-y-2">
        <div class="h-8 w-64 rounded bg-slate-200 dark:bg-slate-700"></div>
        <div class="h-4 w-80 rounded bg-slate-100 dark:bg-slate-800"></div>
    </div>

    <div class="proj-card p-6">
        <div class="flex flex-wrap items-center gap-6">
            <div class="h-10 w-56 rounded-lg bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-10 w-px bg-slate-200 dark:bg-slate-700"></div>
            <div class="space-y-2">
                <div class="h-3 w-20 rounded bg-slate-100 dark:bg-slate-800"></div>
                <div class="h-7 w-24 rounded bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="h-12 w-64 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8 h-[420px] proj-card"></div>
        <div class="space-y-6 lg:col-span-4">
            <div class="h-72 proj-card p-5"></div>
            <div class="h-32 proj-card p-5"></div>
        </div>
    </div>

    <div class="proj-card">
        <div class="h-14 border-b border-slate-100 bg-slate-50/40 dark:border-slate-800 dark:bg-slate-800/20"></div>
        <div class="space-y-3 p-5">
            @for (var i = 0; i < 4; i++)
            {
                <div class="h-16 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
            }
        </div>
    </div>
</div>

<div id="monitoring-content" class="hidden"></div>

<script>
    function initMonitoringPage() {
        const contentDiv = document.getElementById('monitoring-content');
        if (!contentDiv || contentDiv.dataset.loaded === '1') return;

        const searchParams = new URLSearchParams(window.location.search);
        const url = '@Url.Action("MonitoringContent", "Risks", new { area = "Client" })' + '?' + searchParams.toString();

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error(`MonitoringContent request failed: ${response.status}`);
                return response.text();
            })
            .then(html => {
                contentDiv.innerHTML = html;

                // IMPORTANT: Reveal the container BEFORE scripts execute. 
                // Leaflet requires the map container to be visible (not display: none) to calculate its correct size and load tiles.
                const skeleton = document.getElementById('monitoring-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.dataset.loaded = '1';

                const scripts = Array.from(contentDiv.getElementsByTagName('script'));
                
                function loadScriptSequential(index) {
                    if (index >= scripts.length) {
                        // Trigger a resize event to ensure Leaflet catches the dimensions perfectly
                        setTimeout(() => window.dispatchEvent(new Event('resize')), 100);
                        return;
                    }

                    const oldScript = scripts[index];
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                        newScript.onload = () => loadScriptSequential(index + 1);
                        newScript.onerror = () => {
                            console.error('Failed to load script:', oldScript.src);
                            loadScriptSequential(index + 1);
                        };
                        document.body.appendChild(newScript);
                    } else {
                        newScript.text = oldScript.innerHTML;
                        document.body.appendChild(newScript);
                        loadScriptSequential(index + 1);
                    }
                }

                loadScriptSequential(0);
            })
            .catch(error => {
                console.error('Error loading monitoring content:', error);
                const skeleton = document.getElementById('monitoring-skeleton');
                if (skeleton) skeleton.classList.add('hidden');
                contentDiv.classList.remove('hidden');
                contentDiv.innerHTML = '<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-300">Failed to load Risk Monitoring. Please refresh the page.</div>';
                contentDiv.dataset.loaded = '1';
            });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMonitoringPage);
    } else {
        initMonitoringPage();
    }
</script>
