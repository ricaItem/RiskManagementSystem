@model Web_Sentro.Areas.Client.Models.RiskMonitoringViewModel
@{
    Layout = "_LayoutClient";
}

<div class="animate-in fade-in mx-auto max-w-full space-y-6 duration-700">

    @if (TempData["MonitoringMessage"] is string msg && !string.IsNullOrEmpty(msg))
    {
        <div class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-medium text-indigo-800 dark:border-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-200">
            @msg
        </div>
    }

    <div class="relative flex flex-col justify-between gap-4 overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:flex-row md:items-center dark:border-slate-800 dark:bg-slate-900">
        <div class="absolute top-0 right-0 p-4">
            <span class="flex h-3 w-3">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-500"></span>
            </span>
        </div>
        <div class="relative z-10">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Monitoring <span class="text-indigo-600 dark:text-indigo-400">Hub</span></h1>
            <p class="font-semibold tracking-wider text-[11px] text-slate-500 uppercase">Real-Time Site Intelligence & API Integration</p>
        </div>

        <div class="relative z-10 flex items-center gap-6 rounded-xl border border-slate-100 bg-slate-50 p-3 px-5 dark:border-slate-700/50 dark:bg-slate-800/50">
            <div class="text-right">
                <p class="font-bold text-[10px] text-slate-400 uppercase">@Model.ProjectName</p>
                <p class="text-xl font-bold text-slate-900 dark:text-white">@Model.Temperature°C</p>
            </div>
            <div class="h-8 w-px bg-slate-200 dark:bg-slate-700"></div>
            <div>
                <p class="font-bold text-[10px] text-rose-600 uppercase dark:text-rose-400">@Model.WeatherCondition</p>
                <p class="text-xs font-medium text-slate-600 dark:text-slate-400">Wind: @Model.WindSpeed km/h</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <div class="group relative h-[500px] overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm lg:col-span-2 dark:border-slate-800 dark:bg-slate-950">
            <div class="absolute inset-0 transition-all duration-700 group-hover:scale-105">
                <img src="https://api.mapbox.com/styles/v1/mapbox/@(Context.Request.Cookies["theme"] == "dark" ? "dark-v10" : "light-v10")/static/@Model.Longitude,@Model.Latitude,15,0/1200x800?access_token=@ViewBag.MapboxToken"
                     class="h-full w-full object-cover" alt="Risk Map">
            </div>

            <div class="absolute top-4 left-4">
                <div class="rounded-lg border border-white/20 bg-white/80 px-3 py-2 shadow-lg backdrop-blur-md dark:bg-slate-900/80">
                    <p class="font-bold text-[10px] text-slate-500 uppercase">Live Coordinates</p>
                    <p class="font-mono text-xs font-semibold text-slate-900 dark:text-slate-200">@Model.Latitude, @Model.Longitude</p>
                </div>
            </div>

            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                <div class="flex flex-col items-center">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute h-16 w-16 animate-ping rounded-full bg-rose-500/30"></div>
                        <div class="z-10 h-5 w-5 rounded-full border-2 border-white bg-rose-600 shadow-xl dark:border-slate-900"></div>
                    </div>
                    <div class="mt-3 rounded-full border border-white/10 bg-slate-900/90 px-3 py-1.5 font-bold tracking-wide text-white text-[10px] uppercase shadow-2xl backdrop-blur-sm">
                        Critical: Crane Zone
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-6">
            <div class="flex-1 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                <h3 class="mb-5 flex items-center gap-2 font-bold tracking-widest text-[11px] text-slate-400 uppercase">
                    <span class="h-2 w-2 rounded-full bg-rose-500"></span>
                    Priority System Alerts
                </h3>

                <div class="space-y-3">
                    <div class="rounded-xl border border-rose-100 bg-rose-50/50 p-4 dark:border-rose-500/20 dark:bg-rose-500/5">
                        <div class="mb-1 flex items-center gap-2">
                            <svg class="h-4 w-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                            <p class="text-xs font-bold text-rose-700 dark:text-rose-400">Weather Shutdown Advised</p>
                        </div>
                        <p class="leading-relaxed font-medium text-[11px] text-slate-600 dark:text-slate-400">Wind speeds exceed 40km/h. Suspend crane operations.</p>
                    </div>

                    <div class="rounded-xl border border-amber-100 bg-amber-50/50 p-4 dark:border-amber-500/20 dark:bg-amber-500/5">
                        <div class="mb-1 flex items-center gap-2">
                            <svg class="h-4 w-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <p class="text-xs font-bold text-amber-700 dark:text-amber-400">Logistics Delay</p>
                        </div>
                        <p class="leading-relaxed font-medium text-[11px] text-slate-600 dark:text-slate-400">Steel Girder delivery is 4 hours behind schedule.</p>
                    </div>
                </div>
            </div>

            <form asp-action="MonitoringSync" asp-controller="Risks" asp-area="Client" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="group flex w-full items-center justify-center gap-3 rounded-xl bg-indigo-600 py-4 text-xs font-bold tracking-widest text-white uppercase shadow-lg shadow-indigo-500/20 transition-all hover:bg-indigo-700 active:scale-[0.98]">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 transition-transform group-hover:rotate-180">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Sync Monitoring Data
                </button>
            </form>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 p-6 dark:border-slate-800 dark:bg-slate-800/20">
            <div>
                <h2 class="text-sm font-bold tracking-widest text-slate-900 uppercase dark:text-white">Active Risk Feed</h2>
                <p class="font-medium text-[11px] text-slate-500">Real-time status of identified threats</p>
            </div>
            <div class="flex gap-2">
                <span class="rounded-full bg-rose-100 px-3 py-1 font-bold text-rose-700 text-[10px] dark:bg-rose-500/10 dark:text-rose-400">3 CRITICAL</span>
                <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600 text-[10px] dark:bg-slate-800 dark:text-slate-400">5 PENDING</span>
            </div>
        </div>

        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            @foreach (var risk in Model.HighPriorityRisks)
            {
                <div class="group flex items-center justify-between p-5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/40">
                    <div class="flex items-center gap-4">
                        <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200/50 bg-slate-100 text-lg shadow-sm dark:border-slate-700/50 dark:bg-slate-800">
                            @(risk.Category == "Operational" ? "🏗️" : "📉")
                        </div>

                        <div>
                            <div class="flex items-center gap-2">
                                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">@risk.Title</h4>
                                <span class="rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 font-bold text-[9px] text-slate-500 uppercase dark:border-slate-700 dark:bg-slate-800">@risk.Category</span>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-[11px] text-slate-500">
                                <span class="flex items-center gap-1 font-medium"><svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg> @risk.ProjectSite</span>
                                <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-700"></span>
                                <span class="font-medium">Detected: <span class="font-semibold text-indigo-600 dark:text-indigo-400">@risk.DetectedBy</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-6">
                        <div class="hidden text-right md:block">
                            <p class="font-bold text-[10px] text-slate-400 uppercase">Last Update</p>
                            <p class="text-xs font-semibold text-slate-700 dark:text-slate-300">2 mins ago</p>
                        </div>

                        <div class="flex gap-2">
                            <button class="rounded-lg border border-slate-200 p-2.5 text-slate-500 shadow-sm transition-all hover:bg-white dark:border-slate-700 dark:hover:bg-slate-800" title="View Logs">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                            </button>
                            <button class="rounded-lg bg-slate-900 p-2.5 text-white shadow-md transition-all hover:opacity-90 dark:bg-indigo-600" title="Quick Resolve">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t border-slate-100 bg-slate-50/50 p-3 text-center dark:border-slate-800 dark:bg-slate-800/20">
            <button class="w-full py-2 font-bold tracking-widest text-[10px] text-slate-400 uppercase transition-all hover:text-indigo-600">
                View Full Risk Archive ↓
            </button>
        </div>
    </div>
</div>