@model Web_Sentro.Areas.Client.Models.RiskAssessmentViewModel
@{
    Layout = "_LayoutClient";
    var category = ViewBag.Category as string ?? "—";
    var reportedBy = ViewBag.ReportedBy as string ?? "—";
}

<div class="animate-in fade-in mx-auto max-w-6xl space-y-8 duration-500">

    <div class="flex items-center justify-between">
        <div class="space-y-1">
            <a href="@Url.Action("Identification", "Risks")" class="flex items-center gap-2 text-xs font-bold tracking-widest text-slate-500 uppercase transition-colors hover:text-indigo-600">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="3" /></svg>
                Back to List
            </a>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                Assess <span class="text-emerald-500 italic">@Model.RiskTitle</span>
            </h1>
        </div>
        <div class="hidden text-right md:block">
            <span class="font-black tracking-tighter text-[10px] text-slate-400 uppercase">Category</span>
            <p class="font-bold text-slate-700 dark:text-slate-300">@category</p>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/50 md:p-10 lg:col-span-8 dark:border-slate-800 dark:bg-slate-900 dark:shadow-none">

            <div class="mb-10 flex items-center justify-between">
                <h3 class="text-sm font-black tracking-widest text-slate-400 uppercase">Probability vs Impact</h3>
                <div class="flex gap-3">
                    <span class="rounded-full bg-rose-100 px-3 py-1 font-black text-rose-600 text-[10px] uppercase dark:bg-rose-900/30 dark:text-rose-400">Critical Zone</span>
                </div>
            </div>

            <div class="relative grid grid-cols-[auto_1fr] gap-4">
                <div class="flex rotate-180 flex-col justify-between py-10 font-black tracking-[0.4em] text-[10px] text-slate-400 uppercase [writing-mode:vertical-lr]">
                    High Impact — Low Impact
                </div>

                <div>
                    <div class="grid grid-cols-5 gap-3">
                        @for (int i = 5; i >= 1; i--)
                        {
                            @for (int l = 1; l <= 5; l++)
                            {
                                var score = i * l;
                                var colorClass = score >= 20 ? "bg-rose-500 text-white" :
                                score >= 15 ? "bg-orange-500 text-white" :
                                score >= 7 ? "bg-amber-400 text-slate-900" :
                                "bg-emerald-500 text-white";

                                <button type="button"
                                        onclick="updateScore(@l, @i, @score, this)"
                                        class="@colorClass group relative flex h-16 items-center justify-center overflow-hidden rounded-2xl transition-all hover:scale-[1.03] active:scale-95 md:h-24">
                                    <span class="text-xl font-black">@score</span>
                                    <span class="absolute bottom-1 font-bold text-[8px] uppercase opacity-0 group-hover:opacity-100">I:@i L:@l</span>
                                </button>
                            }
                        }
                    </div>

                    <div class="mt-6 flex justify-between px-2 font-black tracking-[0.4em] text-[10px] text-slate-400 uppercase">
                        <span>Low Likelihood</span>
                        <span>High Likelihood</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6 lg:col-span-4">

            <div class="rounded-[2rem] bg-slate-900 p-8 text-white shadow-2xl dark:bg-indigo-950">
                <p class="mb-2 font-black tracking-[0.2em] text-[10px] text-indigo-300/60 uppercase">Calculated Risk Index</p>
                <div class="flex items-baseline gap-3">
                    <span id="displayScore" class="text-7xl font-black italic">1</span>
                    <span id="displayLevel" class="text-lg font-black text-emerald-400 uppercase">Low</span>
                </div>

                <div class="mt-8 flex justify-between border-t border-white/10 pt-6 text-center">
                    <div>
                        <p class="font-black text-[10px] text-slate-400 uppercase">Likelihood</p>
                        <p id="valL" class="text-xl font-black">1</p>
                    </div>
                    <div class="text-xl font-light text-slate-500">×</div>
                    <div>
                        <p class="font-black text-[10px] text-slate-400 uppercase">Impact</p>
                        <p id="valI" class="text-xl font-black">1</p>
                    </div>
                </div>
            </div>

            <form action="@Url.Action("SaveAssessment", "Risks")" method="post" class="space-y-6 rounded-[2rem] border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RiskId" value="@Model.RiskId" />
                <input type="hidden" name="Likelihood" id="hiddenL" value="1" />
                <input type="hidden" name="Impact" id="hiddenI" value="1" />

                <div class="space-y-2">
                    <label class="ml-1 font-black tracking-widest text-[10px] text-slate-400 uppercase">Response Strategy</label>
                    <select name="Strategy" class="w-full rounded-2xl border-none bg-slate-50 px-5 py-4 text-xs font-bold transition-all focus:ring-2 focus:ring-indigo-500 dark:bg-slate-800">
                        <option>Avoid (Eliminate)</option>
                        <option selected>Mitigate (Reduce)</option>
                        <option>Transfer (Share)</option>
                        <option>Accept (Monitor)</option>
                    </select>
                </div>

                <button type="submit" class="w-full transform rounded-2xl bg-indigo-600 py-5 text-xs font-black tracking-widest text-white uppercase shadow-xl shadow-indigo-500/20 transition-all hover:-translate-y-1 hover:bg-indigo-700">
                    Finalize Assessment
                </button>
            </form>

        </div>
    </div>
</div>

<script>
    function updateScore(l, i, score, element) {
        // Visual Feedback: Remove focus from others and highlight selected
        document.querySelectorAll('button[type="button"]').forEach(btn => btn.style.border = "none");
        element.style.border = "4px solid white";
        element.style.boxShadow = "0 0 20px rgba(0,0,0,0.1)";

        // Update Hidden Fields
        document.getElementById('hiddenL').value = l;
        document.getElementById('hiddenI').value = i;

        // Update Display
        document.getElementById('displayScore').innerText = score;
        document.getElementById('valL').innerText = l;
        document.getElementById('valI').innerText = i;

        // Determine Level
        let level = { text: 'Low', cls: 'text-emerald-400' };
        if (score >= 20) level = { text: 'Critical', cls: 'text-rose-500' };
        else if (score >= 15) level = { text: 'High', cls: 'text-orange-400' };
        else if (score >= 7) level = { text: 'Medium', cls: 'text-amber-300' };

        const displayLevel = document.getElementById('displayLevel');
        displayLevel.innerText = level.text;
        displayLevel.className = `text-lg font-black uppercase ${level.cls}`;
    }
</script>