                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1.5">Project</label>
                                        <select id="viewEditProjectId" name="ProjectId" class="block w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-bold focus:border-indigo-500 focus:bg-white focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                                            @foreach (var item in projectsForRiskForm)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1.5">Site</label>
                                        <select id="viewEditSiteId" name="SiteId" class="block w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-bold focus:border-indigo-500 focus:bg-white focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                                            @foreach (var item in sitesForRiskForm)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1.5">Source Type</label>
                                        <select id="viewEditSourceType" name="SourceType" class="block w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-bold focus:border-indigo-500 focus:bg-white focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                                            <option value="Inspection">Inspection</option>
                                            <option value="Incident">Incident</option>
                                            <option value="Audit">Audit</option>
                                            <option value="Observation">Observation</option>
                                        </select>
                                    </div>
                                    <div>
                                         <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1.5">Date Reported</label>
                                         <input type="date" id="viewEditDate" name="ReportedDate" class="block w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-bold focus:border-indigo-500 focus:bg-white focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                                    </div>
                                </div>
                            </div>
                            <div class="mt-8 flex justify-end gap-3 pt-6 border-t border-slate-100 dark:border-slate-800">
                                <button type="button" onclick="cancelEditRisk()" class="rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-500 hover:text-slate-800 transition-colors">Cancel</button>
                                <button type="submit" class="rounded-xl bg-slate-900 px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg hover:bg-indigo-600 hover:shadow-indigo-500/30 transition-all">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Footer Actions -->
             <div class="flex shrink-0 items-center justify-between border-t border-slate-100 bg-slate-50/50 px-8 py-4 dark:border-slate-800 dark:bg-slate-800/50">
                <div class="flex gap-2">
                    @if (isRiskManager || isAdmin)
                    {
                        <div id="viewAdminActions" class="hidden flex gap-2">
                             <form id="viewApproveForm" action="@Url.Action("Approve", "Risks", new { area = "Client" })" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="approveRiskId" />
                                <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:bg-emerald-500 shadow-sm transition-colors">Approve</button>
                            </form>
                            <form id="viewRejectForm" action="@Url.Action("Reject", "Risks", new { area = "Client" })" method="post" onsubmit="return promptReject()">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="rejectRiskId" />
                                <input type="hidden" name="RejectRemarks" id="rejectRemarks" />
                                <button type="submit" class="rounded-xl border border-rose-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-rose-600 hover:bg-rose-50 shadow-sm transition-colors dark:border-rose-900 dark:bg-rose-900/10 dark:text-rose-400">Reject</button>
                            </form>
                        </div>
                         <div id="viewReviewActions" class="hidden">
                            <form id="viewReviewForm" action="@Url.Action("Review", "Risks", new { area = "Client" })" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="reviewRiskId" />
                                <button type="submit" class="rounded-xl bg-indigo-600 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white hover:bg-indigo-500 shadow-sm transition-colors">Mark Reviewed</button>
                            </form>
                        </div>
                    }
                </div>
                <div class="flex gap-3">
                     <button type="button" id="viewEditBtn" onclick="enableEditRisk()" class="hidden rounded-xl border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-colors dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">Edit</button>
                     <a id="viewAssessBtn" href="#" class="hidden rounded-xl bg-slate-900 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white shadow-lg hover:bg-indigo-600 transition-colors dark:bg-white dark:text-slate-900">Assess Risk</a>
                     <a id="viewMitigateBtn" href="#" class="hidden rounded-xl bg-slate-900 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white shadow-lg hover:bg-indigo-600 transition-colors dark:bg-white dark:text-slate-900">Mitigation Plan</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Toggle New Risk Modal
    function toggleNewRiskModal() {
        const modal = document.getElementById('newRiskModal');
        modal.classList.toggle('hidden');
    }

    // Toggle Action Menu in Table
    function toggleActionMenu(btn, id) {
        // Close all others
        document.querySelectorAll('.action-menu').forEach(m => {
            if(m.id !== 'actionMenu-' + id) m.classList.add('hidden');
        });
        const menu = document.getElementById('actionMenu-' + id);
        menu.classList.toggle('hidden');
    }

    // Close menus on click outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('button[onclick^="toggleActionMenu"]') && !e.target.closest('.action-menu')) {
            document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));
        }
    });
    
    // View Risk Modal Logic
    var currentViewRisk = null;
    
    function toggleViewModal() {
        const modal = document.getElementById('viewRiskModal');
        modal.classList.toggle('hidden');
        if(modal.classList.contains('hidden')) {
             cancelEditRisk(); // Reset state on close
        }
    }

    function openViewModal(btn) {
        // Find the tr parent to get data
        const tr = btn.closest('tr');
        if (!tr) return;
        const riskData = JSON.parse(tr.getAttribute('data-risk'));
        currentViewRisk = riskData;
        
        // Populate fields
        document.getElementById('viewTitle').textContent = riskData.Title;
        document.getElementById('viewCategory').textContent = riskData.Category;
        document.getElementById('viewPriority').textContent = riskData.Priority || 'Unassessed';
        document.getElementById('viewStatus').textContent = riskData.Status;
        document.getElementById('viewProjectName').textContent = riskData.ProjectName || 'Unassigned';
        document.getElementById('viewSiteName').textContent = riskData.SiteName;
        document.getElementById('viewSourceType').textContent = riskData.SourceType;

        // Attachments
        const attachContainer = document.getElementById('viewAttachmentsPreview');
        attachContainer.innerHTML = '';
        if (riskData.Attachments && riskData.Attachments.length > 0) {
            riskData.Attachments.forEach(url => {
                const img = document.createElement('img');
                img.src = url;
                img.className = "h-20 w-20 rounded-lg object-cover border border-slate-200 dark:border-slate-700 cursor-pointer hover:opacity-80 transition-opacity";
                img.onclick = () => window.open(url, '_blank');
                attachContainer.appendChild(img);
            });
        } else {
            attachContainer.innerHTML = '<span class="text-xs text-slate-400 italic">No attachments</span>';
        }

        // Setup Actions based on Status & Role
        const assessBtn = document.getElementById('viewAssessBtn');
        const mitigateBtn = document.getElementById('viewMitigateBtn');
        const editBtn = document.getElementById('viewEditBtn');
        const adminActions = document.getElementById('viewAdminActions');
        const reviewActions = document.getElementById('viewReviewActions');
        
        // Reset visibility
        assessBtn.classList.add('hidden');
        mitigateBtn.classList.add('hidden');
        editBtn.classList.add('hidden');
        adminActions.classList.add('hidden');
        reviewActions.classList.add('hidden');

        // Logic
        const status = riskData.RawStatus;
        const currentUserId = '@ViewBag.CurrentUserId';
        const isAdmin = @(isAdmin.ToString().ToLower());
        const isManager = @(isRiskManager.ToString().ToLower());

        // Assessment Link
        assessBtn.href = '@Url.Action("Assess", "Risks", new { area = "Client" })/' + riskData.Id;
        assessBtn.classList.remove('hidden'); // Always allow assessment if viewed? Or restrict? Assuming mostly visible for flow.

        // Mitigation Link
        if (status === 'MitigationRequired' || status === 'Monitoring') {
             mitigateBtn.href = '@Url.Action("Board", "Mitigation", new { area = "Client" })?riskId=' + riskData.Id;
             mitigateBtn.classList.remove('hidden');
             // Keep assess button visible for re-assessment (residual risk)
        }

        // Edit
        if (status === 'Draft' && (riskData.ReportByUserId === currentUserId || isAdmin)) {
            editBtn.classList.remove('hidden');
        } else if (isAdmin) {
            editBtn.classList.remove('hidden'); // Admin can always edit?
        }

        // Approval / Review Flow
        if (status === 'For_Review' && (isManager || isAdmin)) {
             document.getElementById('reviewRiskId').value = riskData.Id;
             reviewActions.classList.remove('hidden');
        }
        if (status === 'Reviewed' && (isManager || isAdmin)) {
             document.getElementById('approveRiskId').value = riskData.Id;
             document.getElementById('rejectRiskId').value = riskData.Id;
             adminActions.classList.remove('hidden');
        }

        // Reset to Details Tab
        if(document.getElementById('viewTabDetails')) {
            document.getElementById('viewTabDetails').click();
        }

        toggleViewModal();
    }
    
    function enableEditRisk() {
        if(!currentViewRisk) return;
        document.getElementById('viewRiskContent').classList.add('hidden');
        document.getElementById('viewModalEditPanel').classList.remove('hidden');
        document.getElementById('viewEditBtn').classList.add('hidden');
        
        // Populate Edit Form
        document.getElementById('viewEditRiskId').value = currentViewRisk.Id;
        document.getElementById('viewEditTitle').value = currentViewRisk.Title;
        document.getElementById('viewEditCategory').value = currentViewRisk.Category;
        document.getElementById('viewEditProjectId').value = currentViewRisk.ProjectId || '';
        document.getElementById('viewEditSiteId').value = currentViewRisk.SiteId || '';
        document.getElementById('viewEditSourceType').value = currentViewRisk.SourceType;
        document.getElementById('viewEditProjectSite').value = currentViewRisk.ProjectSite;
        document.getElementById('viewEditDate').value = currentViewRisk.DateReported;
    }

    function cancelEditRisk() {
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalEditPanel').classList.add('hidden');
        
        // Re-show edit button if applicable
        // ideally re-run the openViewModal logic but simpler to just show if it was shown before
        // for now, strict reload of modal state isn't critical, just hiding the form
        if (document.getElementById('viewAdminActions').classList.contains('hidden') && 
            document.getElementById('viewReviewActions').classList.contains('hidden')) {
             document.getElementById('viewEditBtn').classList.remove('hidden');
        }
    }

    function promptReject() {
        const reason = prompt("Please provide a reason for rejection:");
        if (reason) {
            document.getElementById('rejectRemarks').value = reason;
            return true;
        }
        return false;
    }

    function confirmHardDelete(id, orgId) {
        if(confirm('Are you sure you want to permanently delete this draft? This cannot be undone.')) {
             // Create a form and submit
             var form = document.createElement('form');
             form.method = 'POST';
             form.action = '@Url.Action("HardDelete", "Risks", new { area = "Client" })';
             
             var token = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode(true);
             form.appendChild(token);
             
             var idInput = document.createElement('input');
             idInput.type = 'hidden';
             idInput.name = 'id';
             idInput.value = id;
             form.appendChild(idInput);
             
             var orgInput = document.createElement('input');
             orgInput.type = 'hidden';
             orgInput.name = 'orgId';
             orgInput.value = orgId;
             form.appendChild(orgInput);
             
             document.body.appendChild(form);
             form.submit();
        }
    }

    // Submit handler for new risk
    document.querySelectorAll('button[data-risk-submit]').forEach(btn => {
        btn.addEventListener('click', function() {
            var type = this.getAttribute('data-risk-submit');
            document.getElementById('riskSubmitType').value = type;
            document.getElementById('identifyRiskForm').submit();
        });
    });

    // Tab switching for View Modal
    document.querySelectorAll('.view-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            // Update Tab Styles
            document.querySelectorAll('.view-tab').forEach(t => {
                t.classList.remove('bg-white', 'text-indigo-600', 'shadow-sm', 'ring-1', 'ring-slate-200', 'dark:bg-slate-800', 'dark:text-indigo-400', 'dark:ring-slate-700');
                t.classList.add('text-slate-500', 'hover:bg-slate-100', 'dark:text-slate-400', 'dark:hover:bg-slate-800');
            });
            this.classList.add('bg-white', 'text-indigo-600', 'shadow-sm', 'ring-1', 'ring-slate-200', 'dark:bg-slate-800', 'dark:text-indigo-400', 'dark:ring-slate-700');
            this.classList.remove('text-slate-500', 'hover:bg-slate-100', 'dark:text-slate-400', 'dark:hover:bg-slate-800');
            
            // Toggle Content
            const target = this.getAttribute('data-tab');
            document.getElementById('tab-content-details').classList.add('hidden');
            document.getElementById('tab-content-versions').classList.add('hidden');
            document.getElementById('tab-content-controls').classList.add('hidden');
            
            const content = document.getElementById('tab-content-' + target);
            if(content) {
                content.classList.remove('hidden');
                
                // Load data if needed
                if (currentViewRisk && !content.getAttribute('data-loaded')) {
                    if (target === 'versions') loadRiskVersions(currentViewRisk.Id);
                    else if (target === 'controls') loadRiskControls(currentViewRisk.Id);
                }
            }
        });
    });

    function loadRiskVersions(riskId) {
        const container = document.getElementById('tab-content-versions');
        container.innerHTML = '<div class="flex justify-center p-8"><svg class="animate-spin h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>';
        
        fetch('@Url.Action("GetRiskVersions", "Risks", new { area = "Client" })?id=' + riskId)
            .then(response => response.json())
            .then(data => {
                if (!data || data.length === 0) {
                    container.innerHTML = '<div class="flex flex-col items-center justify-center py-12 text-center"><div class="rounded-full bg-slate-100 p-3 dark:bg-slate-800"><svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div><h3 class="mt-4 text-sm font-medium text-slate-900 dark:text-white">No History Available</h3><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">No version history found for this risk.</p></div>';
                } else {
                    let html = '<div class="relative pl-4 border-l border-slate-200 dark:border-slate-700 space-y-8 ml-2">';
                    data.forEach(v => {
                        const date = new Date(v.changedAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
                        html += `
                            <div class="relative">
                                <div class="absolute -left-[21px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-indigo-600 dark:border-slate-900 shadow-sm ring-1 ring-indigo-600 dark:ring-indigo-500"></div>
                                <div class="text-xs font-semibold text-slate-500 mb-1 dark:text-slate-400">${date}</div>
                                <div class="text-sm font-medium text-slate-900 dark:text-white">${v.changeSummary || 'Update'}</div>
                                <div class="text-xs text-slate-500 mt-0.5 dark:text-slate-500">by ${v.changedByDisplayName || 'System'}</div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                }
                container.setAttribute('data-loaded', 'true');
            })
            .catch(err => {
                container.innerHTML = '<div class="text-center py-8 text-rose-500 text-xs">Failed to load history. Please try again.</div>';
                console.error(err);
            });
    }

    function loadRiskControls(riskId) {
        const container = document.getElementById('tab-content-controls');
        container.innerHTML = '<div class="flex justify-center p-8"><svg class="animate-spin h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>';
        
        fetch('@Url.Action("GetRiskControls", "Risks", new { area = "Client" })?id=' + riskId)
            .then(response => response.json())
            .then(data => {
                if (!data || data.length === 0) {
                     container.innerHTML = '<div class="flex flex-col items-center justify-center py-12 text-center"><div class="rounded-full bg-slate-100 p-3 dark:bg-slate-800"><svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg></div><h3 class="mt-4 text-sm font-medium text-slate-900 dark:text-white">No Linked Controls</h3><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">There are no mitigation tasks currently linked to this risk.</p></div>';
                } else {
                    let html = '<div class="space-y-3">';
                    data.forEach(task => {
                        const statusColor = task.status === 'Done' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 
                                            task.status === 'InProgress' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400' :
                                            'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300';
                                            
                        const dueDate = task.dueDate ? new Date(task.dueDate).toLocaleDateString() : 'No due date';
                        html += `
                            <div class="flex items-start justify-between p-4 rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/60 hover:border-indigo-200 dark:hover:border-indigo-900 transition-colors">
                                <div class="flex gap-3">
                                    <div class="mt-0.5 h-2 w-2 rounded-full ${task.status === 'Done' ? 'bg-emerald-500' : 'bg-slate-300'}"></div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-900 dark:text-white" title="${task.title}">${task.title}</div>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-xs text-slate-500 dark:text-slate-400">Due: ${dueDate}</span>
                                            ${task.progressPercent > 0 ? `<span class="text-xs font-medium text-indigo-600 dark:text-indigo-400">${task.progressPercent}%</span>` : ''}
                                        </div>
                                    </div>
                                </div>
                                <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md ${statusColor}">
                                    ${task.status}
                                </span>
                            </div>
                        `;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                }
                container.setAttribute('data-loaded', 'true');
            })
            .catch(err => {
                container.innerHTML = '<div class="text-center py-8 text-rose-500 text-xs">Failed to load controls. Please try again.</div>';
                console.error(err);
            });
    }

    // Reset Tabs on Open
    const originalOpenViewModal = openViewModal;
    openViewModal = function(btn) {
        originalOpenViewModal(btn);
        
        // Reset fetch state
        if (document.getElementById('tab-content-versions')) document.getElementById('tab-content-versions').removeAttribute('data-loaded');
        if (document.getElementById('tab-content-controls')) document.getElementById('tab-content-controls').removeAttribute('data-loaded');
        
        // Reset to Details Tab
        if (document.getElementById('viewTabDetails')) {
            document.getElementById('viewTabDetails').click();
        }
    };
</script>