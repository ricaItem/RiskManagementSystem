@model Web_Sentro.Areas.Client.Models.PagedResult<Web_Sentro.Areas.Client.Models.RiskIdentificationViewModel>
@{
    var isAdmin = ViewBag.IsAdmin == true;
    var isRiskManager = ViewBag.IsRiskManager == true;
    var query = Context.Request.Query;
    var baseUrl = Url.Action("Identification", "Risks", new { area = "Client", search = query["search"], status = query["status"], category = query["category"], siteId = query["siteId"], showDeleted = query["showDeleted"] });
    var siteFilterList = ViewBag.SiteFilterList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var sitesForRiskForm = ViewBag.SitesForRiskForm as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-300">
    <!-- Success Toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successToast" class="fixed right-6 top-24 z-[100] flex w-full max-w-sm transform items-center gap-4 rounded-xl bg-emerald-50 p-4 shadow-xl transition-all duration-300 dark:bg-emerald-900/40">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div class="flex-1">
                <h4 class="text-sm font-black text-emerald-900 dark:text-emerald-100">Success</h4>
                <p class="text-xs font-medium text-emerald-700 dark:text-emerald-300">@TempData["SuccessMessage"]</p>
            </div>
            <button onclick="document.getElementById('successToast').remove()" class="text-emerald-500 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-200">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <script>setTimeout(() => { const t = document.getElementById('successToast'); if(t) { t.classList.add('opacity-0', 'translate-x-full'); setTimeout(() => t.remove(), 300); } }, 5000);</script>
    }
    <!-- Error Toast (consolidated) -->
    @if (TempData["RejectError"] != null || TempData["ReviewError"] != null || TempData["AssessmentError"] != null || TempData["AttachmentError"] != null)
    {
        var errMsg = TempData["RejectError"] ?? TempData["ReviewError"] ?? TempData["AssessmentError"] ?? TempData["AttachmentError"];
        <div id="errorToast" class="fixed right-6 top-24 z-[100] flex w-full max-w-sm transform items-center gap-4 rounded-xl bg-rose-50 p-4 shadow-xl transition-all duration-300 dark:bg-rose-900/40">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600 dark:bg-rose-500/20 dark:text-rose-400">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="flex-1">
                <h4 class="text-sm font-black text-rose-900 dark:text-rose-100">Action Failed</h4>
                <p class="text-xs font-medium text-rose-700 dark:text-rose-300">@errMsg</p>
            </div>
            <button onclick="document.getElementById('errorToast').remove()" class="text-rose-500 hover:text-rose-700 dark:text-rose-400 dark:hover:text-rose-200">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
        <script>setTimeout(() => { const t = document.getElementById('errorToast'); if(t) { t.classList.add('opacity-0', 'translate-x-full'); setTimeout(() => t.remove(), 300); } }, 5000);</script>
    }
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                Risk <span class="italic" style="color: var(--brand-accent);">Identification</span>
            </h1>
            </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("ExportExcel", "Risks", new { area = "Client" })" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 transition-all hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Export Excel</a>
            <button onclick="toggleNewRiskModal()"
                    class="btn-primary group relative flex items-center gap-3 rounded-xl px-6 py-3 shadow-card transition-all hover:-translate-y-0.5 hover:shadow-card-hover active:scale-95">
                + New Risk Entry
            </button>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        @{
            var kpis = new[] {
                new { Label = "Total Risks", Value = ViewBag.KpiTotalRisks, Color = "emerald", Desc = "Total count" },
                new { Label = "For Review", Value = ViewBag.KpiForReview, Color = "amber", Desc = "Review needed" },
                new { Label = "Critical", Value = ViewBag.KpiCritical, Color = "rose", Desc = "Immediate action" },
                new { Label = "Site Pins", Value = ViewBag.KpiSitePins, Color = "blue", Desc = "Geo-tagged" }
            };
        }
        @foreach (var stat in kpis)
        {
            <div class="kpi-card group rounded-xl sentro-card p-4 dark:border-slate-700 dark:bg-slate-800/90">
                <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">@stat.Label</p>
                <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">@stat.Value</h3>
                <p class="mt-2 w-fit rounded-md px-1.5 py-0.5 font-bold tracking-tighter text-[9px] uppercase @(stat.Color == "rose" ? "bg-rose-50 text-rose-500 dark:bg-rose-500/10" : stat.Color == "amber" ? "bg-amber-50 text-amber-600 dark:bg-amber-500/10" : stat.Color == "blue" ? "bg-sky-50 text-sky-600 dark:bg-sky-500/10" : "bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10")">@stat.Desc</p>
            </div>
        }
    </div>

    <form method="get" action="@Url.Action("Identification", "Risks", new { area = "Client" })" id="filterForm" class="flex flex-wrap items-center gap-2 rounded-3xl sentro-card p-2 dark:border-slate-800 dark:bg-slate-900/90">
        <div class="flex min-w-[300px] flex-1 items-center rounded-2xl border border-transparent px-4 transition-all focus-within:ring-2 focus-within:ring-[var(--brand-primary)] focus-within:ring-opacity-20 dark:bg-slate-800/50" style="background: var(--bg-page);">
            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="3" stroke-linecap="round" /></svg>
            <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search global registry..." class="w-full bg-transparent p-4 text-xs font-bold outline-none dark:text-white">
        </div>
        @if (isAdmin)
        {
            <select name="status" id="statusFilter" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
                <option value="">All</option>
                <option value="NeedsAction">Needs Action</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        else
        {
            <select name="status" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
                <option value="">All Statuses</option>
                <option value="Draft" @(Context.Request.Query["status"] == "Draft" ? "selected" : "")>Draft</option>
                <option value="For_Review" @(Context.Request.Query["status"] == "For_Review" ? "selected" : "")>For review</option>
                <option value="Monitoring" @(Context.Request.Query["status"] == "Monitoring" ? "selected" : "")>Monitoring</option>
                <option value="MitigationRequired" @(Context.Request.Query["status"] == "MitigationRequired" ? "selected" : "")>Mitigation Required</option>
                <option value="Closed_Invalid" @(Context.Request.Query["status"] == "Closed_Invalid" ? "selected" : "")>Closed (Invalid)</option>
                <option value="Closed_Controlled" @(Context.Request.Query["status"] == "Closed_Controlled" ? "selected" : "")>Closed (Controlled)</option>
                <option value="Rejected" @(Context.Request.Query["status"] == "Rejected" ? "selected" : "")>Rejected</option>
            </select>
        }
        <select name="category" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
            <option value="">All Categories</option>
            <option value="Operational" @(Context.Request.Query["category"] == "Operational" ? "selected" : "")>Operational</option>
            <option value="Financial" @(Context.Request.Query["category"] == "Financial" ? "selected" : "")>Financial</option>
            <option value="Safety" @(Context.Request.Query["category"] == "Safety" ? "selected" : "")>Safety</option>
        </select>
        <select name="siteId" class="cursor-pointer rounded-2xl border-none bg-white px-6 py-4 font-black tracking-widest text-[10px] uppercase shadow-sm outline-none dark:bg-slate-800 dark:text-slate-300">
            @foreach (var item in siteFilterList)
            {
                <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedSiteId?.ToString())">@item.Text</option>
            }
        </select>
        @if (isAdmin)
        {
            <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-400">
                <input type="checkbox" name="showDeleted" value="true" @(ViewBag.ShowDeleted == true ? "checked" : "") onchange="this.form.submit()" />
                Show deleted
            </label>
        }
        <button type="submit" class="btn-accent rounded-2xl px-8 py-4 text-sm font-semibold tracking-wide transition-all">
            Apply Filters
        </button>
    </form>

    <div class="rounded-xl sentro-card p-5 dark:border-slate-700 dark:bg-slate-800/90">
        <div class="overflow-x-auto">
            <table class="w-full table-fixed text-left" id="risksTable">
                <thead>
                    <tr class="border-b border-slate-200 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
                        <th class="w-[110px] pb-3 pr-4 font-medium">Risk ID</th>
                        <th class="w-[35%] pb-3 pr-4 font-medium">Risk Identity</th>
                        <th class="w-[140px] pb-3 pr-4 text-center font-medium">Priority</th>
                        <th class="w-[160px] pb-3 pr-4 text-center font-medium">Status</th>
                        <th class="w-[150px] pb-3 pr-4 font-medium">Date Reported</th>
                        <th class="w-[120px] pb-3 px-2 font-medium">Next Review</th>
                        <th class="w-[80px] pb-3 px-2 text-right font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var risk in Model.Items)
                    {
                        var status = risk.Status ?? "Draft";
                        var statusDisplay = status == "Rejected" ? "Rejected" : status == "For_Review" || status == "Submitted" || status == "Reviewed" ? "For review" : status == "Approved" ? "Monitoring" : status == "Closed_Invalid" ? "Closed_Invalid" : status;
                        var actionStatus = status == "Submitted" || status == "Reviewed" ? "For_Review" : status;
                        var dateReported = risk.DateReported ?? risk.DateLogged;
                        var reportedBy = risk.ReportedBy ?? risk.DetectedBy ?? "";
                        var isDeleted = risk.DeletedAt.HasValue;
                        var priorityVal = risk.Priority ?? "Unassessed";
                        var inherentText = risk.InherentScore.HasValue ? $"{(risk.InherentLevel ?? "—")} ({risk.InherentScore})" : "—";
                        var residualText = risk.ResidualScore.HasValue ? $"{(risk.ResidualLevel ?? "—")} ({risk.ResidualScore})" : "—";
                        var priorityTitle = $"Inherent: {inherentText} | Residual: {residualText}";
                        var riskIdDisplay = risk.Id > 0 ? "R-" + risk.Id.ToString("D6") : "R-000000";
                        var riskJson = System.Text.Json.JsonSerializer.Serialize(new {
                            risk.Id,
                            Title = risk.Title ?? "",
                            risk.Category,
                            Priority = priorityVal,
                            Status = statusDisplay,
                            RawStatus = status,
                            risk.SourceType,
                            ProjectSite = risk.ProjectSite ?? "",
                            SiteId = risk.SiteId,
                            SiteName = risk.SiteName ?? "Unassigned",
                            DateReported = dateReported.ToString("yyyy-MM-dd"),
                            ReportedBy = reportedBy,
                            ReportByUserId = risk.ReportByUserId,
                            risk.OrgId,
                            DeletedAt = risk.DeletedAt,
                            Attachments = risk.Attachments ?? new List<string>(),
                            NextReviewDate = risk.NextReviewDate?.ToString("yyyy-MM-dd"),
                            OverdueFlag = risk.OverdueFlag
                        });
                        <tr class="risk-row group cursor-default transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50 @(isDeleted ? "opacity-60" : "")" data-risk="@Html.Raw(System.Net.WebUtility.HtmlEncode(riskJson))" data-status="@statusDisplay" data-priority="@priorityVal" data-deleted="@(isDeleted ? "1" : "0")">
                            <td class="w-[110px] py-3 pr-4">
                                <span class="font-mono text-sm text-slate-600 dark:text-slate-400">@riskIdDisplay</span>
                            </td>
                            <td class="w-[35%] py-3 pr-4 align-top">
                                <div class="min-w-0">
                                    <div class="line-clamp-2 text-sm font-medium text-slate-900 dark:text-white" title="@(risk.Title ?? "")">@(risk.Title ?? "")</div>
                                    @if (risk.AttachmentsCount > 0) { <span class="text-xs text-slate-400">@risk.AttachmentsCount file(s)</span> }
                                </div>
                            </td>
                            <td class="w-[140px] py-3 pr-4 text-center" title="@priorityTitle">
                                @{ var priorityColor = priorityVal == "Critical" ? "bg-rose-500" : priorityVal == "High" ? "bg-orange-500" : priorityVal == "Medium" ? "bg-amber-500" : priorityVal == "Low" ? "bg-emerald-500" : "bg-slate-300"; }
                                <div class="flex items-center justify-center gap-2">
                                    <div class="h-1.5 w-1.5 rounded-full @priorityColor"></div>
                                    <span class="text-sm text-slate-600 dark:text-slate-400">@priorityVal</span>
                                </div>
                            </td>
                            <td class="w-[160px] py-3 pr-4 text-center">
                                @{
                                    var statusColor = statusDisplay == "For review" ? "bg-blue-500" :
                                        statusDisplay == "Rejected" ? "bg-rose-500" :
                                        statusDisplay == "Monitoring" ? "bg-emerald-500" :
                                        statusDisplay == "MitigationRequired" ? "bg-amber-500" :
                                        statusDisplay == "Closed_Invalid" ? "bg-rose-400" :
                                        statusDisplay == "Closed_Controlled" ? "bg-slate-500" :
                                        "bg-slate-300";
                                }
                                <div class="flex items-center justify-center gap-2">
                                    <div class="h-1.5 w-1.5 rounded-full @statusColor @(statusDisplay == "For review" || statusDisplay == "Monitoring" ? "animate-pulse" : "")"></div>
                                    <span class="text-sm text-slate-600 dark:text-slate-400">@statusDisplay</span>
                                </div>
                            </td>
                            <td class="w-[150px] py-3 pr-4">
                                <span class="text-sm text-slate-500 dark:text-slate-400">@dateReported.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="w-[120px] py-3 px-2">
                                @if (risk.NextReviewDate.HasValue)
                                {
                                    <span class="text-sm @(risk.OverdueFlag ? "text-rose-600 dark:text-rose-400" : "text-slate-500 dark:text-slate-400")" title="@(risk.OverdueFlag ? "Overdue" : "Due")">@risk.NextReviewDate.Value.ToString("MMM dd, yyyy")@(risk.OverdueFlag ? " ⚠" : "")</span>
                                }
                                else
                                {
                                    <span class="text-sm text-slate-400">—</span>
                                }
                            </td>
                            <td class="w-[80px] py-3 px-2 text-right">
                                <div class="relative flex justify-end">
                                    @if (!isDeleted)
                                    {
                                        <button type="button" onclick="toggleActionMenu(this, '@risk.Id')" class="rounded-lg border border-slate-200 p-2 text-slate-500 transition-all hover:bg-slate-50 hover:text-slate-700 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" aria-label="Actions">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                                        </button>
                                        <div id="actionMenu-@risk.Id" class="action-menu absolute right-0 top-full z-10 mt-1 hidden w-48 origin-top-right rounded-xl border border-slate-100 bg-white p-1 shadow-xl focus:outline-none dark:border-slate-700 dark:bg-slate-800">
                                            <button type="button" onclick="openViewModal(this)" class="group flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-slate-600 transition-all hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700">
                                                <svg class="h-4 w-4 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                                View Details
                                            </button>
                                            @if (actionStatus != "Draft")
                                            {
                                                <form action="@Url.Action("SoftDelete", "Risks", new { area = "Client" })" method="post" class="w-full">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@risk.Id" />
                                                    <button type="submit" class="group flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-rose-500 transition-all hover:bg-rose-50 dark:hover:bg-rose-900/20">
                                                        <svg class="h-4 w-4 text-rose-400 group-hover:text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                                                        Archive (Soft Delete)
                                                    </button>
                                                </form>
                                            }
                                            @if (actionStatus == "Draft" && (risk.ReportByUserId == ViewBag.CurrentUserId || isAdmin))
                                            {
                                                <button type="button" onclick="confirmHardDelete(@risk.Id, @risk.OrgId)" class="group flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-rose-600 transition-all hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-900/20">
                                                    <svg class="h-4 w-4 text-rose-500 group-hover:text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                    Delete Permanently
                                                </button>
                                            }
                                        </div>
                                    }
                                    else if (isAdmin)
                                    {
                                        <button type="button" onclick="toggleActionMenu(this, '@risk.Id')" class="rounded-lg border border-slate-200 p-2 text-slate-500 transition-all hover:bg-slate-50 hover:text-slate-700 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" aria-label="Actions">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                                        </button>
                                        <div id="actionMenu-@risk.Id" class="action-menu absolute right-0 top-full z-10 mt-1 hidden w-48 origin-top-right rounded-xl border border-slate-100 bg-white p-1 shadow-xl focus:outline-none dark:border-slate-700 dark:bg-slate-800">
                                            <form action="@Url.Action("Restore", "Risks", new { area = "Client" })" method="post" class="w-full">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@risk.Id" />
                                                <button type="submit" class="group flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-emerald-600 transition-all hover:bg-emerald-50 dark:hover:bg-emerald-900/20">
                                                    <svg class="h-4 w-4 text-emerald-500 group-hover:text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                                    Restore Risk
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            ViewData["PageNumber"] = Model.PageNumber;
            ViewData["TotalPages"] = Model.TotalPages;
            ViewData["TotalCount"] = Model.TotalCount;
            ViewData["PageSize"] = Model.PageSize;
            ViewData["BaseUrl"] = baseUrl;
        }
        @await Html.PartialAsync("_Pagination")
    </div>
</div>

<!-- New Risk Modal -->
<div id="newRiskModal" class="fixed inset-0 z-[60] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleNewRiskModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-5xl max-h-[90vh] flex flex-col rounded-xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-900 sm:w-full">
            <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-6 py-4 dark:border-slate-700">
                <h2 class="text-lg font-normal text-slate-900 dark:text-white">Identify New Risk</h2>
                <button type="button" onclick="toggleNewRiskModal()" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300" aria-label="Close"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
            </div>
            <form id="identifyRiskForm" action="@Url.Action("IdentifyNewRisk", "Risks", new { area = "Client" })" method="post" enctype="multipart/form-data" class="flex min-h-0 flex-1 flex-col" onsubmit="var btns=this.querySelectorAll('button[type=button][data-risk-submit]');btns.forEach(function(b){b.disabled=true;});">
                @Html.AntiForgeryToken()
                <input type="hidden" name="submitType" id="riskSubmitType" value="Draft" />
                <input type="hidden" name="ProjectSite" value="" />
                <div class="flex min-h-0 flex-1 flex-col sm:flex-row">
                    <nav class="w-full shrink-0 border-b border-slate-200 bg-slate-50 px-4 py-4 dark:border-slate-700 dark:bg-slate-800/50 sm:w-56 sm:border-b-0 sm:border-r sm:py-6">
                        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-slate-400 dark:text-slate-500">Sections</p>
                        <ul class="space-y-0.5 text-sm">
                            <li><span class="block rounded-lg bg-emerald-50 px-3 py-2 font-medium text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200" id="newRiskNavGeneral">General information</span></li>
                            <li><span class="block rounded-lg px-3 py-2 text-slate-500 dark:text-slate-400">Attachments</span></li>
                            <li><span class="block rounded-lg px-3 py-2 text-slate-500 dark:text-slate-400">Review</span></li>
                        </ul>
                    </nav>
                    <div class="min-w-0 flex-1 overflow-y-auto p-6">
                        <section id="newRiskSectionGeneral" aria-labelledby="newRiskNavGeneral">
                            <h3 class="text-sm font-medium text-slate-900 dark:text-white mb-1">Information</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Enter the general information for this risk.</p>
                            <div class="space-y-6">
                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                    <div class="space-y-1.5">
                                        <label for="identifyRiskReportedDate" class="block text-sm font-medium text-slate-600 dark:text-slate-400">Date reported</label>
                                        <input type="date" id="identifyRiskReportedDate" name="ReportedDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-emerald-400 dark:focus:ring-emerald-400/20" required />
                                    </div>
                                    <div class="space-y-1.5">
                                        <label for="identifyRiskCategory" class="block text-sm font-medium text-slate-600 dark:text-slate-400">Risk category</label>
                                        <select id="identifyRiskCategory" name="Category" class="h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-emerald-400 dark:focus:ring-emerald-400/20">
                                            <option>Operational</option>
                                            <option>Financial</option>
                                            <option>Safety</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <label for="identifyRiskTitle" class="block text-sm font-medium text-slate-600 dark:text-slate-400">Risk description</label>
                                    <textarea id="identifyRiskTitle" name="Title" rows="3" placeholder="Risk description" class="min-h-[4.5rem] w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-emerald-400 dark:focus:ring-emerald-400/20" required></textarea>
                                </div>
                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                    <div class="space-y-1.5">
                                        <label for="identifyRiskSourceType" class="block text-sm font-medium text-slate-600 dark:text-slate-400">Source type</label>
                                        <select id="identifyRiskSourceType" name="SourceType" class="h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-emerald-400 dark:focus:ring-emerald-400/20">
                                            <option value="Inspection">Inspection</option>
                                            <option value="Incident">Incident</option>
                                            <option value="Audit">Audit</option>
                                            <option value="Observation">Observation</option>
                                        </select>
                                    </div>
                                    <div class="space-y-1.5">
                                        <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Status</label>
                                        <input type="text" readonly value="Draft" class="h-10 w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-base text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" title="Save Draft = Draft; Submit Risk = For review" />
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <label for="identifyRiskSiteId" class="block text-sm font-medium text-slate-600 dark:text-slate-400">Site</label>
                                    <select id="identifyRiskSiteId" name="SiteId" class="h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:focus:border-emerald-400 dark:focus:ring-emerald-400/20">
                                        @foreach (var item in sitesForRiskForm)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Reported by</label>
                                    <input type="text" readonly value="Auto-filled" class="h-10 w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-base text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" />
                                </div>
                                <div class="space-y-1.5">
                                    <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Attachments</label>
                                    <input type="file" id="identifyRiskAttachments" name="Attachments" multiple accept="image/jpeg,image/jpg,image/png,image/webp" class="sr-only" />
                                    <div id="identifyRiskDropzone" role="button" tabindex="0" onclick="document.getElementById('identifyRiskAttachments').click()" onkeydown="if(event.key==='Enter'||event.key===' ') document.getElementById('identifyRiskAttachments').click()" class="flex min-h-[100px] cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/50 px-4 py-6 transition-colors hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-600 dark:bg-slate-800/30 dark:hover:border-slate-500 dark:hover:bg-slate-800/50 dark:focus:ring-emerald-400/20">
                                        <svg class="h-8 w-8 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                        <span class="text-sm text-slate-500 dark:text-slate-400">Drag and drop your file here or <span class="font-medium text-emerald-600 dark:text-emerald-400">browse</span></span>
                                        <span id="identifyRiskAttachmentsLabel" class="text-xs text-slate-400 dark:text-slate-500">No file chosen</span>
                                    </div>
                                    <script>
                                        (function() {
                                            var input = document.getElementById('identifyRiskAttachments');
                                            var label = document.getElementById('identifyRiskAttachmentsLabel');
                                            if (input && label) input.addEventListener('change', function() {
                                                label.textContent = this.files.length ? this.files.length + ' file(s) chosen' : 'No file chosen';
                                            });
                                        })();
                                    </script>
                                    @if (TempData["AttachmentError"] != null) { <p class="text-xs text-rose-600 dark:text-rose-400">@TempData["AttachmentError"]</p> }
                                </div>
                            </div>
                        </section>
                    </div>
                    <aside class="hidden w-52 shrink-0 border-l border-slate-200 bg-slate-50/50 p-4 dark:border-slate-700 dark:bg-slate-800/30 lg:block">
                        <p class="text-xs font-medium text-slate-600 dark:text-slate-400">Draft vs submitted</p>
                        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-500">Save draft keeps the risk in Draft. Submit risk sends it for review.</p>
                        <p class="mt-3 text-xs font-medium text-slate-600 dark:text-slate-400">Reported by</p>
                        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-500">Auto-filled with your user when saved.</p>
                    </aside>
                </div>
                <div class="flex shrink-0 justify-end gap-3 border-t border-slate-200 bg-slate-50/50 px-6 py-4 dark:border-slate-700 dark:bg-slate-800/30">
                    <button type="button" onclick="toggleNewRiskModal()" class="rounded-xl px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Cancel</button>
                    <button type="button" data-risk-submit="Draft" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 disabled:opacity-70">Save draft</button>
                    <button type="button" data-risk-submit="Submit" class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-emerald-700 focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:opacity-70">Submit risk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Risk Modal -->
