                                <option value="Incident">Incident</option>
                                <option value="Audit">Audit</option>
                                <option value="Observation">Observation</option>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Status</label>
                            <input type="text" id="viewEditStatus" readonly class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-base text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Reported by</label>
                        <input type="text" id="viewEditReportedBy" readonly class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-base text-slate-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Site</label>
                        <select id="viewEditSiteId" name="SiteId" class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-base dark:border-slate-600 dark:bg-slate-800">
                            @foreach (var item in sitesForRiskForm)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="ProjectSite" id="viewEditProjectSite" />
                    <div class="space-y-1.5">
                        <label class="block text-sm font-medium text-slate-600 dark:text-slate-400">Attachments</label>
                        <input type="file" name="Attachments" multiple accept="image/*" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm file:mr-2 file:rounded file:border-0 file:bg-emerald-50 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-emerald-700 dark:border-slate-600 dark:bg-slate-800 dark:file:bg-emerald-900/30 dark:file:text-emerald-300" />
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="switchViewModalToView()" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancel</button>
                        <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-emerald-700">Save Changes</button>
                    </div>
                </form>
            </div>
                </div>
                <aside id="viewModalInfoPanel" class="hidden w-64 shrink-0 border-l border-slate-200 bg-slate-50/50 p-4 dark:border-slate-700 dark:bg-slate-800/30 lg:block">
                    <p class="text-xs font-medium text-slate-600 dark:text-slate-400">Current status</p>
                    <p id="viewModalInfoStatus" class="mt-1 text-[11px] text-slate-500 dark:text-slate-500">Shown when a risk is open.</p>
                    <p class="mt-3 text-xs font-medium text-slate-600 dark:text-slate-400">Reported by</p>
                    <p id="viewModalInfoReportedBy" class="mt-1 text-[11px] text-slate-500 dark:text-slate-500">—</p>
                    <p class="mt-3 text-xs font-medium text-slate-600 dark:text-slate-400">Site</p>
                    <p id="viewModalInfoSite" class="mt-1 text-[11px] text-slate-500 dark:text-slate-500">—</p>
                </aside>
            </div>
            <div id="viewModalBottomBar" class="flex shrink-0 hidden flex-wrap items-center justify-end gap-3 border-t border-slate-200 px-6 py-4 dark:border-slate-700">
                <div id="viewModalActions" class="flex flex-wrap gap-3">
                    <form id="viewModalSubmitForm" action="@Url.Action("SubmitRisk", "Risks", new { area = "Client" })" method="post" class="hidden inline-flex">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RiskId" id="viewModalSubmitRiskId" />
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-emerald-700">Submit</button>
                    </form>
                    <a id="viewModalAssessLink" href="#" class="hidden inline-flex items-center gap-2 rounded-xl bg-amber-500 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-amber-600">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                        Assess
                    </a>
                    <button type="button" id="viewModalRejectBtn" class="hidden inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-rose-700">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                        Reject
                    </button>
                </div>
                <div id="viewModalFooter" class="flex gap-3">
                    <button type="button" onclick="switchViewModalToEdit()" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Edit</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 z-[70] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeRejectModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md rounded-[2.5rem] border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
            <h3 class="mb-4 text-lg font-black text-slate-900 dark:text-white">Reject Risk</h3>
            <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">Remarks are required when rejecting.</p>
            <form action="@Url.Action("Reject", "Risks", new { area = "Client" })" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectRiskId" />
                <textarea name="RejectRemarks" id="rejectRemarks" rows="3" class="mb-4 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Enter remarks..." required></textarea>
                <div class="flex gap-3">
                    <button type="button" onclick="closeRejectModal()" class="flex-1 rounded-2xl bg-slate-200 py-2.5 text-xs font-bold text-slate-600 uppercase dark:bg-slate-700 dark:text-slate-300">Cancel</button>
                    <button type="submit" class="flex-1 rounded-2xl bg-rose-600 py-2.5 text-xs font-bold text-white uppercase">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hard Delete Modal -->
<div id="hardDeleteModal" class="fixed inset-0 z-[70] hidden transition-all duration-300">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeHardDeleteModal()"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md rounded-[2.5rem] border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
            <h3 class="mb-2 text-lg font-black text-rose-600 dark:text-rose-400">Permanently delete risk?</h3>
            <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">This will delete the risk, all attachments, and evaluations. This action cannot be undone.</p>
            <form action="@Url.Action("HardDelete", "Risks", new { area = "Client" })" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this risk?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="hardDeleteRiskId" />
                <input type="hidden" name="orgId" id="hardDeleteOrgId" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeHardDeleteModal()" class="flex-1 rounded-2xl bg-slate-200 py-2.5 text-xs font-bold text-slate-600 uppercase dark:bg-slate-700 dark:text-slate-300">Cancel</button>
                    <button type="submit" class="flex-1 rounded-2xl bg-rose-600 py-2.5 text-xs font-bold text-white uppercase">Delete permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Image Lightbox Modal -->
<div id="imageLightboxModal" class="fixed inset-0 z-[80] hidden transition-all duration-300" onclick="closeLightbox()">
    <div class="absolute inset-0 bg-black/90 backdrop-blur-md"></div>
    <div class="relative flex min-h-screen items-center justify-center p-4">
        <button type="button" onclick="closeLightbox()" class="absolute right-4 top-4 rounded-full bg-white/10 p-2 text-white hover:bg-white/20">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <img id="lightboxImage" src="" alt="Full size attachment" class="max-h-[90vh] max-w-full rounded-lg object-contain shadow-2xl" onclick="event.stopPropagation()" />
    </div>
</div>

<script>
    var isAdmin = @(isAdmin.ToString().ToLower());
    var isRiskManager = @(isRiskManager.ToString().ToLower());
    var currentUserId = '@ViewBag.CurrentUserId';
    var assessBaseUrl = '@Url.Action("Assess", "Risks", new { area = "Client" })';
    // Base URLs for risk-related APIs
    var risksApiBaseUrl = '@Url.Content("~/api/risks")';
    var controlsApiBaseUrl = '@Url.Content("~/api/controls")';
    
    // New Risk Modal Logic
    window.toggleNewRiskModal = function() {
        var modal = document.getElementById('newRiskModal');
        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
        } else {
            modal.classList.add('hidden');
        }
    };

    // Handle button clicks in new risk form to set submitType
    document.querySelectorAll('button[data-risk-submit]').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('riskSubmitType').value = this.getAttribute('data-risk-submit');
            document.getElementById('identifyRiskForm').submit();
        });
    });

    // View Modal Logic
    window.toggleViewModal = function() {
        var modal = document.getElementById('viewRiskModal');
        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
        } else {
            modal.classList.add('hidden');
        }
    };
    
    window.openViewModal = function(btn) {
        // Close any open action menus
        document.querySelectorAll('.action-menu').forEach(function(m) { m.classList.add('hidden'); });

        var tr = btn.closest('tr');
        if (!tr) {
            console.error('Row element (tr) not found for the clicked button.');
            return;
        }
        
        var riskData = tr.dataset.risk;
        if (!riskData) {
            console.error('No risk data found on the row.');
            return;
        }
        
        try {
            var risk = JSON.parse(riskData);
            var isDeleted = tr.dataset.deleted === "1";
            
            // Populate View Fields
            document.getElementById('viewTitle').textContent = risk.Title || '';
            document.getElementById('viewCategory').textContent = risk.Category || '';
            document.getElementById('viewPriority').textContent = risk.Priority || '';
            document.getElementById('viewStatus').textContent = risk.Status || '';
            document.getElementById('viewSourceType').textContent = risk.SourceType || '';
            document.getElementById('viewSiteName').textContent = risk.SiteName || '';
            document.getElementById('viewDateReported').textContent = risk.DateReported || '';
            document.getElementById('viewReportedBy').textContent = risk.ReportedBy || '';
            
            var infoStatus = document.getElementById('viewModalInfoStatus');
            var infoReported = document.getElementById('viewModalInfoReportedBy');
            var infoSite = document.getElementById('viewModalInfoSite');
            if (infoStatus) infoStatus.textContent = (risk.Status || risk.RawStatus || '—') + ': see workflow above.';
            if (infoReported) infoReported.textContent = risk.ReportedBy || '—';
            if (infoSite) infoSite.textContent = risk.SiteName || '—';
            
            // Populate Edit Fields
            var editIdField = document.getElementById('viewEditRiskId');
            if (editIdField) editIdField.value = risk.Id;
            
            var editTitleField = document.getElementById('viewEditTitle');
            if (editTitleField) editTitleField.value = risk.Title || '';
            
            var editDateField = document.getElementById('viewEditDate');
            if (editDateField) editDateField.value = risk.DateReported || '';
            
            if(risk.Category) {
                 var catSelect = document.getElementById('viewEditCategory');
                 if (catSelect) {
                     for(var i=0; i<catSelect.options.length; i++) {
                         if(catSelect.options[i].value == risk.Category) catSelect.selectedIndex = i;
                     }
                 }
            }
            if(risk.SourceType) {
                 var srcSelect = document.getElementById('viewEditSourceType');
                 if (srcSelect) {
                     for(var i=0; i<srcSelect.options.length; i++) {
                         if(srcSelect.options[i].value == risk.SourceType) srcSelect.selectedIndex = i;
                     }
                 }
            }
            if(risk.SiteId) {
                 var siteSelect = document.getElementById('viewEditSiteId');
                 if (siteSelect) {
                     for(var i=0; i<siteSelect.options.length; i++) {
                         if(siteSelect.options[i].value == risk.SiteId.toString()) siteSelect.selectedIndex = i;
                     }
                 }
            }
            
            var editStatusField = document.getElementById('viewEditStatus');
            if (editStatusField) editStatusField.value = risk.Status || '';
            
            var editReportedByField = document.getElementById('viewEditReportedBy');
            if (editReportedByField) editReportedByField.value = risk.ReportedBy || '';

            // Load Versions & Controls for this risk
            try {
                loadRiskVersions(risk.Id);
                loadRiskControls(risk.Id);
                loadAvailableControls();
            } catch (e) {
                console.warn('Failed to load versions/controls for risk', e);
            }
            
            // Render Attachments
            var attachDiv = document.getElementById('viewAttachmentsPreview');
            if (attachDiv) {
                attachDiv.innerHTML = '';
                if (risk.Attachments && risk.Attachments.length > 0) {
                    var grid = document.createElement('div');
                    grid.className = 'grid grid-cols-2 gap-2 w-full';
                    risk.Attachments.forEach(function(att) {
                        var img = document.createElement('img');
                        img.src = att; // Assuming att is URL
                        img.className = 'w-full h-24 object-cover rounded-lg border border-slate-200 dark:border-slate-700 cursor-pointer transition-transform hover:scale-105';
                        img.onclick = function() { openLightbox(att); };
                        grid.appendChild(img);
                    });
                    attachDiv.appendChild(grid);
                } else {
                    attachDiv.innerHTML = '<span class="text-xs text-slate-400 italic">No attachments</span>';
                }
            }
            
            // Workflow Stepper
            document.querySelectorAll('#viewWorkflowStepper .step').forEach(function(s) {
                s.classList.remove('text-emerald-600', 'text-slate-900', 'dark:text-white', 'border-b-2', 'border-emerald-500');
                s.classList.add('text-slate-300');
                // Use RawStatus if available for precise matching, else Status
                var currentStatus = risk.RawStatus || risk.Status; 
                if (s.dataset.step === currentStatus) {
                    s.classList.remove('text-slate-300');
                    s.classList.add('text-emerald-600', 'font-black', 'border-b-2', 'border-emerald-500');
                }
            });
            
            // Actions Logic
            var actionsDiv = document.getElementById('viewModalActions');
            var footerDiv = document.getElementById('viewModalBottomBar');
            var editBtn = document.querySelector('#viewModalFooter button');
            
            // Hide all actions first
            var submitForm = document.getElementById('viewModalSubmitForm');
            if (submitForm) submitForm.classList.add('hidden');
            
            var assessLink = document.getElementById('viewModalAssessLink');
            if (assessLink) assessLink.classList.add('hidden');
            
            var reviewedForm = document.getElementById('viewModalMarkReviewedForm'); // Might not exist in DOM based on previous Read
            if (reviewedForm) reviewedForm.classList.add('hidden');
            
            var rejectBtn = document.getElementById('viewModalRejectBtn');
            if (rejectBtn) rejectBtn.classList.add('hidden');
            
            if (editBtn) editBtn.classList.add('hidden');
            
            var showFooter = false;
            var isReporter = risk.ReportByUserId === currentUserId;
            // Use RawStatus for logic checks to be safe
            var rawStatus = risk.RawStatus || risk.Status;
            
            if (!isDeleted) {
                // Draft -> Submit (Only for reporter)
                if (rawStatus === 'Draft' && isReporter) {
                    var submitIdField = document.getElementById('viewModalSubmitRiskId');
                    if (submitIdField) submitIdField.value = risk.Id;
                    if (submitForm) submitForm.classList.remove('hidden');
                    if (editBtn) editBtn.classList.remove('hidden');
                    showFooter = true;
                }
                
                // Non-draft -> Assess always available (Admin/Risk Manager)
                if (rawStatus !== 'Draft' && (isAdmin || isRiskManager)) {
                    if (assessLink) {
                        assessLink.href = assessBaseUrl + '?id=' + risk.Id;
                        assessLink.classList.remove('hidden');
                    }
                    // Reject stays limited to review statuses
                    if ((rawStatus === 'For_Review' || rawStatus === 'Submitted') && rejectBtn) {
                        rejectBtn.onclick = function() {
                            openRejectModal(risk.Id);
                        };
                        rejectBtn.classList.remove('hidden');
                    }
                    showFooter = true;
                }
            }
            
            if (footerDiv) {
                if (showFooter || (editBtn && !editBtn.classList.contains('hidden'))) {
                    footerDiv.classList.remove('hidden');
                } else {
                    footerDiv.classList.add('hidden');
                }
            }
            
            // Reset to View Mode
            switchViewModalToView();
            
            // Open Modal
            toggleViewModal();
            
        } catch(e) {
            console.error('Error parsing risk data or populating modal', e);
            alert('Failed to load risk details. Please try refreshing the page.');
        }
    };
    
    window.switchViewModalToEdit = function() {
        document.getElementById('viewRiskContent').classList.add('hidden');
        document.getElementById('viewModalVersionsPanel').classList.add('hidden');
        document.getElementById('viewModalControlsPanel').classList.add('hidden');
        document.getElementById('viewModalEditPanel').classList.remove('hidden');
        document.getElementById('viewModalBottomBar').classList.add('hidden'); // Hide bottom bar in edit mode
    };
    
    window.switchViewModalToView = function() {
        document.getElementById('viewModalEditPanel').classList.add('hidden');
        document.getElementById('viewRiskContent').classList.remove('hidden');
        document.getElementById('viewModalVersionsPanel').classList.add('hidden');
        document.getElementById('viewModalControlsPanel').classList.add('hidden');
        document.getElementById('viewModalBottomBar').classList.remove('hidden');
        if (typeof syncViewModalTabUi === 'function') syncViewModalTabUi('details');
    };
    
    // Tab Switching (syncs top tabs + sidebar)
    function syncViewModalTabUi(tabName) {
        document.querySelectorAll('.view-tab').forEach(t => {
            t.classList.remove('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            t.classList.add('border-transparent', 'text-slate-500', 'dark:text-slate-400');
            if (t.dataset.tab === tabName) {
                t.classList.remove('border-transparent', 'text-slate-500', 'dark:text-slate-400');
                t.classList.add('border-[var(--brand-accent)]', 'text-[var(--brand-accent)]');
            }
        });
        document.querySelectorAll('.view-sidebar-item').forEach(el => {
            el.classList.remove('bg-emerald-50', 'font-medium', 'text-emerald-700', 'dark:bg-emerald-900/30', 'dark:text-emerald-300');
            el.classList.add('text-slate-500', 'dark:text-slate-400');
            if (el.dataset.tab === tabName) {
                el.classList.remove('text-slate-500', 'dark:text-slate-400');
                el.classList.add('bg-emerald-50', 'font-medium', 'text-emerald-700', 'dark:bg-emerald-900/30', 'dark:text-emerald-300');
            }
        });
    }
    document.querySelectorAll('.view-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            var tabName = this.dataset.tab;
            syncViewModalTabUi(tabName);
            document.getElementById('viewRiskContent').classList.add('hidden');
            document.getElementById('viewModalVersionsPanel').classList.add('hidden');
            document.getElementById('viewModalControlsPanel').classList.add('hidden');
            document.getElementById('viewModalEditPanel').classList.add('hidden');
            if(tabName === 'details') document.getElementById('viewRiskContent').classList.remove('hidden');
            if(tabName === 'versions') document.getElementById('viewModalVersionsPanel').classList.remove('hidden');
            if(tabName === 'controls') document.getElementById('viewModalControlsPanel').classList.remove('hidden');
        });
    });

    // --- Versions panel logic ---
    async function loadRiskVersions(riskId) {
        var tbody = document.getElementById('viewVersionsTableBody');
        var emptyMsg = document.getElementById('viewVersionsEmpty');
        var errMsg = document.getElementById('viewVersionsError');
        if (!tbody) return;
        tbody.innerHTML = '';
        if (emptyMsg) emptyMsg.classList.add('hidden');
        if (errMsg) { errMsg.classList.add('hidden'); errMsg.textContent = ''; }
        try {
            var resp = await fetch(risksApiBaseUrl + '/' + riskId + '/versions', { credentials: 'same-origin' });
            if (!resp.ok) {
                if (resp.status === 404 && emptyMsg) {
                    emptyMsg.classList.remove('hidden');
                } else if (errMsg) {
                    errMsg.textContent = 'Failed to load version history.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            var data = await resp.json();
            if (!data || data.length === 0) {
                if (emptyMsg) emptyMsg.classList.remove('hidden');
                return;
            }
            data.forEach(function(v, idx) {
                var tr = document.createElement('tr');
                tr.className = 'border-t border-slate-100 dark:border-slate-800';
                var no = document.createElement('td');
                no.className = 'p-2 text-xs text-slate-500';
                no.textContent = v.versionNo || (idx + 1);
                var date = document.createElement('td');
                date.className = 'p-2 text-xs text-slate-500';
                var d = v.changedAt ? new Date(v.changedAt) : null;
                date.textContent = d ? d.toLocaleString() : '—';
                var by = document.createElement('td');
                by.className = 'p-2 text-xs text-slate-500';
                by.textContent = v.changedByDisplayName || v.changedByUserId || '—';
                var summary = document.createElement('td');
                summary.className = 'p-2 text-xs text-slate-600 dark:text-slate-300';
                summary.textContent = v.changeSummary || '';
                tr.appendChild(no);
                tr.appendChild(date);
                tr.appendChild(by);
                tr.appendChild(summary);
                tbody.appendChild(tr);
            });
        } catch (e) {
            console.error('Error loading versions', e);
            if (errMsg) {
                errMsg.textContent = 'Failed to load version history.';
                errMsg.classList.remove('hidden');
            }
        }
    }

    // --- Controls panel logic ---
    var cachedControls = null;

    async function loadAvailableControls() {
        if (cachedControls !== null) {
            populateControlsDropdown(cachedControls);
            return;
        }
        var select = document.getElementById('viewControlsSelect');
        var errMsg = document.getElementById('viewControlsError');
        if (!select) return;
        if (errMsg) { errMsg.classList.add('hidden'); errMsg.textContent = ''; }
        try {
            var resp = await fetch(controlsApiBaseUrl, { credentials: 'same-origin' });
            if (!resp.ok) {
                if (errMsg) {
                    errMsg.textContent = 'Failed to load available controls.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            var data = await resp.json();
            cachedControls = data || [];
            populateControlsDropdown(cachedControls);
        } catch (e) {
            console.error('Error loading controls', e);
            if (errMsg) {
                errMsg.textContent = 'Failed to load available controls.';
                errMsg.classList.remove('hidden');
            }
        }
    }

    function populateControlsDropdown(list) {
        var select = document.getElementById('viewControlsSelect');
        if (!select) return;
        select.innerHTML = '';
        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Select control to link...';
        select.appendChild(placeholder);
        if (!list || list.length === 0) return;
        list.forEach(function(c) {
            var opt = document.createElement('option');
            opt.value = c.controlId;
            opt.textContent = c.name;
            select.appendChild(opt);
        });
    }

    async function loadRiskControls(riskId) {
        var tbody = document.getElementById('viewControlsTableBody');
        var emptyMsg = document.getElementById('viewControlsEmpty');
        var errMsg = document.getElementById('viewControlsError');
        if (!tbody) return;
        tbody.innerHTML = '';
        if (emptyMsg) emptyMsg.classList.add('hidden');
        if (errMsg) { errMsg.classList.add('hidden'); errMsg.textContent = ''; }
        try {
            var resp = await fetch(risksApiBaseUrl + '/' + riskId + '/controls', { credentials: 'same-origin' });
            if (!resp.ok) {
                if (errMsg) {
                    errMsg.textContent = 'Failed to load linked controls.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            var data = await resp.json();
            if (!data || data.length === 0) {
                if (emptyMsg) emptyMsg.classList.remove('hidden');
                return;
            }
            data.forEach(function(rc) {
                var tr = document.createElement('tr');
                tr.className = 'border-t border-slate-100 dark:border-slate-800';
                var nameTd = document.createElement('td');
                nameTd.className = 'p-2 text-xs text-slate-600 dark:text-slate-200';
                nameTd.textContent = rc.controlName || '';
                var notesTd = document.createElement('td');
                notesTd.className = 'p-2 text-xs text-slate-500';
                notesTd.textContent = rc.notes || '—';
                var actionsTd = document.createElement('td');
                actionsTd.className = 'p-2 text-right';
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'text-xs text-rose-500 hover:underline';
                btn.textContent = 'Unlink';
                btn.addEventListener('click', function() {
                    unlinkControlFromRisk(riskId, rc.riskControlId);
                });
                actionsTd.appendChild(btn);
                tr.appendChild(nameTd);
                tr.appendChild(notesTd);
                tr.appendChild(actionsTd);
                tbody.appendChild(tr);
            });
        } catch (e) {
            console.error('Error loading risk controls', e);
            if (errMsg) {
                errMsg.textContent = 'Failed to load linked controls.';
                errMsg.classList.remove('hidden');
            }
        }
    }

    async function unlinkControlFromRisk(riskId, riskControlId) {
        var errMsg = document.getElementById('viewControlsError');
        if (errMsg) { errMsg.classList.add('hidden'); errMsg.textContent = ''; }
        try {
            var resp = await fetch(risksApiBaseUrl + '/' + riskId + '/controls/' + riskControlId, {
                method: 'DELETE',
                credentials: 'same-origin'
            });
            if (!resp.ok) {
                if (errMsg) {
                    errMsg.textContent = 'Failed to unlink control.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            await loadRiskControls(riskId);
        } catch (e) {
            console.error('Error unlinking control', e);
            if (errMsg) {
                errMsg.textContent = 'Failed to unlink control.';
                errMsg.classList.remove('hidden');
            }
        }
    }

    (function wireControlsLinkButton() {
        var btn = document.getElementById('viewControlsLinkBtn');
        if (!btn) return;
        btn.addEventListener('click', async function() {
            var select = document.getElementById('viewControlsSelect');
            var errMsg = document.getElementById('viewControlsError');
            var editIdField = document.getElementById('viewEditRiskId');
            if (errMsg) { errMsg.classList.add('hidden'); errMsg.textContent = ''; }
            if (!select || !editIdField) return;
            var controlId = select.value;
            var riskId = editIdField.value;
            if (!riskId) {
                if (errMsg) {
                    errMsg.textContent = 'Risk not loaded.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            if (!controlId) {
                if (errMsg) {
                    errMsg.textContent = 'Please select a control to link.';
                    errMsg.classList.remove('hidden');
                }
                return;
            }
            try {
                var resp = await fetch(risksApiBaseUrl + '/' + riskId + '/controls', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ controlId: parseInt(controlId, 10), notes: null })
                });
                if (!resp.ok) {
                    if (resp.status === 404) {
                        if (errMsg) {
                            errMsg.textContent = 'Risk or control not found.';
                            errMsg.classList.remove('hidden');
                        }
                    } else if (errMsg) {
                        errMsg.textContent = 'Failed to link control.';
                        errMsg.classList.remove('hidden');
                    }
                    return;
                }
                await loadRiskControls(parseInt(riskId, 10));
            } catch (e) {
                console.error('Error linking control', e);
                if (errMsg) {
                    errMsg.textContent = 'Failed to link control.';
                    errMsg.classList.remove('hidden');
                }
            }
        });
    })();

    // Reject Modal
    window.openRejectModal = function(riskId) {
        document.getElementById('rejectRiskId').value = riskId;
        document.getElementById('rejectModal').classList.remove('hidden');
        toggleViewModal(); // Close view modal
    };
    
    window.closeRejectModal = function() {
        document.getElementById('rejectModal').classList.add('hidden');
    };

    // Hard Delete Modal
    window.closeHardDeleteModal = function() {
         document.getElementById('hardDeleteModal').classList.add('hidden');
    };
    
    // Lightbox Logic
    window.openLightbox = function(src) {
        document.getElementById('lightboxImage').src = src;
        document.getElementById('imageLightboxModal').classList.remove('hidden');
    };

    window.closeLightbox = function() {
        document.getElementById('imageLightboxModal').classList.add('hidden');
        document.getElementById('lightboxImage').src = '';
    };

    // Action Menu Logic
    window.toggleActionMenu = function(btn, id) {
        // Close other menus
        document.querySelectorAll('.action-menu').forEach(m => {
            if(m.id !== 'actionMenu-' + id) m.classList.add('hidden');
        });
        
        var menu = document.getElementById('actionMenu-' + id);
        if (menu.classList.contains('hidden')) {
            menu.classList.remove('hidden');
        } else {
            menu.classList.add('hidden');
        }
        
        // Prevent click from bubbling to document listener
        event.stopPropagation();
    };
    
    // Close menus when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.action-menu') && !e.target.closest('button[aria-label="Actions"]')) {
             document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));
        }
    });

    window.confirmHardDelete = function(riskId, orgId) {
        document.getElementById('hardDeleteRiskId').value = riskId;
        document.getElementById('hardDeleteOrgId').value = orgId;
        document.getElementById('hardDeleteModal').classList.remove('hidden');
        
        // Close menu
        document.getElementById('actionMenu-' + riskId).classList.add('hidden');
    };
    
</script>
