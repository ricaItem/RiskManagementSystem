                        <li><span id="viewSidebarVersions" class="view-sidebar-item block cursor-pointer rounded-lg px-3 py-2 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800" data-tab="versions" role="button" tabindex="0" onclick="document.getElementById('viewTabVersions').click()" onkeydown="if(event.key==='Enter'||event.key===' ') document.getElementById('viewTabVersions').click()">Versions</span></li>
