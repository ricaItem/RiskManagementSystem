@* Charts Initialization Script *@
<script>
    if (typeof Chart !== 'undefined') {
        const trendCtx = document.getElementById('riskTrendChart').getContext('2d');
        const greenGrad = trendCtx.createLinearGradient(0, 0, 0, 300);
        greenGrad.addColorStop(0, 'rgba(16, 185, 129, 0.1)');
        greenGrad.addColorStop(1, 'rgba(16, 185, 129, 0)');

        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN'],
                datasets: [{
                    label: 'Resolved',
                    data: [30, 45, 38, 60, 55, 75],
                    borderColor: '#10b981',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: greenGrad,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }, {
                    label: 'Critical',
                    data: [40, 35, 45, 30, 35, 25],
                    borderColor: '#f43f5e',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    tension: 0.4,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                animation: { duration: 2000, easing: 'easeOutQuart' },
                scales: {
                    y: { display: false },
                    x: { 
                        grid: { display: false }, 
                        border: { display: false }, 
                        ticks: { font: { size: 10, weight: '500' }, color: '#94a3b8' } 
                    }
                }
            }
        });

        const catCtx = document.getElementById('riskCategoryChart').getContext('2d');
        new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: ['Safety', 'Financial', 'Legal'],
                datasets: [{
                    data: [45, 30, 25],
                    backgroundColor: ['#10b981', '#0ea5e9', '#f59e0b'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '80%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { 
                            boxWidth: 8, 
                            usePointStyle: true, 
                            font: { size: 11, weight: '500', family: "'Inter', sans-serif" },
                            padding: 20,
                            color: '#64748b'
                        }
                    }
                },
                animation: { animateScale: true, animateRotate: true }
            }
        });
    }
</script>
