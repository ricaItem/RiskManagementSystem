@{
    ViewData["Title"] = "Firm Overview";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<div class="animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-8 duration-1000">

    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                BuildCraft <span class="italic" style="color: var(--brand-accent);">Command</span>
            </h1>
        </div>

        <div class="flex flex-wrap items-center gap-2 rounded-2xl sentro-card p-1.5 dark:border-slate-700 dark:bg-slate-800/90">
            <div class="flex items-center border-r border-slate-100 px-4 py-2 dark:border-slate-800">
                <span class="text-opacity-70 mr-3 font-bold text-[10px] text-emerald-500 uppercase">Date Range</span>
                <input type="date" class="cursor-pointer bg-transparent font-bold text-[11px] uppercase outline-none dark:text-slate-300" value="2024-01-01" />
                <span class="mx-2 text-slate-300">-</span>
                <input type="date" class="cursor-pointer bg-transparent font-bold text-[11px] uppercase outline-none dark:text-slate-300" value="2024-06-30" />
            </div>
            <div class="flex items-center border-r border-slate-100 px-4 py-2 dark:border-slate-800">
                <span class="text-opacity-70 mr-3 font-bold text-[10px] text-emerald-500 uppercase">Project</span>
                <select class="cursor-pointer bg-transparent text-xs font-bold outline-none dark:text-slate-300">
                    <option>Global View</option>
                    <option>Sky Tower</option>
                    <option>River Bridge</option>
                </select>
            </div>
            <button class="btn-primary rounded-xl px-5 py-2.5 text-sm tracking-wide transition-all hover:scale-[1.02] active:scale-[0.98]">
                Export Data
            </button>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <a href="@Url.Action("Index", "Mitigation", new { area = "Client" })" class="kpi-card group relative overflow-hidden rounded-xl sentro-card p-4 transition-all hover:-translate-y-0.5 hover:shadow-card-hover dark:border-slate-700 dark:bg-slate-800/90">
            <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">Overdue Items</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">12</h3>
            <p class="mt-2 w-fit rounded-md bg-rose-50 px-1.5 py-0.5 font-bold tracking-tighter text-[9px] text-rose-500 uppercase italic dark:bg-rose-500/10">⚠️ Critical Priority</p>
        </a>

        <a href="@Url.Action("Expenses", "Inventory", new { area = "Client" })" class="kpi-card group rounded-xl sentro-card p-4 transition-all hover:-translate-y-0.5 hover:shadow-card-hover dark:border-slate-700 dark:bg-slate-800/90">
            <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">Approvals</p>
            <h3 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">08</h3>
            <p class="mt-2 font-black text-[8px] text-emerald-500 uppercase italic">+6 New Today</p>
        </a>

        <a href="@Url.Action("Index", "Audit", new { area = "Client" })" class="kpi-card group rounded-xl sentro-card p-4 transition-all hover:-translate-y-0.5 hover:shadow-card-hover dark:border-slate-700 dark:bg-slate-800/90">
            <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">Health Index</p>
            <h3 class="mt-2 text-3xl font-black text-emerald-500">98<span class="text-lg">.2%</span></h3>
            <div class="mt-3 h-0.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                <div class="h-full rounded-full bg-emerald-500" style="width: 98%"></div>
            </div>
        </a>

        <a href="@Url.Action("Index", "Supplier", new { area = "Client" })" class="kpi-card group rounded-xl sentro-card p-4 transition-all hover:-translate-y-0.5 hover:shadow-card-hover dark:border-slate-700 dark:bg-slate-800/90">
            <p class="font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase">System State</p>
            <h3 class="mt-2 text-xl font-black tracking-tighter text-slate-900 uppercase dark:text-white">Operational</h3>
            <p class="mt-2 font-bold text-[10px] text-emerald-500 uppercase">✔ Optimal Flow</p>
        </a>
    </div>

    <div class="grid gap-4 lg:grid-cols-12">
        <div class="rounded-xl sentro-card p-5 lg:col-span-8 dark:border-slate-700 dark:bg-slate-800/90">
            <h3 class="mb-4 text-xs font-semibold tracking-wide text-[var(--text-primary)] dark:text-white">Risk Exposure Velocity</h3>
            <div class="h-56">
                <canvas id="riskTrendChart"></canvas>
            </div>
        </div>

        <div class="rounded-xl sentro-card p-5 lg:col-span-4 dark:border-slate-700 dark:bg-slate-800/90">
            <h3 class="mb-4 text-center text-xs font-semibold tracking-wide text-[var(--text-primary)] dark:text-white">Segmentation</h3>
            <div class="h-52">
                <canvas id="riskCategoryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl sentro-card p-5 dark:border-slate-700 dark:bg-slate-800/90">
            <div class="mb-4 flex items-center justify-between">
                <h3 class="text-xs font-semibold tracking-wide sentro-text-primary dark:text-white">Supplier Alert Watch</h3>
                <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-[10px] text-slate-400 uppercase dark:bg-slate-800">Real-time Feed</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-slate-100 font-black tracking-tighter text-[10px] text-slate-400 uppercase dark:border-slate-800">
                            <th class="pb-2">Partner</th>
                            <th class="pb-2">Risk Level</th>
                            <th class="pb-2 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 dark:divide-slate-800">
                        <tr class="group transition-colors hover:bg-slate-50/50 dark:hover:bg-white/5">
                            <td class="py-3 text-xs font-bold text-slate-700 dark:text-slate-300">SteelCo Fabrication</td>
                            <td class="py-3">
                                <span class="rounded-md bg-rose-100 px-2 py-0.5 font-black text-rose-600 text-[9px] uppercase">Critical</span>
                            </td>
                            <td class="py-3 text-right font-bold text-[10px] text-slate-400">Insurance Expired</td>
                        </tr>
                        <tr class="group transition-colors hover:bg-slate-50/50 dark:hover:bg-white/5">
                            <td class="py-3 text-xs font-bold text-slate-700 dark:text-slate-300">Apex Concrete</td>
                            <td class="py-3">
                                <span class="rounded-md bg-amber-100 px-2 py-0.5 font-black text-amber-600 text-[9px] uppercase">Elevated</span>
                            </td>
                            <td class="py-3 text-right font-bold text-[10px] text-slate-400">Audit Pending</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rounded-xl sentro-card p-5 dark:border-slate-700 dark:bg-slate-800/90">
            <h3 class="mb-4 text-xs font-semibold tracking-wide sentro-text-primary dark:text-white">Department Efficiency</h3>
            <div class="space-y-4">
                <div>
                    <div class="mb-2 flex justify-between">
                        <span class="font-bold text-[11px] dark:text-slate-300">Structural Engineering</span>
                        <span class="font-black text-[11px] text-emerald-500">92%</span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                        <div class="animate-in slide-in-from-left h-full bg-emerald-500 duration-1000" style="width: 92%"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-2 flex justify-between">
                        <span class="font-bold text-[11px] dark:text-slate-300">Logistics & Supply</span>
                        <span class="font-black text-[11px] text-amber-500">64%</span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                        <div class="animate-in slide-in-from-left h-full bg-amber-500 duration-1000" style="width: 64%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#64748b';

    const trendCtx = document.getElementById('riskTrendChart').getContext('2d');
    const greenGrad = trendCtx.createLinearGradient(0, 0, 0, 300);
    greenGrad.addColorStop(0, 'rgba(16, 185, 129, 0.1)');
    greenGrad.addColorStop(1, 'rgba(16, 185, 129, 0)');

    new Chart(trendCtx, {
        type: 'line',
        data: {
            labels: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN'],
            datasets: [{
                label: 'Resolved',
                data: [30, 45, 38, 60, 55, 75],
                borderColor: '#10b981',
                borderWidth: 4,
                fill: true,
                backgroundColor: greenGrad,
                tension: 0.4,
                pointRadius: 0,
                pointHoverRadius: 6
            }, {
                label: 'Critical',
                data: [40, 35, 45, 30, 35, 25],
                borderColor: '#f43f5e',
                borderWidth: 2,
                borderDash: [5, 5],
                tension: 0.4,
                pointRadius: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            animation: { duration: 2000, easing: 'easeOutQuart' },
            scales: {
                y: { display: false },
                x: { grid: { display: false }, border: { display: false }, ticks: { font: { weight: 'bold', size: 9 } } }
            }
        }
    });

    const catCtx = document.getElementById('riskCategoryChart').getContext('2d');
    new Chart(catCtx, {
        type: 'doughnut',
        data: {
            labels: ['Safety', 'Financial', 'Legal'],
            datasets: [{
                data: [45, 30, 25],
                backgroundColor: ['#10b981', '#0ea5e9', '#f59e0b'],
                borderWidth: 0,
                hoverOffset: 15
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '85%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 6, usePointStyle: true, font: { size: 10, weight: 'bold' } }
                }
            },
            animation: { animateScale: true, animateRotate: true }
        }
    });
</script>