@{
    ViewData["Title"] = "Firm Overview";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<div id="dashboard-skeleton" class="animate-pulse min-h-screen space-y-8 p-6">

    <!-- Header Section Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <!-- Title Skeleton -->
            <div class="h-8 w-64 bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>

        <!-- Filter Bar Skeleton -->
        <div class="flex flex-wrap items-center gap-2 rounded-2xl border border-slate-100 p-1.5 dark:border-slate-700 dark:bg-slate-800/50">
            <div class="flex items-center border-r border-slate-100 px-4 py-2 dark:border-slate-800">
                <div class="h-3 w-16 bg-slate-200 rounded mr-3 dark:bg-slate-700"></div>
                <div class="h-4 w-24 bg-slate-200 rounded dark:bg-slate-700"></div>
                <span class="mx-2 text-slate-200 dark:text-slate-700">-</span>
                <div class="h-4 w-24 bg-slate-200 rounded dark:bg-slate-700"></div>
            </div>
            <div class="flex items-center border-r border-slate-100 px-4 py-2 dark:border-slate-800">
                <div class="h-3 w-12 bg-slate-200 rounded mr-3 dark:bg-slate-700"></div>
                <div class="h-4 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
            </div>
            <!-- Button Skeleton -->
            <div class="h-10 w-32 bg-slate-200 rounded-xl dark:bg-slate-700"></div>
        </div>
    </div>

    <!-- KPI Cards Skeleton -->
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="rounded-xl border border-slate-100 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
                <div class="mb-4 h-3 w-24 bg-slate-200 rounded dark:bg-slate-700"></div>
                <div class="mb-2 h-8 w-16 bg-slate-200 rounded dark:bg-slate-700"></div>
                <div class="h-4 w-20 bg-slate-200 rounded dark:bg-slate-700"></div>
            </div>
        }
    </div>

    <!-- Charts Section Skeleton -->
    <div class="grid gap-4 lg:grid-cols-12">
        <!-- Main Chart Skeleton -->
        <div class="rounded-xl border border-slate-100 bg-white p-5 shadow-sm lg:col-span-8 dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-6 h-4 w-48 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="h-56 w-full bg-slate-200 rounded dark:bg-slate-700"></div>
        </div>

        <!-- Doughnut Chart Skeleton -->
        <div class="rounded-xl border border-slate-100 bg-white p-5 shadow-sm lg:col-span-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-6 mx-auto h-4 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="mx-auto h-40 w-40 rounded-full border-8 border-slate-200 dark:border-slate-700"></div>
        </div>
    </div>

    <!-- Bottom Section Skeleton -->
    <div class="grid gap-4 lg:grid-cols-2">
        <!-- Table Skeleton -->
        <div class="rounded-xl border border-slate-100 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-6 flex items-center justify-between">
                <div class="h-4 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
                <div class="h-5 w-24 rounded-full bg-slate-200 dark:bg-slate-700"></div>
            </div>
            <div class="space-y-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="flex items-center justify-between py-2">
                        <div class="h-4 w-1/3 bg-slate-200 rounded dark:bg-slate-700"></div>
                        <div class="h-5 w-16 rounded bg-slate-200 dark:bg-slate-700"></div>
                        <div class="h-3 w-20 bg-slate-200 rounded dark:bg-slate-700"></div>
                    </div>
                    @if (i < 2)
                    {
                        <div class="border-b border-slate-100 dark:border-slate-700"></div>
                    }
                }
            </div>
        </div>

        <!-- Progress Bars/Department Skeleton -->
        <div class="rounded-xl border border-slate-100 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-6 h-4 w-40 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="space-y-6">
                @for (int i = 0; i < 3; i++)
                {
                    <div>
                        <div class="mb-2 flex justify-between">
                            <div class="h-3 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
                            <div class="h-3 w-8 bg-slate-200 rounded dark:bg-slate-700"></div>
                        </div>
                        <div class="h-2 w-full rounded-full bg-slate-200 dark:bg-slate-700"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div id="dashboard-content" class="hidden"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748b';

            fetch('@Url.Action("DashboardContent", "Dashboard", new { area = "Client" })')
                .then(response => response.text())
                .then(html => {
                    const contentDiv = document.getElementById('dashboard-content');
                    contentDiv.innerHTML = html;

                    // Extract and execute scripts from the fetched HTML
                    const scripts = contentDiv.getElementsByTagName('script');
                    for (let i = 0; i < scripts.length; i++) {
                        const script = document.createElement('script');
                        if (scripts[i].src) {
                            script.src = scripts[i].src;
                        } else {
                            script.text = scripts[i].innerText;
                        }
                        document.body.appendChild(script);
                    }

                    document.getElementById('dashboard-skeleton').classList.add('hidden');
                    contentDiv.classList.remove('hidden');
                })
                .catch(error => {
                    console.error('Error fetching dashboard content:', error);
                });
        });
    </script>
}
