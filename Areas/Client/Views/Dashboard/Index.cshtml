@{
    ViewData["Title"] = "Firm Overview";
    Layout = "~/Areas/Client/Views/Shared/_LayoutClient.cshtml";
}

<div id="dashboard-skeleton" class="animate-pulse min-h-screen space-y-6 p-6">

    <!-- Header Section Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <!-- Title Skeleton -->
            <div class="h-8 w-48 bg-slate-200 rounded-md dark:bg-slate-700"></div>
            <div class="h-4 w-64 bg-slate-100 rounded-md mt-2 dark:bg-slate-800"></div>
        </div>

        <!-- Filter Bar Skeleton -->
        <div class="flex flex-wrap items-center gap-3">
            <div class="h-10 w-48 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            <div class="h-10 w-32 bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            <!-- Button Skeleton -->
            <div class="h-10 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
        </div>
    </div>

    <!-- KPI Cards Skeleton -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="mb-2 h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-8 w-12 bg-slate-200 rounded dark:bg-slate-700"></div>
                    </div>
                    <div class="h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800"></div>
                </div>
                <div class="mt-4 h-4 w-24 bg-slate-50 rounded-full dark:bg-slate-800"></div>
            </div>
        }
    </div>

    <!-- Charts Section Skeleton -->
    <div class="grid gap-6 lg:grid-cols-12">
        <!-- Main Chart Skeleton -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-8 dark:border-slate-800 dark:bg-slate-900/40">
            <div class="mb-6 flex justify-between">
                <div class="h-5 w-48 bg-slate-200 rounded dark:bg-slate-700"></div>
                <div class="h-4 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
            </div>
            <div class="h-64 w-full bg-slate-50 rounded-lg dark:bg-slate-800/50"></div>
        </div>

        <!-- Doughnut Chart Skeleton -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-4 dark:border-slate-800 dark:bg-slate-900/40">
            <div class="mb-6 h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="mx-auto h-48 w-48 rounded-full border-8 border-slate-100 dark:border-slate-800"></div>
        </div>
    </div>

    <!-- Bottom Section Skeleton -->
    <div class="grid gap-6 lg:grid-cols-2">
        <!-- Table Skeleton -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
            <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50">
                <div class="h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
                <div class="h-5 w-16 rounded-full bg-slate-100 dark:bg-slate-800"></div>
            </div>
            <div class="p-4 space-y-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="flex items-center justify-between py-1">
                        <div class="h-4 w-1/3 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-5 w-16 rounded bg-slate-100 dark:bg-slate-800"></div>
                        <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                    </div>
                    @if (i < 2)
                    {
                        <div class="border-b border-slate-50 dark:border-slate-800"></div>
                    }
                }
            </div>
        </div>

        <!-- Progress Bars/Department Skeleton -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <div class="mb-6 h-5 w-40 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="space-y-6">
                @for (int i = 0; i < 3; i++)
                {
                    <div>
                        <div class="mb-2 flex justify-between">
                            <div class="h-3 w-32 bg-slate-100 rounded dark:bg-slate-800"></div>
                            <div class="h-3 w-8 bg-slate-100 rounded dark:bg-slate-800"></div>
                        </div>
                        <div class="h-2 w-full rounded-full bg-slate-50 dark:bg-slate-800/50"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div id="dashboard-content" class="hidden"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#64748b';

            window.loadDashboardContent = function(url) {
                if (!url) url = '@Url.Action("DashboardContent", "Dashboard", new { area = "Client" })';
                
                const contentDiv = document.getElementById('dashboard-content');
                
                if (contentDiv.innerHTML.trim() === '') {
                     document.getElementById('dashboard-skeleton').classList.remove('hidden');
                     contentDiv.classList.add('hidden');
                } else {
                     contentDiv.classList.add('opacity-50', 'pointer-events-none');
                }

                fetch(url)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`DashboardContent request failed: ${response.status}`);
                        }
                        return response.text();
                    })
                    .then(html => {
                        contentDiv.innerHTML = html;

                        const scripts = contentDiv.getElementsByTagName('script');
                        const scriptsToRun = [];
                        for (let i = 0; i < scripts.length; i++) {
                            scriptsToRun.push(scripts[i]);
                        }
                        
                        scriptsToRun.forEach(oldScript => {
                            const script = document.createElement('script');
                            if (oldScript.src) {
                                script.src = oldScript.src;
                            } else {
                                script.text = oldScript.innerText;
                            }
                            document.body.appendChild(script);
                        });

                        document.getElementById('dashboard-skeleton').classList.add('hidden');
                        contentDiv.classList.remove('hidden', 'opacity-50', 'pointer-events-none');
                    })
                    .catch(error => {
                        console.error('Error fetching dashboard content:', error);
                        contentDiv.classList.remove('opacity-50', 'pointer-events-none');
                    });
            };

            loadDashboardContent();
        });
    </script>
}
