@model IList<Web_Sentro.Areas.Client.Controllers.BudgetSiteViewModel>
@{
    Layout = "_LayoutClient";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700" data-page-title="@ViewData["Title"]">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            <span class="text-indigo-500 dark:text-indigo-400 italic">Budget by Site</span>
        </h1>
        <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Total expenses & budget utilization per site</p>
    </div>

    <div class="rounded-xl border border-slate-200/70 bg-white/70 overflow-hidden shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-200/70 font-black text-[10px] text-slate-500 uppercase tracking-wider dark:border-slate-800 dark:text-slate-400">
                        <th class="px-6 py-4">Site</th>
                        <th class="px-6 py-4 text-right">Budget allocated</th>
                        <th class="px-6 py-4 text-right">Total expenses</th>
                        <th class="px-6 py-4 text-right">Utilization %</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200/70 dark:divide-slate-800">
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="px-6 py-16 text-center text-sm text-slate-500 dark:text-slate-400">No sites with budget data.</td></tr>
                    }
                    @foreach (var row in Model)
                    {
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                            <td class="px-6 py-4">
                                <span class="font-bold text-slate-900 dark:text-white">@row.SiteName</span>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 ml-1">(@row.SiteCode)</span>
                            </td>
                            <td class="px-6 py-4 text-right font-medium text-slate-700 dark:text-slate-300">@row.BudgetAllocated.ToString("N2")</td>
                            <td class="px-6 py-4 text-right font-medium text-slate-900 dark:text-white">@row.TotalExpenses.ToString("N2")</td>
                            <td class="px-6 py-4 text-right">
                                @if (row.UtilizationPercent.HasValue)
                                {
                                    var pct = row.UtilizationPercent.Value;
                                    var badge = pct > 100 ? "bg-rose-500/10 text-rose-600 dark:text-rose-400" : pct > 80 ? "bg-amber-500/10 text-amber-600 dark:text-amber-400" : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";
                                    <span class="rounded-lg px-2 py-1 text-[10px] font-bold @badge">@pct.ToString("F1")%</span>
                                }
                                else
                                {
                                    <span class="text-slate-400 dark:text-slate-500">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
