@model IEnumerable<dynamic>
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Audit Logs";
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-700">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                System <span class="text-emerald-500 italic">Audit Trail</span>
            </h1>
            <p class="mt-1 font-black tracking-[0.2em] text-[10px] text-slate-400 uppercase dark:text-slate-500">Event log & actor context</p>
        </div>
        <div class="flex gap-3">
            <button class="rounded-xl border border-slate-200 bg-[#fcfcfc] px-5 py-2.5 text-[10px] font-bold uppercase tracking-widest text-slate-600 shadow-card transition-all hover:bg-slate-100 flex items-center gap-2 dark:border-slate-700 dark:bg-slate-800/90 dark:text-slate-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Export CSV
            </button>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-4 shadow-card dark:border-slate-700 dark:bg-slate-800/90 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2.5" stroke-linecap="round" /></svg>
                </span>
                <input type="text" id="logSearch" placeholder="Search by User, IP, or Action..."
                       class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500 transition-all">
            </div>

            <div class="md:col-span-3">
                <select id="severityFilter" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Severities</option>
                    <option value="success">Routine (Success)</option>
                    <option value="warning">Significant (Warning)</option>
                    <option value="critical">Critical (Error)</option>
                </select>
            </div>

            <div class="md:col-span-3">
                <input type="date" id="dateFilter" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-xs font-bold outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="md:col-span-1">
                <button onclick="resetLogs()" class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-xl hover:bg-slate-200 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-[#fcfcfc] p-5 shadow-card dark:border-slate-700 dark:bg-slate-800/90">
        <h3 class="mb-4 text-xs font-black tracking-widest text-slate-900 uppercase dark:text-white">Audit Log</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="auditTable">
                <thead>
                    <tr class="border-b border-slate-100 font-black tracking-tighter text-[10px] text-slate-400 uppercase dark:border-slate-800">
                        <th class="pb-2">Event Details</th>
                        <th class="pb-2">Actor</th>
                        <th class="pb-2">Context</th>
                        <th class="pb-2">Action Taken</th>
                        <th class="pb-2 text-right">Severity</th>
                    </tr>
                </thead>
            <tbody class="divide-y divide-slate-50 dark:divide-slate-800/50">
                @foreach (var log in Model)
                {
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/5 transition-all group log-row">
                        <td class="py-3 pr-4">
                            <div class="text-[11px] font-medium text-slate-900 dark:text-white uppercase">
                                @log.Timestamp.ToString("hh:mm tt")
                            </div>
                            <div class="text-[10px] font-medium text-slate-400">
                                @log.Timestamp.ToString("dd MMM yyyy")
                            </div>
                        </td>

                        <td class="py-3 pr-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-[10px] font-semibold text-blue-600 uppercase">
                                    @log.User.Substring(0, 2)
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-slate-900 dark:text-white log-user">@log.User</div>
                                    <div class="text-[9px] font-mono text-slate-400 log-ip">@log.IpAddress</div>
                                </div>
                            </div>
                        </td>

                        <td class="py-3 pr-4">
                            <span class="text-[9px] font-medium uppercase px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 log-module">
                                @log.Module
                            </span>
                        </td>

                        <td class="py-3 pr-4">
                            <div class="text-xs font-bold text-slate-700 dark:text-slate-300 log-action">@log.Action</div>
                            <p class="text-[10px] text-slate-400 mt-0.5 line-clamp-1 log-details">@log.Details</p>
                        </td>

                        <td class="py-3 text-right">
                            @{
                                var statusColor = log.Status.ToLower() == "success" ? "emerald" : (log.Status.ToLower() == "warning" ? "amber" : "rose");
                                var icon = log.Status.ToLower() == "success" ? "✓" : (log.Status.ToLower() == "warning" ? "!" : "✕");
                            }
                            <span class="log-status inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-@statusColor-500/10 text-@statusColor-600 text-[9px] font-semibold uppercase tracking-tighter border border-@statusColor-500/20">
                                <span class="text-[10px]">@icon</span> @log.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<script>
    const searchInput = document.getElementById('logSearch');
    const severityFilter = document.getElementById('severityFilter');
    const rows = document.querySelectorAll('.log-row');

    function filterLogs() {
        const searchTerm = searchInput.value.toLowerCase();
        const severityTerm = severityFilter.value.toLowerCase();

        rows.forEach(row => {
            const user = row.querySelector('.log-user').innerText.toLowerCase();
            const action = row.querySelector('.log-action').innerText.toLowerCase();
            const module = row.querySelector('.log-module').innerText.toLowerCase();
            const details = row.querySelector('.log-details').innerText.toLowerCase();
            const status = row.querySelector('.log-status').innerText.toLowerCase();

            const matchesSearch = user.includes(searchTerm) || action.includes(searchTerm) || module.includes(searchTerm) || details.includes(searchTerm);
            const matchesSeverity = severityTerm === "" || status.includes(severityTerm);

            row.style.display = (matchesSearch && matchesSeverity) ? "" : "none";
        });
    }

    searchInput.addEventListener('input', filterLogs);
    severityFilter.addEventListener('change', filterLogs);

    function resetLogs() {
        searchInput.value = "";
        severityFilter.value = "";
        filterLogs();
    }
</script>