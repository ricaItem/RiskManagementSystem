@{
    ViewData["Title"] = "Audit Logs";
    Layout = "_LayoutClient";
}

<!-- Skeleton Loader -->
<div id="audit-skeleton" class="animate-pulse min-h-screen space-y-6">
    <!-- Header Section Skeleton -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
            <div class="h-8 w-48 bg-slate-200 rounded-md dark:bg-slate-700"></div>
            <div class="h-4 w-64 bg-slate-100 rounded-md mt-2 dark:bg-slate-800"></div>
        </div>
        <div>
            <div class="h-9 w-32 bg-slate-200 rounded-lg dark:bg-slate-700"></div>
        </div>
    </div>

    <!-- Filter Bar Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-3">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-3">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-3">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
            <div class="md:col-span-1">
                <div class="h-10 w-full bg-slate-100 rounded-lg dark:bg-slate-800"></div>
            </div>
        </div>
    </div>

    <!-- Table Skeleton -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40 overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50">
            <div class="h-5 w-32 bg-slate-200 rounded dark:bg-slate-700"></div>
            <div class="h-5 w-16 rounded-full bg-slate-100 dark:bg-slate-800"></div>
        </div>
        <div class="p-6 space-y-4">
            <!-- Table Header -->
            <div class="flex justify-between border-b border-slate-100 pb-2 dark:border-slate-800">
                <div class="h-4 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-16 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                <div class="h-4 w-16 bg-slate-100 rounded dark:bg-slate-800"></div>
            </div>
            <!-- Table Rows -->
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center justify-between py-2">
                    <div class="space-y-1">
                        <div class="h-3 w-20 bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-2 w-16 bg-slate-50 rounded dark:bg-slate-900"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-8 w-8 rounded-full bg-slate-200 dark:bg-slate-700"></div>
                        <div class="space-y-1">
                            <div class="h-3 w-24 bg-slate-100 rounded dark:bg-slate-800"></div>
                            <div class="h-2 w-16 bg-slate-50 rounded dark:bg-slate-900"></div>
                        </div>
                    </div>
                    <div class="h-5 w-20 rounded bg-slate-100 dark:bg-slate-800"></div>
                    <div class="space-y-1 w-1/4">
                        <div class="h-3 w-full bg-slate-100 rounded dark:bg-slate-800"></div>
                        <div class="h-2 w-3/4 bg-slate-50 rounded dark:bg-slate-900"></div>
                    </div>
                    <div class="h-5 w-20 rounded-lg bg-slate-100 dark:bg-slate-800"></div>
                </div>
                @if (i < 4)
                {
                    <div class="border-b border-slate-50 dark:border-slate-800"></div>
                }
            }
        </div>
    </div>
</div>

<!-- Main Content (Hidden initially) -->
<div id="main-container" class="animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-6 duration-700 hidden">
    <!-- Header -->
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                System Audit Trail
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Event log & actor context</p>
        </div>
        <div class="flex gap-3">
            <button class="rounded-lg bg-white border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-slate-900 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-700 transition-all flex items-center gap-2">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Export CSV
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" /></svg>
                </span>
                <input type="text" id="logSearch" placeholder="Search by User, IP, or Action..."
                       class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg pl-10 pr-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all placeholder:text-slate-400">
            </div>

            <div class="md:col-span-3">
                <select id="severityFilter" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-600 dark:text-slate-300">
                    <option value="">All Severities</option>
                    <option value="success">Routine (Success)</option>
                    <option value="warning">Significant (Warning)</option>
                    <option value="critical">Critical (Error)</option>
                </select>
            </div>

            <div class="md:col-span-3">
                <select id="typeFilter" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-600 dark:text-slate-300">
                    <option value="Audit" selected>Audit Logs</option>
                    <option value="System">System Logs</option>
                    <option value="">All Types</option>
                </select>
            </div>

            <div class="md:col-span-3">
                <input type="date" id="dateFilter" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-4 py-2 text-xs font-medium outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-600 dark:text-slate-300">
            </div>

            <div class="md:col-span-1">
                <button onclick="resetLogs()" class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-lg hover:bg-slate-200 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Content (Table) -->
    <div id="audit-content"></div>
</div>

<script>
    (function () {
        function loadAuditContent(page = 1) {
            const searchInput = document.getElementById('logSearch');
            const severityInput = document.getElementById('severityFilter');
            const typeInput = document.getElementById('typeFilter');
            const dateInput = document.getElementById('dateFilter');
            const contentDiv = document.getElementById('audit-content');
            const skeleton = document.getElementById('audit-skeleton');
            const mainContainer = document.getElementById('main-container');

            if (!searchInput || !severityInput || !typeInput || !dateInput || !contentDiv || !skeleton || !mainContainer) return;

            const search = searchInput.value;
            const severity = severityInput.value;
            const logType = typeInput.value;
            const date = dateInput.value;

            const params = new URLSearchParams({
                area: 'Client',
                page: page,
                pageSize: 10
            });

            if (search) params.append('search', search);
            if (severity) params.append('severity', severity);
            if (logType) params.append('logType', logType);

            if (date) {
                params.append('from', date);
                const d = new Date(date);
                d.setDate(d.getDate() + 1);
                params.append('to', d.toISOString().split('T')[0]);
            }

            const url = '@Url.Action("AuditContent", "Audit", new { area = "Client" })?' + params.toString();

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`AuditContent request failed: ${response.status}`);
                    }
                    return response.text();
                })
                .then(html => {
                    contentDiv.innerHTML = html;

                    skeleton.classList.add('hidden');
                    mainContainer.classList.remove('hidden');

                    document.querySelectorAll('.local-time').forEach(el => {
                        const utc = el.getAttribute('data-utc');
                        if (!utc) return;
                        const localDate = new Date(utc);
                        el.innerText = localDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    });

                    document.querySelectorAll('.local-date').forEach(el => {
                        const utc = el.getAttribute('data-utc');
                        if (!utc) return;
                        const localDate = new Date(utc);
                        el.innerText = localDate.toLocaleDateString([], { day: '2-digit', month: 'short', year: 'numeric' });
                    });

                    document.querySelectorAll('.local-date-header').forEach(el => {
                        const utc = el.getAttribute('data-utc');
                        if (!utc) return;
                        const localDate = new Date(utc);
                        el.innerText = localDate.toLocaleDateString([], { month: 'long', day: '2-digit', year: 'numeric' });
                    });

                    const scripts = Array.from(contentDiv.getElementsByTagName('script'));
                    scripts.forEach(oldScript => {
                        const script = document.createElement('script');
                        if (oldScript.src) {
                            script.src = oldScript.src;
                        } else {
                            script.text = oldScript.textContent;
                        }
                        document.body.appendChild(script);
                    });
                })
                .catch(error => {
                    console.error('Error fetching audit content:', error);
                    skeleton.classList.add('hidden');
                    mainContainer.classList.remove('hidden');
                    contentDiv.innerHTML = '<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800 dark:bg-rose-900/20 dark:text-rose-300">Failed to load Audit content. Please refresh the page.</div>';
                });
        }

        function initAuditPage() {
            const mainContainer = document.getElementById('main-container');
            if (!mainContainer || mainContainer.dataset.auditInitDone === '1') return;

            mainContainer.dataset.auditInitDone = '1';

            let searchTimeout;
            const searchInput = document.getElementById('logSearch');
            const severityInput = document.getElementById('severityFilter');
            const typeInput = document.getElementById('typeFilter');
            const dateInput = document.getElementById('dateFilter');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => loadAuditContent(1), 500);
                });
            }

            if (severityInput) {
                severityInput.addEventListener('change', () => loadAuditContent(1));
            }

            if (typeInput) {
                typeInput.addEventListener('change', () => loadAuditContent(1));
            }

            if (dateInput) {
                dateInput.addEventListener('change', () => loadAuditContent(1));
            }

            loadAuditContent(1);
        }

        window.resetLogs = function () {
            const searchInput = document.getElementById('logSearch');
            const severityInput = document.getElementById('severityFilter');
            const typeInput = document.getElementById('typeFilter');
            const dateInput = document.getElementById('dateFilter');

            if (searchInput) searchInput.value = '';
            if (severityInput) severityInput.value = '';
            if (typeInput) typeInput.value = 'Audit';
            if (dateInput) dateInput.value = '';

            loadAuditContent(1);
        };

        window.changePage = function (page) {
            loadAuditContent(page);
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAuditPage);
        } else {
            initAuditPage();
        }
    })();
</script>
