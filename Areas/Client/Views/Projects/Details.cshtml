@model WEB_Sentro.Areas.Client.Controllers.ProjectDetailsViewModel
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = Model.Name;
}

<style>
    .client-project-details {
        font-family: 'Inter', sans-serif;
    }
    .proj-card {
        background: #ffffff !important;
        border: 1px solid rgba(0, 0, 0, 0.02) !important;
        border-radius: 24px !important; 
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0,0,0,0.02) !important;
    }
    .soft-input {
        background: rgba(241, 245, 249, 0.6) !important;
        border: 1px solid transparent !important;
        border-radius: 12px !important;
        transition: all 0.2s ease;
    }
    .soft-input:focus {
        background: #ffffff !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2) !important;
    }
    .table-header {
        background: rgba(248, 250, 252, 0.5);
    }
    /* Dark mode overrides */
    .dark .proj-card {
        background: #0f172a !important;
        border-color: rgba(255,255,255,0.05) !important;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5) !important;
    }
    .dark .soft-input {
        background: rgba(30, 41, 59, 0.5) !important;
        color: #f8fafc !important;
    }
    .dark .soft-input:focus {
        background: #1e293b !important;
        border-color: #3b82f6 !important;
    }
    .dark .table-header {
        background: rgba(30, 41, 59, 0.3);
    }
</style>

<div class="client-project-details animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-8 p-4 md:p-8 duration-700">
    
    <!-- Header Section -->
    <div class="proj-card p-6 md:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0">
                <nav class="flex mb-2" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-2">
                        <li><a href="@Url.Action("Index", "Projects", new { area = "Client" })" class="text-[11px] font-bold uppercase tracking-widest text-slate-400 hover:text-blue-600 transition-colors">Projects</a></li>
                        <li><svg class="h-4 w-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg></li>
                        <li><span class="text-[11px] font-bold uppercase tracking-widest text-slate-600 dark:text-slate-300" aria-current="page">@Model.ProjectCode</span></li>
                    </ol>
                </nav>
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-white">@Model.Name</h1>
                
                <div class="mt-4 flex flex-wrap items-center gap-4 text-xs font-medium text-slate-500 dark:text-slate-400">
                    @{
                        var statusColor = Model.Status switch {
                            "Active" => "bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400",
                            "Completed" => "bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400",
                            "OnHold" => "bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400",
                            "Cancelled" => "bg-rose-50 text-rose-600 dark:bg-rose-900/30 dark:text-rose-400",
                            _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400"
                        };
                    }
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-[10px] font-bold @statusColor tracking-widest uppercase">
                        @Model.Status
                    </span>
                    <span class="flex items-center gap-1.5 bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-full">
                        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        @Model.ManagerName
                    </span>
                    <span class="flex items-center gap-1.5 bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-full">
                        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        @(Model.SiteName ?? "No Site Assigned")
                    </span>
                </div>
            </div>
            <div class="flex gap-3">
                 <a href="@Url.Action("Edit", "Projects", new { area = "Client", id = Model.ProjectId })" class="rounded-full bg-slate-100 px-6 py-2.5 text-xs font-bold text-slate-600 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 active:scale-95">Edit Project</a>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Budget -->
        <div class="proj-card p-6 flex flex-col justify-center">
            <dt class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-2">Total Budget</dt>
            <dd class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-white">@((Model.Budget ?? 0).ToString("C0", new System.Globalization.CultureInfo("en-PH")))</dd>
            <dd class="text-xs font-medium text-slate-400 mt-2">Spent: @Model.TotalExpenses.ToString("C0", new System.Globalization.CultureInfo("en-PH"))</dd>
        </div>

        <!-- Progress -->
        <div class="proj-card p-6 flex flex-col justify-center">
            <dt class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-2">Progress</dt>
            <dd class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-white">@((Model.Progress * 100).ToString("0"))%</dd>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 mt-3 overflow-hidden">
                <div class="bg-blue-600 h-full rounded-full transition-all duration-1000 ease-out" style="width: @((Model.Progress * 100).ToString("0"))%"></div>
            </div>
        </div>

        <!-- Risks -->
        <div class="proj-card p-6 flex flex-col justify-center">
            <dt class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-2">Active Risks</dt>
            <dd class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-white">@Model.RiskCount</dd>
            <dd class="text-xs font-medium text-rose-500 mt-2 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @Model.HighRiskCount Critical/High
            </dd>
        </div>

        <!-- Tasks -->
        <div class="proj-card p-6 flex flex-col justify-center">
            <dt class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-2">Total Tasks</dt>
            <dd class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-white">@Model.TaskCount</dd>
            <dd class="text-xs font-medium text-slate-400 mt-2">Across all phases</dd>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content (WBS) -->
        <div class="lg:col-span-2 space-y-8">
            <div class="proj-card overflow-hidden">
                <div class="border-b border-slate-100/50 dark:border-slate-800 px-6 py-5">
                    <h3 class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-white">Description</h3>
                </div>
                <div class="p-6 text-sm font-medium text-slate-600 dark:text-slate-400 leading-relaxed">
                    @if (!string.IsNullOrEmpty(Model.Description)) {
                        <p>@Model.Description</p>
                    } else {
                        <p class="italic opacity-60">No description provided.</p>
                    }
                </div>
            </div>

            <!-- Tasks Table -->
            <div class="proj-card overflow-hidden">
                <div class="border-b border-slate-100/50 dark:border-slate-800 px-6 py-5 flex justify-between items-center bg-slate-50/30 dark:bg-slate-800/30">
                    <h3 class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-white">Work Breakdown Structure</h3>
                    <button type="button" onclick="openCreateTaskModal(null)" class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-4 py-2 text-xs font-bold text-blue-600 hover:bg-blue-100 hover:text-blue-700 transition-colors active:scale-95 dark:bg-blue-900/30 dark:text-blue-400 dark:hover:bg-blue-900/50">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                        Add Root Task
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm whitespace-nowrap">
                        <thead class="table-header text-[10px] font-bold uppercase tracking-widest text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-4">Task</th>
                                <th scope="col" class="px-6 py-4">Status</th>
                                <th scope="col" class="px-6 py-4">Progress</th>
                                <th scope="col" class="px-6 py-4">Assigned To</th>
                                <th scope="col" class="px-6 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="wbs-table-body" class="divide-y divide-slate-100/50 dark:divide-slate-800/50">
                            <!-- Tasks injected via JS -->
                        </tbody>
                    </table>
                </div>
                <div id="wbs-loading" class="p-10 text-center text-slate-400 text-xs font-bold uppercase tracking-widest animate-pulse">Loading tasks...</div>
                <div id="wbs-empty" class="hidden p-12 text-center flex flex-col items-center">
                    <div class="h-12 w-12 rounded-full bg-slate-50 dark:bg-slate-800 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    </div>
                    <p class="text-sm font-bold text-slate-600 dark:text-slate-300">No tasks defined yet</p>
                    <p class="text-xs font-medium text-slate-400 mt-1 mb-4">Start breaking down your project into manageable pieces.</p>
                    <button onclick="openCreateTaskModal(null)" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors">Create your first task &rarr;</button>
                </div>
            </div>

            <!-- Risks Table -->
            <div id="risks-section" class="proj-card overflow-hidden">
                <div class="border-b border-slate-100/50 dark:border-slate-800 px-6 py-5 flex justify-between items-center bg-slate-50/30 dark:bg-slate-800/30">
                    <h3 class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-white">Project Risks</h3>
                    <span class="inline-flex items-center justify-center h-6 px-2.5 rounded-full bg-rose-50 text-[10px] font-bold text-rose-600 dark:bg-rose-900/30 dark:text-rose-400 uppercase tracking-widest">@Model.Risks.Count Total</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm whitespace-nowrap">
                        <thead class="table-header text-[10px] font-bold uppercase tracking-widest text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-4">Title</th>
                                <th scope="col" class="px-6 py-4">Category</th>
                                <th scope="col" class="px-6 py-4">Priority</th>
                                <th scope="col" class="px-6 py-4">Status</th>
                                <th scope="col" class="px-6 py-4">Logged</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100/50 dark:divide-slate-800/50">
                            @if (Model.Risks.Any())
                            {
                                foreach (var risk in Model.Risks)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                        <td class="px-6 py-4 font-bold text-slate-800 dark:text-white">@risk.Title</td>
                                        <td class="px-6 py-4 font-medium text-slate-500 dark:text-slate-400">@risk.Category</td>
                                        <td class="px-6 py-4">
                                            @if (risk.Priority == "Critical") {
                                                <span class="inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-rose-600 dark:bg-rose-900/30 dark:text-rose-400">Critical</span>
                                            } else if (risk.Priority == "High") {
                                                <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-orange-600 dark:bg-orange-900/30 dark:text-orange-400">High</span>
                                            } else if (risk.Priority == "Medium") {
                                                <span class="inline-flex items-center rounded-full bg-yellow-50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-yellow-600 dark:bg-yellow-900/30 dark:text-yellow-400">Medium</span>
                                            } else {
                                                <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-slate-600 dark:bg-slate-800 dark:text-slate-400">@risk.Priority</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center rounded-full bg-slate-50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-slate-600 border border-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">@risk.Status</span>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-slate-400 dark:text-slate-500">@risk.DateLogged.ToString("MMM d, yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center">
                                        <p class="text-sm font-bold text-slate-400 dark:text-slate-500">No risks identified for this project yet.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar (Related Items) -->
        <div class="space-y-6">
            <!-- Project Dates -->
            <div class="proj-card overflow-hidden">
                <div class="border-b border-slate-100/50 dark:border-slate-800 px-6 py-5 bg-slate-50/30 dark:bg-slate-800/30">
                    <h3 class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-white">Timeline</h3>
                </div>
                <div class="p-6 space-y-5">
                    <div>
                        <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-1">Start Date</p>
                        <p class="text-sm font-extrabold text-slate-800 dark:text-white">@(Model.StartDate?.ToString("MMMM d, yyyy") ?? "Not set")</p>
                    </div>
                    <div>
                        <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-1">End Date</p>
                        <p class="text-sm font-extrabold text-slate-800 dark:text-white">@(Model.EndDate?.ToString("MMMM d, yyyy") ?? "Not set")</p>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="proj-card overflow-hidden">
                 <div class="border-b border-slate-100/50 dark:border-slate-800 px-6 py-5 bg-slate-50/30 dark:bg-slate-800/30">
                    <h3 class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-white">Related Items</h3>
                </div>
                <div class="divide-y divide-slate-100/50 dark:divide-slate-800/50">
                    <a href="#risks-section" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <span class="text-sm font-bold text-slate-600 group-hover:text-blue-600 transition-colors dark:text-slate-300 dark:group-hover:text-blue-400">Risks</span>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors dark:bg-slate-800 dark:text-slate-400">@Model.RiskCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <span class="text-sm font-bold text-slate-600 group-hover:text-blue-600 transition-colors dark:text-slate-300 dark:group-hover:text-blue-400">Purchase Orders</span>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors dark:bg-slate-800 dark:text-slate-400">@Model.POCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <span class="text-sm font-bold text-slate-600 group-hover:text-blue-600 transition-colors dark:text-slate-300 dark:group-hover:text-blue-400">Incidents</span>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors dark:bg-slate-800 dark:text-slate-400">@Model.IncidentCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                        <span class="text-sm font-bold text-slate-600 group-hover:text-blue-600 transition-colors dark:text-slate-300 dark:group-hover:text-blue-400">Expenses</span>
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-500 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors dark:bg-slate-800 dark:text-slate-400">@Model.ExpenseCount</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Task Modal -->
<div id="createTaskModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4 transition-opacity opacity-0">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-[24px] shadow-2xl border border-slate-200/50 dark:border-slate-800 overflow-hidden transform transition-all scale-95 duration-300">
        <form id="createTaskForm" onsubmit="submitCreateTask(event)">
            <input type="hidden" id="newTaskParentId" name="ParentTaskId" />
            <input type="hidden" id="editingTaskId" name="ProjectTaskId" />
            <input type="hidden" id="taskAssignedTo" name="AssignedToUserId" />
            
            <div class="px-8 py-6 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/50">
                <h3 id="modalTitle" class="text-lg font-extrabold tracking-tight text-slate-800 dark:text-white">New Task</h3>
                <button type="button" onclick="closeCreateTaskModal()" class="text-slate-400 hover:text-rose-500 transition-colors bg-white hover:bg-rose-50 rounded-full p-2 dark:bg-slate-800 dark:hover:bg-rose-900/30"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
            </div>
            
            <div class="p-8 space-y-6">
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Task Title</label>
                    <input type="text" name="Title" required class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800" placeholder="e.g. Excavation Phase 1" />
                </div>
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Description</label>
                    <textarea name="Description" rows="3" class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800" placeholder="Optional task details..."></textarea>
                </div>
                <div id="status-progress-fields" class="grid grid-cols-2 gap-6 hidden">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Status</label>
                        <select name="Status" class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800 cursor-pointer">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="On Hold">On Hold</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Progress (%)</label>
                        <input type="number" name="PercentComplete" min="0" max="100" value="0" class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Start Date</label>
                        <input type="date" name="StartDate" class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800 cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">End Date</label>
                        <input type="date" name="EndDate" class="soft-input w-full px-4 py-3 text-sm font-medium text-slate-800 cursor-pointer" />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-2">Budget Allocation</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                            <span class="text-slate-400 font-medium sm:text-sm">$</span>
                        </div>
                        <input type="number" name="Budget" step="0.01" class="soft-input w-full pl-8 px-4 py-3 text-sm font-medium text-slate-800" placeholder="0.00" />
                    </div>
                </div>
            </div>

            <div class="px-8 py-5 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-3">
                <button type="button" onclick="closeCreateTaskModal()" class="px-6 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-colors active:scale-95 dark:hover:bg-slate-800 dark:text-slate-400">Cancel</button>
                <button type="submit" id="taskSubmitBtn" class="px-6 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full shadow-lg shadow-blue-600/20 transition-all active:scale-95 dark:bg-blue-600 dark:hover:bg-blue-500">Create Task</button>
            </div>
        </form>
    </div>
</div>

<script>
    const PROJECT_ID = @Model.ProjectId;
    const API_URL = '/Client/Projects'; 
    let ALL_TASKS = {};

    document.addEventListener('DOMContentLoaded', loadTasks);
    // Support for soft-nav
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(loadTasks, 100);
    }

    async function loadTasks() {
        const tbody = document.getElementById('wbs-table-body');
        const loading = document.getElementById('wbs-loading');
        const empty = document.getElementById('wbs-empty');
        if (!tbody || !loading || !empty) return;
        
        loading.classList.remove('hidden');
        tbody.innerHTML = '';
        ALL_TASKS = {}; // Reset

        try {
            const res = await fetch(`${API_URL}/GetTasks?projectId=${PROJECT_ID}`);
            if (!res.ok) throw new Error('Failed to load tasks');
            const flatTasks = await res.json();
            
            // Index tasks for quick lookup
            flatTasks.forEach(t => ALL_TASKS[t.projectTaskId] = t);
            
            loading.classList.add('hidden');
            
            if (flatTasks.length === 0) {
                empty.classList.remove('hidden');
                return;
            } else {
                empty.classList.add('hidden');
            }

            // Build Tree
            const tree = buildTree(flatTasks);
            
            // Helper to flatten tree for rendering order
            const flatten = (nodes, level = 0) => {
                let result = [];
                nodes.forEach(node => {
                    node.level = level;
                    result.push(node);
                    if (node.children && node.children.length > 0) {
                        result = result.concat(flatten(node.children, level + 1));
                    }
                });
                return result;
            };

            const renderList = flatten(tree);
            renderList.forEach(node => renderTaskRow(node, tbody));

        } catch (e) {
            console.error(e);
            loading.textContent = 'Error loading tasks.';
        }
    }

    function buildTree(tasks) {
        const map = {};
        const roots = [];
        tasks.forEach(t => {
            const node = { ...t, children: [] };
            map[node.projectTaskId] = node;
        });
        Object.values(map).forEach(node => {
            if (node.parentTaskId && map[node.parentTaskId]) {
                map[node.parentTaskId].children.push(node);
            } else {
                roots.push(node);
            }
        });
        return roots;
    }

    function renderTaskRow(node, container) {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors group';
        
        const indent = node.level * 24;
        const hasChildren = node.children && node.children.length > 0;
        
        // Status Color
        let statusColor = 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400';
        if (node.status === 'Completed') statusColor = 'bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400';
        else if (node.status === 'In Progress') statusColor = 'bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400';
        else if (node.status === 'On Hold') statusColor = 'bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400';
        
        const start = node.startDate ? new Date(node.startDate).toLocaleDateString() : '-';
        const end = node.endDate ? new Date(node.endDate).toLocaleDateString() : '-';

        tr.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center" style="padding-left: ${node.level * 20}px">
                    <span class="text-slate-300 mr-2">
                        ${hasChildren ? '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>' : '<div class="w-4 h-4"></div>'}
                    </span>
                    <div>
                        <div class="font-bold text-slate-800 dark:text-white text-sm">${node.title}</div>
                        <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400">${node.taskCode || ''}</div>
                    </div>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-widest ${statusColor}">
                    ${node.status || 'Pending'}
                </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                    <div class="w-20 bg-slate-100 rounded-full h-1.5 dark:bg-slate-800 overflow-hidden">
                        <div class="bg-blue-500 h-full rounded-full" style="width: ${node.percentComplete}%"></div>
                    </div>
                    <span class="text-[10px] font-bold text-slate-500">${node.percentComplete}%</span>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-slate-500 dark:text-slate-400">
                ${node.assignedToName || '<span class="text-slate-300 italic">Unassigned</span>'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button onclick="openCreateTaskModal(${node.projectTaskId})" class="p-1.5 rounded-md text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-blue-900/30 transition-colors" title="Add Subtask">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    </button>
                    <button onclick="openEditTaskModal(${node.projectTaskId})" class="p-1.5 rounded-md text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors" title="Edit">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    </button>
                    <button onclick="deleteTask(${node.projectTaskId})" class="p-1.5 rounded-md text-rose-500 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-900/30 transition-colors" title="Delete">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                </div>
            </td>
        `;
        container.appendChild(tr);
    }

    function openCreateTaskModal(parentId) {
        document.getElementById('createTaskForm').reset();
        document.getElementById('newTaskParentId').value = parentId || '';
        document.getElementById('editingTaskId').value = ''; 
        document.getElementById('taskAssignedTo').value = '';
        
        document.getElementById('modalTitle').innerText = 'New Task';
        document.getElementById('taskSubmitBtn').innerText = 'Create Task';
        
        document.getElementById('status-progress-fields').classList.add('hidden');
        document.querySelector('select[name=Status]').value = 'Pending';
        document.querySelector('input[name=PercentComplete]').value = 0;

        showModal();
    }

    function openEditTaskModal(taskId) {
        const task = ALL_TASKS[taskId];
        if (!task) return;

        document.getElementById('createTaskForm').reset();
        document.getElementById('editingTaskId').value = taskId;
        document.getElementById('newTaskParentId').value = task.parentTaskId || '';
        document.getElementById('taskAssignedTo').value = task.assignedToUserId || '';
        
        document.getElementById('modalTitle').innerText = 'Edit Task';
        document.getElementById('taskSubmitBtn').innerText = 'Update Task';
        
        document.getElementById('status-progress-fields').classList.remove('hidden');

        const form = document.getElementById('createTaskForm');
        form.querySelector('[name=Title]').value = task.title;
        form.querySelector('[name=Description]').value = task.description || '';
        form.querySelector('[name=StartDate]').value = task.startDate ? task.startDate.split('T')[0] : '';
        form.querySelector('[name=EndDate]').value = task.endDate ? task.endDate.split('T')[0] : '';
        form.querySelector('[name=Budget]').value = task.budget;
        form.querySelector('[name=Status]').value = task.status || 'Pending';
        form.querySelector('[name=PercentComplete]').value = task.percentComplete || 0;

        showModal();
    }

    function showModal() {
        const modal = document.getElementById('createTaskModal');
        modal.classList.remove('hidden');
        // Force reflow
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.firstElementChild.classList.remove('scale-95');
        modal.firstElementChild.classList.add('scale-100');
    }

    function closeCreateTaskModal() {
        const modal = document.getElementById('createTaskModal');
        modal.classList.add('opacity-0');
        modal.firstElementChild.classList.remove('scale-100');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    async function submitCreateTask(e) {
        e.preventDefault();
        
        const form = document.getElementById('createTaskForm');
        const editingTaskId = document.getElementById('editingTaskId').value;
        const parentIdVal = document.getElementById('newTaskParentId').value;
        const assignedTo = document.getElementById('taskAssignedTo').value;
        
        const data = {
            ProjectId: PROJECT_ID,
            ParentTaskId: parentIdVal ? parseInt(parentIdVal) : null,
            Title: form.querySelector('[name=Title]').value,
            Description: form.querySelector('[name=Description]').value,
            StartDate: form.querySelector('[name=StartDate]').value || null,
            EndDate: form.querySelector('[name=EndDate]').value || null,
            Budget: form.querySelector('[name=Budget]').value ? parseFloat(form.querySelector('[name=Budget]').value) : null,
            Status: form.querySelector('select[name=Status]').value,
            PercentComplete: parseInt(form.querySelector('input[name=PercentComplete]').value),
            AssignedToUserId: assignedTo || null
        };

        const btn = form.querySelector('button[type=submit]');
        const oldText = btn.innerText;
        btn.disabled = true;
        btn.innerText = 'Saving...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let url = `${API_URL}/CreateTask`;
            let bodyData = data;

            if (editingTaskId) {
                url = `${API_URL}/UpdateTask`;
                bodyData = { ...data, ProjectTaskId: parseInt(editingTaskId) };
            }
            
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify(bodyData)
            });
            
            if (res.ok) {
                closeCreateTaskModal();
                loadTasks();
            } else {
                console.error(await res.text());
                alert('Failed to save task');
            }
        } catch (err) {
            console.error(err);
            alert('Error saving task');
        } finally {
            btn.disabled = false;
            btn.innerText = oldText;
        }
    }

    async function deleteTask(id) {
        if (!confirm('Are you sure you want to delete this task?')) return;
        
        try {
             const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
             const res = await fetch(`${API_URL}/DeleteTask?id=${id}`, { 
                 method: 'POST',
                 headers: { 'RequestVerificationToken': token || '' }
             });
            if (res.ok) {
                loadTasks();
            } else {
                alert('Failed to delete task');
            }
        } catch (err) {
            console.error(err);
            alert('Error deleting task');
        }
    }
</script>