@model WEB_Sentro.Areas.Client.Controllers.ProjectDetailsViewModel
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = Model.Name;
}

<div class="animate-in fade-in min-h-screen space-y-8 duration-500">
    <!-- Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <nav class="flex" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="@Url.Action("Index", "Projects", new { area = "Client" })" class="text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300">Projects</a></li>
                    <li><svg class="h-5 w-5 flex-shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg></li>
                    <li><span class="text-sm font-medium text-slate-900 dark:text-white" aria-current="page">@Model.ProjectCode</span></li>
                </ol>
            </nav>
            <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">@Model.Name</h1>
            <div class="mt-1 flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-900/30 dark:text-emerald-400">@Model.Status</span>
                <span class="flex items-center gap-1">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    @Model.ManagerName
                </span>
                <span class="flex items-center gap-1">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    @(Model.SiteName ?? "No Site Assigned")
                </span>
            </div>
        </div>
        <div class="flex gap-3">
             <button type="button" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">Edit Project</button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Budget -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <dt class="truncate text-sm font-medium text-slate-500 dark:text-slate-400">Total Budget</dt>
            <dd class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">@((Model.Budget ?? 0).ToString("C0"))</dd>
            <dd class="text-xs text-slate-500 dark:text-slate-400 mt-1">Spent: @Model.TotalExpenses.ToString("C0")</dd>
        </div>

        <!-- Progress -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <dt class="truncate text-sm font-medium text-slate-500 dark:text-slate-400">Progress</dt>
            <dd class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">@((Model.Progress * 100).ToString("0"))%</dd>
            <div class="w-full bg-slate-200 rounded-full h-1.5 mt-2 dark:bg-slate-700">
                <div class="bg-indigo-600 h-1.5 rounded-full" style="width: @((Model.Progress * 100).ToString("0"))%"></div>
            </div>
        </div>

        <!-- Risks -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <dt class="truncate text-sm font-medium text-slate-500 dark:text-slate-400">Active Risks</dt>
            <dd class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">@Model.RiskCount</dd>
            <dd class="text-xs text-rose-500 mt-1">@Model.HighRiskCount Critical/High</dd>
        </div>

        <!-- Tasks -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <dt class="truncate text-sm font-medium text-slate-500 dark:text-slate-400">Total Tasks</dt>
            <dd class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">@Model.TaskCount</dd>
            <dd class="text-xs text-slate-500 dark:text-slate-400 mt-1">Across all phases</dd>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content (WBS) -->
        <div class="lg:col-span-2 space-y-8">
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">Description</h3>
                </div>
                <div class="p-6 text-sm text-slate-600 dark:text-slate-300">
                    @if (!string.IsNullOrEmpty(Model.Description)) {
                        <p>@Model.Description</p>
                    } else {
                        <p class="italic text-slate-400">No description provided.</p>
                    }
                </div>
            </div>

            <!-- Tasks Table -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800 flex justify-between items-center">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">Work Breakdown Structure</h3>
                    <button type="button" onclick="openCreateTaskModal(null)" class="text-sm font-bold text-indigo-600 hover:text-indigo-500 flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Add Root Task
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-3 font-semibold">Task</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Status</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Progress</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Assigned To</th>
                                <th scope="col" class="px-6 py-3 font-semibold text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="wbs-table-body" class="divide-y divide-slate-100 dark:divide-slate-800">
                            <!-- Tasks injected via JS -->
                        </tbody>
                    </table>
                </div>
                <div id="wbs-loading" class="p-6 text-center text-slate-500 text-sm">Loading tasks...</div>
                <div id="wbs-empty" class="hidden p-8 text-center">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">No tasks defined yet</p>
                    <button onclick="openCreateTaskModal(null)" class="mt-2 text-xs font-bold text-indigo-600 hover:text-indigo-500">Create your first task</button>
                </div>
            </div>

            <!-- Risks Table -->
            <div id="risks-section" class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800 flex justify-between items-center">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">Project Risks</h3>
                    <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-600 dark:bg-rose-900/30 dark:text-rose-400">@Model.Risks.Count Total</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-3 font-semibold">Title</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Category</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Priority</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Status</th>
                                <th scope="col" class="px-6 py-3 font-semibold">Date Logged</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @if (Model.Risks.Any())
                            {
                                foreach (var risk in Model.Risks)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                        <td class="px-6 py-4 font-medium text-slate-900 dark:text-white">@risk.Title</td>
                                        <td class="px-6 py-4 text-slate-500 dark:text-slate-400">@risk.Category</td>
                                        <td class="px-6 py-4">
                                            @if (risk.Priority == "Critical") {
                                                <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700 dark:bg-rose-900/30 dark:text-rose-400">Critical</span>
                                            } else if (risk.Priority == "High") {
                                                <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-700 dark:bg-orange-900/30 dark:text-orange-400">High</span>
                                            } else if (risk.Priority == "Medium") {
                                                <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">Medium</span>
                                            } else {
                                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@risk.Priority</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@risk.Status</span>
                                        </td>
                                        <td class="px-6 py-4 text-slate-500 dark:text-slate-400">@risk.DateLogged.ToString("MMM d, yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="px-6 py-8 text-center text-slate-500 dark:text-slate-400 italic">No risks identified for this project yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar (Related Items) -->
        <div class="space-y-6">
            <!-- Project Dates -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">Timeline</h3>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Start Date</p>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@(Model.StartDate?.ToString("MMM d, yyyy") ?? "Not set")</p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">End Date</p>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@(Model.EndDate?.ToString("MMM d, yyyy") ?? "Not set")</p>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
                 <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800">
                    <h3 class="text-base font-semibold text-slate-900 dark:text-white">Related Items</h3>
                </div>
                <div class="divide-y divide-slate-100 dark:divide-slate-800">
                    <a href="#risks-section" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Risks</span>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@Model.RiskCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Purchase Orders</span>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@Model.POCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Incidents</span>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@Model.IncidentCount</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-6 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Expenses</span>
                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">@Model.ExpenseCount</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Task Modal -->
<div id="createTaskModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform transition-all scale-100">
        <form id="createTaskForm" onsubmit="submitCreateTask(event)">
            <input type="hidden" id="newTaskParentId" name="ParentTaskId" />
            <input type="hidden" id="editingTaskId" name="ProjectTaskId" />
            <input type="hidden" id="taskAssignedTo" name="AssignedToUserId" />
            
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/50">
                <h3 id="modalTitle" class="text-lg font-bold text-slate-900 dark:text-white">New Task</h3>
                <button type="button" onclick="closeCreateTaskModal()" class="text-slate-400 hover:text-rose-500"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
            </div>
            
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Task Title</label>
                    <input type="text" name="Title" required class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. Excavation Phase 1" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Description</label>
                    <textarea name="Description" rows="3" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Optional task details..."></textarea>
                </div>
                <div id="status-progress-fields" class="grid grid-cols-2 gap-4 hidden">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Status</label>
                        <select name="Status" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="On Hold">On Hold</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Progress (%)</label>
                        <input type="number" name="PercentComplete" min="0" max="100" value="0" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Start Date</label>
                        <input type="date" name="StartDate" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">End Date</label>
                        <input type="date" name="EndDate" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Budget Allocation</label>
                    <input type="number" name="Budget" step="0.01" class="w-full rounded-lg border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0.00" />
                </div>
            </div>

            <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex justify-end gap-3">
                <button type="button" onclick="closeCreateTaskModal()" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-lg dark:text-slate-300 dark:hover:bg-slate-700">Cancel</button>
                <button type="submit" id="taskSubmitBtn" class="px-4 py-2 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-lg dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100">Create Task</button>
            </div>
        </form>
    </div>
</div>

<script>
    const PROJECT_ID = @Model.ProjectId;
    const API_URL = '/Client/Projects'; 
    let ALL_TASKS = {};

    document.addEventListener('DOMContentLoaded', loadTasks);

    async function loadTasks() {
        const tbody = document.getElementById('wbs-table-body');
        const loading = document.getElementById('wbs-loading');
        const empty = document.getElementById('wbs-empty');
        
        loading.classList.remove('hidden');
        tbody.innerHTML = '';
        ALL_TASKS = {}; // Reset

        try {
            const res = await fetch(`${API_URL}/GetTasks?projectId=${PROJECT_ID}`);
            if (!res.ok) throw new Error('Failed to load tasks');
            const flatTasks = await res.json();
            
            // Index tasks for quick lookup
            flatTasks.forEach(t => ALL_TASKS[t.projectTaskId] = t);
            
            loading.classList.add('hidden');
            
            if (flatTasks.length === 0) {
                empty.classList.remove('hidden');
                return;
            } else {
                empty.classList.add('hidden');
            }

            // Build Tree
            const tree = buildTree(flatTasks);
            
            // Helper to flatten tree for rendering order
            const flatten = (nodes, level = 0) => {
                let result = [];
                nodes.forEach(node => {
                    node.level = level;
                    result.push(node);
                    if (node.children && node.children.length > 0) {
                        result = result.concat(flatten(node.children, level + 1));
                    }
                });
                return result;
            };

            const renderList = flatten(tree);
            renderList.forEach(node => renderTaskRow(node, tbody));

        } catch (e) {
            console.error(e);
            loading.textContent = 'Error loading tasks.';
        }
    }

    function buildTree(tasks) {
        // Create a deep copy to avoid modifying ALL_TASKS directly with circular references if needed, 
        // but here we just add children array.
        const map = {};
        const roots = [];
        // First pass: create nodes
        tasks.forEach(t => {
            // Shallow copy to not mess up ALL_TASKS structure if we reload
            const node = { ...t, children: [] };
            map[node.projectTaskId] = node;
        });
        // Second pass: link parents
        Object.values(map).forEach(node => {
            if (node.parentTaskId && map[node.parentTaskId]) {
                map[node.parentTaskId].children.push(node);
            } else {
                roots.push(node);
            }
        });
        return roots;
    }

    function renderTaskRow(node, container) {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group border-b border-slate-50 dark:border-slate-800/50';
        
        const indent = node.level * 24;
        const hasChildren = node.children && node.children.length > 0;
        
        // Status Color
        let statusColor = 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400';
        if (node.status === 'Completed') statusColor = 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400';
        else if (node.status === 'In Progress') statusColor = 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400';
        else if (node.status === 'On Hold') statusColor = 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400';
        
        // Date formatting
        const start = node.startDate ? new Date(node.startDate).toLocaleDateString() : '-';
        const end = node.endDate ? new Date(node.endDate).toLocaleDateString() : '-';

        // Indentation visual
        const paddingLeft = indent + 24; // Base padding + indent

        tr.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center" style="padding-left: ${node.level * 20}px">
                    <span class="text-slate-400 mr-2">
                        ${hasChildren ? '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>' : '<div class="w-4 h-4"></div>'}
                    </span>
                    <div>
                        <div class="font-medium text-slate-900 dark:text-white text-sm">${node.title}</div>
                        <div class="text-[10px] text-slate-500 font-mono">${node.taskCode || ''}</div>
                    </div>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${statusColor}">
                    ${node.status || 'Pending'}
                </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-2">
                    <div class="w-16 bg-slate-200 rounded-full h-1.5 dark:bg-slate-700">
                        <div class="bg-indigo-600 h-1.5 rounded-full" style="width: ${node.percentComplete}%"></div>
                    </div>
                    <span class="text-xs text-slate-500">${node.percentComplete}%</span>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 dark:text-slate-400">
                ${node.assignedToName || '<span class="text-slate-400 italic">Unassigned</span>'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button onclick="openCreateTaskModal(${node.projectTaskId})" class="text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300" title="Add Subtask">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    </button>
                    <button onclick="openEditTaskModal(${node.projectTaskId})" class="text-amber-600 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300" title="Edit">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    </button>
                    <button onclick="deleteTask(${node.projectTaskId})" class="text-rose-600 hover:text-rose-900 dark:text-rose-400 dark:hover:text-rose-300" title="Delete">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                </div>
            </td>
        `;
        container.appendChild(tr);
    }

    function openCreateTaskModal(parentId) {
        document.getElementById('createTaskForm').reset();
        document.getElementById('newTaskParentId').value = parentId || '';
        document.getElementById('editingTaskId').value = ''; // Ensure not in edit mode
        document.getElementById('taskAssignedTo').value = '';
        
        document.getElementById('modalTitle').innerText = 'New Task';
        document.getElementById('taskSubmitBtn').innerText = 'Create Task';
        
        // Hide status/progress for new tasks
        document.getElementById('status-progress-fields').classList.add('hidden');
        
        // Defaults
        document.querySelector('select[name=Status]').value = 'Pending';
        document.querySelector('input[name=PercentComplete]').value = 0;

        showModal();
    }

    function openEditTaskModal(taskId) {
        const task = ALL_TASKS[taskId];
        if (!task) return;

        document.getElementById('createTaskForm').reset();
        document.getElementById('editingTaskId').value = taskId;
        document.getElementById('newTaskParentId').value = task.parentTaskId || '';
        document.getElementById('taskAssignedTo').value = task.assignedToUserId || '';
        
        document.getElementById('modalTitle').innerText = 'Edit Task';
        document.getElementById('taskSubmitBtn').innerText = 'Update Task';
        
        // Show status/progress for edits
        document.getElementById('status-progress-fields').classList.remove('hidden');

        // Populate Form
        const form = document.getElementById('createTaskForm');
        form.querySelector('[name=Title]').value = task.title;
        form.querySelector('[name=Description]').value = task.description || '';
        form.querySelector('[name=StartDate]').value = task.startDate ? task.startDate.split('T')[0] : '';
        form.querySelector('[name=EndDate]').value = task.endDate ? task.endDate.split('T')[0] : '';
        form.querySelector('[name=Budget]').value = task.budget;
        form.querySelector('[name=Status]').value = task.status || 'Pending';
        form.querySelector('[name=PercentComplete]').value = task.percentComplete || 0;

        showModal();
    }

    function showModal() {
        const modal = document.getElementById('createTaskModal');
        modal.classList.remove('hidden');
        setTimeout(() => {
             modal.firstElementChild.classList.remove('scale-95');
             modal.firstElementChild.classList.add('scale-100');
        }, 10);
    }

    function closeCreateTaskModal() {
        const modal = document.getElementById('createTaskModal');
        modal.firstElementChild.classList.remove('scale-100');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    async function submitCreateTask(e) {
        e.preventDefault();
        
        const form = document.getElementById('createTaskForm');
        const editingTaskId = document.getElementById('editingTaskId').value;
        // Manual gathering because FormData can be tricky with JSON content-type directly
        const parentIdVal = document.getElementById('newTaskParentId').value;
        const assignedTo = document.getElementById('taskAssignedTo').value;
        
        const data = {
            ProjectId: PROJECT_ID,
            ParentTaskId: parentIdVal ? parseInt(parentIdVal) : null,
            Title: form.querySelector('[name=Title]').value,
            Description: form.querySelector('[name=Description]').value,
            StartDate: form.querySelector('[name=StartDate]').value || null,
            EndDate: form.querySelector('[name=EndDate]').value || null,
            Budget: form.querySelector('[name=Budget]').value ? parseFloat(form.querySelector('[name=Budget]').value) : null,
            Status: form.querySelector('select[name=Status]').value,
            PercentComplete: parseInt(form.querySelector('input[name=PercentComplete]').value),
            AssignedToUserId: assignedTo || null
        };

        const btn = form.querySelector('button[type=submit]');
        const oldText = btn.innerText;
        btn.disabled = true;
        btn.innerText = 'Saving...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            let url = `${API_URL}/CreateTask`;
            let bodyData = data;

            if (editingTaskId) {
                url = `${API_URL}/UpdateTask`;
                // Add Update specific fields if needed, or merge
                bodyData = { ...data, ProjectTaskId: parseInt(editingTaskId) };
            }
            
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify(bodyData)
            });
            
            if (res.ok) {
                closeCreateTaskModal();
                loadTasks();
            } else {
                console.error(await res.text());
                alert('Failed to save task');
            }
        } catch (err) {
            console.error(err);
            alert('Error saving task');
        } finally {
            btn.disabled = false;
            btn.innerText = oldText;
        }
    }

    async function deleteTask(id) {
        if (!confirm('Are you sure you want to delete this task?')) return;
        
        try {
             const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
             const res = await fetch(`${API_URL}/DeleteTask?id=${id}`, { 
                 method: 'POST',
                 headers: { 'RequestVerificationToken': token || '' }
             });
            if (res.ok) {
                loadTasks();
            } else {
                alert('Failed to delete task');
            }
        } catch (err) {
            console.error(err);
            alert('Error deleting task');
        }
    }
</script>
