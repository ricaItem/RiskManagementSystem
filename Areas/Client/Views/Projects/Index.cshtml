@model WEB_Sentro.Areas.Client.Controllers.ProjectIndexViewModel
@{
    Layout = "_LayoutClient";
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) : 1;
}

<style>
    .client-projects {
        font-family: 'Inter', sans-serif;
    }

    /* Soft floating cards - no harsh borders */
    .proj-card {
        background: #ffffff !important;
        border: 1px solid rgba(0, 0, 0, 0.02) !important;
        border-radius: 24px !important; 
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0,0,0,0.02) !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* Interactive proj cards */
    a.proj-card:hover, .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08), 0 2px 5px rgba(0,0,0,0.03) !important;
    }

    /* Clean Pill Inputs */
    .pill-input {
        background: rgba(241, 245, 249, 0.6) !important; /* Very faint slate-100 */
        border: 1px solid transparent !important;
        transition: all 0.2s ease;
        border-radius: 9999px;
    }
    .pill-input:focus-within, .pill-input:hover {
        background: #ffffff !important;
        border-color: #e2e8f0 !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02) !important;
    }
</style>

<div class="client-projects animate-in fade-in slide-in-from-bottom-4 min-h-screen space-y-8 p-4 md:p-8 duration-700">
    
    <!-- Header Section -->
    <div class="proj-card p-6 md:p-8">
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
            <div class="min-w-0">
                <div class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-1">Home / Projects</div>
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-800">
                    Project Portfolio
                </h1>
                <p class="mt-1 text-sm font-medium text-slate-400">Manage and track your active construction zones.</p>
            </div>
            
            <a href="@Url.Action("Create", "Projects", new { area = "Client" })" class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-xs font-bold text-white shadow-lg shadow-blue-600/20 transition-all hover:bg-blue-700 hover:shadow-xl hover:shadow-blue-600/30 active:scale-95 min-w-[150px]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                New Project
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-sm font-medium text-emerald-800 flex items-center gap-3 shadow-sm">
            <div class="rounded-full bg-emerald-200/50 p-1.5 text-emerald-600">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            @TempData["Message"]
        </div>
    }

    <!-- Filters Section -->
    <div class="proj-card p-6">
        <form method="get" action="@Url.Action("Index", "Projects", new { area = "Client" })" class="flex flex-wrap items-center gap-4">
            <div class="flex-1 min-w-[240px]">
                <div class="pill-input flex items-center px-4 py-2">
                    <svg class="w-4 h-4 text-slate-400 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    <input type="text" name="search" value="@Model.Search" placeholder="Search project name or code..." class="w-full border-0 bg-transparent p-0 text-sm font-medium text-slate-700 focus:ring-0 placeholder:font-normal placeholder:text-slate-400" />
                </div>
            </div>
            <div class="w-full sm:w-56">
                <div class="pill-input flex items-center px-4 py-2">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mr-2 shrink-0">Status</span>
                    <select name="status" asp-items="@(new SelectList(new[] { "Draft", "Active", "OnHold", "Completed", "Cancelled" }, Model.StatusFilter))" class="w-full border-0 bg-transparent p-0 text-sm font-medium text-slate-700 focus:ring-0 cursor-pointer">
                        <option value="">All statuses</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="rounded-full bg-slate-100 px-6 py-2.5 text-xs font-bold text-slate-600 transition hover:bg-slate-200 focus-visible:ring-2 focus-visible:ring-slate-400 active:scale-95">Filter</button>
        </form>
    </div>

    <!-- Projects Grid -->
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-20 proj-card flex flex-col items-center justify-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-slate-50 mb-5">
                <svg class="h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </div>
            <h3 class="text-lg font-bold tracking-tight text-slate-800">No projects found</h3>
            <p class="mt-2 text-sm font-medium text-slate-400">Get started by creating a new active project zone.</p>
            <div class="mt-6">
                <a href="@Url.Action("Create", "Projects", new { area = "Client" })" class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-lg shadow-blue-600/20 hover:bg-blue-700 transition-all active:scale-95">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    New Project
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var p in Model.Items)
            {
                var statusColor = p.Status switch {
                    "Active" => "bg-emerald-50 text-emerald-600",
                    "Completed" => "bg-blue-50 text-blue-600",
                    "OnHold" => "bg-amber-50 text-amber-600",
                    "Cancelled" => "bg-rose-50 text-rose-600",
                    _ => "bg-slate-50 text-slate-600"
                };

                <div class="group proj-card flex flex-col overflow-hidden hover-lift">
                    <div class="p-6 flex-1">
                        <div class="flex items-start justify-between mb-5">
                            <div class="h-12 w-12 rounded-full bg-blue-50/80 flex items-center justify-center text-blue-600 font-black text-xl shadow-inner">
                                @(p.Name.Length > 0 ? p.Name[0].ToString().ToUpper() : "P")
                            </div>
                            <span class="inline-flex items-center rounded-full px-3 py-1 text-[10px] font-bold @statusColor tracking-widest uppercase">
                                @p.Status
                            </span>
                        </div>
                        
                        <h3 class="text-lg font-extrabold tracking-tight text-slate-800 mb-1 line-clamp-1" title="@p.Name">@p.Name</h3>
                        <p class="text-[11px] font-mono font-medium text-slate-400 mb-5">@p.ProjectCode</p>
                        
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Manager</span>
                                <span class="text-xs font-semibold text-slate-700">@p.ManagerName</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Site</span>
                                <span class="text-xs font-semibold text-slate-700 truncate max-w-[120px]" title="@p.SiteName">@(p.SiteName ?? "None")</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Budget</span>
                                <span class="text-xs font-bold text-slate-800">@(p.Budget.HasValue ? p.Budget.Value.ToString("C0", new System.Globalization.CultureInfo("en-PH")) : "-")</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-slate-50/50 px-6 py-4 flex items-center justify-between border-t border-slate-100/50">
                        <div class="text-[11px] font-medium text-slate-400">
                            @if (p.EndDate.HasValue) {
                                <span>Due @p.EndDate.Value.ToString("MMM d, yyyy")</span>
                            } else {
                                <span>No due date</span>
                            }
                        </div>
                        <a href="@Url.Action("Details", "Projects", new { area = "Client", id = p.ProjectId })" class="text-[11px] font-bold text-blue-600 hover:text-blue-700 uppercase tracking-widest flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            View <span aria-hidden="true">&rarr;</span>
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="flex justify-center mt-8">
                <nav class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-slate-100">
                    @if (Model.PageNumber > 1)
                    {
                        <a href="@Url.Action("Index", "Projects", new { area = "Client", page = Model.PageNumber - 1, search = Model.Search, status = Model.StatusFilter })" class="p-2 rounded-full text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                            <span class="sr-only">Previous</span>
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                        </a>
                    }
                    
                    <span class="text-xs font-bold text-slate-600 px-4">
                        Page @Model.PageNumber of @totalPages
                    </span>

                    @if (Model.PageNumber < totalPages)
                    {
                        <a href="@Url.Action("Index", "Projects", new { area = "Client", page = Model.PageNumber + 1, search = Model.Search, status = Model.StatusFilter })" class="p-2 rounded-full text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors">
                            <span class="sr-only">Next</span>
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </a>
                    }
                </nav>
            </div>
        }
    }
</div>
