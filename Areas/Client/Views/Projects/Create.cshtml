@model WEB_Sentro.Areas.Client.Controllers.ProjectCreateViewModel
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "New Project";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="mb-8">
        <a href="@Url.Action("Index", "Projects", new { area = "Client" })" class="text-sm font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300 flex items-center gap-1 mb-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Projects
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Create New Project</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Initialize a new construction project, assign a site and manager.</p>
    </div>

    <form method="post" asp-action="Create" class="space-y-8">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Project Details</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="col-span-2">
                    <label asp-for="Name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Project Name</label>
                    <input asp-for="Name" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm" placeholder="e.g. Davao Commercial Complex" />
                    <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
                </div>

                <div>
                    <label asp-for="ProjectCode" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Project Code</label>
                    <input asp-for="ProjectCode" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm" placeholder="e.g. PRJ-2024-001" />
                    <span asp-validation-for="ProjectCode" class="text-xs text-rose-500"></span>
                </div>

                <div>
                    <label asp-for="Status" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Initial Status</label>
                    <select asp-for="Status" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm">
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                    </select>
                </div>

                <div class="col-span-2">
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description</label>
                    <textarea asp-for="Description" rows="3" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm"></textarea>
                </div>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Timeline & Budget</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Start Date</label>
                    <input asp-for="StartDate" type="date" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm" />
                </div>

                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">End Date</label>
                    <input asp-for="EndDate" type="date" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm" />
                </div>

                <div>
                    <label asp-for="Budget" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Total Budget</label>
                    <div class="relative rounded-md shadow-sm">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <span class="text-slate-500 sm:text-sm">$</span>
                        </div>
                        <input asp-for="Budget" type="number" step="0.01" class="w-full rounded-lg border-slate-200 bg-slate-50 pl-7 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm" placeholder="0.00" />
                    </div>
                </div>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Assignment</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="SiteId" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Project Site</label>
                    <select asp-for="SiteId" asp-items="Model.AvailableSites" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm">
                        <option value="">-- Select a Site --</option>
                    </select>
                    <p class="mt-1 text-xs text-slate-500">The physical location where this project is taking place.</p>
                </div>

                <div>
                    <label asp-for="ManagerUserId" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Project Manager</label>
                    <select asp-for="ManagerUserId" asp-items="Model.AvailableManagers" class="w-full rounded-lg border-slate-200 bg-slate-50 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:text-sm">
                        <option value="">-- Select Manager --</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-4">
            <a href="@Url.Action("Index", "Projects", new { area = "Client" })" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancel</a>
            <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Create Project</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
