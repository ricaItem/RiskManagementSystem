@model WEB_Sentro.Areas.Vendor.Models.BillingIndexViewModel
@{
    ViewData["Title"] = "Billing & Subscriptions";
    Layout = "~/Areas/Vendor/Views/Shared/_LayoutVendor.cshtml";
}

<div class="space-y-6 animate-in fade-in duration-500">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Billing <span class="text-emerald-600">Operations</span></h1>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Live subscription and revenue data</p>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Total Revenue</p>
            <p class="text-2xl font-black text-slate-900 dark:text-white">@Model.TotalRevenueDisplay</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Monthly Recurring Revenue</p>
            <p class="text-2xl font-black text-emerald-600">@Model.MonthlyRecurringRevenueDisplay</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Active Subscriptions</p>
            <p class="text-2xl font-black text-sky-500">@Model.ActiveSubscriptionsCount</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Renewals in 30 Days</p>
            <p class="text-2xl font-black text-amber-500">@Model.PendingRenewalsCount</p>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white overflow-hidden dark:border-slate-800 dark:bg-slate-900/50 shadow-sm">
        <div class="p-6 border-b border-slate-100 dark:border-slate-800">
            <h3 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white">Organization Subscriptions</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 text-[10px] font-black uppercase tracking-widest text-slate-400 dark:bg-slate-800/30">
                        <th class="px-6 py-4">Organization</th>
                        <th class="px-6 py-4">Plan</th>
                        <th class="px-6 py-4">Users / Limit</th>
                        <th class="px-6 py-4">Next Renewal</th>
                        <th class="px-6 py-4">Amount</th>
                        <th class="px-6 py-4">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                    @foreach (var sub in Model.Subscriptions)
                    {
                        var utilization = sub.SeatLimit.HasValue && sub.SeatLimit.Value > 0
                            ? Math.Min(100, (int)Math.Round(sub.ActiveUsers * 100.0 / sub.SeatLimit.Value))
                            : 0;
                        <tr>
                            <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">@sub.OrganizationName</td>
                            <td class="px-6 py-4">@sub.PlanName</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-slate-600 dark:text-slate-300">@sub.ActiveUsers / @(sub.SeatLimit?.ToString() ?? "-")</span>
                                    @if (sub.SeatLimit.HasValue && sub.SeatLimit.Value > 0)
                                    {
                                        <div class="h-1.5 w-12 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                            <div class="h-full bg-sky-500" style="width: @utilization%"></div>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-500">@sub.NextRenewalDisplay</td>
                            <td class="px-6 py-4 font-black text-slate-900 dark:text-white">@sub.AmountDisplay</td>
                            <td class="px-6 py-4">
                                <span class="text-xs font-bold @(sub.SubscriptionStatus == "Active" ? "text-emerald-600" : "text-amber-500")">@sub.SubscriptionStatus</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
