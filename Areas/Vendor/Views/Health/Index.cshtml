@model WEB_Sentro.Areas.Vendor.Models.HealthIndexViewModel
@{
    ViewData["Title"] = "System Health & Uptime";
    Layout = "~/Areas/Vendor/Views/Shared/_LayoutVendor.cshtml";
}

<div class="space-y-6 animate-in fade-in duration-500">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">System <span class="text-emerald-600">Health</span></h1>
            <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Last check @Model.CheckedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
        </div>
        <div class="rounded-full px-4 py-2 text-xs font-black uppercase @Model.OverallStatusClass bg-white border border-slate-200 dark:bg-slate-900 dark:border-slate-800">
            @Model.OverallStatus
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Application Uptime</p>
            <p class="text-2xl font-black text-slate-900 dark:text-white">@Model.AppUptimeDisplay</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Checks</p>
            <p class="text-2xl font-black text-sky-500">@Model.Checks.Count</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <p class="text-[10px] uppercase tracking-widest text-slate-400">Critical Checks</p>
            <p class="text-2xl font-black text-rose-500">@Model.Checks.Count(c => c.Status == "Critical")</p>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white overflow-hidden dark:border-slate-800 dark:bg-slate-900/50">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-400 dark:bg-slate-800/30">
                    <th class="px-6 py-4">Check</th>
                    <th class="px-6 py-4">Description</th>
                    <th class="px-6 py-4">Value</th>
                    <th class="px-6 py-4">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                @foreach (var check in Model.Checks)
                {
                    <tr>
                        <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">@check.Name</td>
                        <td class="px-6 py-4 text-slate-500">@check.Description</td>
                        <td class="px-6 py-4">@check.Value</td>
                        <td class="px-6 py-4"><span class="text-xs font-bold @check.StatusColorClass">@check.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
