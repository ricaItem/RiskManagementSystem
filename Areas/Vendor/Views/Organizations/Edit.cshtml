@model WEB_Sentro.Areas.Vendor.Models.OrganizationEditViewModel

@{
    ViewData["Title"] = "Edit Organization";
    Layout = "~/Areas/Vendor/Views/Shared/_LayoutVendor.cshtml";
}

<div class="space-y-8 animate-in fade-in duration-500">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white lg:text-3xl">
                Edit <span class="text-emerald-600 dark:text-emerald-400">Organization</span>
            </h1>
            <p class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                Update organization details, subscription plan, and contact information.
            </p>
        </div>
        <a asp-action="Index" class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-bold text-slate-700 transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Back to List
        </a>
    </div>

    <div class="rounded-3xl border border-slate-200/70 bg-white p-8 shadow-sm dark:border-slate-800/70 dark:bg-slate-900/50">
        <form asp-action="Update" asp-route-id="@Model.OrganizationId" method="post" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OrganizationId" />

            <div class="grid gap-8 md:grid-cols-2">
                <div class="space-y-6">
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">General Information</h3>
                    
                    <div class="space-y-4">
                        <div>
                            <label asp-for="OrgName" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                            <input asp-for="OrgName" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                            <span asp-validation-for="OrgName" class="text-xs text-rose-500 font-bold"></span>
                        </div>

                        <div>
                            <label asp-for="OrgCode" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                            <input asp-for="OrgCode" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                            <span asp-validation-for="OrgCode" class="text-xs text-rose-500 font-bold"></span>
                        </div>

                         <div>
                            <label asp-for="TaxId" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                            <input asp-for="TaxId" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                            <span asp-validation-for="TaxId" class="text-xs text-rose-500 font-bold"></span>
                        </div>
                    </div>
                </div>

                <div class="space-y-6">
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">Subscription & Status</h3>
                    
                    <div class="space-y-4">
                        <div>
                            <label asp-for="PlanName" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                            <select asp-for="PlanName" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                                <option value="Basic">Basic</option>
                                <option value="Professional">Professional</option>
                                <option value="Enterprise">Enterprise</option>
                            </select>
                            <span asp-validation-for="PlanName" class="text-xs text-rose-500 font-bold"></span>
                        </div>

                        <div>
                            <label asp-for="Status" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                            <select asp-for="Status" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                                <option value="Active">Active</option>
                                <option value="Pending">Pending</option>
                                <option value="Suspended">Suspended</option>
                                <option value="Archived">Archived</option>
                            </select>
                            <span asp-validation-for="Status" class="text-xs text-rose-500 font-bold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-slate-100 dark:border-slate-800 pt-8 mt-8">
                 <h3 class="text-lg font-black text-slate-900 dark:text-white mb-6">Contact & Address</h3>
                 <div class="grid gap-6 md:grid-cols-2">
                      <div>
                        <label asp-for="PrimaryEmail" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="PrimaryEmail" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="PrimaryEmail" class="text-xs text-rose-500 font-bold"></span>
                    </div>

                    <div>
                        <label asp-for="PrimaryPhone" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="PrimaryPhone" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="PrimaryPhone" class="text-xs text-rose-500 font-bold"></span>
                    </div>

                    <div>
                        <label asp-for="Website" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="Website" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="Website" class="text-xs text-rose-500 font-bold"></span>
                    </div>

                    <div>
                        <label asp-for="AddressLine" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="AddressLine" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="AddressLine" class="text-xs text-rose-500 font-bold"></span>
                    </div>

                    <div>
                        <label asp-for="City" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="City" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="City" class="text-xs text-rose-500 font-bold"></span>
                    </div>

                    <div>
                        <label asp-for="Country" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2"></label>
                        <input asp-for="Country" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold focus:border-emerald-500 focus:ring-0 dark:border-slate-800 dark:bg-slate-950 dark:text-white" />
                        <span asp-validation-for="Country" class="text-xs text-rose-500 font-bold"></span>
                    </div>
                 </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <a asp-action="Index" class="rounded-xl px-6 py-3 text-sm font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</a>
                <button type="submit" class="rounded-xl bg-emerald-600 px-8 py-3 text-sm font-black text-white hover:bg-emerald-500 shadow-xl shadow-emerald-600/10">Save Changes</button>
            </div>
        </form>
    </div>
    
    <div class="rounded-3xl border border-rose-200/70 bg-rose-50/50 p-8 shadow-sm dark:border-rose-900/30 dark:bg-rose-900/10 mt-8">
        <h3 class="text-lg font-black text-rose-700 dark:text-rose-400 mb-4">Danger Zone</h3>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-6">
            Deleting an organization is irreversible. Please be certain.
        </p>
        <form asp-action="Delete" asp-route-id="@Model.OrganizationId" method="post" onsubmit="return confirm('Are you sure you want to delete this organization? This action cannot be undone.');">
            @Html.AntiForgeryToken()
             <button type="submit" class="rounded-xl bg-rose-600 px-6 py-2.5 text-xs font-bold text-white shadow-lg shadow-rose-600/20 transition-all hover:bg-rose-700">
                Delete Organization
            </button>
        </form>
    </div>
</div>
