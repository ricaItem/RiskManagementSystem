@model WEB_Sentro.Areas.Vendor.Models.VendorDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Vendor/Views/Shared/_LayoutVendor.cshtml";
    var complianceDashOffset = (double?)ViewData["ComplianceDashOffset"] ?? 552.92;
}

@functions {
    private static string SparklinePoints(List<int> points)
    {
        var values = (points ?? new List<int>()).ToList();
        if (values.Count == 0) values = new List<int> { 0, 0, 0, 0, 0, 0 };

        var max = Math.Max(1, values.Max());
        var step = values.Count == 1 ? 0 : 100.0 / (values.Count - 1);
        var pairs = new List<string>();

        for (var i = 0; i < values.Count; i++)
        {
            var x = Math.Round(i * step, 2);
            var y = Math.Round(60 - (values[i] * 60.0 / max), 2);
            pairs.Add($"{x},{y}");
        }

        return string.Join(" ", pairs);
    }

    private static string RiskVelocityDirection(List<int> points)
    {
        var values = (points ?? new List<int>()).ToList();
        if (values.Count < 2) return "Stable";

        var first = values.First();
        var last = values.Last();

        if (last > first) return "Uptrend";
        if (last < first) return "Downtrend";
        return "Stable";
    }

    private static string RiskVelocityDirectionClass(List<int> points)
    {
        var direction = RiskVelocityDirection(points);
        if (direction == "Uptrend") return "text-emerald-600 bg-emerald-50 border-emerald-200";
        if (direction == "Downtrend") return "text-rose-600 bg-rose-50 border-rose-200";
        return "text-slate-600 bg-slate-50 border-slate-200";
    }

    private static string BucketLabel(int index)
    {
        return index switch
        {
            0 => "W1",
            1 => "W2",
            2 => "W3",
            3 => "W4",
            4 => "W5",
            _ => "Now"
        };
    }
}

<div class="space-y-8 animate-in fade-in duration-500">
    <div class="relative overflow-hidden rounded-3xl border border-slate-200/70 bg-white/50 p-8 shadow-sm backdrop-blur-md dark:border-slate-800/70 dark:bg-slate-900/50">
        <div class="relative z-10 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white lg:text-3xl">
                    System Risk <span class="text-emerald-600 dark:text-emerald-400">Intelligence</span>
                </h1>
                <p class="mt-2 max-w-2xl text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">
                    Real-time oversight across <span class="font-bold text-slate-700 dark:text-slate-200">@Model.OrganizationCount.ToString("N0") organizations</span>.
                    Monitor compliance trends and system-wide exposure from a single vantage point.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <button class="flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-semibold text-white transition-all hover:bg-slate-800 dark:bg-white dark:text-slate-900">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    New Report
                </button>
            </div>
        </div>
        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-emerald-500/10 blur-3xl"></div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="group rounded-3xl border border-slate-200/70 bg-white p-6 transition-all hover:shadow-md dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="flex items-center justify-between">
                <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/50">
                    <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16" /></svg>
                </div>
                <span class="text-[10px] font-medium uppercase tracking-widest text-slate-400">Organizations</span>
            </div>
            <div class="mt-4">
                <h3 class="text-3xl font-semibold text-slate-900 dark:text-white">@Model.OrganizationCount.ToString("N0")</h3>
                <p class="text-xs font-medium text-slate-500">Active Tenants</p>
            </div>
        </div>

        <div class="group rounded-3xl border border-slate-200/70 bg-white p-6 transition-all hover:shadow-md dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="flex items-center justify-between">
                <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/50">
                    <svg class="h-6 w-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
                <span class="text-[10px] font-medium uppercase tracking-widest text-slate-400">Active Risks</span>
            </div>
            <div class="mt-4">
                <h3 class="text-3xl font-semibold text-slate-900 dark:text-white">@Model.ActiveRisksCount.ToString("N0")</h3>
                <p class="text-xs font-medium text-slate-500">Across Platform</p>
            </div>
        </div>

        <div class="group rounded-3xl border border-slate-200/70 bg-white p-6 transition-all hover:shadow-md dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="flex items-center justify-between">
                <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/50">
                    <svg class="h-6 w-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <span class="text-[10px] font-medium uppercase tracking-widest text-slate-400">Open Incidents</span>
            </div>
            <div class="mt-4">
                <h3 class="text-3xl font-semibold text-slate-900 dark:text-white">@Model.OpenIncidentsCount.ToString("N0")</h3>
                <p class="text-xs font-medium text-slate-500">Awaiting Action</p>
            </div>
        </div>

        <div class="group rounded-3xl border border-slate-200/70 bg-white p-6 transition-all hover:shadow-md dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="flex items-center justify-between">
                <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/50">
                    <svg class="h-6 w-6 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <span class="text-[10px] font-medium uppercase tracking-widest text-slate-400">Platform Health</span>
            </div>
            <div class="mt-4">
                <h3 class="text-3xl font-semibold text-slate-900 dark:text-white">@Model.PlatformHealthPercent.ToString("0.0")%</h3>
                <p class="text-xs font-medium text-slate-500">Average health score</p>
            </div>
        </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8 rounded-3xl border border-slate-200/70 bg-white p-8 dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Risk Velocity</h3>
                    <p class="text-xs font-normal text-slate-500">Aggregated activity trend across active tenants</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-200">
                    @Model.RiskVelocityTotalEvents.ToString("N0") events (30d)
                </div>
            </div>

            <div class="mt-8 rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 p-4 dark:border-slate-800 dark:from-slate-900/70 dark:to-slate-950/70">
                @if (Model.RiskVelocityPoints.Sum() == 0)
                {
                    <div class="flex h-64 items-center justify-center text-center">
                        <div class="mx-auto h-12 w-12 rounded-full bg-slate-100 p-2 dark:bg-slate-800/60">
                            <svg class="text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>
                        </div>
                        <p class="mt-3 text-sm font-medium text-slate-600 dark:text-slate-400">No velocity data yet</p>
                        <p class="text-[10px] text-slate-400">Snapshot service has not generated trend points.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] uppercase tracking-wider text-slate-400">Signal</p>
                                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">30-day activity momentum</p>
                            </div>
                            <span class="rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-wider @RiskVelocityDirectionClass(Model.RiskVelocityPoints)">
                                @RiskVelocityDirection(Model.RiskVelocityPoints)
                            </span>
                        </div>

                        <div class="relative h-56 overflow-hidden rounded-xl border border-slate-200 bg-white px-3 py-4 dark:border-slate-700 dark:bg-slate-900/60">
                            <svg viewBox="0 0 100 60" class="h-full w-full overflow-visible">
                                <defs>
                                    <linearGradient id="riskVelocityArea" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
                                        <stop offset="100%" stop-color="#10b981" stop-opacity="0.02" />
                                    </linearGradient>
                                    <linearGradient id="riskVelocityStroke" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#34d399" />
                                        <stop offset="100%" stop-color="#10b981" />
                                    </linearGradient>
                                </defs>

                                <line x1="0" y1="10" x2="100" y2="10" stroke="#e2e8f0" stroke-width="0.6" stroke-dasharray="2 2" />
                                <line x1="0" y1="25" x2="100" y2="25" stroke="#e2e8f0" stroke-width="0.6" stroke-dasharray="2 2" />
                                <line x1="0" y1="40" x2="100" y2="40" stroke="#e2e8f0" stroke-width="0.6" stroke-dasharray="2 2" />
                                <line x1="0" y1="55" x2="100" y2="55" stroke="#cbd5e1" stroke-width="0.8" />

                                <polygon points="@SparklinePoints(Model.RiskVelocityPoints) 100,55 0,55" fill="url(#riskVelocityArea)" />
                                <polyline fill="none" stroke="url(#riskVelocityStroke)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" points="@SparklinePoints(Model.RiskVelocityPoints)" />

                                @{
                                    var points = Model.RiskVelocityPoints ?? new List<int>();
                                    var maxPoint = Math.Max(1, points.Count == 0 ? 1 : points.Max());
                                    var step = points.Count <= 1 ? 0 : 100.0 / (points.Count - 1);
                                }
                                @for (var i = 0; i < points.Count; i++)
                                {
                                    var x = Math.Round(i * step, 2);
                                    var y = Math.Round(55 - (points[i] * 45.0 / maxPoint), 2);
                                    <circle cx="@x" cy="@y" r="1.2" fill="#10b981" stroke="white" stroke-width="0.8" />
                                }
                            </svg>
                        </div>

                        @{
                            var labelPoints = Model.RiskVelocityPoints ?? new List<int>();
                        }
                        <div class="grid grid-cols-6 gap-2 text-center">
                            @for (var i = 0; i < labelPoints.Count; i++)
                            {
                                <div class="rounded-lg border border-slate-200 bg-white py-2 text-[10px] dark:border-slate-700 dark:bg-slate-900/50">
                                    <p class="font-semibold text-slate-700 dark:text-slate-200">@BucketLabel(i)</p>
                                    <p class="text-slate-500">@labelPoints[i]</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-4 rounded-3xl border border-slate-200/70 bg-gradient-to-b from-white to-slate-50/50 p-8 dark:border-slate-800/70 dark:from-slate-900/50 dark:to-slate-900/80">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white text-center">System Compliance</h3>

            <div class="relative mt-10 flex justify-center">
                <svg class="h-48 w-48 -rotate-90 transform">
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" class="text-slate-200 dark:text-slate-800" />
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" stroke-dasharray="552.92" stroke-dashoffset="@complianceDashOffset" class="text-emerald-500" stroke-linecap="round" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-4xl font-semibold text-slate-900 dark:text-white">@Model.CompliancePercent%</span>
                    <span class="text-[10px] font-medium uppercase tracking-widest text-emerald-600">@Model.DataFreshnessLabel</span>
                </div>
            </div>

            <div class="mt-10 space-y-4">
                <div class="flex items-center justify-between text-sm">
                    <span class="font-medium text-slate-600 dark:text-slate-400">Target Goal</span>
                    <span class="font-semibold text-slate-900 dark:text-white">@Model.ComplianceTargetPercent.ToString("0.0")%</span>
                </div>
                <div class="h-2 w-full rounded-full bg-slate-200 dark:bg-slate-800">
                    <div class="h-2 rounded-full bg-emerald-500" style="width: @Model.CompliancePercent%"></div>
                </div>
                <p class="text-center text-[10px] font-medium text-slate-400">Last updated: @Model.LastUpdatedDisplay</p>
            </div>
        </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200/70 bg-white p-6 dark:border-slate-800/70 dark:bg-slate-900/50">
            <h4 class="text-sm font-medium uppercase tracking-widest text-slate-400">Risk Severity</h4>
            <div class="mt-6 space-y-5">
                @foreach (var item in Model.RiskSeverity)
                {
                    <div>
                        <div class="mb-2 flex justify-between text-xs font-medium">
                            <span class="text-slate-700 dark:text-slate-300">@item.Label</span>
                            <span class="text-slate-900 dark:text-white">@item.Count.ToString("N0")</span>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-slate-100 dark:bg-slate-800">
                            <div class="h-1.5 rounded-full @item.ColorClass" style="width: @item.Percent%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200/70 bg-white p-6 dark:border-slate-800/70 dark:bg-slate-900/50">
            <div class="mb-6 flex items-center justify-between">
                <h4 class="text-sm font-medium uppercase tracking-widest text-slate-400">Live Feed</h4>
                <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <div class="space-y-6">
                @if (Model.LiveFeed.Count == 0)
                {
                    <p class="text-xs font-medium text-slate-500">No recent events in the last 48 hours.</p>
                }
                else
                {
                    @foreach (var eventRow in Model.LiveFeed)
                    {
                        <div class="flex gap-4">
                            <div class="mt-1 h-2 w-2 shrink-0 rounded-full @eventRow.DotClass"></div>
                            <div>
                                <p class="text-xs font-medium text-slate-900 dark:text-white">@eventRow.Title</p>
                                <p class="text-[10px] font-medium text-slate-500">@eventRow.Meta</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="rounded-3xl border border-emerald-100 bg-emerald-50/50 p-6 dark:border-emerald-900/30 dark:bg-emerald-900/10">
            <h4 class="text-sm font-semibold uppercase tracking-widest text-emerald-800 dark:text-emerald-400">System Health</h4>
            <div class="mt-6 grid grid-cols-2 gap-4">
                <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
                    <p class="text-[10px] font-medium text-slate-400 uppercase">Snapshot Age</p>
                    <p class="text-lg font-semibold text-slate-900 dark:text-white">@Model.LastUpdatedDisplay</p>
                </div>
                <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
                    <p class="text-[10px] font-medium text-slate-400 uppercase">Jobs</p>
                    <p class="text-lg font-semibold text-emerald-600">@Model.JobsStatusLabel</p>
                </div>
            </div>
            <button class="mt-6 w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all hover:scale-[1.02] active:scale-95">
                Run Diagnostic
            </button>
        </div>
    </div>
</div>
