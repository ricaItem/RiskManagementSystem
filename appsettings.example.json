{
  "ConnectionStrings": {
    "PlatformDb": "Server=(localdb)\\mssqllocaldb;Database=Sentro_Platform;Trusted_Connection=True;MultipleActiveResultSets=true",
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Sentro_Platform;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Tenant_Org_1": "Server=(localdb)\\mssqllocaldb;Database=Sentro_Tenant_1;Trusted_Connection=True;MultipleActiveResultSets=true",
    "TenantDb": "Server=(localdb)\\mssqllocaldb;Database=Sentro_Tenant_1;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": true,
    "AutoMigrateTenantOrg1": true
  },
  "Monitoring": {
    "SyncIntervalMinutes": 15,
    "SyncOrgIds": [ 1 ]
  },
  "RiskReview": {
    "ReminderIntervalHours": 24,
    "NotifyDaysAhead": 7,
    "OrgIds": [ 1 ]
  },
  "VendorAnalytics": {
    "SnapshotIntervalMinutes": 15,
    "MaxParallelTenants": 4
  },
  "PayMongo": {
    "SecretKey": "",
    "PublicKey": "",
    "BaseUrl": "https://api.paymongo.com"
  },
  "Jwt": {
    "Issuer": "WEB_Sentro",
    "Audience": "WEB_Sentro.Client",
    "SigningKey": "replace-with-a-long-random-secret-at-least-32-characters",
    "AccessTokenMinutes": 60,
    "TwoFactorChallengeMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
